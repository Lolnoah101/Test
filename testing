local function TeleportToFarmTarget(
    Target
)
    local Root =
        GetRootPart()

    local Position =
        GetClientEnemyPosition(
            Target
        )

    if not Root
        or not Position
    then
        return false
    end

    CancelFarmTween()
    StopLegitMovement()

    -- One instant teleport. Rotation stays exactly as it was.
    local RotationOnly =
        Root.CFrame
        - Root.Position

    Root.CFrame =
        CFrame.new(
            Position
        )
        * RotationOnly

    Root.AssemblyLinearVelocity =
        Vector3.zero

    Root.AssemblyAngularVelocity =
        Vector3.zero

    return true
end


local function TweenToFarmTarget(
    Target
)
    local Root =
        GetRootPart()

    local Position =
        GetClientEnemyPosition(
            Target
        )

    if not Root
        or not Position
    then
        return false
    end

    CancelFarmTween()
    StopLegitMovement()

    local RotationOnly =
        Root.CFrame
        - Root.Position

    local Distance =
        (
            Root.Position
            - Position
        ).Magnitude

    local Duration =
        math.max(
            Distance
                / math.max(
                    tonumber(
                        Settings.FarmTweenSpeed
                    ) or 35,
                    1
                ),
            0.05
        )

    local Tween =
        TweenService:Create(
            Root,
            TweenInfo.new(
                Duration,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.Out
            ),
            {
                CFrame =
                    CFrame.new(
                        Position
                    )
                    * RotationOnly,
            }
        )

    ActiveFarmTween =
        Tween

    Tween:Play()

    task.spawn(function()
        Tween.Completed:Wait()

        if ActiveFarmTween == Tween then
            ActiveFarmTween = nil
        end

        if Root
            and Root.Parent
        then
            Root.AssemblyLinearVelocity =
                Vector3.zero

            Root.AssemblyAngularVelocity =
                Vector3.zero
        end
    end)

    return true
end


local function LegitMoveToFarmTarget(
    Target
)
    local Character =
        LocalPlayer.Character

    local Humanoid =
        Character
        and Character:FindFirstChildOfClass(
            "Humanoid"
        )

    local Root =
        GetRootPart()

    local Position =
        GetClientEnemyPosition(
            Target
        )

    if not Humanoid
        or not Root
        or not Position
    then
        return false
    end

    CancelFarmTween()

    local Now =
        os.clock()

    local DestinationChanged =
        LegitLastDestination == nil
        or (
            LegitLastDestination
            - Position
        ).Magnitude
            >= LEGIT_DESTINATION_EPSILON

    local RefreshDue =
        Now - LegitLastMoveAt
            >= LEGIT_MOVE_REFRESH

    -- Reissuing MoveTo every loop makes the Humanoid jitter/stutter.
    -- Only refresh when the target actually moved or enough time passed.
    if DestinationChanged
        or RefreshDue
    then
        Humanoid:MoveTo(
            Position
        )

        LegitLastDestination =
            Position

        LegitLastMoveAt =
            Now
    end

    return true
end


local function ResetCurrentFarmTarget()
    StopFarmMovement()

    CurrentFarmUUID = nil
    CurrentFarmArea = nil
    CurrentFarmArrived = false
end


task.spawn(function()
    while HubRunning do
        local Success,
            ErrorMessage =
            pcall(function()
                -- Gamemode farming can target either the verified Time Trial
                -- folder or the local Raid_<UserId> folder.
                local GamemodeFolder,
                    GamemodeArea =
                    GetActiveGamemodeFarmFolder()

                local UseGamemode =
                    GamemodeFolder ~= nil

                -- A live gamemode always owns movement first.
                if UseGamemode then
                    Settings.__MovementPriorityState =
                        GamemodeArea == "TimeTrial"
                        and "Time Trial"
                        or "Raid"

                -- CRITICAL RAID HOLD:
                -- The server enemy folder can disappear for a moment between
                -- waves / during boss transitions. Never let normal Auto Farm
                -- interpret that gap as "Raid ended" and teleport back outside.
                elseif HasLocalRaidMovementLock() then
                    Settings.__MovementPriorityState =
                        "Raid • Waiting For Next Wave"

                    ResetCurrentFarmTarget()

                    Settings.__FarmTargetMissingSince =
                        nil

                    Settings.__FarmLastMoveAt =
                        0

                    CancelFarmTween()
                    StopLegitMovement()

                    return

                -- Commandment Fragments interrupt normal farming, but NEVER
                -- interrupt a live Time Trial / Raid.
                elseif Settings.__FragmentPriorityActive then
                    Settings.__MovementPriorityState =
                        "Commandment Fragment"

                    ResetCurrentFarmTarget()

                    Settings.__FarmTargetMissingSince =
                        nil

                    Settings.__FarmLastMoveAt =
                        0

                    return

                elseif Settings.AutoFarm then
                    Settings.__MovementPriorityState =
                        "Normal Farm"

                else
                    Settings.__MovementPriorityState =
                        "Idle"

                    ResetCurrentFarmTarget()

                    Settings.__FarmTargetMissingSince =
                        nil

                    Settings.__FarmLastMoveAt =
                        0

                    return
                end

                local UseNormalFarm =
                    Settings.AutoFarm
                    and not UseGamemode

                local TargetValid

                if UseGamemode then
                    TargetValid =
                        IsCurrentGamemodeTargetValid(
                            GamemodeFolder,
                            GamemodeArea
                        )
                else
                    TargetValid =
                        IsCurrentFarmTargetValid()
                end

                if not TargetValid then
                    ResetCurrentFarmTarget()

                    Settings.__FarmTargetMissingSince =
                        nil

                    Settings.__FarmLastMoveAt =
                        0

                    if UseGamemode then
                        local UUID,
                            Target =
                            GetGamemodeFarmTarget(
                                GamemodeFolder
                            )

                        if UUID
                            and Target
                        then
                            CurrentFarmUUID =
                                UUID

                            CurrentFarmArea =
                                GamemodeArea

                            CurrentFarmArrived =
                                false
                        end
                    else
                        local UUID,
                            Target,
                            AreaName =
                            GetSelectedFarmTarget()

                        if UUID
                            and Target
                            and AreaName
                        then
                            CurrentFarmUUID =
                                UUID

                            CurrentFarmArea =
                                AreaName

                            CurrentFarmArrived =
                                false
                        end
                    end
                end

                if not CurrentFarmUUID then
                    return
                end

                local Target

                if UseGamemode then
                    Target =
                        GetCurrentGamemodeTarget(
                            GamemodeFolder
                        )
                else
                    Target =
                        GetCurrentFarmClientTarget()
                end

                -- Client enemy models can briefly disappear during
                -- respawns/streaming. Give them a very short grace period,
                -- then drop the stale UUID and acquire another target.
                if not Target
                    or not Target.Parent
                then
                    if not Settings.__FarmTargetMissingSince then
                        Settings.__FarmTargetMissingSince =
                            os.clock()

                    elseif os.clock()
                        - Settings.__FarmTargetMissingSince
                        >= 0.35
                    then
                        ResetCurrentFarmTarget()

                        Settings.__FarmTargetMissingSince =
                            nil

                        Settings.__FarmLastMoveAt =
                            0
                    end

                    return
                end

                Settings.__FarmTargetMissingSince =
                    nil

                local Mode =
                    Settings.FarmMode

                if Mode == "Teleport" then
                    if IsTargetInRange(
                        CurrentFarmUUID
                    ) then
                        CurrentFarmArrived =
                            true

                        return
                    end

                    -- If the same enemy moves or respawns outside attack
                    -- range, re-position instead of trusting an old
                    -- CurrentFarmArrived state forever.
                    CurrentFarmArrived =
                        false

                    local Now =
                        os.clock()

                    local LastMoveAt =
                        tonumber(
                            Settings.__FarmLastMoveAt
                        )
                        or 0

                    if LastMoveAt == 0
                        or Now - LastMoveAt
                            >= 0.05
                    then
                        if TeleportToFarmTarget(
                            Target
                        ) then
                            Settings.__FarmLastMoveAt =
                                Now
                        end
                    end

                elseif Mode == "Tween" then
                    if IsTargetInRange(
                        CurrentFarmUUID
                    ) then
                        if not CurrentFarmArrived then
                            CancelFarmTween()

                            local Root =
                                GetRootPart()

                            if Root then
                                Root.AssemblyLinearVelocity =
                                    Vector3.zero

                                Root.AssemblyAngularVelocity =
                                    Vector3.zero
                            end

                            CurrentFarmArrived =
                                true
                        end
                    else
                        -- Re-arm movement if the target leaves range.
                        CurrentFarmArrived =
                            false

                        if not ActiveFarmTween then
                            TweenToFarmTarget(
                                Target
                            )
                        end
                    end

                elseif Mode == "Legit" then
                    if IsTargetInRange(
                        CurrentFarmUUID
                    ) then
                        if not CurrentFarmArrived then
                            StopLegitMovement()

                            CurrentFarmArrived =
                                true
                        end
                    else
                        CurrentFarmArrived =
                            false

                        LegitMoveToFarmTarget(
                            Target
                        )
                    end
                end
            end)

        if not Success then
            warn(
                "[Anime Breaker] Auto Farm recovered from error: "
                    .. tostring(
                        ErrorMessage
                    )
            )

            -- Clear stale state after an unexpected transient error,
            -- but keep the worker itself alive.
            ResetCurrentFarmTarget()


local FlyConnection = nil
local CharacterAddedConnection = nil
local BaseWalkSpeeds = setmetatable(
    {},
    { __mode = "k" }
)


local function GetPlayerHumanoid()
    local Character =
        LocalPlayer.Character

    return Character
        and Character:FindFirstChildOfClass(
            "Humanoid"
        )
end


local function GetPlayerRoot()
    local Character =
        LocalPlayer.Character

    return Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )
end


local function ApplySpeedMultiplier()
    local Humanoid =
        GetPlayerHumanoid()

    if not Humanoid then
        return
    end

    if BaseWalkSpeeds[
        Humanoid
    ] == nil
    then
        BaseWalkSpeeds[
            Humanoid
        ] =
            Humanoid.WalkSpeed
    end

    local Base =
        tonumber(
            BaseWalkSpeeds[
                Humanoid
            ]
        )
        or 16

    Humanoid.WalkSpeed =
        Base
        * math.clamp(
            tonumber(
                Settings.SpeedMultiplier
            )
            or 1,
            1,
            10
        )
end


local function RestoreWalkSpeed()
    local Humanoid =
        GetPlayerHumanoid()

    if not Humanoid then
        return
    end

    local Base =
        BaseWalkSpeeds[
            Humanoid
        ]

    if Base ~= nil then
        Humanoid.WalkSpeed =
            Base
    end
end


local function StopFly()
    Settings.Fly =
        false

    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection =
            nil
    end

    local Root =
        GetPlayerRoot()

    if Root then
        Root.AssemblyLinearVelocity =
            Vector3.zero

        Root.AssemblyAngularVelocity =
            Vector3.zero
    end
end


local function StartFly()
    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection =
            nil
    end

    Settings.Fly =
        true

    FlyConnection =
        RunService.RenderStepped:Connect(
            function()
                if not HubRunning
                    or not Settings.Fly
                then
                    return
                end

                local Character =
                    LocalPlayer.Character

                local Humanoid =
                    Character
                    and Character:FindFirstChildOfClass(
                        "Humanoid"
                    )

                local Root =
                    Character
                    and Character:FindFirstChild(
                        "HumanoidRootPart"
                    )

                local Camera =
                    workspace.CurrentCamera

                if not Humanoid
                    or not Root
                    or not Camera
                then
                    return
                end

                local MoveDirection =
                    Humanoid.MoveDirection

                local FlatForward =
                    Vector3.new(
                        Camera.CFrame.LookVector.X,
                        0,
                        Camera.CFrame.LookVector.Z
                    )

                local FlatRight =
                    Vector3.new(
                        Camera.CFrame.RightVector.X,
                        0,
                        Camera.CFrame.RightVector.Z
                    )

                if FlatForward.Magnitude > 0 then
                    FlatForward =
                        FlatForward.Unit
                end

                if FlatRight.Magnitude > 0 then
                    FlatRight =
                        FlatRight.Unit
                end

                -- Humanoid.MoveDirection already reflects WASD / thumbstick.
                local Horizontal =
                    MoveDirection

                local Vertical =
                    0

                if UserInputService:IsKeyDown(
                    Enum.KeyCode.Space
                )
                    or UserInputService:IsKeyDown(
                        Enum.KeyCode.E
                    )
                then
                    Vertical += 1
                end

                if UserInputService:IsKeyDown(
                    Enum.KeyCode.LeftControl
                )
                    or UserInputService:IsKeyDown(
                        Enum.KeyCode.Q
                    )
                then
                    Vertical -= 1
                end

                local Speed =
                    math.clamp(
                        tonumber(
                            Settings.FlySpeed
                        )
                        or 75,
                        10,
                        250
                    )

                local Velocity =
                    (
                        Horizontal
                        * Speed
                    )
                    + Vector3.new(
                        0,
                        Vertical * Speed,
                        0
                    )

                Root.Anchored =
                    false

                Root.AssemblyAngularVelocity =
                    Vector3.zero

                Root.AssemblyLinearVelocity =
                    Velocity
            end
        )
end



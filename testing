local HatchLuckUpgradeBusy = false


local function GetHatchLuckUpgradeState()
    local SavedData =
        LocalPlayer:FindFirstChild("SavedData")

    if not SavedData then
        return nil, "SavedData not found."
    end

    local HatchUpgrades =
        SavedData:FindFirstChild("HatchUpgrades")

    local Cash =
        SavedData:FindFirstChild("Cash")

    if not HatchUpgrades or not Cash then
        return nil, "HatchUpgrades or Cash not found."
    end

    local UsedFreeHatchUpgrades =
        SavedData:FindFirstChild("UsedFreeHatchUpgrades")

    local FreeHatchUpgrades =
        SavedData:FindFirstChild("FreeHatchUpgrades")

    local UpgradeValue =
        tonumber(HatchUpgrades.Value) or 0

    local UsedFree =
        UsedFreeHatchUpgrades
        and (tonumber(UsedFreeHatchUpgrades.Value) or 0)
        or 0

    local FreeCount =
        FreeHatchUpgrades
        and (tonumber(FreeHatchUpgrades.Value) or 0)
        or 0

    local CashValue =
        tonumber(Cash.Value) or 0

    local PaidUpgrades =
        HatchLuck.GetPaidUpgrades(
            UpgradeValue,
            UsedFree
        )

    local Price =
        HatchLuck.GetPrice(PaidUpgrades)

    return {
        SavedData = SavedData,
        HatchUpgrades = HatchUpgrades,
        Cash = Cash,
        UpgradeValue = UpgradeValue,
        UsedFree = UsedFree,
        FreeCount = FreeCount,
        CashValue = CashValue,
        PaidUpgrades = PaidUpgrades,
        Price = tonumber(Price),
    }
end


local function TryHatchLuckUpgrade()
    if HatchLuckUpgradeBusy then
        return false, "Busy"
    end

    if not Settings.AutoHatchLuckUpgrade then
        return false, "Disabled"
    end

    -- The game's own BuyOne handler refuses upgrades while this
    -- setting is explicitly false, so pause automation too.
    if LocalPlayer:GetAttribute("Setting_LuckMultiplier") == false then
        return false, "Luck Multiplier setting is disabled."
    end

    local State, ErrorMessage =
        GetHatchLuckUpgradeState()

    if not State then
        return false, ErrorMessage
    end

    local IsFree =
        State.FreeCount > 0

    local IsAffordable =
        IsFree
        or (
            State.Price ~= nil
            and State.CashValue >= State.Price
        )

    if not IsAffordable then
        return false, "Not enough cash."
    end

    HatchLuckUpgradeBusy = true

    local BeforeValue =
        State.UpgradeValue

    local Success, FireError =
        pcall(function()
            -- Buy exactly one upgrade, matching the normal Purchase button.
            HatchLuckUpgradeEvent:FireServer()
        end)

    if not Success then
        HatchLuckUpgradeBusy = false
        return false, tostring(FireError)
    end

    Log(
        "Hatch Luck upgrade requested"
            .. (
                IsFree
                and " • FREE"
                or (
                    " • Cost "
                    .. tostring(State.Price)
                )
            )
    )

    -- Wait briefly for the server to update HatchUpgrades.
    -- This prevents firing the purchase remote repeatedly before
    -- the previous purchase has been processed.
    local Timeout =
        os.clock() + 1.5

    while HubRunning
        and Settings.AutoHatchLuckUpgrade
        and os.clock() < Timeout
    do
        if not State.HatchUpgrades.Parent then
            break
        end

        if tonumber(State.HatchUpgrades.Value) ~= BeforeValue then
            Log(
                "Hatch Luck upgraded to level "
                    .. tostring(
                        State.HatchUpgrades.Value
                    )
            )
            break
        end

        task.wait(0.05)
    end

    HatchLuckUpgradeBusy = false
    return true
end


task.spawn(function()
    while HubRunning do
        if Settings.AutoHatchLuckUpgrade
            and not HatchLuckUpgradeBusy
        then
            local Success, Result =
                pcall(TryHatchLuckUpgrade)

            if not Success then
                HatchLuckUpgradeBusy = false
                Log(
                    "Auto Hatch Luck Upgrade error: "
                        .. tostring(Result)
                )
            end
        end

        task.wait(
            math.max(
                tonumber(
                    Settings.HatchLuckUpgradeDelay
                ) or 0.35,
                0.10
            )
        )
    end
end)



local HeroPassiveLabelToUUID = {}
local HeroPassiveUUIDToLabel = {}
local LastHeroPassiveSignature = nil
local HeroPassiveSpinBusy = false

local HERO_PASSIVE_SPIN_DELAY = 1.00


local function GetEquippedHeroFolder()
    local Ignore =
        Workspace:FindFirstChild(
            "_IGNORE"
        )

    local Pets =
        Ignore
        and Ignore:FindFirstChild(
            "Pets"
        )

    return Pets
        and Pets:FindFirstChild(
            tostring(
                LocalPlayer.UserId
            )
        )
end


local function BuildEquippedHeroOptions()
    local Folder =
        GetEquippedHeroFolder()

    local RawEntries = {}

    if Folder then
        for _, Hero in ipairs(
            Folder:GetChildren()
        ) do
            local Equipped =
                Hero:GetAttribute(
                    "Equipped"
                )

            if Equipped == true then
                local HeroId =
                    Hero:GetAttribute(
                        "Id"
                    )

                local DisplayName =
                    typeof(HeroId) == "string"
                    and HeroId ~= ""
                    and HeroId
                    or Hero.Name

                table.insert(
                    RawEntries,
                    {
                        Name = DisplayName,
                        UUID = Hero.Name,
                    }
                )
            end
        end
    end

    table.sort(
        RawEntries,
        function(A, B)
            if A.Name == B.Name then
                return A.UUID < B.UUID
            end

            return A.Name < B.Name
        end
    )

    local Options = {}
    local LabelToUUID = {}
    local UUIDToLabel = {}
    local NameCounts = {}
    local NameIndexes = {}
    local SignatureParts = {}

    -- Count duplicate hero names first.
    for _, Entry in ipairs(
        RawEntries
    ) do
        NameCounts[
            Entry.Name
        ] =
            (
                NameCounts[
                    Entry.Name
                ]
                or 0
            )
            + 1
    end

    for _, Entry in ipairs(
        RawEntries
    ) do
        local NameIndex =
            (
                NameIndexes[
                    Entry.Name
                ]
                or 0
            )
            + 1

        NameIndexes[
            Entry.Name
        ] =
            NameIndex

        local Label =
            Entry.Name

        -- Rayfield needs unique option strings so duplicate pets
        -- can each map to their own UUID. Use invisible zero-width
        -- spaces instead of showing UUIDs/numbers to the user.
        if NameCounts[
            Entry.Name
        ] > 1
            and NameIndex > 1
        then
            Label =
                Entry.Name
                .. string.rep(
                    utf8.char(
                        0x200B
                    ),
                    NameIndex - 1
                )
        end

        table.insert(
            Options,
            Label
        )

        LabelToUUID[
            Label
        ] =
            Entry.UUID

        UUIDToLabel[
            Entry.UUID
        ] =
            Label

        -- Include UUID in the refresh signature. This means adding,
        -- removing, equipping, or swapping a duplicate same-name pet
        -- still causes the dropdown to refresh.
        table.insert(
            SignatureParts,
            Entry.Name
                .. "@"
                .. Entry.UUID
        )
    end

    HeroPassiveLabelToUUID =
        LabelToUUID

    HeroPassiveUUIDToLabel =
        UUIDToLabel

    return Options,
        table.concat(
            SignatureParts,
            "|"
        )
end


local function RefreshHeroPassiveSelection()
    local Options, Signature =
        BuildEquippedHeroOptions()

    local SelectedUUID =
        Settings.SelectedHeroPassiveUUID

    if SelectedUUID
        and HeroPassiveUUIDToLabel[
            SelectedUUID
        ]
    then
        Settings.SelectedHeroPassiveLabel =
            HeroPassiveUUIDToLabel[
                SelectedUUID
            ]
    elseif #Options > 0 then
        Settings.SelectedHeroPassiveLabel =
            Options[1]

        Settings.SelectedHeroPassiveUUID =
            HeroPassiveLabelToUUID[
                Options[1]
            ]
    else
        Settings.SelectedHeroPassiveLabel =
            nil

        Settings.SelectedHeroPassiveUUID =
            nil
    end

    return Options
end



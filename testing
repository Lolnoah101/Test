local function UnloadHub()
    if not HubRunning then
        -- Even if logic is already stopped, make sure a stale UI is removed.
        DestroyRayfieldWindow()

        return
    end

    ----------------------------------------------------------
    -- STOP NEW WORK FIRST
    ----------------------------------------------------------

    HubRunning =
        false

    Settings.AutoEquipSlot =
        false

    Settings.AutoSkills =
        false

    Settings.AutoEquipBestEquipment =
        false

    Settings.AutoFarm =
        false

    Settings.AutoFarmBoss =
        false

    Settings.AutoFarmDungeon =
        false

    Settings.AutoRewardChests =
        false

    Settings.AutoLeaveDungeon =
        false

    Settings.AutoDieAtPoints =
        false

    Settings.AutoOuwigaharaNormal =
        false

    Settings.AutoSkipWave =
        false

    Settings.AutoPickBestCards =
        false

    Settings.AutoSecondWind =
        false

    Settings.AutoFarmQuest =
        false

    Settings.AntiAFK =
        false

    ----------------------------------------------------------
    -- STOP CONTROLLERS / LOOPS
    ----------------------------------------------------------

    StopAutoClick()

    AutoBlockController:Stop()

    AutoSkillController:Stop()

    AutoBestEquipmentController:Stop()

    StopAutoOpenChest()

    RaidController:Stop()

    AutoSellController:Stop()

    AutoOuwigaharaController:Stop()

    AutoSkipWaveController:Stop()

    AutoCardController:Stop()

    StopFly()

    AntiRagdollController:Stop()

    RestoreWalkSpeed()

    StopAutoPickUpLoot()

    QuestController:Stop()

    QuestFarmController:Stop()

    StopAntiSunDamage()

    ----------------------------------------------------------
    -- CLEAR SHARED MOVEMENT / BUSY FLAGS
    ----------------------------------------------------------

    Settings.__LootAggroCleanup =
        false

    Settings.__BossRewardBusy =
        false

    Settings.__BossRewardCollecting =
        false

    Settings.__BossLootCenter =
        nil

    Settings.__BossLootRadius =
        nil

    Settings.__LootFarmBusy =
        false

    Settings.__RewardRoomBusy =
        false

    Settings.__DungeonEntryBusy =
        false

    ----------------------------------------------------------
    -- DISCONNECT STANDALONE CONNECTIONS
    ----------------------------------------------------------

    if QuestFarmStateConnection then
        QuestFarmStateConnection:Disconnect()

        QuestFarmStateConnection =
            nil
    end

    if ChestAddedConnection then
        ChestAddedConnection:Disconnect()

        ChestAddedConnection =
            nil
    end

    if LootAddedConnection then
        LootAddedConnection:Disconnect()

        LootAddedConnection =
            nil
    end

    if AntiAFKConnection then
        AntiAFKConnection:Disconnect()

        AntiAFKConnection =
            nil
    end

    if CharacterAddedConnection then
        CharacterAddedConnection:Disconnect()

        CharacterAddedConnection =
            nil
    end

    if FlyConnection then
        FlyConnection:Disconnect()

        FlyConnection =
            nil
    end

    ----------------------------------------------------------
    -- CLEAR SINGLETON POINTER BEFORE DESTROYING THE WINDOW.
    ----------------------------------------------------------

    if getgenv().__HOLLOWMOON_AUTOCLICK_UNLOAD
        == UnloadHub
    then
        getgenv().__HOLLOWMOON_AUTOCLICK_UNLOAD =
            nil
    end

    ----------------------------------------------------------
    -- ACTUALLY REMOVE THE RAYFIELD WINDOW.
    ----------------------------------------------------------

    DestroyRayfieldWindow()
end


getgenv().__HOLLOWMOON_AUTOCLICK_UNLOAD = nil
end

getgenv().__HOLLOWMOON_AUTOCLICK_UNLOAD =

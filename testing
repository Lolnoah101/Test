local function FindBestFishInStage(
    StageNumber
)

    local Folder =
        GetWorldFish()


    if not Folder then
        return nil
    end


    local Candidates = {}


    for _, Fish in ipairs(
        Folder:GetChildren()
    ) do

        local Info =
            GetFishInfo(
                Fish
            )


        if
            Info
            and Info.stage == StageNumber
            and Info.prompt.Enabled
        then

            local Accept =
                false


            if
                Settings.FishFarmMode
                == "Highest Price"
            then

                Accept =
                    true


            elseif
                Settings.FishFarmMode
                == "Rarity"
            then

                Accept =

                    Settings.FishRarity
                    == "Any"

                    or Info.rarity
                    == Settings.FishRarity

            end


            if Accept then

                table.insert(
                    Candidates,
                    Info
                )

            end

        end

    end


    table.sort(
        Candidates,

        function(A, B)

            return A.price > B.price

        end
    )


    return Candidates[1]
end


local function PickupFarmFish(
    StageNumber
)

    if
        IsBackpackFull()
        or not Settings.AutoFarmFish
    then

        return false
    end


    local Fish =
        FindBestFishInStage(
            StageNumber
        )


    if not Fish then
        return false
    end


    TeleportToCFrame(

        Fish.root.CFrame
        * CFrame.new(
            0,
            2,
            0
        )
    )


    task.wait(0.07)


    if typeof(
        fireproximityprompt
    ) ~= "function"
    then

        return false
    end


    local Success =
        pcall(function()

            fireproximityprompt(
                Fish.prompt
            )

        end)


    task.wait(
        Settings.FishPickupDelay
    )


    return Success
end


local function FarmStageUntilFull(
    StageNumber
)

    while
        HubRunning
        and Settings.AutoFarmFish
        and not IsBackpackFull()
    do

        if not PickupFarmFish(
            StageNumber
        )
        then

            task.wait(0.2)

        end

    end


    return
        IsBackpackFull()
end


local function WaitForBackpackReset()

    FarmWaitingForBackpack =
        true

    if Settings.AutoHome then

        CheckBackpack()

    end


    local LastRetry =
        0


    while
        HubRunning
        and Settings.AutoFarmFish
    do

        local Amount, Capacity =
            GetBackpackNumbers()


        if
            Capacity > 0
            and Amount < Capacity
            and not BackpackSequenceBusy
        then

            BackpackFullHandled =
                false

            -- Give the server/character a moment to settle before the
            -- farm begins teleporting through stages again.
            task.wait(
                Settings.FarmResumeDelay
            )

            FarmWaitingForBackpack =
                false

            return true

        end


        -- If Auto Sell is enabled but a previous sell didn't actually
        -- clear the backpack, re-arm the home sequence and try again.
        if
            Settings.AutoHome
            and Settings.AutoSellFish
            and IsBackpackFull()
            and not BackpackSequenceBusy
            and os.clock() - LastRetry >= 1
        then

            BackpackFullHandled =
                false

            CheckBackpack()

            LastRetry =
                os.clock()

        elseif Settings.AutoHome then

            CheckBackpack()

        end


        task.wait(0.15)

    end


    FarmWaitingForBackpack =
        false

    return false
end


local function DrainStageTimed(
    Stage,
    HasCompletedStage
)

    local Water =
        GetStageWater(
            Stage.folder
        )


    if not Water then
        return "skip"
    end


    if IsWaterDrained(
        Water
    ) then

        return "done"
    end


    local Started =
        os.clock()


    local LastTeleport =
        0


    while
        HubRunning
        and Settings.AutoFarmFish
        and Water.Parent
        and not IsWaterDrained(
            Water
        )
    do

        if
            HasCompletedStage
            and os.clock() - Started
                >= Settings.StageDrainTimeout
        then

            return "timeout"

        end


        if
            os.clock()
            - LastTeleport
            >= 0.25
        then

            TeleportToCFrame(

                Water.CFrame
                * CFrame.new(
                    0,

                    Water.Size.Y
                    * 0.5
                    + 2.5,

                    0
                )
            )


            LastTeleport =
                os.clock()

        end


        if not Settings.AutoWater then

            WaterOnce()

        end


        RunService.Heartbeat:Wait()

    end


    if IsWaterDrained(
        Water
    ) then

        return "done"

    end


    return "stopped"
end


--// ============================================================
--// FARM LOOP
--// ============================================================

local FishFarmLoopID =
    0


local LastCompletedStage =
    nil


local function DoFarmResetCycle()

    if not LastCompletedStage then
        return false
    end


    if not FarmStageUntilFull(
        LastCompletedStage
    )
    then

        return false
    end


    if not WaitForBackpackReset() then

        return false
    end


    LastCompletedStage =
        nil


    return true
end


local function StartFishFarm()

    FishFarmLoopID += 1


    local ID =
        FishFarmLoopID


    LastCompletedStage =
        nil


    task.spawn(function()

        local StageIndex =
            1


        while
            HubRunning
            and Settings.AutoFarmFish
            and ID == FishFarmLoopID
        do

            local Stages =
                GetStages()


            if #Stages == 0 then

                task.wait(1)

                continue
            end


            if StageIndex > #Stages then

                if
                    LastCompletedStage
                    and DoFarmResetCycle()
                then

                    StageIndex =
                        1

                end


                task.wait(0.1)

                continue
            end


            local Stage =
                Stages[
                    StageIndex
                ]


            local Result =
                DrainStageTimed(

                    Stage,

                    LastCompletedStage
                    ~= nil
                )


            if Result == "done" then

                LastCompletedStage =
                    Stage.number


                StageIndex += 1


            elseif Result == "timeout" then

                if DoFarmResetCycle() then

                    StageIndex =
                        1

                end


            elseif Result == "skip" then

                StageIndex += 1


            else

                task.wait(0.25)

            end


            task.wait(0.05)

        end

    end)
end


local function StopFishFarm()

    Settings.AutoFarmFish =
        false


    FishFarmLoopID += 1
end



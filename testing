local function GetRootPart()
    local Character =
        LocalPlayer.Character

    return Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )
end


local function PointInsideZone(
    Zone,
    WorldPosition
)
    if not Zone
        or not Zone:IsA("BasePart")
    then
        return false
    end

    local LocalPosition =
        Zone.CFrame:PointToObjectSpace(
            WorldPosition
        )

    local HalfSize =
        Zone.Size * 0.5

    return math.abs(LocalPosition.X)
            <= HalfSize.X
        and math.abs(LocalPosition.Y)
            <= HalfSize.Y
        and math.abs(LocalPosition.Z)
            <= HalfSize.Z
end


local function GetCurrentAreaName()
    local Root =
        GetRootPart()

    local MapFolder =
        Workspace:FindFirstChild("_MAP")

    if not Root
        or not MapFolder
    then
        return nil
    end

    local BestArea = nil
    local BestVolume = math.huge

    for _, Area in ipairs(
        MapFolder:GetChildren()
    ) do
        local Zone =
            Area:FindFirstChild("Zone")

        if Zone
            and Zone:IsA("BasePart")
            and PointInsideZone(
                Zone,
                Root.Position
            )
        then
            -- If zones ever overlap, prefer the smaller/more specific one.
            local Volume =
                Zone.Size.X
                * Zone.Size.Y
                * Zone.Size.Z

            if Volume < BestVolume then
                BestVolume = Volume
                BestArea = Area.Name
            end
        end
    end

    return BestArea
end



local function ActivatePickup(Prompt)
    if not Prompt then
        return false
    end

    if typeof(fireproximityprompt) == "function" then
        return pcall(function()
            fireproximityprompt(Prompt)
        end)
    end

    return false
end

local function WaitForPickup(Egg, Timeout)
    Timeout = Timeout or 2

    local Started = os.clock()

    while os.clock() - Started < Timeout do
        if not Egg or not Egg.Parent then
            return true
        end

        task.wait(0.05)
    end

    return false
end

local function PickupEgg(WantedLuck, ShowNotification)
    if IsPickingUp then
        return false, "Already handling an egg."
    end

    IsPickingUp = true

    local Success, EggOrMessage, Prompt = TweenToEgg(WantedLuck)

    if not Success then
        IsPickingUp = false
        return false, EggOrMessage
    end

    local Egg = EggOrMessage

    -- If Auto Pickup was turned off while moving, stop the sequence.
    if not Settings.AutoPickup and not ShowNotification then
        IsPickingUp = false
        return false, "Auto Pickup was disabled."
    end

    task.wait(Settings.PickupSettleDelay)

    if not Settings.AutoPickup and not ShowNotification then
        IsPickingUp = false
        return false, "Auto Pickup was disabled."
    end

    local Activated = ActivatePickup(Prompt)

    if not Activated then
        IsPickingUp = false
        return false, "Pickup prompt could not be activated."
    end

    WaitForPickup(Egg, 2)

    PickupCount += 1

    Log("Picked up " .. tostring(WantedLuck))

    task.wait(Settings.ReturnDelay)

    if not Settings.AutoPickup and not ShowNotification then
        IsPickingUp = false
        return false, "Auto Pickup was disabled."
    end

    local Returned, ReturnMessage = TweenToPlot()

    if ShowNotification then
        if Returned then
            Toast(
                "Egg Picked Up",
                tostring(WantedLuck) .. " • Returned to plot"
            )
        else
            Notify(
                "Return Failed",
                ReturnMessage,
                4
            )
        end
    end

    IsPickingUp = false

    return true
end

local function PickupSelectedEgg(ShowNotification)
    if IsPickingUp then
        return false, "Already handling an egg."
    end

    IsPickingUp = true

    local Success, EggOrMessage, Prompt, MatchedLuck =

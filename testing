local function GetPlayerPlot()
    for _, Plot in ipairs(Plots:GetChildren()) do
        local Data = Plot:FindFirstChild("Data")
        local Owner = Data and Data:FindFirstChild("Owner")

        if Owner and Owner:IsA("ObjectValue") then
            if Owner.Value == LocalPlayer then
                return Plot
            end

            if Owner.Value and Owner.Value.Name == LocalPlayer.Name then
                return Plot
            end
        end
    end

    return nil
end

local function GetPlotTarget(Plot)
    if not Plot then
        return nil
    end

    local Baseplate = Plot:FindFirstChild("Baseplate")

    if Baseplate and Baseplate:IsA("BasePart") then
        return Baseplate
    end

    local Spawn = Plot:FindFirstChildWhichIsA("SpawnLocation", true)

    if Spawn then
        return Spawn
    end

    if Plot:IsA("Model") and Plot.PrimaryPart then
        return Plot.PrimaryPart
    end

    return Plot:FindFirstChildWhichIsA("BasePart", true)
end

local function TweenToPlot()
    local Plot = GetPlayerPlot()

    if not Plot then
        return false, "Your plot could not be found."
    end

    local Target = GetPlotTarget(Plot)

    if not Target then
        return false, "Your plot was found, but no usable BasePart was found."
    end

    Log("Tweening back to plot: " .. Plot.Name)

    local Success = TweenToCFrame(
        Target.CFrame * CFrame.new(
            0,
            Settings.PlotOffsetY,
            0
        ),
        function()
            return (not IsPickingUp) or Settings.AutoPickup
        end
    )

    if not Success then
        return false, "Tween to plot was interrupted."
    end

    return true
end


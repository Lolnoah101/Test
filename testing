        RegionName = "Mistfall Harbor",

        NPCPaths = {
            {
                "Debree",
                "Regions",
                "Mistfall Harbor",
                "StationaryNpcs",
                "Ginzo",
            },
        },

        NPCCacheKey = "Mistfall Harbor/Ginzo",

        -- Exact Ginzo position captured from the live model.
        -- This lets Auto Sell stream Mistfall Harbor even when Ginzo is
        -- completely unloaded and has never been seen by this hub session.
        LoadPosition = Vector3.new(
            273.799,
            944,
            528.189
        ),
    },

    CoinNames = {
        "Coin Pouch",
        "Coin Pile",
        "Coin Stack",
        "Coin",
    },


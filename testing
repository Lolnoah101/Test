local MAX_PLOT_EGGS = 10


local function GetPlotEggFolder(Plot)
    if not Plot then
        return nil
    end

    return Plot:FindFirstChild("Eggs")
end


local function GetPlacedEggCountForPlot(Plot)
    local Folder = GetPlotEggFolder(Plot)

    if not Folder then
        return 0
    end

    local Count = 0

    for _, Egg in ipairs(Folder:GetChildren()) do
        -- Placed eggs normally carry EggKey. Keep a fallback for
        -- replicated egg models that arrive before their attribute.
        if Egg:GetAttribute("EggKey") ~= nil
            or Egg:IsA("Model")
            or Egg:IsA("BasePart")
        then
            Count += 1
        end
    end

    return Count
end


local function GetWorldPosition(Object)
    if not Object then
        return nil
    end

    if Object:IsA("BasePart") then
        return Object.Position
    end

    if Object:IsA("Model") then
        local Success, Pivot =
            pcall(function()
                return Object:GetPivot()
            end)

        if Success then
            return Pivot.Position
        end
    end

    local Part =
        Object:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    return Part and Part.Position or nil
end


local function GetPlotPlacementBase(Plot)
    if not Plot then
        return nil
    end

    local Baseplate =
        Plot:FindFirstChild("Baseplate")

    if Baseplate
        and Baseplate:IsA("BasePart")
    then
        return Baseplate
    end

    local Target =
        GetPlotTarget(Plot)

    if Target
        and Target:IsA("BasePart")
    then
        return Target
    end

    return nil
end


local function BuildPlotPlacementSlots(Plot)
    local Base =
        GetPlotPlacementBase(Plot)

    if not Base then
        return {}
    end

    local Slots = {}

    -- Use a 4x4 candidate grid but still enforce the game's 10-egg cap.
    -- More candidate positions helps avoid overlapping eggs the player
    -- may have placed manually.
    local Columns = 4
    local Rows = 4

    local HalfX =
        math.max(
            Base.Size.X * 0.34,
            2
        )

    local HalfZ =
        math.max(
            Base.Size.Z * 0.34,
            2
        )

    local SurfaceY =
        Base.Size.Y / 2
        + 0.05

    for Row = 1, Rows do
        for Column = 1, Columns do
            local XAlpha =
                Columns == 1
                and 0
                or (
                    (Column - 1)
                    / (Columns - 1)
                    * 2
                    - 1
                )

            local ZAlpha =
                Rows == 1
                and 0
                or (
                    (Row - 1)
                    / (Rows - 1)
                    * 2
                    - 1
                )

            local LocalPosition =
                Vector3.new(
                    XAlpha * HalfX,
                    SurfaceY,
                    ZAlpha * HalfZ
                )

            table.insert(
                Slots,
                Base.CFrame:PointToWorldSpace(
                    LocalPosition
                )
            )
        end
    end

    return Slots
end


local function GetNextPlotPlacementPosition(Plot)
    local Slots =
        BuildPlotPlacementSlots(Plot)

    if #Slots == 0 then
        return nil
    end

    local ExistingPositions = {}
    local Folder =
        GetPlotEggFolder(Plot)

    if Folder then
        for _, Egg in ipairs(
            Folder:GetChildren()
        ) do
            local Position =
                GetWorldPosition(Egg)

            if Position then
                table.insert(
                    ExistingPositions,
                    Position
                )
            end
        end
    end

    -- Pick the first grid point that is not already occupied.
    -- X/Z distance is what matters for eggs sitting on the plot floor.
    for _, Slot in ipairs(Slots) do
        local Occupied = false

        for _, Existing in ipairs(
            ExistingPositions
        ) do
            local HorizontalDistance =
                Vector2.new(
                    Slot.X - Existing.X,
                    Slot.Z - Existing.Z
                ).Magnitude

            if HorizontalDistance < 3.5 then
                Occupied = true
                break
            end
        end

        if not Occupied then
            return Slot
        end
    end

    return nil
end



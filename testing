local function UnloadHub()
    HubRunning = false
    Settings.AutoPickup = false
    Settings.AutoPlaceEgg = false
    Settings.AutoHatch = false
    Settings.AutoHatchLuckUpgrade = false
    Settings.AutoPlaceBestPets = false
    Settings.AutoFeedBestPets = false
    Settings.AutoSellUnderWeight = false
    Settings.AntiAFK = false

    if AntiAFKConnection then
        AntiAFKConnection:Disconnect()
        AntiAFKConnection = nil
    end

    CancelActiveMovement()

    pcall(function()
        Window:Unload()
    end)

    getgenv().__SHADOW_GARDEN_UNLOAD = nil
end

getgenv().__SHADOW_GARDEN_UNLOAD = UnloadHub

SettingsTab:CreateButton({
    name = "Unload Hub",
    callback = UnloadHub
})


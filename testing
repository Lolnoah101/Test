--==================================================
-- ENEMY ALIVE CHECK
--==================================================

local function isEntityAlive(entity)

    if not entity or not entity.Parent then
        return false
    end

    -- Humanoid
    local humanoid =
        entity:FindFirstChildOfClass("Humanoid")

    if humanoid then
        return humanoid.Health > 0
    end

    -- Dead attribute
    if entity:GetAttribute("Dead") == true then
        return false
    end

    -- Health attribute
    local healthAttribute =
        entity:GetAttribute("Health")

    if healthAttribute ~= nil then

        local health =
            tonumber(healthAttribute)

        if health then
            return health > 0
        end
    end

    -- Health NumberValue
    local healthValue =
        entity:FindFirstChild("Health")

    if healthValue
        and healthValue:IsA("NumberValue") then

        return healthValue.Value > 0
    end

    return false
end

--==================================================
-- ENEMY FOLDERS
--==================================================

local function getEnemyFolders()

    local npcFolder =
        workspace:FindFirstChild("NPCs")

    local bossFolder =
        workspace:FindFirstChild("Boss")

    return npcFolder, bossFolder
end

--==================================================
-- GET ROOT PART
--==================================================

local function getEnemyRoot(entity)

    if not entity then
        return nil
    end

    return
        entity:FindFirstChild("HumanoidRootPart")
        or entity.PrimaryPart
        or entity:FindFirstChildWhichIsA("BasePart")
end

--==================================================
-- GET CLOSEST ENEMY IN FOLDER
--==================================================

local function getClosestInFolder(folder)

    if not folder then
        return nil
    end

    local character =
        LocalPlayer.Character

    if not character then
        return nil
    end

    local hrp =
        character:FindFirstChild("HumanoidRootPart")

    if not hrp then
        return nil
    end

    local closest = nil
    local closestDistance = math.huge

    for _, entity in ipairs(folder:GetChildren()) do

        if isEntityAlive(entity) then

            local root =
                getEnemyRoot(entity)

            if root then

                local currentDistance =
                    (hrp.Position - root.Position).Magnitude

                if currentDistance < closestDistance then

                    closestDistance = currentDistance

                    closest = {
                        entity = entity,
                        part = root,
                        distance = currentDistance,
                    }
                end
            end
        end
    end

    return closest
end

--==================================================
-- GET CLOSEST TARGET
--==================================================

local function getClosestAliveTarget()

    local npcFolder, bossFolder =
        getEnemyFolders()

    -- NPCs have priority
    local npcTarget =
        getClosestInFolder(npcFolder)

    if npcTarget then
        return npcTarget
    end

    -- Bosses second
    local bossTarget =
        getClosestInFolder(bossFolder)

    if bossTarget then
        return bossTarget
    end

    return nil
end

--==================================================
-- HAS ALIVE TARGET
--==================================================

local function hasAliveTargets()

    local npcFolder, bossFolder =
        getEnemyFolders()

    if npcFolder then

        for _, npc in ipairs(npcFolder:GetChildren()) do

            if isEntityAlive(npc) then
                return true
            end
        end
    end

    if bossFolder then

        for _, boss in ipairs(bossFolder:GetChildren()) do

            if isEntityAlive(boss) then
                return true
            end
        end
    end

    return false
end

--==================================================
-- TARGET CFRAME
--==================================================

local function getTargetCFrame(enemyPart)

    if not enemyPart
        or not enemyPart.Parent then

        return nil
    end

    local enemyPosition =
        enemyPart.Position

    --==================================================
    -- ABOVE
    --==================================================

    if selectedMode == "Above" then

        local position =
            enemyPosition
            + Vector3.new(0, distance, 0)

        return CFrame.lookAt(
            position,
            enemyPosition + Vector3.new(0, 2, 0)
        )
    end

    --==================================================
    -- BELOW
    --==================================================

    if selectedMode == "Below" then

        local position =
            enemyPosition
            - Vector3.new(0, distance, 0)

        return CFrame.lookAt(
            position,
            enemyPosition
        )
    end

    --==================================================
    -- BEHIND
    --==================================================

    if selectedMode == "Behind" then

        local lookVector =
            enemyPart.CFrame.LookVector

        if lookVector.Magnitude < 0.1 then

            lookVector =
                Vector3.new(0, 0, -1)
        end

        local position =
            enemyPosition
            - lookVector * distance
            + Vector3.new(0, 2, 0)

        return CFrame.lookAt(
            position,
            enemyPosition
        )
    end

    --==================================================
    -- CIRCLE
    --==================================================

    if selectedMode == "Circle" then

        local angle =
            os.clock() * circleSpeed

        local offset =
            Vector3.new(
                math.cos(angle) * distance,
                1,
                math.sin(angle) * distance
            )

        local position =
            enemyPosition + offset

        return CFrame.lookAt(
            position,
            enemyPosition
        )
    end

    return nil
end

--==================================================
-- STOP FOLLOW
--==================================================

local function stopFollow()

    if followConnection then

        followConnection:Disconnect()
        followConnection = nil

    end

    currentTarget = nil

    local character =
        LocalPlayer.Character

    if character then

        local humanoid =
            character:FindFirstChildOfClass("Humanoid")

        if humanoid then
            humanoid.AutoRotate = true
        end
    end
end

--==================================================
-- START FOLLOW
--==================================================

local function startFollow(targetData)

    if not targetData
        or not targetData.entity then

        return
    end

    if followConnection then

        followConnection:Disconnect()
        followConnection = nil

    end

    local player =
        LocalPlayer

    print(
        "[AutoFarm] Following:",
        targetData.entity.Name
    )

    followConnection =
        RunService.Heartbeat:Connect(function()

            if not getgenv().AutoFarm then
                return
            end

            local character =
                player.Character

            if not character then
                return
            end

            local hrp =
                character:FindFirstChild(
                    "HumanoidRootPart"
                )

            if not hrp then
                return
            end

            local enemy =
                targetData.entity

            --==================================================
            -- TARGET CHECK
            --==================================================

            if not enemy
                or not enemy.Parent
                or not isEntityAlive(enemy) then

                currentTarget = nil

                if followConnection then
                    followConnection:Disconnect()
                    followConnection = nil
                end

                return
            end

            --==================================================
            -- REFRESH ROOT
            --==================================================

            local enemyRoot =
                getEnemyRoot(enemy)

            if not enemyRoot then
                return
            end

            targetData.part =
                enemyRoot

            --==================================================
            -- TARGET POSITION + ROTATION
            --==================================================

            local targetCFrame =
                getTargetCFrame(enemyRoot)

            if targetCFrame then

                -- Direct position + rotation
                hrp.CFrame =
                    targetCFrame

                -- Stop Humanoid from fighting
                -- the farm rotation.
                local humanoid =
                    character:FindFirstChildOfClass(
                        "Humanoid"
                    )

                if humanoid then
                    humanoid.AutoRotate = false
                end
            end
        end)
end

--==================================================
-- FARM LOOP
--==================================================

local function startFarm()

    if farmLoopRunning then
        return
    end

    farmLoopRunning = true

    task.spawn(function()

        print("[AutoFarm] Enabled")

        while getgenv().AutoFarm do

            local character =
                LocalPlayer.Character

            local hrp =
                character
                and character:FindFirstChild(
                    "HumanoidRootPart"
                )

            if not hrp then

                task.wait(0.5)

                continue
            end

            --==================================================
            -- KEEP CURRENT TARGET
            --==================================================

            if currentTarget
                and currentTarget.entity
                and currentTarget.entity.Parent
                and isEntityAlive(
                    currentTarget.entity
                ) then

                task.wait(0.2)

                continue
            end

            --==================================================
            -- CURRENT TARGET LOST
            --==================================================

            if followConnection then

                followConnection:Disconnect()
                followConnection = nil

            end

            currentTarget = nil

            --==================================================
            -- FIND NEW TARGET
            --==================================================

            local target =
                getClosestAliveTarget()

            if target then

                currentTarget =
                    target

                print(
                    "[AutoFarm] New target:",
                    target.entity.Name
                )

                startFollow(target)

            else

                task.wait(0.5)
            end

            task.wait(0.1)
        end

        stopFollow()

        farmLoopRunning = false

        print("[AutoFarm] Disabled")

    end)
end


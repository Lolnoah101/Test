local RaidController = {
    LoopID = 0,
    Busy = false,
    CurrentChest = nil,
    CurrentEnemy = nil,
    AutoClickNoticeEnemy = nil,

    -- Sealed caches are streamed like region NPCs. These are populated
    -- dynamically from ReplicatedStorage.Ouwland.Content.Misc.Npcs
    -- "Sealed Chest T1/T2/T3" instead of hardcoding GetChildren() indexes.
    SpawnPoints = nil,
    SpawnScanIndex = 0,
    NextSpawnSweepAt = 0,

    -- Event-driven chest waiting. Once a full sweep proves the server has no
    -- visible/streamed cache, stay put and watch for a new chest instead of
    -- immediately bouncing through every configured spawn again.
    SpawnCooldowns = {},
    SpawnWakeRequested = false,
    ChestsFolder = nil,
    ChestsDescendantConnection = nil,
    WorkspaceChestConnection = nil,
    LastNoChestStatusAt = 0,
    NoChestStatusInterval = 5,

    -- Chest/enemy discovery. Temporary.ActiveNpcs can contain multiple
    -- copies with the same visible name, so targets are resolved by their
    -- actual Humanoid-bearing model instead of by GetChildren() indexes.
    EnemyRadius = 125,
    LootRadius = 85,

    -- Raid positioning.
    -- Spawn/chest travel uses Farm Movement + Tween Speed.
    -- Enemy combat uses the normal Farm Position + Farm Range controls.
    ChestHoverHeight = 20,
    SpawnProbeHeight = 22,

    -- Streaming probe tuning. Each candidate point is checked immediately
    -- and then polled briefly while the nearby cache/guards replicate.
    SpawnProbeTimeout = 0.22,
    SpawnProbePollInterval = 0.025,
    SpawnMatchRadius = 70,

    -- T2/T3 expose RespawnTime=1500 (25 minutes). T1 exposes no explicit
    -- RespawnTime, so it uses the chest-spawn watcher plus this slow safety
    -- rescan instead of inventing a fake countdown.
    NoChestSweepDelay = 90.0,

    UpdateInterval = 0.08,
    EmptyEnemyConfirmTime = 1.25,
    ChestEnableTimeout = 8.0,

    -- Sealed caches can drop several prompts that each require a 2-second
    -- hold. Raid collection now waits on the actual prompt list instead of
    -- treating this timeout as the normal completion condition.
    LootCollectTimeout = 90.0,
    LootQuietConfirmTime = 1.50,

    CompletedChests = setmetatable(
        {},
        { __mode = "k" }
    ),
}


function RaidController:GetCharacterRoot()
    local Character =
        LocalPlayer.Character

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    return Character, Root
end


function RaidController:GetChestPrompt(
    Chest
)
    if not Chest
        or not Chest.Parent
    then
        return nil
    end

    -- Preferred captured layout:
    -- workspace.Chests.<Sealed Cache>.RootPart
    --     .ChestPromptAnchor.ChestPrompt
    local RootPart =
        Chest:FindFirstChild(
            "RootPart"
        )

    local Anchor =
        RootPart
        and RootPart:FindFirstChild(
            "ChestPromptAnchor"
        )

    local Prompt =
        Anchor
        and Anchor:FindFirstChild(
            "ChestPrompt"
        )

    if Prompt
        and Prompt:IsA(
            "ProximityPrompt"
        )
    then
        return Prompt
    end

    -- Fallback if a cache tier uses one extra container layer.
    Prompt =
        Chest:FindFirstChild(
            "ChestPrompt",
            true
        )

    return Prompt
        and Prompt:IsA(
            "ProximityPrompt"
        )
        and Prompt
        or nil
end


function RaidController:IsRaidChest(
    Chest
)
    if not Chest
        or not Chest.Parent
    then
        return false
    end

    local Name =
        string.lower(
            tostring(
                Chest.Name
            )
        )

    -- Captured raid caches are named Sealed Cache T1/T3.
    if not string.find(
        Name,
        "sealed cache",
        1,
        true
    )
    then
        return false
    end

    return self:GetChestPrompt(
        Chest
    ) ~= nil
end


function RaidController:GetChestCFrame(
    Chest
)
    if not Chest
        or not Chest.Parent
    then
        return nil
    end

    local RootPart =
        Chest:FindFirstChild(
            "RootPart"
        )
        or Chest:FindFirstChild(
            "RootPart",
            true
        )

    if RootPart
        and RootPart:IsA(
            "BasePart"
        )
    then
        return RootPart.CFrame
    end

    if Chest:IsA("Model") then
        return Chest:GetPivot()
    end

    local Part =
        Chest:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    return Part
        and Part.CFrame
        or nil
end


function RaidController:GetServerNow()
    local Success,
        Value =
        pcall(function()
            return workspace:GetServerTimeNow()
        end)

    if Success
        and typeof(Value) == "number"
    then
        return Value
    end

    return os.clock()
end


function RaidController:GetSpawnKey(
    Point
)
    if type(Point) ~= "table" then
        return nil
    end

    return tostring(
        Point.Tier
        or Point.ChestId
        or "Chest"
    )
        .. "#"
        .. tostring(
            Point.Index
            or 0
        )
end


function RaidController:IsSpawnCoolingDown(
    Point
)
    local Key =
        self:GetSpawnKey(
            Point
        )

    if not Key then
        return false,
            0
    end

    local Until =
        tonumber(
            self.SpawnCooldowns[
                Key
            ]
        )

    if not Until then
        return false,
            0
    end

    local Remaining =
        Until
        - self:GetServerNow()

    if Remaining <= 0 then
        self.SpawnCooldowns[
            Key
        ] =
            nil

        return false,
            0
    end

    return true,
        Remaining
end


function RaidController:FindNearestSpawnPoint(
    Position
)
    if typeof(Position) ~= "Vector3" then
        return nil,
            math.huge
    end

    local BestPoint =
        nil

    local BestDistance =
        math.huge

    for _,
        Point in ipairs(
            self:LoadSpawnPoints()
        )
    do
        if typeof(Point.CFrame)
            == "CFrame"
        then
            local Distance =
                (
                    Point.CFrame.Position
                    - Position
                ).Magnitude

            if Distance
                < BestDistance
            then
                BestDistance =
                    Distance

                BestPoint =
                    Point
            end
        end
    end

    return BestPoint,
        BestDistance
end


function RaidController:MarkSpawnCooldown(
    Position
)
    local Point,
        Distance =
        self:FindNearestSpawnPoint(
            Position
        )

    if not Point
        or Distance
            > math.max(
                self.SpawnMatchRadius,
                90
            )
    then
        return
    end

    local RespawnTime =
        tonumber(
            Point.RespawnTime
        )

    if not RespawnTime
        or RespawnTime <= 0
    then
        -- T1 currently has no explicit RespawnTime in its client config.
        return
    end

    local Key =
        self:GetSpawnKey(
            Point
        )

    self.SpawnCooldowns[
        Key
    ] =
        self:GetServerNow()
        + RespawnTime

    HubDebug(
        "[Combat Hub] "
            .. tostring(
                Point.ChestId
                or Point.Tier
            )
            .. " respawn tracked: "
            .. tostring(
                math.floor(
                    RespawnTime / 60
                )
            )
            .. "m "
            .. tostring(
                math.floor(
                    RespawnTime % 60
                )
            )
            .. "s"
    )
end


function RaidController:GetNextKnownRespawn()
    local Now =
        self:GetServerNow()

    local BestRemaining =
        nil

    for Key,
        Until in pairs(
            self.SpawnCooldowns
        )
    do
        local NumericUntil =
            tonumber(
                Until
            )

        local Remaining =
            NumericUntil
            and (
                NumericUntil
                - Now
            )
            or 0

        if Remaining <= 0 then
            self.SpawnCooldowns[
                Key
            ] =
                nil
        elseif not BestRemaining
            or Remaining < BestRemaining
        then
            BestRemaining =
                Remaining
        end
    end

    return BestRemaining
end


function RaidController:SignalChestSpawn(
    Instance
)
    if not Instance then
        return
    end

    local InstanceName =
        string.lower(
            tostring(
                Instance.Name
            )
        )

    local Candidate =
        nil

    if string.find(
        InstanceName,
        "sealed cache",
        1,
        true
    ) then
        Candidate =
            Instance
    elseif Instance:IsA(
        "ProximityPrompt"
    )
        and Instance.Name
            == "ChestPrompt"
    then
        local Current =
            Instance.Parent

        while Current
            and Current ~= workspace
        do
            local Name =
                string.lower(
                    tostring(
                        Current.Name
                    )
                )

            if string.find(
                Name,
                "sealed cache",
                1,
                true
            ) then
                Candidate =
                    Current

                break
            end

            Current =
                Current.Parent
        end
    end

    if not Candidate then
        return
    end

    self.SpawnWakeRequested =
        true

    self.NextSpawnSweepAt =
        0

    HubDebug(
        "[Combat Hub] Sealed cache spawn detected; raid watcher waking."
    )
end


function RaidController:EnsureChestSpawnWatcher()
    local Chests =
        workspace:FindFirstChild(
            "Chests"
        )

    if Chests
        ~= self.ChestsFolder
    then
        if self.ChestsDescendantConnection then
            self.ChestsDescendantConnection:Disconnect()
            self.ChestsDescendantConnection =
                nil
        end

        self.ChestsFolder =
            Chests

        if Chests then
            self.ChestsDescendantConnection =
                Chests.DescendantAdded:Connect(
                    function(Instance)
                        if HubRunning
                            and Settings.AutoRaidChest
                        then
                            self:SignalChestSpawn(
                                Instance
                            )
                        end
                    end
                )
        end
    end

    if not self.WorkspaceChestConnection then
        self.WorkspaceChestConnection =
            workspace.ChildAdded:Connect(
                function(Child)
                    if Child.Name == "Chests" then
                        task.defer(function()
                            if HubRunning
                                and Settings.AutoRaidChest
                            then
                                self:EnsureChestSpawnWatcher()
                                self.SpawnWakeRequested =
                                    true
                                self.NextSpawnSweepAt =
                                    0
                            end
                        end)
                    end
                end
            )
    end
end


function RaidController:DisconnectChestSpawnWatcher()
    if self.ChestsDescendantConnection then
        self.ChestsDescendantConnection:Disconnect()
        self.ChestsDescendantConnection =
            nil
    end

    if self.WorkspaceChestConnection then
        self.WorkspaceChestConnection:Disconnect()
        self.WorkspaceChestConnection =
            nil
    end

    self.ChestsFolder =
        nil
end


function RaidController:ScheduleNoChestWait()
    local NextKnown =
        self:GetNextKnownRespawn()

    local Delay =
        tonumber(
            self.NoChestSweepDelay
        )
        or 90

    if NextKnown then
        Delay =
            math.min(
                Delay,
                math.max(
                    NextKnown,
                    1
                )
            )
    end

    self.NextSpawnSweepAt =
        os.clock()
        + Delay

    local Now =
        os.clock()

    if Now
        - self.LastNoChestStatusAt
        >= self.NoChestStatusInterval
    then
        self.LastNoChestStatusAt =
            Now

        if NextKnown then
            local Seconds =
                math.max(
                    0,
                    math.ceil(
                        NextKnown
                    )
                )

            HubDebug(
                "[Combat Hub] No raid cache active. Next tracked respawn ~"
                    .. tostring(
                        math.floor(
                            Seconds / 60
                        )
                    )
                    .. "m "
                    .. tostring(
                        Seconds % 60
                    )
                    .. "s; watching for chest spawns. Safety scan in "
                    .. tostring(
                        math.ceil(
                            Delay
                        )
                    )
                    .. "s."
            )
        else
            HubDebug(
                "[Combat Hub] No raid cache active. Watching workspace.Chests; safety scan in "
                    .. tostring(
                        math.ceil(
                            Delay
                        )
                    )
                    .. "s."
            )
        end
    end
end


function RaidController:FindRaidChest()
    local Chests =
        workspace:FindFirstChild(
            "Chests"
        )

    if not Chests then
        return nil
    end

    local _, Root =
        self:GetCharacterRoot()

    local BestChest = nil
    local BestDistance = math.huge

    for _, Chest in ipairs(
        Chests:GetChildren()
    ) do
        if not self.CompletedChests[
            Chest
        ]
            and self:IsRaidChest(
                Chest
            )
        then
            local CFrameValue =
                self:GetChestCFrame(
                    Chest
                )

            if CFrameValue then
                local Distance =
                    Root
                    and (
                        CFrameValue.Position
                        - Root.Position
                    ).Magnitude
                    or 0

                if Distance < BestDistance then
                    BestDistance = Distance
                    BestChest = Chest
                end
            end
        end
    end

    return BestChest
end


function RaidController:LoadSpawnPoints()
    if type(self.SpawnPoints) == "table"
        and #self.SpawnPoints > 0
    then
        return self.SpawnPoints
    end

    local Ouwland =
        ReplicatedStorage:FindFirstChild(
            "Ouwland"
        )

    local Content =
        Ouwland
        and Ouwland:FindFirstChild(
            "Content"
        )

    local Misc =
        Content
        and Content:FindFirstChild(
            "Misc"
        )

    local Npcs =
        Misc
        and Misc:FindFirstChild(
            "Npcs"
        )

    if not Npcs then
        return {}
    end

    local Points = {}

    for _, ModuleName in ipairs({
        "Sealed Chest T1",
        "Sealed Chest T2",
        "Sealed Chest T3",
    }) do
        local Module =
            Npcs:FindFirstChild(
                ModuleName
            )

        if Module
            and Module:IsA(
                "ModuleScript"
            )
        then
            local Success,
                Config =
                pcall(
                    require,
                    Module
                )

            if Success
                and type(Config) == "table"
                and type(Config.Spawns) == "table"
            then
                local ChestId =
                    Config.WorldEvent
                    and Config.WorldEvent.ChestId
                    or string.gsub(
                        ModuleName,
                        "Chest",
                        "Cache"
                    )

                local RespawnTime =
                    tonumber(
                        Config.WorldEvent
                        and Config.WorldEvent.RespawnTime
                    )

                local ActiveCount =
                    tonumber(
                        Config.WorldEvent
                        and Config.WorldEvent.ActiveCount
                    )

                for Index, SpawnCFrame in ipairs(
                    Config.Spawns
                ) do
                    if typeof(SpawnCFrame)
                        == "CFrame"
                    then
                        Points[#Points + 1] = {
                            Tier = ModuleName,
                            ChestId = ChestId,
                            Index = Index,
                            CFrame = SpawnCFrame,
                            RespawnTime = RespawnTime,
                            ActiveCount = ActiveCount,

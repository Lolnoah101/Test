local autoM1 = false
local autoSkill1 = false
local autoSkill2 = false
local autoSkill3 = false
local autoSkill4 = false

--==================================================
-- M1 ATTACK
--==================================================

Tabs.Combat:AddToggle("AutoM1", {
    Title = "Auto M1",
    Description = "Automatically uses the basic attack.",
    Default = false,

    Callback = function(Value)
        autoM1 = Value

        if Value then
            task.spawn(function()
                while autoM1 do

                    pcall(function()
                        Remotes.Attack:FireServer(
                            Vector3.new(0, 0, 0)
                        )
                    end)

                    task.wait(0.1)
                end
            end)
        end
    end
})


local function ReleaseBlockingForCombat()
    if not Settings.AutoBlock then
        return true
    end

    local Now =
        os.clock()

    -- Don't spam UnHold on every combo stage. Stage 1 is enough to clear
    -- a stale server block left over from the previous enemy swing.
    if Now
        - (
            Settings.__CombatLastForcedUnhold
            or 0
        )
        < 0.06
    then
        return true
    end

    Settings.__CombatLastForcedUnhold =
        Now

    local Character =
        LocalPlayer.Character

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    local Position =
        Root
        and Root.Position
        or Vector3.zero

    local Success =
        pcall(function()
            CombatEvent:FireServer(
                "server_skill_controller_signaler",
                "Blocking",
                "UnHold",
                Position,
                nil
            )
        end)

    return Success
end


local function SendCombatStage(
    Stage,
    Context
)
    -- ALL combat requests belong to the user's Auto Click toggle.
    -- Auto Raid Chest only handles target discovery and positioning.
    if not HubRunning
        or not Settings.AutoClick
    then
        return false
    end

    -- A real Auto Block threat gets temporary priority over offense.
    -- This is intentionally NOT based on distance alone anymore.
    if Settings.AutoBlock
        and Settings.__AutoBlockThreatActive
    then
        return false
    end

    -- If the last defensive window left Blocking replicated for a moment,
    -- clear it before Stage 1 so the server accepts the new combo.
    if Stage == 1
        and Settings.AutoBlock
    then
        ReleaseBlockingForCombat()

        -- Preserve remote ordering: UnHold should reach the server just
        -- before Combat_Service begins the next combo.
        task.wait(0.015)
    end

    Context =
        Context
        or ResolveCombatContext()

    local TimingValue,
        UsedDynamic =
        GetCombatTiming(
            Context,
            Stage
        )

    if TimingValue == nil then
        return false
    end

    local Success,
        ErrorMessage =
        pcall(function()
            CombatEvent:FireServer(
                "Combat_Service",
                Context.RemoteName,
                Stage,
                false,
                TimingValue,
                false,
                Context.AlternateSwing
            )
        end)

    if not Success then
        warn(
            "[Combat Hub] "
                .. tostring(
                    Context.RemoteName
                )
                .. " combo "
                .. tostring(Stage)
                .. ": "
                .. tostring(
                    ErrorMessage
                )
        )

        return false
    end

    Settings.__LastCombatTiming =
        TimingValue

    Settings.__LastCombatDynamic =
        UsedDynamic

    return true
end


local AutoClickNearbyCache = {
    CheckedAt = 0,
    Result = false,

    -- 20 ms detection cadence.
    Interval = 0.02,

    -- Full hierarchy fallback stays throttled; spatial detection handles
    -- normal cases much faster.
    FallbackScanAt = 0,
    FallbackScanInterval = 0.20,
}


local function GetAutoClickEnemyRoot(
    Model
)
    if not Model
        or not Model.Parent
    then
        return nil
    end

    return Model:FindFirstChild(
        "HumanoidRootPart"
    )
        or Model.PrimaryPart
        or Model:FindFirstChild(
            "UpperTorso"
        )
        or Model:FindFirstChild(
            "Torso"
        )
        or Model:FindFirstChildWhichIsA(
            "BasePart",
            true
        )
end


local function HasNearbyEnemyForAutoClick()
    local Now =
        os.clock()

    if Now
        - AutoClickNearbyCache.CheckedAt
        < AutoClickNearbyCache.Interval
    then
        return AutoClickNearbyCache.Result
    end

    AutoClickNearbyCache.CheckedAt =
        Now

    local Character =
        LocalPlayer.Character

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    local Humanoid =
        Character
        and Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not Root
        or not Humanoid
        or Humanoid.Health <= 0
    then
        AutoClickNearbyCache.Result =
            false

        return false
    end

    local Range =
        math.clamp(
            tonumber(
                Settings.AutoClickRange
            )
            or 22,
            5,
            80
        )

    local function IsValidEnemyModel(
        Model
    )
        if not Model
            or not Model.Parent
            or not Model:IsA(
                "Model"
            )
            or Model == Character
            or Players:GetPlayerFromCharacter(
                Model
            )
        then
            return false
        end

        local EnemyHumanoid =
            Model:FindFirstChildOfClass(
                "Humanoid"
            )
            or Model:FindFirstChildWhichIsA(
                "Humanoid",
                true
            )

        if not EnemyHumanoid
            or EnemyHumanoid.Health <= 0
        then
            return false
        end

        local EnemyRoot =
            GetAutoClickEnemyRoot(
                Model
            )

        if not EnemyRoot then
            return false
        end

        return (
            EnemyRoot.Position
            - Root.Position
        ).Magnitude
            <= Range
    end

    ----------------------------------------------------------
    -- 1) Immediate aggro/following targets.
    ----------------------------------------------------------

    local Following =
        Character:FindFirstChild(
            "NpcsFollowing"
        )

    if Following then
        for _,
            ValueObject in ipairs(
                Following:GetChildren()
            )
        do
            if ValueObject:IsA(
                "ObjectValue"
            )
                and ValueObject.Value
                and IsValidEnemyModel(
                    ValueObject.Value
                )
            then
                AutoClickNearbyCache.Result =
                    true

                return true
            end
        end
    end

    ----------------------------------------------------------
    -- 2) Fast spatial radius query.
    ----------------------------------------------------------

    local HumanoidsFolder =
        workspace:FindFirstChild(
            "Humanoids"
        )

    if HumanoidsFolder then
        local Params =
            OverlapParams.new()

        Params.FilterType =
            Enum.RaycastFilterType.Include

        Params.FilterDescendantsInstances = {
            HumanoidsFolder,
        }

        Params.MaxParts =
            128

        local Success,
            Parts =
            pcall(
                workspace.GetPartBoundsInRadius,
                workspace,
                Root.Position,
                Range,
                Params
            )

        if Success
            and type(
                Parts
            ) == "table"
        then
            local Seen =
                {}

            for _,
                Part in ipairs(
                    Parts
                )
            do
                local Model =
                    Part:FindFirstAncestorOfClass(
                        "Model"
                    )

                if Model
                    and not Seen[
                        Model
                    ]
                then
                    Seen[
                        Model
                    ] =
                        true

                    local ActiveNpcs =
                        Model:FindFirstAncestor(
                            "ActiveNpcs"
                        )

                    if ActiveNpcs
                        and IsValidEnemyModel(
                            Model
                        )
                    then
                        AutoClickNearbyCache.Result =
                            true

                        return true
                    end
                end
            end
        end
    end

    ----------------------------------------------------------
    -- 3) Slower hierarchy fallback for unusual rigs.
    ----------------------------------------------------------

    if HumanoidsFolder
        and Now
            - AutoClickNearbyCache.FallbackScanAt
            >= AutoClickNearbyCache.FallbackScanInterval
    then
        AutoClickNearbyCache.FallbackScanAt =
            Now

        for _,
            EnemyHumanoid in ipairs(
                HumanoidsFolder:GetDescendants()
            )
        do
            if EnemyHumanoid:IsA(
                "Humanoid"
            )
                and EnemyHumanoid.Health > 0
            then
                local Model =
                    EnemyHumanoid.Parent

                if Model
                    and Model:IsA(
                        "Model"
                    )
                then
                    local ActiveNpcs =
                        Model:FindFirstAncestor(
                            "ActiveNpcs"
                        )

                    if ActiveNpcs
                        and IsValidEnemyModel(
                            Model
                        )
                    then
                        AutoClickNearbyCache.Result =
                            true

                        return true
                    end
                end
            end
        end
    end

    AutoClickNearbyCache.Result =
        false

    return false
end

local function StartAutoClick()
    AutoClickLoopID +=
        1

    local LoopID =
        AutoClickLoopID

    AutoClickNearbyCache.CheckedAt =
        0

    AutoClickNearbyCache.Result =
        false

    task.spawn(function()
        while HubRunning
            and Settings.AutoClick
            and LoopID
                == AutoClickLoopID
        do
            --------------------------------------------------
            -- No nearby live enemy = send NO combat stages.
            --------------------------------------------------

            if not HasNearbyEnemyForAutoClick()
            then
                task.wait(
                    0.02
                )

                continue
            end

            local Context =
                ResolveCombatContext()

            local CompletedCombo =
                true

            for Stage = 1, 5 do
                if not HubRunning
                    or not Settings.AutoClick
                    or LoopID
                        ~= AutoClickLoopID
                then
                    CompletedCombo =
                        false

                    break
                end

                -- Re-check before every stage so death / movement / teleport
                -- cancels the rest of the combo instead of building requests.
                if not HasNearbyEnemyForAutoClick()
                then
                    CompletedCombo =
                        false

                    break
                end

                local Sent =
                    SendCombatStage(
                        Stage,
                        Context
                    )

                if not Sent then
                    -- Auto Block can intentionally suppress a stage while
                    -- defending. Stop this combo and restart fresh afterward.
                    CompletedCombo =
                        false

                    break
                end

                if Stage < 5 then
                    task.wait(
                        COMBO_STEP_DELAY
                    )
                end
            end

            if HubRunning
                and Settings.AutoClick
                and LoopID
                    == AutoClickLoopID
            then
                task.wait(
                    CompletedCombo
                    and COMBO_RESET_DELAY
                    or 0.04
                )
            end
        end
    end)
end

local function StopAutoClick()
    Settings.AutoClick =
        false

    AutoClickLoopID +=
        1

    AutoClickNearbyCache.CheckedAt =
        0

    AutoClickNearbyCache.Result =
        false
end




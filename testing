local Fluent = loadstring(game:HttpGet(
    "https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"
))()

local Window = Fluent:CreateWindow({
    Title = "[NEW GAME]",
    SubTitle = "Combat Hub",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})

local Tabs = {
    Combat = Window:AddTab({
        Title = "Combat",
        Icon = "sword"
    })
}

local Options = Fluent.Options

-- =========================================================
-- REMOTES
-- =========================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AttackRemote = ReplicatedStorage
    :WaitForChild("Player")
    :WaitForChild("Remotes")
    :WaitForChild("Inputs")
    :WaitForChild("Attack")

local SkillRemote = ReplicatedStorage
    :WaitForChild("Player")
    :WaitForChild("Remotes")
    :WaitForChild("Inputs")
    :WaitForChild("Skill")

print("[Combat] Attack remote found!")
print("[Combat] Skill remote found!")


-- =========================================================
-- VARIABLES
-- =========================================================

local autoAttack = false
local autoSkills = false


-- =========================================================
-- AUTO M1
-- =========================================================

Tabs.Combat:AddToggle("AutoAttack", {
    Title = "Auto M1",
    Default = false,

    Callback = function(Value)
        autoAttack = Value

        if autoAttack then
            task.spawn(function()
                while autoAttack do

                    pcall(function()
                        AttackRemote:FireServer(
                            Vector3.new(0, 0, 0)
                        )
                    end)

                    task.wait(0.1)
                end
            end)
        end
    end
})


-- =========================================================
-- SKILL SELECTION
-- =========================================================

local SkillDropdown = Tabs.Combat:AddDropdown("SkillSelection", {
    Title = "Select Skills",
    Values = {
        "1",
        "2",
        "3",
        "4"
    },
    Multi = true,
    Default = {}
})


-- =========================================================
-- AUTO SKILLS
-- =========================================================

Tabs.Combat:AddToggle("AutoSkills", {
    Title = "Auto Skills",
    Default = false,

    Callback = function(Value)
        autoSkills = Value

        if autoSkills then
            task.spawn(function()
                while autoSkills do

                    local selectedSkills = SkillDropdown.Value

                    for skillNumber, enabled in pairs(selectedSkills) do

                        if not autoSkills then
                            break
                        end

                        if enabled then
                            pcall(function()
                                SkillRemote:FireServer(
                                    tonumber(skillNumber),
                                    "tap",
                                    Vector3.new(0, 0, 0)
                                )
                            end)

                            task.wait(0.2)
                        end
                    end

                    task.wait(0.5)
                end
            end)
        end
    end
})



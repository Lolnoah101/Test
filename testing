--==================================================
-- ENEMY DETECTION
--==================================================

local function isEntityAlive(entity)
    if not entity or not entity.Parent then
        return false
    end

    local humanoid = entity:FindFirstChildOfClass("Humanoid")

    if humanoid then
        return humanoid.Health > 0
    end

    if entity:GetAttribute("Dead") == true then
        return false
    end

    local health = entity:GetAttribute("Health")

    if health ~= nil then
        local numericHealth = tonumber(health)

        if numericHealth then
            return numericHealth > 0
        end
    end

    return false
end

local function getNPCFolder()
    for _, object in ipairs(workspace:GetChildren()) do
        if string.find(object.Name, "Generated_") then

            local npcFolder = object:FindFirstChild("NPCs")

            if npcFolder then
                return npcFolder
            end
        end
    end

    return nil
end

local function getAllEnemies()
    local enemies = {}

    local npcFolder = getNPCFolder()

    if not npcFolder then
        return enemies
    end

    for _, enemy in ipairs(npcFolder:GetChildren()) do

        if isEntityAlive(enemy) then

            local root =
                enemy:FindFirstChild("HumanoidRootPart")
                or enemy:FindFirstChildWhichIsA("BasePart")

            if root then
                table.insert(enemies, enemy)
            end
        end
    end

    return enemies
end

local function hasAliveTargets()
    return #getAllEnemies() > 0
end

local function getClosestEnemy()
    local character = LocalPlayer.Character

    if not character then
        return nil
    end

    local hrp = character:FindFirstChild("HumanoidRootPart")

    if not hrp then
        return nil
    end

    local closest = nil
    local closestDistance = math.huge

    for _, enemy in ipairs(getAllEnemies()) do

        local root =
            enemy:FindFirstChild("HumanoidRootPart")
            or enemy:FindFirstChildWhichIsA("BasePart")

        if root and isEntityAlive(enemy) then

            local distanceFromPlayer =
                (hrp.Position - root.Position).Magnitude

            if distanceFromPlayer < closestDistance then

                closestDistance = distanceFromPlayer

                closest = {
                    entity = enemy,
                    part = root,
                    distance = distanceFromPlayer
                }
            end
        end
    end

    return closest
end

--==================================================
-- MOVEMENT
--==================================================

local function cleanupMovement()

    if farmConnection then
        farmConnection:Disconnect()
        farmConnection = nil
    end

    if bodyPosition then
        bodyPosition:Destroy()
        bodyPosition = nil
    end

    if bodyGyro then
        bodyGyro:Destroy()
        bodyGyro = nil
    end

    currentTarget = nil
end

local function createMovement(hrp)

    if not hrp then
        return
    end

    if bodyPosition then
        bodyPosition:Destroy()
    end

    if bodyGyro then
        bodyGyro:Destroy()
    end

    bodyPosition = Instance.new("BodyPosition")

    bodyPosition.Name = "AutoFarmPosition"
    bodyPosition.MaxForce = Vector3.new(
        100000,
        100000,
        100000
    )

    bodyPosition.P = 10000
    bodyPosition.D = 1000
    bodyPosition.Position = hrp.Position

    bodyPosition.Parent = hrp

    bodyGyro = Instance.new("BodyGyro")

    bodyGyro.Name = "AutoFarmGyro"
    bodyGyro.MaxTorque = Vector3.new(
        100000,
        100000,
        100000
    )

    bodyGyro.P = 10000
    bodyGyro.D = 1000
    bodyGyro.CFrame = hrp.CFrame

    bodyGyro.Parent = hrp
end

--==================================================
-- TARGET POSITION
--==================================================

local function getTargetPosition(targetPart)

    if not targetPart or not targetPart.Parent then
        return nil, nil
    end

    local enemyPosition = targetPart.Position
    local targetPosition

    if selectedMode == "Above" then

        targetPosition =
            enemyPosition +
            Vector3.new(0, distance, 0)

    elseif selectedMode == "Below" then

        targetPosition =
            enemyPosition -
            Vector3.new(0, distance, 0)

    elseif selectedMode == "Behind" then

        local lookVector = targetPart.CFrame.LookVector

        targetPosition =
            enemyPosition -
            lookVector * distance

    elseif selectedMode == "Circle" then

        local angle = os.clock() * 3

        local offset = Vector3.new(
            math.cos(angle) * distance,
            1,
            math.sin(angle) * distance
        )

        targetPosition =
            enemyPosition + offset
    end

    return targetPosition, enemyPosition
end

--==================================================
-- UPDATE FARM
--==================================================

local function updateFarm()

    if not getgenv().AutoFarm then
        return
    end

    local character = LocalPlayer.Character

    if not character then
        currentTarget = nil
        return
    end

    local hrp =
        character:FindFirstChild("HumanoidRootPart")

    if not hrp then
        currentTarget = nil
        return
    end

    -- Recreate movement after respawn
    if not bodyPosition
        or bodyPosition.Parent ~= hrp
        or not bodyGyro
        or bodyGyro.Parent ~= hrp then

        createMovement(hrp)
    end

    --==================================================
    -- CURRENT TARGET
    --==================================================

    if currentTarget then

        local enemy = currentTarget.entity

        if not isEntityAlive(enemy) then
            currentTarget = nil
        else

            local root =
                enemy:FindFirstChild("HumanoidRootPart")
                or enemy:FindFirstChildWhichIsA("BasePart")

            if root then

                currentTarget.part = root

                local targetPosition, enemyPosition =
                    getTargetPosition(root)

                if targetPosition then

                    bodyPosition.Position =
                        targetPosition

                    local direction =
                        enemyPosition - targetPosition

                    if direction.Magnitude > 0.01 then

                        bodyGyro.CFrame =
                            CFrame.lookAt(
                                Vector3.zero,
                                direction.Unit
                            )
                    end
                end

                return
            end

            currentTarget = nil
        end
    end

    --==================================================
    -- FIND NEW TARGET
    --==================================================

    local newTarget = getClosestEnemy()

    if newTarget then

        currentTarget = newTarget

        print(
            "[AutoFarm] New target:",
            newTarget.entity.Name
        )

        local targetPosition, enemyPosition =
            getTargetPosition(newTarget.part)

        if targetPosition then

            bodyPosition.Position =
                targetPosition

            local direction =
                enemyPosition - targetPosition

            if direction.Magnitude > 0.01 then

                bodyGyro.CFrame =
                    CFrame.lookAt(
                        Vector3.zero,
                        direction.Unit
                    )
            end
        end
    else

        currentTarget = nil
    end
end


local function GetTeleportQueueFunction()
    local QueueFunction =
        nil

    pcall(function()
        QueueFunction =
            rawget(
                getgenv(),
                "queue_on_teleport"
            )
            or rawget(
                getgenv(),
                "queueonteleport"
            )
    end)

    if type(
        QueueFunction
    ) ~= "function"
        and type(
            syn
        ) == "table"
    then
        QueueFunction =
            syn.queue_on_teleport
    end

    return type(
        QueueFunction
    ) == "function"
        and QueueFunction
        or nil
end


local function QueueHollowMoonHubForTeleport()
    if getgenv().__HOLLOWMOON_TELEPORT_LOADER_QUEUED then
        return true
    end

    local QueueFunction =
        GetTeleportQueueFunction()

    if not QueueFunction then
        return false
    end

    local Source = [=[
task.wait(1.5)

-- The queued entry is now being consumed by this teleport.
getgenv().__HOLLOWMOON_TELEPORT_LOADER_QUEUED = nil

-- Prevent duplicate stale queued entries from creating several UIs.
if getgenv().__HOLLOWMOON_TELEPORT_LOADER_EXECUTING then
    return
end

getgenv().__HOLLOWMOON_TELEPORT_LOADER_EXECUTING = true

pcall(function()
    local ExistingUnload =
        rawget(
            getgenv(),
            "__HOLLOWMOON_AUTOCLICK_UNLOAD"
        )

    if type(ExistingUnload) == "function" then
        pcall(ExistingUnload)
        task.wait(0.15)
    end

    loadstring(
        game:HttpGet(
            "https://raw.githubusercontent.com/Lolnoah101/Test/refs/heads/main/testing"
        )
    )()
end)

task.delay(
    5,
    function()
        getgenv().__HOLLOWMOON_TELEPORT_LOADER_EXECUTING = nil
    end
)
]=]

    local Success =
        pcall(
            QueueFunction,
            Source
        )

    if Success then
        getgenv().__HOLLOWMOON_TELEPORT_LOADER_QUEUED =
            true
    end

    return Success
end


local AutoExecuteController = {
    Queued = false,
}


function AutoExecuteController:Enable()
    local Success =
        QueueHollowMoonHubForTeleport()

    self.Queued =
        Success

    return Success
end


function AutoExecuteController:Disable()
    -- Most executor queue_on_teleport APIs do not expose a portable
    -- "dequeue" operation. Disabling prevents future queues after this load.
    self.Queued =
        false
end


function AutoExecuteController:Refresh()
    if Settings.AutoExecuteOnTeleport then
        return self:Enable()
    end

    return false
end



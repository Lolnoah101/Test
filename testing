--============================================================
-- Live dashboard updater
--============================================================

local function RefreshDashboard()
    local Amount, Capacity = GetBackpackNumbers()
    local Active = CountActiveAutomation()

    BackpackAmountStat:Set(Amount)
    BackpackCapacityStat:Set(Capacity)
    CashStat:Set(tonumber(CashValue.Value) or 0)
    ActiveStat:Set(Active)
    StageStat:Set(#GetStages())
    RuntimeStat:Set(math.floor(os.clock() - SessionStarted))

    if Active > 0 then
        local SavedColor = Window:Get("StatusTagColor")
        local ActiveColor = typeof(SavedColor) == "Color3"
            and SavedColor
            or Color3.fromRGB(65, 190, 120)

        StatusTag:Set({
            text = "ACTIVE " .. tostring(Active),
            color = ActiveColor
        })

        SessionSummary:Set(
            tostring(Active)
            .. " automation feature"
            .. (Active == 1 and " is" or "s are")
            .. " currently enabled."
        )
    else
        StatusTag:Set({
            text = "IDLE",
            color = Color3.fromRGB(115, 120, 135)
        })

        SessionSummary:Set("No automation is currently active.")
    end
end

TrackConnection(AmountValue:GetPropertyChangedSignal("Value"):Connect(RefreshDashboard))
TrackConnection(CapacityValue:GetPropertyChangedSignal("Value"):Connect(RefreshDashboard))
TrackConnection(CashValue:GetPropertyChangedSignal("Value"):Connect(RefreshDashboard))

local DashboardLoopID = 1

task.spawn(function()
    local ID = DashboardLoopID

    while HubRunning and ID == DashboardLoopID and not Window.unloaded do
        RefreshDashboard()
        task.wait(0.5)
    end
end)


    if not CurrentPumpTarget then

        RefreshPumpTarget()

    end


    local Pump =
        CurrentPumpTarget


    if not Pump then
        return
    end


    local Updated =
        GetPumpInfo(
            Pump.card
        )


    if
        Updated
        and Updated.owned
    then

        RefreshPumpTarget()

        Pump =
            CurrentPumpTarget

    end


    if not Pump then
        return
    end


    local Cash =
        tonumber(
            CashValue.Value
        ) or 0


    if Cash < Pump.price then
        return

local function GetBaseArea()

    return Workspace
        :WaitForChild("PlayerEar")
        :WaitForChild("2")
        :WaitForChild(PLAYER_AREA_NAME)
end


local function GetHomeCFrame()

    if HomeTarget:IsA(
        "BasePart"
    ) then

        return HomeTarget.CFrame
    end


    if HomeTarget:IsA(
        "Model"
    ) then

        return HomeTarget:GetPivot()
    end


    if HomeTarget:IsA(
        "Attachment"
    ) then

        return HomeTarget.WorldCFrame
    end


    local Part =
        HomeTarget:FindFirstChildWhichIsA(
            "BasePart",
            true
        )


    if Part then

        return Part.CFrame
    end


    return nil
end


local function TeleportHome()

    local Target =
        GetHomeCFrame()


    if not Target then

        warn(
            "[Auto Home] Home target missing"
        )

        return false
    end


    return TeleportToCFrame(

        Target
        * CFrame.new(
            0,
            3,
            0
        )
    )
end



end


function AutoCardController:ScoreCard(
    Entry,
    Mode
)
    Mode =
        tostring(
            Mode
            or Settings.CardPickMode
            or "Best Cards"
        )

    if Mode
        == "More Points"
    then
        return self:ScoreMorePoints(
            Entry
        )
    end

    if Mode
        == "Towards Character"
    then
        return self:ScoreTowardsCharacter(
            Entry
        )
    end

    return self:ScoreBalanced(
        Entry
    )
end


function AutoCardController:PressCard(

    Entry,
    Reason
)
    if not Entry
        or not Entry.Button
        or not Entry.Button.Parent
    then
        return false
    end

    if os.clock()
        - self.LastClickAt
        < self.ClickRetryDelay
    then
        return false
    end

    local Success =
        false

    if type(
        firesignal
    ) == "function"
    then
        local Ok =
            pcall(function()
                firesignal(
                    Entry.Button.MouseButton1Click
                )
            end)

        if Ok then
            Success =
                true
        end
    end

    if not Success then
        local Ok =
            pcall(function()
                Entry.Button:Activate()
            end)

        if Ok then
            Success =
                true
        end
    end

    if Success then
        self.LastClickAt =
            os.clock()

        HubDebug(
            "[Combat Hub] Card picked: "
                .. tostring(
                    Entry.Title
                )
                .. " | "
                .. tostring(
                    Reason
                    or "Auto Pick"
                )
        )
    end

    return Success
end


function AutoCardController:LogOffer(
    Entries,
    Signature
)
    if not Signature
        or Signature
            == self.LastLoggedSignature
    then
        return
    end

    self.LastLoggedSignature =
        Signature

    local Names =
        {}

    for _,
        Entry in ipairs(
            Entries
        )
    do
        table.insert(
            Names,
            "["
                .. tostring(
                    Entry.Slot
                )
                .. "] "
                .. tostring(
                    Entry.Title
                )
        )
    end

    HubDebug(
        "[Combat Hub] Card offer: "
            .. table.concat(
                Names,
                " | "
            )
    )
end


function AutoCardController:Step()
    if not HubRunning
        or (
            not Settings.AutoPickBestCards
            and not Settings.AutoSecondWind
        )
    then
        return
    end

    local Entries,
        BBCards =
        self:GetCardEntries()

    if #Entries == 0
        or not BBCards
    then
        -- The offer disappeared. Clear the signature so an identical set of
        -- cards on a later floor/wave can be selected again.
        self.LastOfferSignature =
            nil

        self.LastLoggedSignature =
            nil

        return
    end

    local Signature =
        self:GetOfferSignature(
            Entries
        )

    self:LogOffer(
        Entries,
        Signature
    )

    -- Don't repeatedly choose from the same currently-visible offer.
    if Signature
        and Signature
            == self.LastOfferSignature
    then
        return
    end

    local HealthPercent =
        self:GetHealthPercent()

    local Threshold =
        math.clamp(
            tonumber(
                Settings.SecondWindHealthPercent
            )
            or 40,
            1,
            100
        )

    ----------------------------------------------------------
    -- PRIORITY 1: EMERGENCY SECOND WIND
    ----------------------------------------------------------

    if Settings.AutoSecondWind
        and HealthPercent
            <= Threshold
    then
        for _,
            Entry in ipairs(
                Entries
            )
        do
            if self:IsSecondWind(
                Entry
            ) then
                if self:PressCard(
                    Entry,
                    string.format(
                        "Second Wind emergency %.0f%% <= %.0f%%",
                        HealthPercent,
                        Threshold
                    )
                )
                then
                    self.LastOfferSignature =
                        Signature
                end

                return
            end
        end
    end

    ----------------------------------------------------------
    -- PRIORITY 2: GENERAL BEST CARD
    ----------------------------------------------------------

    if not Settings.AutoPickBestCards then
        return
    end

    local Mode =
        tostring(
            Settings.CardPickMode
            or "Best Cards"
        )

    local BestEntry =
        nil

    local BestScore =
        -math.huge

    local function CanUseEntry(
        Entry
    )
        if self:IsNeverPickCard(
            Entry
        )
        then
            return false
        end

        -- If Auto Second Wind is enabled while we're healthy, preserve the
        -- emergency heal regardless of which dropdown mode is selected.
        if Settings.AutoSecondWind
            and HealthPercent
                > Threshold
            and self:IsSecondWind(
                Entry
            )
        then
            return false
        end

        return true
    end

    for _,
        Entry in ipairs(
            Entries
        )
    do
        if CanUseEntry(
            Entry
        )
        then
            local Score =
                self:ScoreCard(
                    Entry,
                    Mode
                )

            if Score
                > BestScore
            then
                BestScore =
                    Score

                BestEntry =
                    Entry
            end
        end
    end

    local UsedFallback =
        false

    -- More Points / Towards Character should not freeze a milestone if the
    -- current hand simply has no matching card. In that case, fall back to
    -- the balanced "Best Cards" ranking while still honoring NeverPick.
    if not BestEntry
        and Mode
            ~= "Best Cards"
    then
        UsedFallback =
            true

        BestScore =
            -math.huge

        for _,
            Entry in ipairs(
                Entries
            )
        do
            if CanUseEntry(
                Entry
            ) then
                local Score =
                    self:ScoreCard(
                        Entry,
                        "Best Cards"
                    )

                if Score
                    > BestScore
                then
                    BestScore =
                        Score

                    BestEntry =
                        Entry
                end
            end
        end
    end

    if BestEntry then
        if self:PressCard(
            BestEntry,
            (
                UsedFallback
                and (
                    Mode
                    .. " fallback → Best Cards"
                )
                or Mode
            )
                .. " | score "
                .. string.format(
                    "%.1f",
                    BestScore
                )
        )
        then
            self.LastOfferSignature =
                Signature
        end
    else
        HubDebug(
            "[Combat Hub] Auto Pick Cards: no eligible card found • Skip ignored"
        )
    end
end


function AutoCardController:Start()
    if self.Running then
        return
    end

    self.Running =
        true

    self.LoopID +=
        1

    self.LastOfferSignature =
        nil

    self.LastLoggedSignature =
        nil

    self.LastClickAt =
        0

    local MyLoopID =
        self.LoopID

    task.spawn(function()
        while HubRunning
            and self.Running
            and MyLoopID
                == self.LoopID
        do
            if Settings.AutoPickBestCards
                or Settings.AutoSecondWind
            then
                self:Step()
            end

            task.wait(
                0.15
            )
        end
    end)
end


function AutoCardController:RefreshRunState()
    if Settings.AutoPickBestCards
        or Settings.AutoSecondWind
    then
        self:Start()

        return
    end

    self:Stop()
end


function AutoCardController:Stop()
    self.Running =
        false

    self.LoopID +=
        1

    self.LastOfferSignature =
        nil

    self.LastLoggedSignature =
        nil

    self.LastClickAt =
        0
end



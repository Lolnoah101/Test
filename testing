--// ============================================================
--// SMOOTH TWEEN MOVEMENT
--// ============================================================

local function CancelActiveMovement()
    -- Invalidate any movement loop currently running.
    MovementGeneration += 1

    -- Cancel the active TweenService tween exactly once.
    local Tween = ActiveMovementTween
    ActiveMovementTween = nil

    if Tween then
        pcall(function()
            Tween:Cancel()
        end)
    end

    -- Stop leftover character momentum.
    local Character = LocalPlayer.Character
    local Root = Character
        and Character:FindFirstChild("HumanoidRootPart")

    if Root then
        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end
end


local function TweenToCFrame(Target, ContinueCheck)
    local Root = GetRoot()

    if not Root or typeof(Target) ~= "CFrame" then
        return false
    end

    -- Starting a new movement invalidates any older movement.
    CancelActiveMovement()

    local MyGeneration = MovementGeneration

    Root.AssemblyLinearVelocity = Vector3.zero
    Root.AssemblyAngularVelocity = Vector3.zero

    -- Move in short TweenService segments instead of one long tween.
    -- This makes Tween Speed react while the slider is being moved.
    while HubRunning and MyGeneration == MovementGeneration do
        if ContinueCheck and not ContinueCheck() then
            CancelActiveMovement()
            return false
        end

        Root = GetRoot()

        if not Root then
            CancelActiveMovement()
            return false
        end

        local Delta = Target.Position - Root.Position
        local Distance = Delta.Magnitude

        if Distance <= 0.75 then
            Root.CFrame = Target
            Root.AssemblyLinearVelocity = Vector3.zero
            Root.AssemblyAngularVelocity = Vector3.zero

            if ActiveMovementTween then
                ActiveMovementTween = nil
            end

            return true
        end

        -- Read the setting EVERY segment so slider changes apply immediately.
        local Speed = math.max(
            tonumber(Settings.TweenSpeed) or 120,
            1
        )

        -- Short segment duration keeps live speed changes responsive.
        local SegmentTime = 0.10
        local StepDistance = math.min(
            Distance,
            Speed * SegmentTime
        )

        local Direction = Delta.Unit
        local NextPosition =
            Root.Position + Direction * StepDistance

        local Alpha = math.clamp(
            StepDistance / math.max(Distance, 0.001),
            0,
            1
        )

        local NextCFrame =
            Root.CFrame:Lerp(Target, Alpha)

        -- Keep the calculated position exact while preserving interpolated rotation.
        NextCFrame = CFrame.new(NextPosition) * NextCFrame.Rotation

        local ActualTime =
            math.max(
                StepDistance / Speed,
                0.02
            )

        local Tween = TweenService:Create(
            Root,
            TweenInfo.new(
                ActualTime,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.Out
            ),
            {
                CFrame = NextCFrame
            }
        )

        ActiveMovementTween = Tween
        Tween:Play()

        local State = Tween.Completed:Wait()

        if ActiveMovementTween == Tween then
            ActiveMovementTween = nil
        end

        if MyGeneration ~= MovementGeneration then
            return false
        end

        if State ~= Enum.PlaybackState.Completed then
            return false
        end
    end

    return false
end


local function CountTrueSelections(
    Selection
)
    local Count = 0

    if typeof(Selection)
        ~= "table"
    then
        return 0
    end

    for _, Enabled in pairs(
        Selection
    ) do
        if Enabled == true then
            Count += 1
        end
    end

    return Count
end


local function CountActiveAutomation()
    local Count = 0

    for _, Key in ipairs(
        AutomationSettingKeys
    ) do
        if Settings[Key] == true then
            Count += 1
        end
    end

    return Count
end


local function GetDashboardTargetName()
    if not CurrentFarmUUID
        or not CurrentFarmArea
    then
        return "None"
    end

    local Folder =
        GetServerEnemyAreaFolder(
            CurrentFarmArea
        )

    local Enemy =
        Folder
        and Folder:FindFirstChild(
            CurrentFarmUUID
        )

    return Enemy
        and GetEnemyDisplayName(
            Enemy
        )
        or "Target"
end



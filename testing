local function GetPlaceEggDropdownOptions()
    local Options =
        GetBackpackEggNames()

    local Seen = {}

    for _, Name in ipairs(Options) do
        Seen[Name] = true
    end

    -- Always keep the two preferred eggs visible in the dropdown.
    for _, Name in ipairs({
        "Cherub Egg",
        "Blackhole Egg",
    }) do
        if not Seen[Name] then
            table.insert(Options, Name)
            Seen[Name] = true
        end
    end

    table.sort(
        Options,
        function(A, B)
            local APriority =
                PreferredEggPriority[A] or 999

            local BPriority =
                PreferredEggPriority[B] or 999

            if APriority ~= BPriority then
                return APriority < BPriority
            end

            return A < B
        end
    )

    return Options
end



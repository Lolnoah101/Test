function RaidController:FindRaidChestNear(
    Position,
    ExpectedChestId
)
    if typeof(Position) ~= "Vector3" then
        return nil
    end

    local Chests =
        workspace:FindFirstChild(
            "Chests"
        )

    if not Chests then
        return nil
    end

    local BestChest = nil
    local BestDistance = math.huge
    local ExpectedLower =
        ExpectedChestId
        and string.lower(
            tostring(
                ExpectedChestId
            )
        )
        or nil

    for _, Chest in ipairs(
        Chests:GetChildren()
    ) do
        if not self.CompletedChests[
            Chest
        ]
            and self:IsRaidChest(
                Chest
            )
        then
            local ChestCFrame =
                self:GetChestCFrame(
                    Chest
                )

            if ChestCFrame then
                local Distance =
                    (
                        ChestCFrame.Position
                        - Position
                    ).Magnitude

                if Distance <= self.SpawnMatchRadius then
                    local NameMatches =
                        not ExpectedLower
                        or string.lower(
                            tostring(
                                Chest.Name
                            )
                        ) == ExpectedLower

                    -- Prefer the tier expected at this spawn, but still accept
                    -- a nearby sealed cache if the live game renamed the model.
                    local Score =
                        Distance
                        + (
                            NameMatches
                            and 0
                            or 1000
                        )

                    if Score < BestDistance then
                        BestDistance = Score
                        BestChest = Chest
                    end
                end
            end
        end
    end

    return BestChest
end


function RaidController:RequestSpawnStreaming(
    Position
)
    if typeof(Position) ~= "Vector3" then
        return
    end

    -- Keep RequestStreamAroundAsync off the raid loop because some clients
    -- wait for streaming work to finish before the call returns.
    task.spawn(function()
        pcall(function()
            LocalPlayer:RequestStreamAroundAsync(
                Position,
                1
            )
        end)
    end)
end


function RaidController:ProbeSpawnPoint(
    Point,
    MyLoopID
)
    if type(Point) ~= "table"
        or typeof(Point.CFrame) ~= "CFrame"
    then
        return nil
    end

    local Position =
        Point.CFrame.Position

    -- A chest may already have replicated from a previous probe.
    local Existing =
        self:FindRaidChestNear(
            Position,
            Point.ChestId
        )

    if Existing then
        return Existing
    end

    Settings.__RaidFarmBusy = true
    self.Busy = true

    self:RequestSpawnStreaming(
        Position
    )

    -- Enter the spawn's streaming radius from above. This mirrors the
    -- quest-giver preload system and also keeps us clear of raid guards.
    self:HoverAt(
        Point.CFrame,
        self.SpawnProbeHeight
    )

    self:RequestSpawnStreaming(
        Position
    )

    local Deadline =
        os.clock()
        + self.SpawnProbeTimeout

    repeat
        local Chest =
            self:FindRaidChestNear(
                Position,
                Point.ChestId
            )

        if Chest then
            return Chest
        end

        -- Sometimes another active cache in the newly streamed area is a
        -- little farther from the exact config CFrame. Accept any visible
        -- sealed cache as a fallback instead of unnecessarily continuing.
        Chest =
            self:FindRaidChest()

        if Chest then
            return Chest
        end

        if not HubRunning
            or not Settings.AutoRaidChest
            or MyLoopID ~= self.LoopID
        then
            return nil
        end

        task.wait(
            self.SpawnProbePollInterval
        )
    until os.clock() >= Deadline

    return nil
end


function RaidController:FindOrStreamRaidChest(
    MyLoopID
)
    self:EnsureChestSpawnWatcher()

    -- Fast path: an already replicated cache means no spawn-point travel.
    local VisibleChest =
        self:FindRaidChest()

    if VisibleChest then
        self.SpawnWakeRequested =
            false

        return VisibleChest
    end

    if self.SpawnWakeRequested then
        self.SpawnWakeRequested =
            false

        self.NextSpawnSweepAt =
            0
    end

    -- Empty-server waiting mode: stay where you are until a watched chest
    -- appears or the next scheduled safety/respawn check is due.
    if os.clock()
        < (
            self.NextSpawnSweepAt
            or 0
        )
    then
        return nil
    end

    local Points =
        self:LoadSpawnPoints()

    if #Points == 0 then
        self:ScheduleNoChestWait()

        return nil
    end

    local StartIndex =
        math.clamp(
            tonumber(
                self.SpawnScanIndex
            ) or 0,
            0,
            #Points
        )
        + 1

    if StartIndex > #Points then
        StartIndex = 1
    end

    for Offset = 0, #Points - 1 do
        if not HubRunning
            or not Settings.AutoRaidChest
            or MyLoopID ~= self.LoopID
        then
            return nil
        end

        local Index =
            ((
                StartIndex
                + Offset
                - 2
            ) % #Points)
            + 1

        self.SpawnScanIndex =
            Index

        local Point =
            Points[
                Index
            ]

        local Cooling =
            self:IsSpawnCoolingDown(
                Point
            )

        if not Cooling then
            local Chest =
                self:ProbeSpawnPoint(
                    Point,
                    MyLoopID
                )

            if Chest then
                return Chest
            end
        end
    end

    -- A full sweep found nothing. Do not immediately teleport through all
    -- points again. workspace.Chests events can wake this instantly.
    self:ScheduleNoChestWait()

    return nil
end


function RaidController:ReleaseCharacter()
    -- Raid combat now uses the same shared farm movement controller as
    -- Auto Farm / Auto Farm Quest, so release any anchor/tween/noclip it owns.
    QuestFarmController:ResetTarget()

    local _, Root =
        self:GetCharacterRoot()

    if Root then
        Root.Anchored = false
        Root.AssemblyLinearVelocity =
            Vector3.zero
        Root.AssemblyAngularVelocity =
            Vector3.zero
    end
end


function RaidController:HoverAt(
    TargetCFrame,
    Height
)
    local Character, Root =
        self:GetCharacterRoot()

    if not Character
        or not Root
        or typeof(TargetCFrame) ~= "CFrame"
    then
        return false
    end

    Height =
        tonumber(Height)
        or 10

    -- Raid travel between chest spawn points and the cache itself follows
    -- the same Farm Movement + Tween Speed settings as the normal farm.
    LootMoveState:CancelTween()
    LootMoveState:RestoreNoclip()
    LootMoveState.Busy = false

    local TargetPosition =
        TargetCFrame.Position

    local HoverPosition =
        TargetPosition
        + Vector3.new(
            0,
            Height,
            0
        )

    local Destination =
        CFrame.lookAt(
            HoverPosition,
            TargetPosition,
            Vector3.new(
                0,
                0,
                -1
            )
        )

    Root.Anchored = false
    Root.AssemblyLinearVelocity =
        Vector3.zero
    Root.AssemblyAngularVelocity =
        Vector3.zero

    QuestFarmController:EnableFarmNoclip(
        Character
    )

    if Settings.FarmMovement == "Tween" then
        local Speed =
            math.clamp(
                tonumber(
                    Settings.QuestTweenSpeed
                )
                or 100,
                10,
                300
            )

        local Distance =
            (
                Destination.Position
                - Root.Position
            ).Magnitude

        local Duration =
            math.max(
                Distance / Speed,
                0.04
            )

        local Tween =
            TweenService:Create(
                Root,
                TweenInfo.new(
                    Duration,
                    Enum.EasingStyle.Linear,
                    Enum.EasingDirection.Out
                ),
                {
                    CFrame = Destination,
                }
            )

        Tween:Play()

        local Completed =
            false

        pcall(function()
            Tween.Completed:Wait()
            Completed =
                true
        end)

        if not Completed
            or not Root.Parent
        then
            QuestFarmController:RestoreFarmNoclip()
            return false
        end
    else
        -- Default raid travel follows the user's Teleport farm method.
        pcall(function()
            Character:PivotTo(
                Destination
            )

            Root.CFrame =
                Destination
        end)
    end

    if Root.Parent
        and Character.Parent
    then
        Root.AssemblyLinearVelocity =
            Vector3.zero
        Root.AssemblyAngularVelocity =
            Vector3.zero
        Root.CFrame =
            Destination

        -- Hold the spawn/chest hover point steady. Enemy combat itself
        -- uses QuestFarmController:HoverOverTarget below.
        Root.Anchored =
            true
    end

    QuestFarmController:RestoreFarmNoclip()

    return true
end


function RaidController:GetTemporaryActiveNpcs()
    local Humanoids =
        workspace:FindFirstChild(
            "Humanoids"
        )

    local Regions =
        Humanoids
        and Humanoids:FindFirstChild(
            "Regions"
        )

    local Temporary =
        Regions
        and Regions:FindFirstChild(
            "Temporary"
        )

    return Temporary
        and Temporary:FindFirstChild(
            "ActiveNpcs"
        )
        or nil
end


function RaidController:GetEnemyRoot(
    Enemy
)
    if not Enemy
        or not Enemy.Parent
    then
        return nil
    end

    return Enemy:FindFirstChild(
        "HumanoidRootPart"
    )
        or Enemy.PrimaryPart
        or Enemy:FindFirstChildWhichIsA(
            "BasePart",
            true
        )
end


function RaidController:IsEnemyAlive(
    Enemy
)
    if not Enemy
        or not Enemy.Parent
        or not Enemy:IsDescendantOf(
            workspace
        )
    then
        return false
    end

    local Humanoid =
        Enemy:FindFirstChildOfClass(
            "Humanoid"
        )

    return Humanoid ~= nil
        and Humanoid.Health > 0
        and self:GetEnemyRoot(
            Enemy
        ) ~= nil
end


function RaidController:FindRaidEnemy(
    ChestPosition
)
    local ActiveNpcs =
        self:GetTemporaryActiveNpcs()

    if not ActiveNpcs
        or typeof(ChestPosition) ~= "Vector3"
    then
        return nil
    end

    local BestEnemy = nil
    local BestDistance = math.huge
    local SeenHumanoids = {}

    for _, Object in ipairs(
        ActiveNpcs:GetDescendants()
    ) do
        if Object:IsA("Model") then
            local Humanoid =
                Object:FindFirstChildOfClass(
                    "Humanoid"
                )

            if Humanoid
                and Humanoid.Health > 0
                and not SeenHumanoids[
                    Humanoid
                ]
            then
                SeenHumanoids[Humanoid] =
                    true

                local Root =
                    self:GetEnemyRoot(
                        Object
                    )

                if Root then
                    local Distance =
                        (
                            Root.Position
                            - ChestPosition
                        ).Magnitude

                    if Distance <= self.EnemyRadius
                        and Distance < BestDistance
                    then
                        BestDistance = Distance
                        BestEnemy = Object
                    end
                end
            end
        end
    end

    return BestEnemy
end


function RaidController:AttackEnemy(
    Enemy,
    ChestPosition,
    MyLoopID
)
    self.CurrentEnemy =
        Enemy

    -- Raid mode does NOT send its own combat remote anymore.
    -- It only keeps the player positioned on the target while the
    -- existing Auto Click toggle owns the 1 -> 5 attack loop.
    self:ReleaseCharacter()

    while HubRunning
        and Settings.AutoRaidChest
        and MyLoopID == self.LoopID
        and self:IsEnemyAlive(
            Enemy
        )
    do
        local EnemyRoot =
            self:GetEnemyRoot(
                Enemy
            )

        if not EnemyRoot then
            break
        end

        if (
            EnemyRoot.Position
            - ChestPosition
        ).Magnitude > self.EnemyRadius + 35
        then
            break
        end

        QuestFarmController:HoverOverTarget(
            Enemy,
            "Raid"
        )

        if not Settings.AutoClick then
            if self.AutoClickNoticeEnemy
                ~= Enemy
            then
                self.AutoClickNoticeEnemy =
                    Enemy

                HubDebug(
                    "[Combat Hub] Raid target ready: "
                        .. tostring(
                            Enemy.Name
                        )
                        .. " | waiting for Auto Click"
                )
            end
        else
            if self.AutoClickNoticeEnemy
                == Enemy
            then
                HubDebug(
                    "[Combat Hub] Auto Click active; attacking raid target: "
                        .. tostring(
                            Enemy.Name
                        )
                )
            end

            self.AutoClickNoticeEnemy =
                nil
        end

        task.wait(
            self.UpdateInterval
        )
    end

    QuestFarmController:ResetTarget(
        "Raid"
    )

    self.AutoClickNoticeEnemy =
        nil

    self.CurrentEnemy =
        nil
end


function RaidController:ClearChestEnemies(
    Chest,
    MyLoopID
)
    local ChestCFrame =
        self:GetChestCFrame(
            Chest
        )

    if not ChestCFrame then
        return false
    end

    local ChestPosition =
        ChestCFrame.Position

    local EmptySince = nil
    local StartedAt =
        os.clock()

    -- IMPORTANT:
    -- Do NOT use ChestPrompt.Enabled as proof that the raid guards are dead.
    -- The prompt can already exist/be enabled while the server still refuses
    -- to open the cache. The authoritative condition we can observe here is
    -- that no living Temporary.ActiveNpcs remain around this chest.
    while HubRunning
        and Settings.AutoRaidChest
        and MyLoopID == self.LoopID
        and Chest.Parent
    do
        local Enemy =
            self:FindRaidEnemy(
                ChestPosition
            )

        if Enemy then
            EmptySince = nil

            local Humanoid =
                Enemy:FindFirstChildOfClass(
                    "Humanoid"
                )

            HubDebug(
                "[Combat Hub] Raid target: "
                    .. tostring(Enemy.Name)
                    .. (
                        Humanoid
                        and (
                            " | HP "
                            .. string.format(
                                "%.1f",
                                Humanoid.Health
                            )
                        )
                        or ""
                    )
            )

            self:AttackEnemy(
                Enemy,
                ChestPosition,
                MyLoopID
            )
        else
            -- Stay above the cache while waiting for replication / checking
            -- that every guard belonging to this raid is really gone.
            self:HoverAt(
                ChestCFrame,
                self.ChestHoverHeight
            )

            if not EmptySince then
                EmptySince =
                    os.clock()
            end

            -- Require the area to remain clear continuously before opening.
            -- This prevents a brief streaming gap from being mistaken for a
            -- completed raid.
            if os.clock() - EmptySince
                >= self.EmptyEnemyConfirmTime
            then
                HubDebug(
                    "[Combat Hub] Raid area clear; opening cache."
                )

                return true
            end

            -- If guards have not replicated yet, keep scanning rather than
            -- immediately trying the chest.
            if os.clock() - StartedAt
                > self.ChestEnableTimeout
                and not self:GetTemporaryActiveNpcs()
            then
                return false
            end

            task.wait(
                self.UpdateInterval
            )
        end
    end

    return false
end


function RaidController:WaitForChestPrompt(
    Chest,
    MyLoopID,
    Timeout
)
    Timeout =
        tonumber(Timeout)
        or self.ChestEnableTimeout

    local Deadline =
        os.clock()
        + Timeout

    repeat
        if not HubRunning
            or not Settings.AutoRaidChest
            or MyLoopID ~= self.LoopID
        then
            return nil
        end

        if not Chest
            or not Chest.Parent
        then
            return nil
        end

        local Prompt =
            self:GetChestPrompt(
                Chest
            )

        if Prompt
            and Prompt.Parent
        then
            return Prompt
        end

        -- Keep the cache area streamed while its prompt/state replicates.
        local ChestCFrame =
            self:GetChestCFrame(
                Chest
            )

        if ChestCFrame then
            self:RequestSpawnStreaming(
                ChestCFrame.Position
            )
        end

        task.wait(
            0.03
        )
    until os.clock() >= Deadline

    return nil
end


function RaidController:MoveIntoPromptRange(
    Prompt,
    MyLoopID
)
    if not Prompt
        or not Prompt.Parent
    then
        return false
    end

    local Character, Root =
        self:GetCharacterRoot()

    if not Character
        or not Root
    then
        return false
    end

    -- If we're already beside the chest, do not move again.
    local InRange =
        LootMoveState:IsPromptInRange(
            Prompt,
            Root
        )

    if InRange then
        Root.Anchored =
            false

        return true
    end

    local TargetCFrame =
        LootMoveState:GetPromptCFrame(
            Prompt
        )

    if not TargetCFrame then
        return false
    end

    self:ReleaseCharacter()

    local RotationOnly =
        Root.CFrame
        - Root.Position

    local Destination =
        CFrame.new(
            TargetCFrame.Position
            + Vector3.new(
                0,
                2,
                0
            )
        )
        * RotationOnly

    QuestFarmController:EnableFarmNoclip(
        Character
    )

    if Settings.FarmMovement == "Tween" then
        local Speed =
            math.clamp(
                tonumber(
                    Settings.QuestTweenSpeed
                )
                or 100,
                10,
                300
            )

        local Distance =
            (
                Destination.Position
                - Root.Position
            ).Magnitude

        local Duration =
            math.max(
                Distance / Speed,
                0.04
            )

        local Tween =
            TweenService:Create(
                Root,
                TweenInfo.new(
                    Duration,
                    Enum.EasingStyle.Linear,
                    Enum.EasingDirection.Out
                ),
                {
                    CFrame = Destination,
                }
            )

        Tween:Play()

        local Completed =
            false

        pcall(function()
            Tween.Completed:Wait()
            Completed =
                true
        end)

        if not Completed then
            QuestFarmController:RestoreFarmNoclip()
            return false
        end
    else
        Character:PivotTo(
            Destination
        )

        Root.CFrame =
            Destination
    end

    QuestFarmController:RestoreFarmNoclip()

    Root.Anchored =
        false

    Root.AssemblyLinearVelocity =
        Vector3.zero

    Root.AssemblyAngularVelocity =
        Vector3.zero

    -- Wait only until the real ProximityPrompt range says we're close enough.
    local Deadline =
        os.clock()
        + 1.0

    repeat
        if not HubRunning
            or not Settings.AutoRaidChest
            or MyLoopID ~= self.LoopID
            or not Prompt.Parent
        then
            return false
        end

        local NowInRange =
            LootMoveState:IsPromptInRange(
                Prompt,
                Root
            )

        if NowInRange then
            return true
        end

        task.wait(
            0.02
        )
    until os.clock() >= Deadline

    return false
end


function RaidController:OpenChest(
    Chest,
    MyLoopID
)
    if not Chest
        or not Chest.Parent
    then
        return true
    end

    -- Guard death can cause the live cache prompt/state to replicate again.
    -- A missing prompt is NOT treated as a successful open anymore.
    local Prompt =
        self:WaitForChestPrompt(
            Chest,
            MyLoopID,
            self.ChestEnableTimeout
        )

    if not Prompt then
        return false
    end

    -- Wait for the raid lock to release.
    local EnableDeadline =
        os.clock()
        + self.ChestEnableTimeout

    while HubRunning
        and Settings.AutoRaidChest
        and MyLoopID == self.LoopID
        and Chest.Parent
        and os.clock() < EnableDeadline
    do
        if not Prompt.Parent then
            Prompt =
                self:WaitForChestPrompt(
                    Chest,
                    MyLoopID,
                    1.5
                )

            if not Prompt then
                return false
            end
        end

        if Prompt.Enabled then
            break
        end

        task.wait(
            0.03
        )
    end

    if not Chest.Parent then
        return true
    end

    if not Prompt
        or not Prompt.Parent
        or not Prompt.Enabled
    then
        return false
    end

    -- IMPORTANT:
    -- Drop from the combat/farm position and move BESIDE the actual cache.
    -- This uses the same Farm Movement + Tween Speed setting as the hub.
    local Reached =
        self:MoveIntoPromptRange(
            Prompt,
            MyLoopID
        )

    if not Reached then
        return false
    end

    -- Release any remaining farm anchor before the normal chest scanner runs.
    self:ReleaseCharacter()

    local _, Root =
        self:GetCharacterRoot()

    if not Root then
        return false
    end

    -- Verify we're physically inside the real prompt distance before asking
    -- the user's Auto Open Chest system to do anything.
    if not LootMoveState:IsPromptInRange(
        Prompt,
        Root
    )
    then
        return false
    end

    HubDebug(
        "[Combat Hub] Raid cache cleared; waiting for Auto Open Chest."
    )

    -- Auto Raid Chest no longer has a private chest-opening fallback.
    -- The existing Auto Open Chest toggle/function owns this stage.
    while HubRunning
        and Settings.AutoRaidChest
        and MyLoopID == self.LoopID
        and Chest.Parent
    do
        -- If the user has Auto Open Chest enabled, run the SAME scanner/
        -- prompt function that the normal toggle already uses.
        if Settings.AutoOpenChest then
            if Prompt
                and Prompt.Parent
                and Prompt.Enabled
            then
                OpenChestPrompt(
                    Prompt
                )
            else
                Prompt =
                    self:GetChestPrompt(
                        Chest
                    )
            end

            ScanExistingChests()
        end

        -- Successful open states observed by the client:
        --   * cache model gets removed
        --   * old prompt gets removed/replaced
        --   * prompt becomes disabled after the server accepts it
        if not Chest.Parent then
            return true
        end

        if not Prompt
            or not Prompt.Parent
        then
            -- Give a replacement prompt a brief chance to replicate.
            local Replacement =
                self:WaitForChestPrompt(
                    Chest,
                    MyLoopID,
                    0.35
                )

            if not Replacement then
                return true
            end

            Prompt =
                Replacement
        elseif not Prompt.Enabled then
            task.wait(
                0.15
            )

            if not Prompt.Parent
                or not Prompt.Enabled
            then
                return true
            end
        end

        task.wait(
            0.04
        )
    end

    return not Chest.Parent
end


function RaidController:CountPendingChestLoot(
    ChestPosition
)
    if typeof(ChestPosition) ~= "Vector3" then
        return 0
    end

    local Count =
        0

    local Seen = {}

    local function ConsiderPrompt(
        Prompt
    )
        if not Prompt
            or Seen[Prompt]
            or not Prompt.Parent
            or not Prompt:IsA(
                "ProximityPrompt"
            )
            or not IsCollectiblePrompt(
                Prompt
            )
        then
            return
        end

        Seen[Prompt] =
            true

        local SoulPrompt =
            IsSoulPrompt(
                Prompt
            )

        -- Match ScanExistingLoot behavior:
        -- disabled normal loot is not currently collectible, while souls
        -- can still be handled by the soul hold helper.
        if not SoulPrompt
            and not Prompt.Enabled
        then
            return
        end

        if IsLootPrompt(
            Prompt
        )
        then
            local LootDrop =
                GetLootDropFromPrompt(
                    Prompt
                )

            if not LootDrop
                or not LootMatchesSelection(
                    LootDrop
                )
            then
                return
            end
        end

        local TargetCFrame =
            LootMoveState:GetPromptCFrame(
                Prompt
            )

        if not TargetCFrame then
            return
        end

        if (
            TargetCFrame.Position
            - ChestPosition
        ).Magnitude > self.LootRadius
        then
            return
        end

        Count += 1
    end

    ----------------------------------------------------------
    -- NORMAL LOOT
    ----------------------------------------------------------

    local LootFolder =
        GetLootFolder()

    if LootFolder then
        for _,
            Object in ipairs(
                LootFolder:GetDescendants()
            )
        do
            if IsLootPrompt(
                Object
            )
            then
                ConsiderPrompt(
                    Object
                )
            end
        end
    end

    ----------------------------------------------------------
    -- SOULS
    ----------------------------------------------------------

    local Debree =
        GetDebreeFolder()

    if Debree then
        for _,
            Drop in ipairs(
                Debree:GetChildren()
            )
        do
            if Drop.Name == "Weak Soul"
                or Drop.Name == "Strong Soul"
            then
                local Prompt =
                    Drop:FindFirstChild(
                        "SoulPrompt",
                        true
                    )

                if Prompt then
                    ConsiderPrompt(
                        Prompt
                    )
                end
            end
        end
    end

    return Count
end


function RaidController:CollectChestLoot(
    ChestPosition,
    MyLoopID
)
    if typeof(ChestPosition) ~= "Vector3" then
        return
    end

    Settings.__RaidCollecting =
        true

    Settings.__RaidLootCenter =
        ChestPosition

    Settings.__RaidLootRadius =
        self.LootRadius

    self:ReleaseCharacter()

    HubDebug(
        "[Combat Hub] Raid cache opened; waiting for ALL nearby loot."
    )

    -- Keep using the user's existing Auto Pick Up Loot/Souls toggle.
    -- Restart its loop once so freshly-created cache drops are scanned
    -- immediately, but Raid itself does not replace that collector.
    if Settings.AutoPickUpLoot then
        StartAutoPickUpLoot()
    end

    local StartedAt =
        os.clock()

    local HardDeadline =
        StartedAt
        + math.max(
            tonumber(
                self.LootCollectTimeout
            )
            or 90,
            30
        )

    local QuietSince =
        nil

    local LastPendingCount =
        -1

    while HubRunning
        and Settings.AutoRaidChest
        and MyLoopID == self.LoopID
    do
        local Now =
            os.clock()

        if not Settings.AutoPickUpLoot then
            -- Respect the user's normal loot toggle. If they turn it off,
            -- Raid does not secretly collect items for them.
            if Now - StartedAt
                >= 1.0
            then
                break
            end

            task.wait(
                LOOT_SCAN_INTERVAL
            )

            continue
        end

        local PendingCount =
            self:CountPendingChestLoot(
                ChestPosition
            )

        local Busy =
            LootMoveState.Busy
            or CollectibleInteractionBusy
            or Settings.__LootFarmBusy

        if PendingCount
            ~= LastPendingCount
        then
            LastPendingCount =
                PendingCount

            HubDebug(
                "[Combat Hub] Raid loot remaining: "
                    .. tostring(
                        PendingCount
                    )
            )
        end

        if Busy
            or PendingCount > 0
        then
            -- Any current interaction OR any prompt still waiting means the
            -- chest is not complete. In particular, a 2-second T hold keeps
            -- Raid parked here until that prompt disappears.
            QuietSince =
                nil
        else
            if not QuietSince then
                QuietSince =
                    Now
            end

            if Now - QuietSince
                >= (
                    tonumber(
                        self.LootQuietConfirmTime
                    )
                    or 1.50
                )
            then
                HubDebug(
                    "[Combat Hub] Raid loot complete; no prompts remain."
                )

                break
            end
        end

        -- Hard safety cap for a permanently bugged prompt. Never use the cap
        -- to interrupt an interaction that is currently holding a key.
        if Now >= HardDeadline
            and not LootMoveState.Busy
            and not CollectibleInteractionBusy
        then
            warn(
                "[Combat Hub] Raid loot safety timeout; moving on with "
                    .. tostring(
                        PendingCount
                    )
                    .. " prompt(s) still detected."
            )

            break
        end

        task.wait(
            LOOT_SCAN_INTERVAL
        )
    end

    -- Do not move to another chest while a hold that already started is
    -- still completing, even if Raid was toggled/state-changed mid-loop.
    while HubRunning
        and Settings.AutoRaidChest
        and MyLoopID == self.LoopID
        and CollectibleInteractionBusy
    do
        task.wait(
            0.03
        )
    end

    Settings.__RaidCollecting =
        false

    Settings.__RaidLootCenter =
        nil

    Settings.__RaidLootRadius =
        nil

    Settings.__LootFarmBusy =
        false

    LootMoveState:CancelTween()
    LootMoveState:RestoreNoclip()
    LootMoveState.Busy =
        false

    -- IMPORTANT: do not force CollectibleInteractionBusy = false here.
    -- HoldPromptKey owns that state and clears it only after T is released.
end


function RaidController:RunChest(
    Chest,
    MyLoopID
)
    if not Chest
        or not Chest.Parent
    then
        return false
    end

    local ChestCFrame =
        self:GetChestCFrame(
            Chest
        )

    if not ChestCFrame then
        return false
    end

    self.Busy = true
    self.CurrentChest = Chest
    Settings.__RaidFarmBusy = true
    Settings.__RaidCollecting = false
    Settings.__RaidLootCenter = nil
    Settings.__RaidLootRadius = nil

    -- First action requested: teleport/fly directly above the raid cache.
    self:HoverAt(
        ChestCFrame,
        self.ChestHoverHeight
    )

    task.wait(0.12)

    local Cleared =
        self:ClearChestEnemies(
            Chest,
            MyLoopID
        )

    if not Cleared
        and Chest.Parent
    then
        self.Busy = false
        self.CurrentChest = nil
        Settings.__RaidFarmBusy = false
        self:ReleaseCharacter()
        return false
    end

    local Opened =
        self:OpenChest(
            Chest,
            MyLoopID
        )

    if Opened then
        self.CompletedChests[
            Chest
        ] = true

        self:MarkSpawnCooldown(
            ChestCFrame.Position
        )

        -- Stay at THIS raid until the normal Auto Pick Up Loot/Souls
        -- collector finishes its chest-local pass, then resume the spawn sweep.
        self:CollectChestLoot(
            ChestCFrame.Position,
            MyLoopID
        )

        HubDebug(
            "[Combat Hub] Raid cache complete; searching for next cache."
        )
    end

    self.Busy = false
    self.CurrentChest = nil
    self.CurrentEnemy = nil
    Settings.__RaidCollecting = false
    Settings.__RaidLootCenter = nil
    Settings.__RaidLootRadius = nil
    Settings.__RaidFarmBusy = false
    Settings.__LootFarmBusy = false

    self:ReleaseCharacter()

    return Opened
end


function RaidController:Start()
    self.LoopID += 1

    local MyLoopID =
        self.LoopID

    self.Busy = false
    self.CurrentChest = nil
    self.CurrentEnemy = nil
    self.SpawnScanIndex = 0
    self.NextSpawnSweepAt = 0
    self.SpawnWakeRequested = false
    self.LastNoChestStatusAt = 0

    self:EnsureChestSpawnWatcher()

    Settings.__RaidFarmBusy = false
    Settings.__RaidCollecting = false
    Settings.__RaidLootCenter = nil
    Settings.__RaidLootRadius = nil

    -- Stop any old normal-farm movement before Raid starts owning travel.
    QuestFarmController:ResetTarget()

    task.spawn(function()
        while HubRunning
            and Settings.AutoRaidChest
            and MyLoopID == self.LoopID
        do
            if Settings.__AutoSellBusy then
                self:ReleaseCharacter()

                task.wait(
                    0.10
                )

                continue
            end

            local Success,
                ErrorMessage =
                pcall(function()
                    local Chest =
                        self:FindOrStreamRaidChest(
                            MyLoopID
                        )

                    if Chest then
                        self:RunChest(
                            Chest,
                            MyLoopID
                        )
                    else
                        self.Busy = false
                        self.CurrentChest = nil
                        self.CurrentEnemy = nil
                        Settings.__RaidFarmBusy = false
                        Settings.__RaidCollecting = false
                        self:ReleaseCharacter()
                    end
                end)

            if not Success then
                warn(
                    "[Combat Hub] Auto Raid Chest recovered: "
                        .. tostring(
                            ErrorMessage
                        )
                )

                self.Busy = false
                self.CurrentChest = nil
                self.CurrentEnemy = nil
                Settings.__RaidFarmBusy = false
                Settings.__RaidCollecting = false
                Settings.__RaidLootCenter = nil
                Settings.__RaidLootRadius = nil
                Settings.__LootFarmBusy = false
                self:ReleaseCharacter()
            end

            task.wait(
                self.UpdateInterval
            )
        end
    end)
end


function RaidController:Stop()
    Settings.AutoRaidChest =
        false

    self.LoopID += 1
    self.Busy = false
    self.CurrentChest = nil
    self.CurrentEnemy = nil

    Settings.__RaidFarmBusy = false
    Settings.__RaidCollecting = false
    Settings.__RaidLootCenter = nil
    Settings.__RaidLootRadius = nil
    Settings.__LootFarmBusy = false

    self:DisconnectChestSpawnWatcher()
    self:ReleaseCharacter()
end




function LootMoveState:EnableNoclip(
    Character
)
    if not Character then
        return
    end

    for _, Object in ipairs(
        Character:GetDescendants()
    ) do
        if Object:IsA("BasePart") then
            if self.NoclipStates[
                Object
            ] == nil
            then
                self.NoclipStates[
                    Object
                ] =
                    Object.CanCollide
            end

            Object.CanCollide =
                false
        end
    end

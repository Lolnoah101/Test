local function GetEnemyDisplayName(
    ServerEnemy
)
    if not ServerEnemy then
        return nil
    end

    -- Use the enemy's Name ATTRIBUTE for the dropdown.
    -- Example:
    -- Name = "Master Inventor"
    -- Id = "Bulma"
    local AttributeName =
        ServerEnemy:GetAttribute("Name")

    if typeof(AttributeName) == "string"
        and AttributeName ~= ""
    then
        return AttributeName
    end

    -- Fallback only if the Name attribute is missing.
    return ServerEnemy.Name
end


local function IsServerEnemyAlive(
    ServerEnemy
)
    if not ServerEnemy
        or not ServerEnemy.Parent
    then
        return false
    end

    if ServerEnemy:GetAttribute("Dead")
        == true
    then
        return false
    end

    local HP =
        tonumber(
            ServerEnemy:GetAttribute("HP")
        )

    if HP ~= nil
        and HP <= 0
    then
        return false
    end

    return true
end


local function IsSecretEnemy(
    ServerEnemy
)
    if not ServerEnemy then
        return false
    end

    return ServerEnemy:GetAttribute(
        "Rarity"
    ) == "Secret"
end


local function GetAllSecretEnemyOptions()

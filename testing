local AutoSellPetBusy = false
local LastAutoSellMessage = nil


local function GetSellNPC()
    local Stalls =
        Workspace:FindFirstChild("Stalls")

    local Sell =
        Stalls and Stalls:FindFirstChild("Sell")

    return Sell and Sell:FindFirstChild("Richie")
end


local function GetPetToolWeight(Tool)
    if not Tool then
        return 0
    end

    local Weight =
        tonumber(Tool:GetAttribute("Weight"))
        or tonumber(Tool:GetAttribute("BaseWeight"))

    if Weight then
        return Weight
    end

    local FromName =
        tostring(Tool.Name):match(
            "%[([%d%.]+)%s*[Kk][Gg]%]"
        )

    return tonumber(FromName) or 0
end


local function FindPetToolByKey(PetKey)
    for _, Container in ipairs({
        LocalPlayer.Character,
        Backpack,
    }) do
        if Container then
            for _, Child in ipairs(Container:GetChildren()) do
                if Child:IsA("Tool")
                    and Child:HasTag("Pet")
                    and Child:GetAttribute("PetKey") == PetKey
                then
                    return Child
                end
            end
        end
    end

    return nil
end


local function GetDesiredBestPetKeys()
    local Result = {}

    if not Settings.AutoPlaceBestPets
        or not CollectOwnedPets
    then
        return Result
    end

    local Success, Owned =
        pcall(CollectOwnedPets)

    if not Success or typeof(Owned) ~= "table" then
        return Result
    end

    local MaxPets =
        tonumber(
            LocalPlayer:GetAttribute("MaxPets")
        ) or 5

    for Index = 1,
        math.min(
            MaxPets,
            #Owned
        )
    do
        local Pet = Owned[Index]

        if Pet and Pet.Key then
            Result[Pet.Key] = true
        end
    end

    return Result
end


local function GetUnderWeightPetTools()
    local Threshold =
        math.max(
            tonumber(
                Settings.SellWeightThreshold
            ) or 10,
            0
        )

    local ProtectedBestKeys =
        GetDesiredBestPetKeys()

    local SeenKeys = {}
    local Result = {}

    for _, Container in ipairs({
        LocalPlayer.Character,
        Backpack,
    }) do
        if Container then
            for _, Child in ipairs(Container:GetChildren()) do
                if Child:IsA("Tool")
                    and Child:HasTag("Pet")
                then
                    local PetKey =
                        Child:GetAttribute("PetKey")

                    if PetKey
                        and not SeenKeys[PetKey]
                        and not ProtectedBestKeys[PetKey]
                    then
                        SeenKeys[PetKey] = true

                        local Weight =
                            GetPetToolWeight(Child)

                        if Weight < Threshold then
                            table.insert(
                                Result,
                                {
                                    Tool = Child,
                                    Key = PetKey,
                                    Weight = Weight,
                                }
                            )
                        end
                    end
                end
            end
        end
    end

    table.sort(
        Result,
        function(A, B)
            if A.Weight ~= B.Weight then
                return A.Weight < B.Weight
            end

            return tostring(A.Key) < tostring(B.Key)
        end
    )

    return Result
end


local function EquipPetForSale(Pet)
    local Character =
        GetCharacter()

    local Humanoid =
        Character
        and Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not Character
        or not Humanoid
        or Humanoid.Health <= 0
        or not Pet
        or not Pet.Tool
        or not Pet.Tool.Parent
    then
        return nil
    end

    if LocalPlayer:GetAttribute("IsRiding") == true
        or LocalPlayer:GetAttribute("IsPassenger") == true
    then
        return nil
    end

    pcall(function()
        Humanoid:UnequipTools()
    end)

    task.wait(0.08)

    pcall(function()
        Humanoid:EquipTool(Pet.Tool)
    end)

    local Timeout =
        os.clock() + 1.5

    while HubRunning
        and Pet.Tool.Parent ~= Character
        and os.clock() < Timeout
    do
        task.wait()
    end

    if Pet.Tool.Parent == Character then
        return Pet.Tool
    end

    return nil
end


local function SellOneUnderWeightPet()
    if AutoSellPetBusy then
        return false, "Busy"
    end

    if not Settings.AutoSellUnderWeight then
        return false, "Disabled"
    end

    if BestPetsBusy
        or AutoFeedBestPetsBusy
    then
        return false, "Waiting for pet automation"
    end

    local Candidates =
        GetUnderWeightPetTools()

    local Pet =
        Candidates[1]

    if not Pet then
        return false, "No pets under weight"
    end

    local Richie =
        GetSellNPC()

    if not Richie then
        return false, "Richie not found"
    end

    -- Recheck immediately before equipping so a changed threshold
    -- cannot sell a pet that is no longer eligible.
    local CurrentWeight =
        GetPetToolWeight(Pet.Tool)

    if CurrentWeight >= Settings.SellWeightThreshold then
        return false, "Pet no longer under threshold"
    end

    AutoSellPetBusy = true

    local Equipped =
        EquipPetForSale(Pet)

    if not Equipped then
        AutoSellPetBusy = false
        return false, "Could not equip pet"
    end

    -- The normal dialogue option sells the currently equipped pet.
    local FireSuccess, FireError =
        pcall(function()
            DialogueSelectEvent:FireServer(
                Richie,
                "I would like to sell this"
            )
        end)

    if not FireSuccess then
        AutoSellPetBusy = false

        return false,
            "DialogueSelect failed: "
                .. tostring(FireError)
    end

    Log(
        "Auto Sell requested • "
            .. tostring(Pet.Tool.Name)
            .. " • "
            .. string.format(
                "%.2f KG",
                CurrentWeight
            )
    )

    -- Confirm this specific pet Tool disappears before moving on.
    local Sold = false
    local Timeout =
        os.clock() + 2.5

    while HubRunning
        and Settings.AutoSellUnderWeight
        and os.clock() < Timeout
    do
        if not FindPetToolByKey(Pet.Key) then
            Sold = true
            break
        end

        task.wait(0.08)
    end

    if Sold then
        Log(
            "Auto Sold pet • "
                .. tostring(Pet.Key)
                .. " • "
                .. string.format(
                    "%.2f KG",
                    CurrentWeight
                )
        )

        LastAutoSellMessage = nil
    else
        Log(
            "Auto Sell did not confirm removal • "
                .. tostring(Pet.Key)
        )

        local Character =
            LocalPlayer.Character

        local Humanoid =
            Character
            and Character:FindFirstChildOfClass(
                "Humanoid"
            )

        if Humanoid
            and LocalPlayer:GetAttribute("IsRiding") ~= true
        then
            pcall(function()
                Humanoid:UnequipTools()
            end)
        end
    end

    AutoSellPetBusy = false

    return Sold,
        Sold
            and Pet
            or "Sale was not confirmed"
end


task.spawn(function()
    while HubRunning do
        if Settings.AutoSellUnderWeight

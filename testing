local function SendAntiAFKInput()
    if not HubRunning or not Settings.AntiAFK then
        return
    end

    AntiAFKTriggers += 1

    local Camera = Workspace.CurrentCamera
    local CameraCFrame =
        Camera and Camera.CFrame
        or CFrame.new()

    local Success, ErrorMessage =
        pcall(function()
            VirtualUser:CaptureController()

            VirtualUser:Button2Down(
                Vector2.new(0, 0),
                CameraCFrame
            )

            task.wait(0.05)

            VirtualUser:Button2Up(
                Vector2.new(0, 0),
                CameraCFrame
            )
        end)

    if Success then
        Log(
            "Anti AFK triggered • "
                .. tostring(AntiAFKTriggers)
        )
    else
        warn(
            "[Shadow Garden] Anti AFK failed: "
                .. tostring(ErrorMessage)
        )
    end
end


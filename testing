local function FindHatchPrompt(Egg)
    if not Egg then
        return nil
    end

    for _, Object in ipairs(Egg:GetDescendants()) do
        if Object:IsA("ProximityPrompt")
            and Object.Name == "Hatch"
        then
            return Object
        end
    end

    return nil
end


local function FindReadyHatchEgg()
    local Folder = GetOwnPlacedEggFolder()

    if not Folder then
        return nil
    end

    for _, Egg in ipairs(Folder:GetChildren()) do
        local EggKey =
            Egg:GetAttribute("EggKey")

        if EggKey
            and not Egg:HasTag("Hatching")
        then
            local Prompt =
                FindHatchPrompt(Egg)

            -- Hatch any egg whose normal Hatch prompt is ready.
            if Prompt and Prompt.Enabled then
                return Egg, Prompt
            end
        end
    end

    return nil
end


local function HatchOneReadyEgg()
    if not Settings.AutoHatch then
        return false, "Auto Hatch is disabled."
    end

    local Egg, Prompt =
        FindReadyHatchEgg()

    if not Egg then
        return false, "No egg is ready to hatch."
    end

    local EggKey =
        Egg:GetAttribute("EggKey")

    if not EggKey then
        return false, "Selected egg has no EggKey."
    end

    Egg:AddTag("Hatching")
    Prompt.Enabled = false

    Log(
        "Hatching "
            .. tostring(Egg.Name)
            .. " | "
            .. tostring(EggKey)
    )

    local Success, ErrorMessage =
        pcall(function()
            HatchEvent:FireServer({
                EggKey = EggKey
            })
        end)

    if not Success then
        pcall(function()
            Egg:RemoveTag("Hatching")
        end)

        if Prompt.Parent then
            Prompt.Enabled = true
        end

        return false, tostring(ErrorMessage)
    end

    -- If the server does not remove/update the egg, re-arm it later.
    task.delay(4, function()
        if Egg and Egg.Parent and Egg:HasTag("Hatching") then
            pcall(function()
                Egg:RemoveTag("Hatching")
            end)

            local CurrentPrompt =
                FindHatchPrompt(Egg)

            if CurrentPrompt then
                CurrentPrompt.Enabled = true
            end
        end
    end)

    return true, Egg.Name
end



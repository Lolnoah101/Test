--// ANTI SUN DAMAGE
--// ============================================================

local function GetSunSignalFunction()
    if SunSignalFunction then
        return SunSignalFunction
    end

    if SunSignalLoadTried then
        return nil
    end

    SunSignalLoadTried = true

    local Success, Result =
        pcall(function()
            local Communication =
                ReplicatedStorage:WaitForChild(
                    "Communication"
                )

            local ServerAndClient =
                Communication:WaitForChild(
                    "ServerAndClient"
                )

            local Signals =
                ServerAndClient:WaitForChild(
                    "Signals"
                )

            local Module =
                Signals:WaitForChild(
                    "SignalFunction"
                )

            return require(Module)
        end)

    if Success
        and type(Result) == "table"
        and type(Result.ToServer) == "function"
    then
        SunSignalFunction = Result
        return SunSignalFunction
    end

    warn(
        "[Combat Hub] Anti Sun could not load SignalFunction: "
            .. tostring(Result)
    )

    return nil
end


local function SendSunDamageState(
    InSun
)
    local SignalFunction =
        GetSunSignalFunction()

    if not SignalFunction then
        return false
    end

    local Success, Result =
        pcall(
            SignalFunction.ToServer,
            "SunDamage",
            InSun == true
        )

    if not Success then
        warn(
            "[Combat Hub] Anti Sun remote failed: "
                .. tostring(Result)
        )

        return false
    end

    return Result == true
        or Result == nil
end


local function IsSunDamageLocalScript(
    Object
)
    if not Object
        or not Object:IsA("LocalScript")
        or Object.Name ~= "SunDamage"
    then
        return false
    end

    local PlayerGui =
        LocalPlayer:FindFirstChild(
            "PlayerGui"
        )

    if not PlayerGui
        or not Object:IsDescendantOf(
            PlayerGui
        )
    then
        return false
    end

    -- Prefer the exact path captured from the game:
    -- PlayerGui.UCS.Game_Play.SunDamage
    local UCS =
        PlayerGui:FindFirstChild(
            "UCS"
        )

    local GamePlay =
        UCS
        and UCS:FindFirstChild(
            "Game_Play"
        )

    if GamePlay
        and Object:IsDescendantOf(
            GamePlay
        )
    then
        return true
    end

    -- Fallback in case the UI is rebuilt under a slightly different
    -- container while keeping the SunDamage LocalScript name.
    return true
end


local function RememberAndDisableSunScript(
    Script
)
    if not IsSunDamageLocalScript(
        Script
    ) then
        return false
    end

    if AntiSunScripts[Script] == nil then
        local Original = {}

        pcall(function()
            Original.Disabled =
                Script.Disabled
        end)

        pcall(function()
            Original.Enabled =
                Script.Enabled
        end)

        AntiSunScripts[Script] =
            Original
    end

    -- Some Roblox builds expose both Enabled and Disabled on BaseScript.
    -- Set both so the game's sun checker is stopped regardless of which
    -- property the client currently honors.
    pcall(function()
        Script.Enabled = false
    end)

    pcall(function()
        Script.Disabled = true
    end)

    return true
end


local function DisableExistingSunScripts()
    local PlayerGui =
        LocalPlayer:FindFirstChild(
            "PlayerGui"
        )

    if not PlayerGui then
        return 0
    end

    local Count = 0

    for _, Object in ipairs(
        PlayerGui:GetDescendants()
    ) do
        if RememberAndDisableSunScript(
            Object
        ) then
            Count += 1
        end
    end

    return Count
end


local function RestoreSunScripts()
    for Script, Original in pairs(
        AntiSunScripts
    ) do
        if Script
            and Script.Parent
        then
            if Original.Enabled ~= nil then
                pcall(function()
                    Script.Enabled =
                        Original.Enabled
                end)
            end

            if Original.Disabled ~= nil then
                pcall(function()
                    Script.Disabled =
                        Original.Disabled
                end)
            end
        end
    end

    table.clear(
        AntiSunScripts
    )
end


local function StopAntiSunDamage()
    Settings.AntiSunDamage = false
    AntiSunLoopID += 1

    if AntiSunDescendantConnection then
        AntiSunDescendantConnection:Disconnect()
        AntiSunDescendantConnection = nil
    end

    RestoreSunScripts()
end


local function StartAntiSunDamage()
    Settings.AntiSunDamage = true
    AntiSunLoopID += 1

    local LoopID =
        AntiSunLoopID

    if AntiSunDescendantConnection then
        AntiSunDescendantConnection:Disconnect()
        AntiSunDescendantConnection = nil
    end

    DisableExistingSunScripts()

    -- Turning the LocalScript off by itself is not enough if it already
    -- told the server that the player is in sunlight. Clear that server
    -- state immediately.
    SendSunDamageState(false)

    local PlayerGui =
        LocalPlayer:FindFirstChild(
            "PlayerGui"
        )

    if PlayerGui then
        AntiSunDescendantConnection =
            PlayerGui.DescendantAdded:Connect(
                function(Object)
                    if HubRunning
                        and Settings.AntiSunDamage
                    then
                        RememberAndDisableSunScript(
                            Object
                        )
                    end
                end
            )
    end

    task.spawn(function()
        while HubRunning
            and Settings.AntiSunDamage
            and LoopID == AntiSunLoopID
        do
            -- The UI can recreate SunDamage after respawn/region changes.
            DisableExistingSunScripts()

            -- Keep the server-side state cleared in case an old copy of the
            -- checker managed to report true before it was disabled.
            SendSunDamageState(false)

            task.wait(0.50)
        end
    end)
end



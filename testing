function QuestFarmController:BuildFarmSpec(
    Name,
    Source
)
    local Config =
        FarmMobConfigs[
            Name
        ]

    if not Config then
        return nil
    end

    return {
        EnemyName =
            Config.EnemyName,

        RegionName =
            Config.RegionName,

        SearchAllRegions =
            Config.SearchAllRegions == true,

        IsBoss =
            Config.IsBoss == true,

        NpcCode =
            Config.NpcCode,

        Category =
            Config.Category,

        SelectionName =
            Name,

        Source =
            Source
            or "Auto Farm",
    }
end


function QuestFarmController:GetSelectedFarmSpecs()
    local Specs =
        {}

    local Seen =
        {}

    local Selected =
        Settings.SelectedFarmMobs

    if type(
        Selected
    ) ~= "table"
    then
        Selected = {
            Settings.SelectedFarmMob,
        }
    end

    for _,
        Name in ipairs(
            Selected
        )
    do
        if type(
            Name
        ) == "string"
            and not Seen[
                Name
            ]
            and FarmMobConfigs[
                Name
            ]
        then
            local Spec =
                self:BuildFarmSpec(
                    Name,
                    "Auto Farm"
                )

            if Spec then
                Seen[
                    Name
                ] =
                    true

                table.insert(
                    Specs,
                    Spec
                )
            end
        end
    end

    return Specs
end


function QuestFarmController:GetAllBossFarmSpecs()
    local Specs =
        {}

    for _,
        Name in ipairs(
            FarmBossNames
        )
    do
        local Spec =
            self:BuildFarmSpec(
                Name,
                "Auto Farm Boss"
            )

        if Spec then
            table.insert(
                Specs,
                Spec
            )
        end
    end

    return Specs
end


function QuestFarmController:BuildMultiFarmSpec(
    Specs,
    Source
)
    if type(
        Specs
    ) ~= "table"
        or #Specs <= 0
    then
        return nil
    end

    if #Specs == 1 then
        return Specs[
            1
        ]
    end

    local EnemyNameSet =
        {}

    local BossSpecs =
        {}

    for _,
        Spec in ipairs(
            Specs
        )
    do
        EnemyNameSet[
            Spec.EnemyName
        ] =
            true

        if Spec.IsBoss then
            table.insert(
                BossSpecs,
                Spec
            )
        end
    end

    return {
        EnemyName =
            "__MULTI_FARM__",

        MultiFarm =
            true,

        Specs =
            Specs,

        BossSpecs =
            BossSpecs,

        EnemyNameSet =
            EnemyNameSet,

        SearchAllRegions =
            true,

        Source =
            Source
            or "Auto Farm",
    }
end


function QuestFarmController:GetGeneralFarmSpec()
    if Settings.AutoFarmBoss then
        return self:BuildMultiFarmSpec(
            self:GetAllBossFarmSpecs(),
            "Auto Farm Boss"
        )
    end

    if Settings.AutoFarm then
        return self:BuildMultiFarmSpec(
            self:GetSelectedFarmSpecs(),
            "Auto Farm"
        )
    end

    return nil
end


function QuestFarmController:ObjectMatchesMultiFarm(
    Object,
    Spec
)
    if not Object
        or not Spec
        or not Spec.MultiFarm
    then
        return false
    end

    local Set =
        Spec.EnemyNameSet
        or {}

    if Set[
        Object.Name
    ]
    then
        return true
    end

    local Parent =
        Object.Parent

    return Parent ~= nil
        and Set[
            Parent.Name
        ] == true
end


function QuestFarmController:TargetMatchesFarmSpec(
    Target,
    Spec
)
    if not Target
        or not Spec
    then
        return false
    end

    if Spec.DungeonMode then
        return true
    end

    if Spec.MultiFarm then
        if Spec.EnemyNameSet
            and Spec.EnemyNameSet[
                Target.Name
            ]
        then
            return true
        end

        for _,
            BossSpec in ipairs(
                Spec.BossSpecs
                or {}
            )
        do
            local Container =
                self:GetBossContainer(
                    BossSpec
                )

            if Container
                and Target:IsDescendantOf(
                    Container
                )
            then
                return true
            end
        end

        return false
    end

    if Target.Name
        == Spec.EnemyName
    then
        return true
    end

    if Spec.IsBoss then
        local Container =
            self:GetBossContainer(
                Spec
            )

        return Container ~= nil
            and Target:IsDescendantOf(
                Container
            )
    end

    return false
end


function QuestFarmController:FindMultiFarmTarget(
    Spec
)
    if not Spec
        or not Spec.MultiFarm
    then
        return nil
    end

    local Character =
        LocalPlayer.Character

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    local RootPosition =
        Root
        and Root.Position
        or Vector3.zero

    local BestTarget =
        nil

    local BestDistance =
        math.huge

    local Seen =
        {}

    local function Consider(
        Target
    )
        if not Target
            or Seen[
                Target
            ]
            or not Target.Parent
            or not (
                Target:IsA(
                    "Model"
                )
                or Target:IsA(
                    "BasePart"
                )
            )
            or not self:IsInsideActiveNpcs(
                Target
            )
            or not self:IsAlive(
                Target
            )
        then
            return
        end

        local TargetRoot =
            self:GetStableTargetRoot(
                Target
            )

        if not TargetRoot
            or not TargetRoot.Parent
        then
            return
        end

        Seen[
            Target
        ] =
            true

        local Distance =
            (
                TargetRoot.Position
                - RootPosition
            ).Magnitude

        if Distance
            < BestDistance
        then
            BestDistance =
                Distance

            BestTarget =
                Target
        end
    end

    -- Boss-specific lookup handles BossInfo/world-boss layouts.
    for _,
        BossSpec in ipairs(
            Spec.BossSpecs
            or {}
        )
    do
        Consider(
            self:FindBossTarget(
                BossSpec
            )
        )
    end

    -- Also inspect normal ActiveNpcs naming across all regions.
    local Humanoids =
        workspace:FindFirstChild(
            "Humanoids"
        )

    local Regions =
        Humanoids
        and Humanoids:FindFirstChild(
            "Regions"
        )

    if Regions then
        local Wanted =
            Spec.EnemyNameSet
            or {}

        for _,
            Object in ipairs(
                Regions:GetDescendants()
            )
        do
            if Wanted[
                Object.Name
            ]
            then
                Consider(
                    Object
                )
            end
        end
    end

    return BestTarget
end


function QuestFarmController:GetBestMissingBossSpec(
    Spec
)
    if not Spec
        or not Spec.MultiFarm
    then
        return nil
    end

    local Character =
        LocalPlayer.Character

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    local RootPosition =
        Root
        and Root.Position
        or Vector3.zero

    local BestSpec =
        nil

    local BestTier =
        math.huge

    local BestPrimary =
        math.huge

    local BestDistance =
        math.huge

    for _,
        BossSpec in ipairs(
            Spec.BossSpecs
            or {}
        )
    do
        if not self:FindBossTarget(
            BossSpec
        )
        then
            local Center =
                self:GetBossCenter(
                    BossSpec
                )

            if typeof(
                Center
            ) == "Vector3"
            then
                local Remaining =
                    self:GetBossRespawnRemaining(
                        BossSpec
                    )

                local Tier =
                    Remaining
                    and Remaining > 0
                    and 1
                    or 0

                local Primary =
                    Tier == 1
                    and Remaining
                    or 0

                local Distance =
                    (
                        RootPosition
                        - Center
                    ).Magnitude

                if Tier < BestTier
                    or (
                        Tier == BestTier
                        and (
                            Primary < BestPrimary
                            or (
                                Primary == BestPrimary
                                and Distance
                                    < BestDistance
                            )
                        )
                    )
                then
                    BestTier =
                        Tier

                    BestPrimary =
                        Primary

                    BestDistance =
                        Distance

                    BestSpec =
                        BossSpec
                end
            end
        end
    end

    return BestSpec
end


function QuestFarmController:GetActiveFarmSpec()
    -- Raid Chest owns movement while it is positioning over a cache,
    -- clearing its temporary NPCs, opening it, or collecting its drops.
    if Settings.__RaidFarmBusy then
        return nil
    end

    -- Loot pickup owns movement first. Once no eligible loot remains,
    -- quest/general farming resumes automatically.
    if Settings.__LootFarmBusy then
        return nil
    end

    -- Auto Farm Quest has priority while the selected quest is
    -- actually active and incomplete.
    if Settings.AutoFarmQuest then
        local Config =
            QuestController:GetConfig()

        local DataQuest =
            Config
            and QuestController:FindQuestData(
                Config
            )
            or nil

        local Card =
            Config
            and not DataQuest
            and QuestController:FindQuestCard(
                Config
            )
            or nil

        local ActionableTask =
            DataQuest
            and QuestController:GetActionableQuestTask(
                DataQuest
            )
            or nil

        local DataTaskDetails =
            {}

        if DataQuest then
            local _,
                _,
                Details =
                QuestController:ReadQuestDataProgress(
                    DataQuest
                )

            DataTaskDetails =
                Details
                or {}
        end

        local HasTaskData =
            DataQuest
            and type(
                DataTaskDetails
            ) == "table"
            and #DataTaskDetails > 0

        local QuestActive =
            Config
            and Config.EnemyName
            and (
                (
                    DataQuest
                    and not QuestController:IsQuestDataComplete(
                        DataQuest
                    )
                    and (
                        not HasTaskData
                        or ActionableTask ~= nil
                    )
                )
                or (
                    not DataQuest
                    and Card
                    and not QuestController:IsComplete(
                        Card,
                        Config
                    )
                )
            )

        if QuestActive then
            local EnemyName =
                Config.EnemyName

            -- Future multi-stage quests can map a replicated task name to a
            -- different enemy without rewriting the farm controller.
            if ActionableTask
                and type(
                    Config.TaskTargets
                ) == "table"
                and Config.TaskTargets[
                    ActionableTask.Name
                ]
            then
                EnemyName =
                    Config.TaskTargets[
                        ActionableTask.Name
                    ]
            end

            return {
                EnemyName = EnemyName,
                RegionName = Config.RegionName
                    or "Windy Peak",
                Source = "Quest",
                QuestTask = ActionableTask
                    and ActionableTask.Name
                    or nil,
            }
        end
    end

    -- Dungeon farm has priority over the ordinary mob dropdown.
    -- Dungeon NPC names can change between rooms/waves, so this mode
    -- intentionally farms ANY live NPC under Temporary.ActiveNpcs.
    if Settings.AutoFarmDungeon then
        return {
            EnemyName = "__DUNGEON__",
            RegionName = "Temporary",
            DungeonMode = true,
            Source = "Dungeon",
        }
    end

    -- If no quest/dungeon farm currently owns movement, use either
    -- the independent all-boss mode or the ordinary multi-selected list.
    local GeneralSpec =
        self:GetGeneralFarmSpec()

    if GeneralSpec then
        return GeneralSpec
    end

    return nil
end


function QuestFarmController:GetWorldBossesModule()
    if self.WorldBossesLoadTried then
        return self.WorldBossesModule
    end

    self.WorldBossesLoadTried =
        true

    pcall(function()
        self.WorldBossesModule =
            require(
                ReplicatedStorage
                    :WaitForChild("CAM")
                    :WaitForChild("Client")
                    :WaitForChild("Modules")
                    :WaitForChild("WorldBosses")
            )
    end)

    return self.WorldBossesModule
end


function QuestFarmController:NormalizeBossName(
    Value
)
    local Text =
        string.lower(
            tostring(
                Value
                or ""
            )
        )

    return string.gsub(
        Text,
        "[^%w]",
        ""
    )
end


function QuestFarmController:GetBossWorldEntry(
    Spec
)
    if not Spec
        or not Spec.IsBoss
    then
        return nil
    end

    local Module =
        self:GetWorldBossesModule()

    if type(Module) ~= "table"
        or type(Module.Get) ~= "function"
    then
        return nil
    end

    local Success,
        Entries =
        pcall(
            Module.Get
        )

    if not Success
        or type(Entries) ~= "table"
    then
        return nil
    end

    local WantedName =
        self:NormalizeBossName(
            Spec.EnemyName
        )

    local WantedCode =
        self:NormalizeBossName(
            Spec.NpcCode
            or Spec.EnemyName
        )

    for _,
        Entry in ipairs(
            Entries
        )
    do
        local EntryName =
            self:NormalizeBossName(
                Entry.Name
            )

        local EntryCode =
            self:NormalizeBossName(
                Entry.Code
            )

        if EntryName == WantedName
            or EntryCode == WantedName
            or EntryCode == WantedCode
        then
            return Entry
        end
    end

    return nil
end


function QuestFarmController:GetBossContainer(
    Spec
)
    if not Spec
        or not Spec.IsBoss
    then
        return nil
    end

    local Wanted =
        self:NormalizeBossName(
            Spec.EnemyName
        )

    -- BossUI watches CollectionService's BossTag. Prefer the same source
    -- because BossInfo may exist even while the actual boss model is absent.
    for _,
        Tagged in ipairs(
            CollectionService:GetTagged(
                "BossTag"
            )
        )
    do
        if Tagged:IsDescendantOf(
            workspace
        ) then
            local Parent =
                Tagged.Parent

            local ParentName =
                Parent
                and self:NormalizeBossName(
                    Parent.Name
                )
                or ""

            local NpcCode =
                self:NormalizeBossName(
                    Tagged:GetAttribute(
                        "NpcCode"
                    )
                )

            if Parent
                and (
                    ParentName == Wanted
                    or NpcCode == Wanted
                )
            then
                return Parent
            end
        end
    end

    local Humanoids =
        workspace:FindFirstChild(
            "Humanoids"
        )

    local Regions =
        Humanoids
        and Humanoids:FindFirstChild(
            "Regions"
        )

    if not Regions then
        return nil
    end

    local function FindInRegion(
        Region
    )
        if not Region then
            return nil
        end

        local ActiveNpcs =
            Region:FindFirstChild(
                "ActiveNpcs"
            )

        if not ActiveNpcs then
            return nil
        end

        local Direct =
            ActiveNpcs:FindFirstChild(
                Spec.EnemyName
            )

        if Direct then
            return Direct
        end

        for _,
            Candidate in ipairs(
                ActiveNpcs:GetChildren()
            )
        do
            if self:NormalizeBossName(
                Candidate.Name
            ) == Wanted
            then
                return Candidate
            end

            local BossInfo =
                Candidate:FindFirstChild(
                    "BossInfo"
                )

            if BossInfo
                and self:NormalizeBossName(
                    BossInfo:GetAttribute(
                        "NpcCode"
                    )
                ) == Wanted
            then
                return Candidate
            end
        end

        return nil
    end

    if Spec.RegionName then
        local Found =
            FindInRegion(
                Regions:FindFirstChild(
                    Spec.RegionName
                )
            )

        if Found then
            return Found
        end
    end

    if Spec.SearchAllRegions then
        for _,
            Region in ipairs(
                Regions:GetChildren()
            )
        do
            local Found =
                FindInRegion(
                    Region
                )

            if Found then
                return Found
            end
        end
    end

    return nil
end


function QuestFarmController:GetBossInfo(
    Spec
)
    local Container =
        self:GetBossContainer(
            Spec
        )

    if not Container then
        return nil,
            nil
    end

    local BossInfo =
        Container:FindFirstChild(
            "BossInfo"
        )
        or Container:FindFirstChild(
            "BossInfo",
            true
        )

    return BossInfo,
        Container
end


function QuestFarmController:FindBossTarget(
    Spec
)
    local BossInfo,
        Container =
        self:GetBossInfo(
            Spec
        )

    if not Container then
        return nil
    end

    -- Permanent/event bosses often use BossName.BossName.
    local Named =
        Container:FindFirstChild(
            Spec.EnemyName
        )

    if Named
        and Named:IsA(
            "Model"
        )
        and self:IsAlive(
            Named
        )
        and self:GetStableTargetRoot(
            Named
        )
    then
        return Named
    end

    -- Some layouts put the humanoid model directly on the boss container.
    if Container:IsA(
        "Model"
    )
        and self:IsAlive(
            Container
        )
        and self:GetStableTargetRoot(
            Container
        )
    then
        return Container
    end

    -- World bosses use BossInfo beside a model that only exists while spawned.
    for _,
        Child in ipairs(
            Container:GetChildren()
        )
    do
        if Child:IsA(
            "Model"
        )
            and Child ~= BossInfo
            and self:IsAlive(
                Child
            )
            and self:GetStableTargetRoot(
                Child
            )
        then
            return Child
        end
    end

    return nil
end


function QuestFarmController:GetBossCenter(
    Spec
)
    if not Spec
        or not Spec.IsBoss
    then
        return nil
    end

    local BossInfo =
        self:GetBossInfo(
            Spec
        )

    if BossInfo then
        local Center =
            BossInfo:GetAttribute(
                "Center"
            )

        if typeof(Center)
            == "Vector3"
        then
            return Center
        end

        if typeof(Center)
            == "CFrame"
        then
            return Center.Position
        end
    end

    -- Replicated WorldBosses data gives the boss area even when its model
    -- is not currently spawned or the workspace region is still streamed out.
    local Entry =
        self:GetBossWorldEntry(
            Spec
        )

    if Entry then
        local Position =
            Entry.Position

        if typeof(Position)
            == "Vector3"
        then
            return Position
        end

        if typeof(Position)
            == "CFrame"
        then
            return Position.Position
        end
    end

    local Target =
        self:FindBossTarget(
            Spec
        )

    local Root =
        Target
        and self:GetStableTargetRoot(
            Target
        )

    return Root
        and Root.Position
        or nil
end


function QuestFarmController:GetBossRespawnRemaining(
    Spec
)
    local BossInfo,
        Container =
        self:GetBossInfo(
            Spec
        )

    if not BossInfo
        or not Container
        or BossInfo:GetAttribute(
            "SpawnCountdown"
        ) ~= true
    then
        return nil
    end

    local DespawnedAt =
        Container:GetAttribute(
            "DespawnedAt"
        )

    local SpawnTime =
        tonumber(
            BossInfo:GetAttribute(
                "SpawnTime"
            )
        )

    if typeof(DespawnedAt)
        ~= "number"
        or not SpawnTime
    then
        return nil
    end

    return math.max(
        0,
        SpawnTime
            - (
                workspace:GetServerTimeNow()
                - DespawnedAt
            )
    )
end


function QuestFarmController:RequestBossStreaming(
    Position
)
    if typeof(Position)
        ~= "Vector3"
        or self.BossStreamBusy
    then
        return
    end

    self.BossStreamBusy =
        true

    task.spawn(function()
        pcall(function()
            LocalPlayer:RequestStreamAroundAsync(
                Position,
                4
            )
        end)

        self.BossStreamBusy =
            false
    end)
end


function QuestFarmController:HandleMissingBoss(
    Spec
)
    if not Spec
        or not Spec.IsBoss
        or not (
            Settings.AutoFarm
            or Settings.AutoFarmBoss
        )
    then
        return false
    end

    local Center =
        self:GetBossCenter(
            Spec
        )

    if typeof(Center)
        ~= "Vector3"
    then
        return false
    end

    self:RequestBossStreaming(
        Center
    )

    local Character =
        LocalPlayer.Character

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Character
        or not Root
    then
        return false
    end

    local Distance =
        (
            Root.Position
            - Center
        ).Magnitude

    local Now =
        os.clock()

    -- Same idea as quest NPC preloading: when the selected boss is streamed
    -- out, move to its known area once, request streaming, then wait there.
    if Distance
        > self.BossArrivalDistance
        and (
            self.LastBossTravelName
                ~= Spec.EnemyName
            or Now
                - self.LastBossTravelAt
                >= self.BossTravelCooldown
        )
    then
        self.LastBossTravelName =
            Spec.EnemyName

        self.LastBossTravelAt =
            Now

        self:StopHeartbeatLock(
            "Farm"
        )

        self:EnableFarmNoclip(
            Character
        )

        local Destination =
            CFrame.new(
                Center
                + Vector3.new(
                    0,
                    8,
                    0
                )
            )

        pcall(function()
            Character:PivotTo(
                Destination
            )

            Root.CFrame =
                Destination

            Root.AssemblyLinearVelocity =
                Vector3.zero

            Root.AssemblyAngularVelocity =
                Vector3.zero
        end)

        self:RequestBossStreaming(
            Center
        )

        HubDebug(
            "[Combat Hub] Boss preload: "
                .. tostring(
                    Spec.EnemyName
                )
                .. " | moved to boss area"
        )

        return true
    end

    if Now
        - self.LastBossStatusAt
        >= self.BossStatusInterval
    then
        self.LastBossStatusAt =
            Now

        local Remaining =
            self:GetBossRespawnRemaining(
                Spec
            )

        if Remaining
            and Remaining > 0
        then
            local Seconds =
                math.ceil(
                    Remaining
                )

            HubDebug(
                "[Combat Hub] "
                    .. tostring(
                        Spec.EnemyName
                    )
                    .. " respawns in ~"
                    .. tostring(
                        math.floor(
                            Seconds / 60
                        )
                    )
                    .. "m "
                    .. tostring(
                        Seconds % 60
                    )
                    .. "s"
            )
        else
            HubDebug(
                "[Combat Hub] Waiting for "
                    .. tostring(
                        Spec.EnemyName
                    )
                    .. " to spawn..."
            )
        end
    end

    return true
end


function QuestFarmController:GetActiveNpcsFolder()
    local Spec =
        self:GetActiveFarmSpec()

    local Humanoids =
        workspace:FindFirstChild(
            "Humanoids"
        )

    local Regions =
        Humanoids
        and Humanoids:FindFirstChild(
            "Regions"
        )

    if not Regions then
        return nil
    end

    -- Dungeon mobs all replicate under the shared Temporary region.
    if Spec
        and Spec.DungeonMode
    then
        local Temporary =
            Regions:FindFirstChild(
                "Temporary"
            )

        return Temporary
            and Temporary:FindFirstChild(
                "ActiveNpcs"
            )
            or nil
    end

    -- Hoyuzo / Kaiden event mobs may not always belong to Bamboo Grove.
    -- For those selections, watch/search every region and filter targets
    -- so only descendants of an ActiveNpcs folder are accepted.
    if Spec
        and Spec.SearchAllRegions
    then
        return Regions
    end

    local RegionName =
        Spec
        and Spec.RegionName
        or "Windy Peak"

    local Region =
        Regions:FindFirstChild(
            RegionName
        )

    return Region
        and Region:FindFirstChild(
            "ActiveNpcs"
        )
end


function QuestFarmController:IsInsideActiveNpcs(
    Object
)
    local Current =
        Object

    while Current
        and Current ~= workspace
    do
        if Current.Name
            == "ActiveNpcs"
        then
            return true
        end

        Current =
            Current.Parent
    end

    return false
end


function QuestFarmController:DisconnectSpawnWatcher()
    if self.SpawnConnection then
        self.SpawnConnection:Disconnect()
        self.SpawnConnection = nil
    end

    self.WatchedFolder = nil
end


function QuestFarmController:EnsureSpawnWatcher()
    local Folder =
        self:GetActiveNpcsFolder()

    if Folder == self.WatchedFolder
        and self.SpawnConnection
    then
        return
    end

    self:DisconnectSpawnWatcher()

    if not Folder then
        return
    end

    self.WatchedFolder =
        Folder

    self.SpawnConnection =
        Folder.DescendantAdded:Connect(
            function(Object)
                if not HubRunning
                    or not (
                        Settings.AutoFarmQuest
                        or Settings.AutoFarmDungeon
                        or Settings.AutoFarm
                        or Settings.AutoFarmBoss
                    )
                then
                    return
                end

                local Spec =
                    self:GetActiveFarmSpec()

                if not Spec
                    or not Spec.EnemyName
                then
                    return
                end

                -- Bear Cub replicates as:
                -- ActiveNpcs["Bear Cub"]["Bear Cub"]
                -- so one spawn can fire multiple matching DescendantAdded
                -- events. Do NOT throw away a live target every time another
                -- bear/container appears; that was causing rapid retargeting
                -- and visible tween jitter.
                local BossContainer =
                    Spec.IsBoss
                    and self:GetBossContainer(
                        Spec
                    )
                    or nil

                local DungeonGroup =
                    Spec.DungeonMode
                    and self:GetDungeonGroupObject(
                        Object,
                        Folder
                    )
                    or nil

                local DungeonObjectAllowed =
                    DungeonGroup
                    and self:IsDungeonGroupAllowed(
                        DungeonGroup
                    )
                    or false

                local MatchesSelection =
                    self:IsInsideActiveNpcs(
                        Object
                    )
                    and (
                        (
                            Spec.DungeonMode
                            and DungeonObjectAllowed
                            and (
                                Object:IsA(
                                    "Model"
                                )
                                or Object:IsA(
                                    "Humanoid"
                                )
                                or Object.Name
                                    == "HumanoidRootPart"
                            )
                        )
                        or (
                            Spec.MultiFarm
                            and self:ObjectMatchesMultiFarm(
                                Object,
                                Spec
                            )
                        )
                        or Object.Name
                            == Spec.EnemyName
                        or (
                            Object.Parent
                            and Object.Parent.Name
                                == Spec.EnemyName
                        )
                        or (
                            BossContainer
                            and Object:IsDescendantOf(
                                BossContainer
                            )
                            and (
                                Object:IsA(
                                    "Model"
                                )
                                or Object:IsA(
                                    "Humanoid"
                                )
                                or Object.Name
                                    == "HumanoidRootPart"
                            )
                        )
                    )

                if MatchesSelection then
                    if Spec.DungeonMode
                        and DungeonObjectAllowed
                        and (
                            Object:IsA(
                                "Humanoid"
                            )
                            or Object.Name
                                == "HumanoidRootPart"
                        )
                    then
                        self:ClearDungeonPending()
                    end

                    local Current =
                        self.CurrentTarget

                    local CurrentStillValid =
                        Current
                        and Current.Parent
                        and self:IsAlive(
                            Current
                        )
                        and self:GetStableTargetRoot(
                            Current
                        ) ~= nil

                    if not CurrentStillValid then
                        self.CurrentTarget =
                            nil

                        self.LastForcedTargetRefresh =
                            0
                    end
                end
            end
        )
end


function QuestFarmController:GetEnemyObject(
    Container,
    EnemyName
)
    if not Container then
        return nil
    end

    -- Known structures:
    -- Windy Peak:
    --   ActiveNpcs.Bandit.Bandit
    --   ActiveNpcs.Zuko.Zuko
    --
    -- Bamboo Grove:
    --   ActiveNpcs["Bear Cub"]["Bear Cub"]
    --   ActiveNpcs["Mother Bear"]["Mother Bear"]
    --   ActiveNpcs["Hoyuzo Subordinate"]["Hoyuzo Subordinate"]
    --   ActiveNpcs["Kaiden Subordinate"]["Kaiden Subordinate"]
    --   ActiveNpcs.Hoyuzo.Hoyuzo
    --   ActiveNpcs.Kaiden.Kaiden
    --
    -- Hoyuzo / Kaiden event mobs are searched across ALL regions,
    -- so this still works if that event spawns outside Bamboo Grove.
    --
    -- The outer named object can be a container/folder and the inner
    -- object with the same name is the actual NPC model.
    local NamedChild =
        Container:FindFirstChild(
            EnemyName
        )

    if NamedChild
        and (
            NamedChild:IsA("Model")
            or NamedChild:IsA("BasePart")
        )
    then
        return NamedChild
    end

    if Container.Name == EnemyName then
        -- If the container itself is the NPC, use it.
        if Container:IsA("Model")
            or Container:IsA("BasePart")
        then
            return Container
        end

        -- Otherwise this is a folder/container such as
        -- ActiveNpcs["Bear Cub"], so look inside for the actual NPC.
        local InnerEnemy =
            Container:FindFirstChild(
                EnemyName
            )

        if InnerEnemy
            and (
                InnerEnemy:IsA("Model")
                or InnerEnemy:IsA("BasePart")
            )
        then
            return InnerEnemy
        end
    end

    for _, Object in ipairs(
        Container:GetDescendants()
    ) do
        if Object.Name == EnemyName
            and (
                Object:IsA("Model")
                or Object:IsA("BasePart")
            )
        then
            return Object
        end
    end

    return nil
end


function QuestFarmController:GetTargetPosition(
    Object
)
    if not Object
        or not Object.Parent
    then
        return nil
    end

    if Object:IsA(
        "BasePart"
    ) then
        return Object.Position
    end

    if Object:IsA(
        "Model"
    ) then
        return Object:GetPivot().Position
    end

    local Part =
        Object:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    return Part
        and Part.Position
        or nil
end


function QuestFarmController:GetTargetCFrame(
    Object
)
    if not Object
        or not Object.Parent
    then
        return nil
    end

    -- Always track the same stable body/root that Above mode uses.
    -- Bear Cub's model pivot can move around more during animations,
    -- which makes Behind/Below and the initial tween look shaky.
    local StableRoot =
        self:GetStableTargetRoot(
            Object
        )

    if StableRoot
        and StableRoot.Parent
    then
        return StableRoot.CFrame
    end

    if Object:IsA(
        "BasePart"
    ) then
        return Object.CFrame
    end

    if Object:IsA(
        "Model"
    ) then
        return Object:GetPivot()
    end

    local Part =
        Object:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    return Part
        and Part.CFrame
        or nil
end


function QuestFarmController:IsAlive(
    Object
)
    if not Object
        or not Object.Parent
    then
        return false
    end

    local Humanoid =
        Object:FindFirstChildWhichIsA(
            "Humanoid",
            true
        )

    if Humanoid then
        return Humanoid.Health > 0
    end

    local Dead =
        Object:GetAttribute(
            "Dead"
        )

    if Dead == true then
        return false
    end

    local Health =
        tonumber(
            Object:GetAttribute(
                "Health"
            )
            or Object:GetAttribute(
                "HP"
            )
        )

    if Health ~= nil
        and Health <= 0
    then
        return false
    end

    return true
end


function QuestFarmController:IsDungeonUiActive()
    local PlayerGui =
        LocalPlayer:FindFirstChild(
            "PlayerGui"
        )

    local ComponentsHolder =
        PlayerGui
        and PlayerGui:FindFirstChild(
            "ComponentsHolder"
        )

    local MainNotificationFrame =
        ComponentsHolder
        and ComponentsHolder:FindFirstChild(
            "MainNotificationFrame"
        )

    local TopBar =
        MainNotificationFrame
        and MainNotificationFrame:FindFirstChild(
            "OuwigaharaTopBar"
        )

    if not TopBar then
        return false
    end

    local Current =
        TopBar

    while Current
        and Current ~= game
    do
        if Current:IsA(
            "GuiObject"
        )
            and not Current.Visible
        then
            return false
        end

        if Current:IsA(
            "LayerCollector"
        )
            and not Current.Enabled
        then
            return false
        end

        Current =
            Current.Parent
    end

    return true
end


function QuestFarmController:NormalizeDungeonGroupName(
    Value
)
    return string.lower(
        tostring(
            Value
            or ""
        )
    )
end


function QuestFarmController:GetDungeonGroupObject(
    Object,
    Folder
)
    if not Object
        or not Folder
    then
        return nil
    end

    local Current =
        Object

    while Current
        and Current.Parent
        and Current ~= Folder
    do
        if Current.Parent
            == Folder
        then
            return Current
        end

        Current =
            Current.Parent
    end

    return nil
end


function QuestFarmController:IsDungeonGroupAllowed(
    Group
)
    if not Group
        or not Group.Parent
    then
        return false
    end

    -- Ouwigahara reuses many NPC types that also exist in raids/world content,
    -- including Cache Lancer, Grove Raider, Reaper, and bosses.
    -- Do not filter dungeon waves by NPC name or boss metadata.
    --
    -- Safety comes from:
    --   1) the Ouwigahara UI being active
    --   2) the distance leash in FindDungeonTarget()
    if not self:IsDungeonUiActive() then
        return false
    end

    return true
end


function QuestFarmController:GetDungeonGroupFolders(
    Folder
)
    local Groups =
        {}

    if not Folder then
        return Groups
    end

    for _,
        Child in ipairs(
            Folder:GetChildren()
        )
    do
        -- The game currently creates containers such as:
        -- ActiveNpcs["Beast Born Demon"]
        -- ActiveNpcs["High Demon"]
        -- ActiveNpcs["Lesser Demon"]
        -- ActiveNpcs.Mizunoto
        --
        -- The actual NPC model with the same name may arrive later.
        if (
            Child:IsA(
                "Folder"
            )
            or Child:IsA(
                "Model"
            )
        )
            and self:IsDungeonGroupAllowed(
                Child
            )
        then
            table.insert(
                Groups,
                Child
            )
        end
    end

    table.sort(
        Groups,
        function(A, B)
            return A.Name
                < B.Name
        end
    )

    return Groups
end


function QuestFarmController:GetDungeonPendingSignature(
    Groups
)
    if type(
        Groups
    ) ~= "table"
        or #Groups == 0
    then
        return nil
    end

    local Names =
        {}

    for _,
        Group in ipairs(
            Groups
        )
    do
        table.insert(
            Names,
            tostring(
                Group.Name
            )
        )
    end

    return table.concat(
        Names,
        " | "
    )
end


function QuestFarmController:RequestDungeonStreaming()
    if self.DungeonStreamRequestBusy then
        return
    end

    local Now =
        os.clock()

    if Now
        - self.DungeonLastStreamRequestAt
        < self.DungeonStreamRequestInterval
    then
        return
    end

    local Character =
        LocalPlayer.Character

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Root then
        return
    end

    self.DungeonLastStreamRequestAt =
        Now

    self.DungeonStreamRequestBusy =
        true

    local Position =
        Root.Position

    task.spawn(function()
        pcall(function()
            workspace:RequestStreamAroundAsync(
                Position
            )
        end)

        self.DungeonStreamRequestBusy =
            false
    end)
end


function QuestFarmController:SetDungeonPending(
    Groups
)
    local Signature =
        self:GetDungeonPendingSignature(
            Groups
        )

    if not Signature then
        self.DungeonPendingSignature =
            nil

        self.DungeonPendingSince =
            0

        return
    end

    local Now =
        os.clock()

    if Signature
        ~= self.DungeonPendingSignature
    then
        self.DungeonPendingSignature =
            Signature

        self.DungeonPendingSince =
            Now

        self.DungeonLastStatusAt =
            0

        HubDebug(
            "[Combat Hub] Dungeon room loading: "
                .. Signature
                .. " | waiting for live Humanoids/models"
        )
    elseif Now
        - self.DungeonLastStatusAt
        >= 5
    then
        self.DungeonLastStatusAt =
            Now

        HubDebug(
            "[Combat Hub] Dungeon still loading NPC models: "
                .. Signature
                .. " | "
                .. tostring(
                    math.floor(
                        Now
                        - self.DungeonPendingSince
                    )
                )
                .. "s"
        )
    end

    self:RequestDungeonStreaming()
end


function QuestFarmController:ClearDungeonPending()
    self.DungeonPendingSignature =
        nil

    self.DungeonPendingSince =
        0

    self.DungeonLastStatusAt =
        0

    self.DungeonLastStreamRequestAt =
        0
end


function QuestFarmController:GetDungeonGroupName(
    Object,
    Folder
)
    if not Object
        or not Folder
    then
        return nil
    end

    local Current =
        Object

    local Last =
        nil

    while Current
        and Current.Parent
        and Current ~= Folder
    do
        Last =
            Current

        if Current.Parent
            == Folder
        then
            return Current.Name
        end

        Current =
            Current.Parent
    end

    return Last
        and Last.Name
        or nil
end


function QuestFarmController:FindDungeonTarget()
    local Folder =
        self:GetActiveNpcsFolder()

    if not Folder then
        return nil
    end

    -- Outside Ouwigahara, Temporary.ActiveNpcs contains many unrelated
    -- world-event / raid / boss NPCs. Dungeon mode should simply wait.
    if not self:IsDungeonUiActive() then
        self:ClearDungeonPending()

        self.LastDungeonGroupName =
            nil

        return nil
    end

    local Character =
        LocalPlayer.Character

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Root then
        return nil
    end

    local RootPosition =
        Root.Position

    local BestTarget =
        nil

    local BestDistance =
        math.huge

    local BestGroup =
        nil

    local SeenModels =
        {}

    local function ConsiderHumanoid(
        Humanoid
    )
        if not Humanoid
            or not Humanoid:IsA(
                "Humanoid"
            )
            or Humanoid.Health <= 0
            or not Humanoid:IsDescendantOf(
                Folder
            )
        then
            return
        end

        local Model =
            Humanoid.Parent

        if not Model
            or not Model:IsA(
                "Model"
            )
            or Model == Character
            or SeenModels[
                Model
            ]
        then
            return
        end

        SeenModels[
            Model
        ] =
            true

        local Group =
            self:GetDungeonGroupObject(
                Model,
                Folder
            )

        if not Group
            or not self:IsDungeonGroupAllowed(
                Group
            )
        then
            return
        end

        local TargetRoot =
            self:GetStableTargetRoot(
                Model
            )

        if not TargetRoot
            or not TargetRoot.Parent
        then
            return
        end

        local IsMob =
            Model:GetAttribute(
                "IsMob"
            )

        if IsMob == false then
            return
        end

        local Distance =
            (
                TargetRoot.Position
                - RootPosition
            ).Magnitude

        -- This is the key anti-warp rule. If a temporary NPC is hundreds or
        -- thousands of studs away on another streamed map, ignore it instead
        -- of teleporting there and unloading the actual dungeon.
        if Distance
            > self.DungeonMaxTargetDistance
        then
            return
        end

        if Distance
            < BestDistance
        then
            BestDistance =
                Distance

            BestTarget =
                Model

            BestGroup =
                Group.Name
        end
    end

    for _,
        Object in ipairs(
            Folder:GetDescendants()
        )
    do
        if Object:IsA(
            "Humanoid"
        ) then
            ConsiderHumanoid(
                Object
            )
        end
    end

    if BestTarget then
        self:ClearDungeonPending()

        if BestGroup
            ~= self.LastDungeonGroupName
        then
            self.LastDungeonGroupName =
                BestGroup

            HubDebug(
                "[Combat Hub] Dungeon group: "
                    .. tostring(
                        BestGroup
                    )
                    .. " | target: "
                    .. tostring(
                        BestTarget.Name
                    )
                    .. " | distance: "
                    .. tostring(
                        math.floor(
                            BestDistance
                        )
                    )
                    .. " | hp: "
                    .. tostring(
                        math.floor(
                            (
                                BestTarget:FindFirstChildOfClass(
                                    "Humanoid"
                                )
                                and BestTarget:FindFirstChildOfClass(
                                    "Humanoid"
                                ).Health
                            )
                            or 0
                        )
                    )
            )
        end

        return BestTarget
    end

    -- A dungeon group can replicate before its inner model:
    --
    -- ActiveNpcs["Beast Born Demon"]
    --     ...later...
    -- ActiveNpcs["Beast Born Demon"]["Beast Born Demon"]
    --
    -- Stay exactly on the map where the dungeon placed the player and keep
    -- requesting streaming THERE. Never use another Temporary NPC as a
    -- substitute destination.
    local Groups =
        self:GetDungeonGroupFolders(
            Folder
        )

    if #Groups > 0 then
        self:SetDungeonPending(
            Groups
        )
    else
        self:ClearDungeonPending()

        self.LastDungeonGroupName =
            nil
    end

    return nil
end


function QuestFarmController:FindTarget(
    EnemyName
)
    local Spec =
        self:GetActiveFarmSpec()

    if Spec
        and Spec.DungeonMode
    then
        return self:FindDungeonTarget()
    end

    if Spec
        and Spec.MultiFarm
    then
        return self:FindMultiFarmTarget(
            Spec
        )
    end

    if Spec
        and Spec.IsBoss
        and Spec.EnemyName == EnemyName
    then
        local BossTarget =
            self:FindBossTarget(
                Spec
            )

        if BossTarget then
            return BossTarget
        end
    end

    local Folder =
        self:GetActiveNpcsFolder()

    if not Folder then
        return nil
    end

    local Character =
        LocalPlayer.Character

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    local RootPosition =
        Root
        and Root.Position
        or Vector3.zero

    local BestTarget = nil
    local BestDistance = math.huge
    local Seen = {}

    local function Consider(
        Enemy
    )
        if not Enemy
            or Seen[Enemy]
            or Enemy.Name ~= EnemyName
            or not (
                Enemy:IsA("Model")
                or Enemy:IsA("BasePart")
            )
            or not Enemy:IsDescendantOf(
                Folder
            )
            or not self:IsInsideActiveNpcs(
                Enemy
            )
        then
            return
        end

        Seen[Enemy] = true

        if not self:IsAlive(
            Enemy
        ) then
            return
        end

        local TargetRoot =
            self:GetStableTargetRoot(
                Enemy
            )

        if not TargetRoot
            or not TargetRoot.Parent
        then
            return
        end

        local Position =
            TargetRoot.Position

        local Distance =
            (
                Position
                - RootPosition
            ).Magnitude

        if Distance
            < BestDistance
        then
            BestDistance =
                Distance

            BestTarget =
                Enemy
        end
    end

    -- Keep the known container layout fast.
    for _, Container in ipairs(
        Folder:GetChildren()
    ) do
        if Container.Name == EnemyName then
            Consider(
                self:GetEnemyObject(
                    Container,
                    EnemyName
                )
            )
        end
    end

    -- Fallback: NPC replication/order can change, so also search every
    -- descendant for a matching model/part.
    for _, Object in ipairs(
        Folder:GetDescendants()
    ) do
        Consider(
            Object
        )
    end

    return BestTarget
end


function QuestFarmController:GetCurrentTarget(
    EnemyName
)
    local Folder =
        self:GetActiveNpcsFolder()

    local Spec =
        self:GetActiveFarmSpec()

    local Target =
        self.CurrentTarget

    local BossContainer =
        Spec
        and Spec.IsBoss
        and self:GetBossContainer(
            Spec
        )
        or nil

    local NameMatches =
        Target
        and Spec
        and self:TargetMatchesFarmSpec(
            Target,
            Spec
        )

    local TargetValid =
        Folder
        and Target
        and Target.Parent
        and NameMatches
        and Target:IsDescendantOf(
            Folder
        )
        and self:IsInsideActiveNpcs(
            Target
        )
        and self:IsAlive(
            Target
        )
        and self:GetStableTargetRoot(
            Target
        ) ~= nil

    -- Smooth/sticky target behavior:
    -- stay on the current NPC until it actually dies/despawns.
    -- This is especially important for Bear Cub because several bears
    -- can be close together and "nearest" can flip back and forth while
    -- they move, making the player/tween constantly change direction.
    if TargetValid then
        return Target
    end

    local FreshTarget =
        self:FindTarget(
            EnemyName
        )

    self.LastForcedTargetRefresh =
        os.clock()

    if FreshTarget then
        self.CurrentTarget =
            FreshTarget

        return FreshTarget
    end

    self.CurrentTarget =
        nil

    return nil
end


function QuestFarmController:IsTargetBossForSpec(
    Target,
    Spec
)
    if not Target
        or not Spec
    then
        return false
    end

    if Spec.DungeonMode then
        return false
    end

    if Spec.IsBoss then
        return true
    end

    if Spec.MultiFarm then
        for _,
            BossSpec in ipairs(
                Spec.BossSpecs
                or {}
            )
        do
            if Target.Name
                == BossSpec.EnemyName
            then
                return true
            end

            local Container =
                self:GetBossContainer(
                    BossSpec
                )

            if Container
                and Target:IsDescendantOf(
                    Container
                )
            then
                return true
            end
        end
    end

    return false
end


function QuestFarmController:TrackCombatTarget(
    Target,
    Spec
)
    if not Target
        or not Target.Parent
    then
        return
    end

    local Root =
        self:GetStableTargetRoot(
            Target
        )

    local Humanoid =
        Target:FindFirstChildWhichIsA(
            "Humanoid",
            true
        )

    self.LastCombatTarget =
        Target

    self.LastCombatTargetName =
        Target.Name

    self.LastCombatTargetWasBoss =
        self:IsTargetBossForSpec(
            Target,
            Spec
        )

    if Root then
        self.LastCombatTargetPosition =
            Root.Position
    end

    if Humanoid then
        self.LastCombatTargetHealth =
            Humanoid.Health
    end
end


function QuestFarmController:ClearTrackedCombatTarget()
    self.LastCombatTarget =
        nil

    self.LastCombatTargetName =
        nil

    self.LastCombatTargetWasBoss =
        false

    self.LastCombatTargetPosition =
        nil

    self.LastCombatTargetHealth =
        nil
end


function QuestFarmController:GetGenericChestPrompt(
    Chest
)
    if not Chest
        or not Chest.Parent
    then
        return nil
    end

    local RootPart =
        Chest:FindFirstChild(
            "RootPart"
        )
        or Chest:FindFirstChild(
            "RootPart",
            true
        )

    local Anchor =
        RootPart
        and RootPart:FindFirstChild(
            "ChestPromptAnchor"
        )

    local Prompt =
        Anchor
        and Anchor:FindFirstChild(
            "ChestPrompt"
        )

    if Prompt
        and Prompt:IsA(
            "ProximityPrompt"
        )
    then
        return Prompt
    end

    Prompt =
        Chest:FindFirstChild(
            "ChestPrompt",
            true
        )

    return Prompt
        and Prompt:IsA(
            "ProximityPrompt"
        )
        and Prompt
        or nil
end


function QuestFarmController:GetGenericChestCFrame(
    Chest
)
    if not Chest
        or not Chest.Parent
    then
        return nil
    end

    local Root =
        Chest:FindFirstChild(
            "RootPart"
        )
        or Chest.PrimaryPart
        or Chest:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    if Root
        and Root:IsA(
            "BasePart"
        )
    then
        return Root.CFrame
    end

    if Chest:IsA(
        "Model"
    )
    then
        return Chest:GetPivot()
    end

    return nil
end


function QuestFarmController:IsChestOpened(
    Chest,
    Prompt
)
    if not Chest
        or not Chest.Parent
    then
        return true
    end

    -- ChestController applies IsOpen when it has an Opened ChestState.
    if Chest:GetAttribute(
        "IsOpen"
    ) == true
    then
        return true
    end

    local State =
        string.lower(
            tostring(
                Chest:GetAttribute(
                    "ChestState"
                )
                or ""
            )
        )

    if State == "opened"
        or State == "despawned"
    then
        return true
    end

    if not Prompt
        or not Prompt.Parent
        or not Prompt.Enabled
    then
        return true
    end

    return false
end


function QuestFarmController:IsBossRewardChestCandidate(
    Chest
)
    if not Chest
        or not Chest.Parent
    then
        return false
    end

    local Name =
        string.lower(
            tostring(
                Chest.Name
            )
        )

    -- These have dedicated controllers and must never be mistaken for a
    -- normal world-boss kill chest.
    if string.find(
        Name,
        "sealed cache",
        1,
        true
    )
        or string.find(
            Name,
            "ouwigahara",
            1,
            true
        )
    then
        return false
    end

    local Prompt =
        self:GetGenericChestPrompt(
            Chest
        )

    return Prompt ~= nil
        and not self:IsChestOpened(
            Chest,
            Prompt
        )
end


function QuestFarmController:FindNearbyBossRewardChest(
    Center
)
    if typeof(
        Center
    ) ~= "Vector3"
    then
        return nil
    end

    local Chests =
        workspace:FindFirstChild(
            "Chests"
        )

    if not Chests then
        return nil
    end

    local Best =
        nil

    local BestDistance =
        math.huge

    for _,
        Chest in ipairs(
            Chests:GetChildren()
        )
    do
        if self:IsBossRewardChestCandidate(
            Chest
        )
        then
            local CFrame =
                self:GetGenericChestCFrame(
                    Chest
                )

            if CFrame then
                local Distance =
                    (
                        CFrame.Position
                        - Center
                    ).Magnitude

                if Distance
                    <= self.BossChestSearchRadius
                    and Distance
                        < BestDistance
                then
                    BestDistance =
                        Distance

                    Best =
                        Chest
                end
            end
        end
    end

    return Best
end


function QuestFarmController:ClearAggroBeforeRewards(
    Timeout
)
    Timeout =
        tonumber(
            Timeout
        )
        or self.AggroCleanupTimeout

    local Deadline =
        os.clock()
        + Timeout

    while HubRunning
        and os.clock()
            < Deadline
    do
        local Target =
            FindAggroedEnemyTarget()

        if not Target then
            Settings.__LootAggroCleanup =
                false

            self.CurrentTarget =
                nil

            self:StopHeartbeatLock(
                "Farm"
            )

            return true
        end

        Settings.__LootAggroCleanup =
            true

        Settings.__LootFarmBusy =
            false

        self.CurrentTarget =
            Target

        local Humanoid =
            Target:FindFirstChildWhichIsA(
                "Humanoid",
                true
            )

        HubDebug(
            "[Combat Hub] Loot safety: finishing aggroed "
                .. tostring(
                    Target.Name
                )
                .. " before rewards"
        )

        self:HoverOverTarget(
            Target,
            "Farm"
        )

        while HubRunning
            and os.clock()
                < Deadline
            and Target.Parent
            and (
                not Humanoid
                or Humanoid.Health > 0
            )
        do
            task.wait(
                0.05
            )
        end

        self.CurrentTarget =
            nil

        self:StopHeartbeatLock(
            "Farm"
        )

        task.wait(
            0.05
        )
    end

    Settings.__LootAggroCleanup =
        false

    self.CurrentTarget =
        nil

    self:StopHeartbeatLock(
        "Farm"
    )

    warn(
        "[Combat Hub] Loot safety: aggro cleanup timed out"
    )

    return false
end


function QuestFarmController:OpenBossRewardChest(
    Chest
)
    if not Settings.AutoOpenChest
        or not Chest
        or not Chest.Parent
    then
        return false
    end

    local Prompt =
        self:GetGenericChestPrompt(
            Chest
        )

    if not Prompt then
        return false
    end

    self:StopHeartbeatLock(
        "Farm"
    )

    Settings.__LootFarmBusy =
        true

    local Reached =
        LootMoveState:TeleportToPrompt(
            Prompt
        )

    if not Reached then
        Settings.__LootFarmBusy =
            false

        return false
    end

    local Deadline =
        os.clock()
        + self.BossChestOpenTimeout

    while HubRunning
        and Settings.AutoOpenChest
        and Chest.Parent
        and os.clock()
            < Deadline
    do
        if self:IsChestOpened(
            Chest,
            Prompt
        )
        then
            Settings.__LootFarmBusy =
                false

            return true
        end

        if not Prompt.Parent then
            Prompt =
                self:GetGenericChestPrompt(
                    Chest
                )

            if not Prompt then
                Settings.__LootFarmBusy =
                    false

                return true
            end
        end

        if Prompt.Enabled then
            OpenChestPrompt(
                Prompt
            )
        end

        task.wait(
            0.08
        )
    end

    local Opened =
        self:IsChestOpened(
            Chest,
            Prompt
        )

    Settings.__LootFarmBusy =
        false

    return Opened
end


function QuestFarmController:CollectBossRewardLoot(
    Center
)
    if not Settings.AutoPickUpLoot
        or typeof(
            Center
        ) ~= "Vector3"
    then
        return
    end

    Settings.__BossRewardCollecting =
        true

    Settings.__BossLootCenter =
        Center

    Settings.__BossLootRadius =
        self.BossLootRadius

    -- Wake the existing normal loot/soul worker for freshly-created drops.
    StartAutoPickUpLoot()

    local StartedAt =
        os.clock()

    local HardDeadline =
        StartedAt
        + self.BossLootHardTimeout

    local SawLoot =
        false

    local QuietSince =
        nil

    local LastCount =
        -1

    while HubRunning
        and Settings.AutoPickUpLoot
        and os.clock()
            < HardDeadline
    do
        local Aggro =
            FindAggroedEnemyTarget()

        if Aggro then
            Settings.__BossRewardCollecting =
                false

            Settings.__BossLootCenter =
                nil

            Settings.__BossLootRadius =
                nil

            self:ClearAggroBeforeRewards(
                self.AggroCleanupTimeout
            )

            Settings.__BossRewardCollecting =
                true

            Settings.__BossLootCenter =
                Center

            Settings.__BossLootRadius =
                self.BossLootRadius
        end

        ScanExistingLoot(
            Center,
            self.BossLootRadius
        )

        local Pending =
            CountEligibleCollectiblesNear(
                Center,
                self.BossLootRadius
            )

        local Busy =
            LootMoveState.Busy
            or CollectibleInteractionBusy
            or Settings.__LootFarmBusy

        if Pending ~= LastCount then
            LastCount =
                Pending

            HubDebug(
                "[Combat Hub] Boss reward loot remaining: "
                    .. tostring(
                        Pending
                    )
            )
        end

        if Pending > 0
            or Busy
        then
            SawLoot =
                true

            QuietSince =
                nil
        else
            local SinceStart =
                os.clock()
                - StartedAt

            if not SawLoot
                and SinceStart
                    < self.BossLootSpawnGrace
            then
                QuietSince =
                    nil
            else
                if not QuietSince then
                    QuietSince =
                        os.clock()
                end

                if os.clock()
                    - QuietSince
                    >= self.BossLootQuietConfirm
                then
                    break
                end
            end
        end

        task.wait(
            LOOT_SCAN_INTERVAL
        )
    end

    while HubRunning
        and CollectibleInteractionBusy
    do
        task.wait(
            0.03
        )
    end

    Settings.__BossRewardCollecting =
        false

    Settings.__BossLootCenter =
        nil

    Settings.__BossLootRadius =
        nil

    Settings.__LootFarmBusy =
        false
end


function QuestFarmController:HandleBossPostKillRewards(
    BossName,
    DeathPosition
)
    if self.PostBossRewardBusy
        or typeof(
            DeathPosition
        ) ~= "Vector3"
    then
        return
    end

    if not Settings.AutoOpenChest
        and not Settings.AutoPickUpLoot
    then
        return
    end

    -- Never run world-boss reward handling inside Ouwigahara reward shops.
    if LocalPlayer:GetAttribute(
        "InShops"
    ) == true
        or tostring(
            workspace:GetAttribute(
                "MinigameState"
            )
            or ""
        ) == "Climbing"
    then
        return
    end

    self.PostBossRewardBusy =
        true

    Settings.__BossRewardBusy =
        true

    self.CurrentTarget =
        nil

    self:StopHeartbeatLock(
        "Farm"
    )

    HubDebug(
        "[Combat Hub] Boss defeated: "
            .. tostring(
                BossName
            )
            .. " • finishing combat/rewards before next boss"
    )

    ----------------------------------------------------------
    -- 1) FINISH ANY NPC STILL TARGETING US
    ----------------------------------------------------------

    self:ClearAggroBeforeRewards(
        self.AggroCleanupTimeout
    )

    ----------------------------------------------------------
    -- 2) WAIT FOR / OPEN NEARBY BOSS CHEST
    ----------------------------------------------------------

    local RewardCenter =
        DeathPosition

    if Settings.AutoOpenChest then
        local Chest =
            nil

        local Deadline =
            os.clock()
            + self.BossChestSpawnWait

        while HubRunning
            and Settings.AutoOpenChest
            and os.clock()
                < Deadline
        do
            local Aggro =
                FindAggroedEnemyTarget()

            if Aggro then
                self:ClearAggroBeforeRewards(
                    self.AggroCleanupTimeout
                )
            end

            Chest =
                self:FindNearbyBossRewardChest(
                    DeathPosition
                )

            if Chest then
                break
            end

            task.wait(
                0.10
            )
        end

        if Chest then
            local ChestCFrame =
                self:GetGenericChestCFrame(
                    Chest
                )

            if ChestCFrame then
                RewardCenter =
                    ChestCFrame.Position
            end

            HubDebug(
                "[Combat Hub] Boss reward chest found: "
                    .. tostring(
                        Chest.Name
                    )
            )

            local Opened =
                self:OpenBossRewardChest(
                    Chest
                )

            HubDebug(
                "[Combat Hub] Boss reward chest open confirmed: "
                    .. tostring(
                        Opened
                    )
            )

            -- Chest drops can replicate just after the accepted open state.
            task.wait(
                0.20
            )
        else
            HubDebug(
                "[Combat Hub] No boss chest appeared near "
                    .. tostring(
                        BossName
                    )
                    .. " within "
                    .. tostring(
                        self.BossChestSpawnWait
                    )
                    .. "s"
            )
        end
    end

    ----------------------------------------------------------
    -- 3) WAIT FOR AND COLLECT ALL NEARBY LOOT / SOULS
    ----------------------------------------------------------

    if Settings.AutoPickUpLoot then
        self:CollectBossRewardLoot(
            RewardCenter
        )
    end

    Settings.__BossRewardCollecting =
        false

    Settings.__BossLootCenter =
        nil

    Settings.__BossLootRadius =
        nil

    Settings.__BossRewardBusy =
        false

    Settings.__LootAggroCleanup =
        false

    Settings.__LootFarmBusy =
        false

    self.PostBossRewardBusy =
        false

    self.CurrentTarget =
        nil

    self:StopHeartbeatLock(
        "Farm"
    )

    HubDebug(
        "[Combat Hub] Boss reward stage complete • resuming farm"
    )
end


function QuestFarmController:GetStableTargetRoot(
    Target
)
    if not Target
        or not Target.Parent
    then
        return nil
    end

    if Target:IsA(
        "BasePart"
    ) then
        return Target
    end

    if Target:IsA(
        "Model"
    ) then
        local Root =
            Target:FindFirstChild(
                "HumanoidRootPart",
                true
            )
            or Target.PrimaryPart
            or Target:FindFirstChild(
                "RootPart",
                true
            )
            or Target:FindFirstChildWhichIsA(
                "BasePart",
                true
            )

        return Root
    end

    return Target:FindFirstChildWhichIsA(
        "BasePart",
        true
    )
end


function QuestFarmController:EnableFarmNoclip(
    Character
)
    if not Character
        or not Character.Parent
    then
        return false
    end

    for _, Object in ipairs(
        Character:GetDescendants()
    ) do
        if Object:IsA("BasePart") then
            -- Save each part's real collision state once so it can
            -- be restored exactly when farming stops.
            if self.NoclipStates[
                Object
            ] == nil
            then
                self.NoclipStates[
                    Object
                ] =
                    Object.CanCollide
            end

            if Object.CanCollide then
                Object.CanCollide =
                    false
            end
        end
    end

    return true
end


function QuestFarmController:RestoreFarmNoclip()
    for Part, OriginalCanCollide in pairs(
        self.NoclipStates
    ) do
        if Part
            and Part.Parent
            and Part:IsA(
                "BasePart"
            )
        then
            pcall(function()
                Part.CanCollide =
                    OriginalCanCollide
            end)
        end
    end

    table.clear(
        self.NoclipStates
    )
end


function QuestFarmController:StopHeartbeatLock(
    RequestingOwner
)
    -- A normal farm reset must never steal movement from Raid mode.
    if RequestingOwner
        and self.LockOwner
        and self.LockOwner ~= RequestingOwner
    then
        return
    end

    if self.LockConnection then
        self.LockConnection:Disconnect()
        self.LockConnection =
            nil
    end

    local Root =
        self.LockRoot

    if Root
        and Root.Parent
    then
        pcall(function()
            Root.AssemblyLinearVelocity =
                Vector3.zero

            Root.AssemblyAngularVelocity =
                Vector3.zero

            -- Always release normal farm positioning unanchored.
            Root.Anchored =
                false
        end)
    end

    local Humanoid =
        self.LockHumanoid

    if Humanoid
        and Humanoid.Parent
    then
        pcall(function()
            Humanoid.AutoRotate =
                self.LockOriginalAutoRotate
        end)
    end

    self.LockTarget =
        nil

    self.LockOwner =
        nil

    self.LockCharacter =
        nil

    self.LockRoot =
        nil

    self.LockHumanoid =
        nil

    self.LastNoclipRefresh =
        0

    self:RestoreFarmNoclip()
end


-- Compatibility helper for older parts of the hub.
-- Farm movement itself no longer creates Tween objects.
function QuestFarmController:CancelTween()
    return
end


function QuestFarmController:GetFarmAimPosition(
    Target,
    StableRoot
)
    if not StableRoot
        or not StableRoot.Parent
    then
        return nil
    end

    -- Use a fixed offset from HumanoidRootPart instead of tracking Head.
    -- Animated head/torso motion was one of the main causes of camera/body
    -- shaking while following an NPC.
    local AimHeight =
        1.75

    local Humanoid =
        Target
        and Target:FindFirstChildWhichIsA(
            "Humanoid",
            true
        )

    if Humanoid then
        local HipHeight =
            tonumber(
                Humanoid.HipHeight
            )

        if HipHeight then
            AimHeight =
                math.clamp(
                    HipHeight + 0.75,
                    1.5,
                    3.25
                )
        end
    end

    return StableRoot.Position
        + Vector3.new(
            0,
            AimHeight,
            0
        )
end


function QuestFarmController:BuildFarmCFrame(
    Target
)
    local StableRoot =
        self:GetStableTargetRoot(
            Target
        )

    if not StableRoot
        or not StableRoot.Parent
    then
        return nil
    end

    local Distance =
        math.clamp(
            tonumber(
                Settings.QuestFarmDistance
            )
            or 10,
            3,
            30
        )

    -- While Auto Click is attacking, prevent a large Farm Range from
    -- placing the character outside normal melee hit validation.
    if Settings.AutoClick then
        Distance =
            math.min(
                Distance,
                6
            )
    end

    local Mode =
        Settings.QuestFarmPosition
        or "Above"

    local TargetPosition =
        StableRoot.Position

    local AimPosition =
        self:GetFarmAimPosition(
            Target,
            StableRoot
        )
        or TargetPosition

    if Mode == "Behind" then
        -- Use only the NPC root's horizontal facing direction.
        -- Vertical animation/tilt can no longer move the "behind" point.
        local HorizontalLook =
            Vector3.new(
                StableRoot.CFrame.LookVector.X,
                0,
                StableRoot.CFrame.LookVector.Z
            )

        if HorizontalLook.Magnitude
            < 0.001
        then
            HorizontalLook =
                Vector3.new(
                    0,
                    0,
                    -1
                )
        else
            HorizontalLook =
                HorizontalLook.Unit
        end

        local FarmPosition =
            TargetPosition
            - (
                HorizontalLook
                * Distance
            )

        -- Behind should feel like you're locked to the NPC's back,
        -- not like you're standing behind them while pitching upward
        -- toward their head. Keep the player's orientation completely
        -- horizontal and match the NPC's yaw.
        return CFrame.lookAt(
            FarmPosition,
            FarmPosition
                + HorizontalLook,
            Vector3.yAxis
        )
    end

    -- Above and Below both use a FIXED horizontal roll reference.
    -- That stops the character from spinning/rolling whenever the NPC
    -- changes facing direction while we're looking almost straight up/down.
    local FixedVerticalUp =
        Vector3.new(
            0,
            0,
            -1
        )

    if Mode == "Below" then
        local FarmPosition =
            TargetPosition
            - Vector3.new(
                0,
                Distance,
                0
            )

        -- This genuinely places the player below the NPC and makes the
        -- character's front (-Z) point upward toward the target.
        return CFrame.lookAt(
            FarmPosition,
            AimPosition,
            FixedVerticalUp
        )
    end

    -- Default = Above.
    local FarmPosition =
        TargetPosition
        + Vector3.new(
            0,
            Distance,
            0
        )

    -- Character front (-Z) points downward toward the NPC.
    return CFrame.lookAt(
        FarmPosition,
        AimPosition,
        FixedVerticalUp
    )
end


function QuestFarmController:HeartbeatFarmStep(
    DeltaTime
)
    local Target =
        self.LockTarget

    local Owner =
        self.LockOwner

    local Character =
        self.LockCharacter

    local Root =
        self.LockRoot

    local Humanoid =
        self.LockHumanoid

    if not HubRunning
        or not Target
        or not Target.Parent
        or not Character
        or not Character.Parent
        or not Root
        or not Root.Parent
        or not self:IsAlive(
            Target
        )
    then
        self:StopHeartbeatLock(
            Owner
        )

        return
    end

    -- Auto Sell / dungeon entry temporarily own character movement.
    if Settings.__AutoSellBusy
        or Settings.__DungeonEntryBusy
    then
        self:StopHeartbeatLock(
            Owner
        )

        return
    end

    -- Respect movement priority.
    if Owner == "Farm" then
        if not (
            Settings.AutoFarm
            or Settings.AutoFarmBoss
            or Settings.AutoFarmDungeon
            or Settings.AutoFarmQuest
        )
            or Settings.__RaidFarmBusy
            or Settings.__LootFarmBusy
        then
            self:StopHeartbeatLock(
                "Farm"
            )

            return
        end
    elseif Owner == "Raid" then
        if not Settings.AutoRaidChest then
            self:StopHeartbeatLock(
                "Raid"
            )

            return
        end
    end

    -- Character may have respawned while the lock was active.
    local LiveCharacter =
        LocalPlayer.Character

    local LiveRoot =
        LiveCharacter
        and LiveCharacter:FindFirstChild(
            "HumanoidRootPart"
        )

    if LiveCharacter ~= Character
        or LiveRoot ~= Root
    then
        self:StopHeartbeatLock(
            Owner
        )

        return
    end

    local Desired =
        self:BuildFarmCFrame(
            Target
        )

    if not Desired then
        self:StopHeartbeatLock(
            Owner
        )

        return
    end

    -- Refresh noclip occasionally instead of rescanning every frame.
    if os.clock()
        - self.LastNoclipRefresh
        >= 0.40
    then
        self:EnableFarmNoclip(
            Character
        )

        self.LastNoclipRefresh =
            os.clock()
    end

    if Humanoid
        and Humanoid.Parent
    then
        Humanoid.AutoRotate =
            false
    end

    -- COMBAT-SAFE HEARTBEAT LOCK:
    -- Do NOT anchor HumanoidRootPart while farming. This game can reject
    -- Combat_Service hits while the local character is anchored.
    -- Stability comes from per-Heartbeat CFrame correction, zero velocity,
    -- AutoRotate off, and noclip instead.
    Root.Anchored =
        false

    Root.AssemblyLinearVelocity =
        Vector3.zero

    Root.AssemblyAngularVelocity =
        Vector3.zero

    if Settings.FarmMovement
        == "Tween"
    then
        -- Heartbeat "Tween" mode is a constant-speed follower rather than
        -- repeatedly cancelling/recreating TweenService tweens.
        local Speed =
            math.clamp(
                tonumber(
                    Settings.QuestTweenSpeed
                )
                or 100,
                10,
                300
            )

        local Current =
            Root.CFrame

        local CurrentPosition =
            Current.Position

        local DesiredPosition =
            Desired.Position

        local Offset =
            DesiredPosition
            - CurrentPosition

        local Distance =
            Offset.Magnitude

        local NewPosition =
            DesiredPosition

        if Distance > 0.001 then
            local StepDistance =
                math.min(
                    Distance,
                    Speed
                        * math.max(
                            DeltaTime,
                            0
                        )
                )

            NewPosition =
                CurrentPosition
                + (
                    Offset.Unit
                    * StepDistance
                )
        end

        local CurrentRotation =
            Current
            - CurrentPosition

        local DesiredRotation =
            Desired
            - DesiredPosition

        local RotationAlpha =
            math.clamp(
                (
                    tonumber(
                        self.RotationFollowSpeed
                    )
                    or 16
                )
                * math.max(
                    DeltaTime,
                    0
                ),
                0,
                1
            )

        local SmoothedRotation =
            CurrentRotation:Lerp(
                DesiredRotation,
                RotationAlpha
            )

        Root.CFrame =
            CFrame.new(
                NewPosition
            )
            * SmoothedRotation
    else
        -- Teleport mode is a perfect per-frame lock to the calculated point.
        Root.CFrame =
            Desired
    end
end


function QuestFarmController:EnsureHeartbeatLock(
    Target,
    Owner
)
    Owner =
        Owner
        or "Farm"

    if not Target
        or not Target.Parent
    then
        return false
    end

    -- Raid movement has priority over the ordinary Auto Farm loop.
    if self.LockOwner == "Raid"
        and Owner ~= "Raid"
    then
        return false
    end

    local Character =
        LocalPlayer.Character

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    local Humanoid =
        Character
        and Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not Character
        or not Root
    then
        return false
    end

    local SameLock =
        self.LockConnection
        and self.LockTarget == Target
        and self.LockOwner == Owner
        and self.LockCharacter == Character
        and self.LockRoot == Root

    if SameLock then
        return true
    end

    -- Stop the previous owner/target before taking a new lock.
    self:StopHeartbeatLock()

    self.LockTarget =
        Target

    self.LockOwner =
        Owner

    self.LockCharacter =
        Character

    self.LockRoot =
        Root

    self.LockHumanoid =
        Humanoid

    self.LockOriginalAnchored =
        Root.Anchored

    self.LockOriginalAutoRotate =
        Humanoid
        and Humanoid.AutoRotate
        or true

    self:EnableFarmNoclip(
        Character
    )

    self.LastNoclipRefresh =
        os.clock()

    -- Stay unanchored from the first lock frame so normal combat can
    -- continue while the farm controller owns positioning.
    Root.Anchored =
        false

    Root.AssemblyLinearVelocity =
        Vector3.zero

    Root.AssemblyAngularVelocity =
        Vector3.zero

    if Humanoid then
        Humanoid.AutoRotate =
            false
    end

    -- Apply one frame immediately so Teleport mode does not wait for the
    -- next Heartbeat before moving into position.
    self:HeartbeatFarmStep(
        0
    )

    HubDebug(
        "[Combat Hub] Farm lock: "
            .. tostring(
                Owner
            )
            .. " -> "
            .. tostring(
                Target.Name
            )
            .. " | unanchored combat-safe"
    )

    self.LockConnection =
        RunService.Heartbeat:Connect(
            function(DeltaTime)
                local Success,
                    ErrorMessage =
                    pcall(function()
                        self:HeartbeatFarmStep(
                            DeltaTime
                        )
                    end)

                if not Success then
                    warn(
                        "[Combat Hub] Heartbeat farm recovered: "
                            .. tostring(
                                ErrorMessage
                            )
                    )

                    self:StopHeartbeatLock(
                        Owner
                    )
                end
            end
        )

    return true
end


function QuestFarmController:HoverOverTarget(
    Target,
    Owner
)
    if not Target
        or not Target.Parent
        or not self:IsAlive(
            Target
        )
        or not self:GetStableTargetRoot(
            Target
        )
    then
        return false
    end

    return self:EnsureHeartbeatLock(
        Target,
        Owner
            or "Farm"
    )
end


function QuestFarmController:ResetTarget(
    RequestingOwner
)
    -- A Farm reset cannot interrupt an active Raid lock.
    if RequestingOwner == "Farm"
        and self.LockOwner == "Raid"
    then
        self.CurrentTarget =
            nil

        self.LastForcedTargetRefresh =
            0

        return
    end

    self.CurrentTarget =
        nil

    if RequestingOwner == nil
        or RequestingOwner == "Farm"
    then
        self.LastDungeonGroupName =
            nil

        self:ClearDungeonPending()
    end

    self:StopHeartbeatLock(
        RequestingOwner
    )

    self.LastForcedTargetRefresh =
        0

    if RequestingOwner == nil
        or RequestingOwner == "Farm"
    then
        self.LastBossTravelName =
            nil
    end
end


function QuestFarmController:Start()
    self.LoopID += 1

    local MyLoopID =
        self.LoopID

    self:ResetTarget()
    self:EnsureSpawnWatcher()

    task.spawn(function()
        while HubRunning
            and (
                Settings.AutoFarmQuest
                or Settings.AutoFarmDungeon
                or Settings.AutoFarm
                or Settings.AutoFarmBoss
            )
            and MyLoopID == self.LoopID
        do
            local Success,
                ErrorMessage =
                pcall(function()
                    self:EnsureSpawnWatcher()

                    ------------------------------------------------------
                    -- A) NORMAL LOOT/SOUL SAFETY:
                    -- if a drop is waiting but another NPC is still
                    -- targeting us, finish that attacker FIRST.
                    ------------------------------------------------------

                    if Settings.__LootAggroCleanup then
                        local AggroTarget =
                            FindAggroedEnemyTarget()

                        if AggroTarget then
                            self.CurrentTarget =
                                AggroTarget

                            self:HoverOverTarget(
                                AggroTarget,
                                "Farm"
                            )

                            return
                        end

                        Settings.__LootAggroCleanup =
                            false

                        self.CurrentTarget =
                            nil

                        self:StopHeartbeatLock(
                            "Farm"
                        )
                    end

                    ------------------------------------------------------
                    -- B) POST-BOSS REWARD GATE:
                    -- detect death BEFORE FindTarget can choose the next
                    -- boss in a multi-boss selection.
                    ------------------------------------------------------

                    if self.LastCombatTarget
                        and not self:IsAlive(
                            self.LastCombatTarget
                        )
                    then
                        local WasBoss =
                            self.LastCombatTargetWasBoss

                        local BossName =
                            self.LastCombatTargetName

                        local DeathPosition =
                            self.LastCombatTargetPosition

                        self:ClearTrackedCombatTarget()

                        self.CurrentTarget =
                            nil

                        self:StopHeartbeatLock(
                            "Farm"
                        )

                        if WasBoss
                            and typeof(
                                DeathPosition
                            ) == "Vector3"
                        then
                            self:HandleBossPostKillRewards(
                                BossName,
                                DeathPosition
                            )

                            return
                        end
                    end

                    local Spec =
                        self:GetActiveFarmSpec()

                    if not Spec
                        or not Spec.EnemyName
                    then
                        -- Raid / loot movement can temporarily own the player.
                        -- Only release an ordinary Farm lock here.
                        self:ResetTarget(
                            "Farm"
                        )

                        return
                    end

                    local Target =
                        self:GetCurrentTarget(
                            Spec.EnemyName
                        )

                    if Target then
                        self:TrackCombatTarget(
                            Target,
                            Spec
                        )

                        self:HoverOverTarget(
                            Target,
                            "Farm"
                        )
                    else
                        -- Keep waiting for respawns instead of stopping the
                        -- controller, but release the old Heartbeat target.
                        self.CurrentTarget =
                            nil

                        self:StopHeartbeatLock(
                            "Farm"
                        )

                        if Spec.IsBoss then
                            self:HandleMissingBoss(
                                Spec
                            )
                        elseif Spec.MultiFarm then
                            local MissingBoss =
                                self:GetBestMissingBossSpec(
                                    Spec
                                )

                            if MissingBoss then
                                self:HandleMissingBoss(
                                    MissingBoss
                                )
                            end
                        end
                    end
                end)

            if not Success then
                warn(
                    "[Combat Hub] Shared Auto Farm recovered: "
                        .. tostring(
                            ErrorMessage
                        )
                )

                self.CurrentTarget =
                    nil

                self.LastForcedTargetRefresh =
                    0
            end

            task.wait(
                self.UpdateInterval
            )
        end
    end)
end


function QuestFarmController:RefreshRunState()
    if Settings.AutoFarmQuest
        or Settings.AutoFarmDungeon
        or Settings.AutoFarm
        or Settings.AutoFarmBoss
    then
        self:Start()
    else
        self:Stop()
    end
end


-- Quest progress changes wake Auto Farm Quest immediately. Target scanning
-- still runs normally because NPCs themselves can spawn/despawn dynamically.
local QuestFarmStateConnection =
    QuestController.StateChanged.Event:Connect(
        function()
            if not HubRunning
                or not Settings.AutoFarmQuest
            then
                return
            end

            QuestFarmController:ResetTarget(
                "Farm"
            )

            QuestFarmController:RefreshRunState()
        end
    )


function QuestFarmController:Stop()
    self.LoopID += 1
    self:ResetTarget()
    self:StopHeartbeatLock()
    self:RestoreFarmNoclip()
    self:DisconnectSpawnWatcher()
    self:ClearTrackedCombatTarget()

    self.PostBossRewardBusy =
        false

    Settings.__BossRewardBusy =
        false

    Settings.__BossRewardCollecting =
        false

    Settings.__BossLootCenter =
        nil

    Settings.__BossLootRadius =
        nil

    Settings.__LootAggroCleanup =
        false
end



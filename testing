function AutoOuwigaharaController:IsDungeonRunning()
    if self:IsInRewardShops() then
        return false
    end

    local State =
        self:GetMinigameState()

    if State == "Climbing" then
        return true
    end

    if self:IsRewardResultsVisible() then
        return false
    end

    -- GUI fallback only when the authoritative state is not decisive.
    if QuestFarmController
        and type(
            QuestFarmController.IsDungeonUiActive
        ) == "function"
    then
        local Success,
            Active =
            pcall(function()
                return QuestFarmController:IsDungeonUiActive()
            end)

        if Success then
            return Active == true
                and State ~= "Lobby"
        end
    end

    return false
end


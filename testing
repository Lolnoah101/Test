local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local Window = Rayfield:CreateWindow({
    name = "Testing",
    subtitle = "Combat",
    theme = "default",

    configuration = {
        autoSave = true,
        autoLoad = true,
        fileName = "TestingHub",
    },
})

local CombatTab = Window:CreateTab({
    name = "Combat",
})

local Remotes = game:GetService("ReplicatedStorage").Player.Remotes.Inputs
local Attack = Remotes.Attack
local Skill = Remotes.Skill

local AutoM1 = false
local AutoSkill = false
local SelectedSkills = {
    "Skill 1"
}

-- =========================
-- AUTO M1
-- =========================

CombatTab:CreateToggle({
    name = "Auto M1",
    flag = "AutoM1",

    callback = function(value)
        AutoM1 = value

        if value then
            task.spawn(function()
                while AutoM1 do
                    Attack:FireServer(Vector3.new(0, 0, 0))
                    task.wait(0.1)
                end
            end)
        end
    end,
})

-- =========================
-- MULTI-SKILL SELECTOR
-- =========================

CombatTab:CreateDropdown({
    name = "Select Skills",
    flag = "SelectedSkills",

    multiSelect = true,

    options = {
        "Skill 1",
        "Skill 2",
        "Skill 3",
        "Skill 4",
    },

    value = {
        "Skill 1"
    },

    callback = function(selected)
        SelectedSkills = selected
    end,
})

-- =========================
-- AUTO SKILL
-- =========================

CombatTab:CreateToggle({
    name = "Auto Skill",
    flag = "AutoSkill",

    callback = function(value)
        AutoSkill = value

        if value then
            task.spawn(function()
                while AutoSkill do

                    for _, skillName in ipairs(SelectedSkills) do

                        if not AutoSkill then
                            break
                        end

                        local skillNumber

                        if skillName == "Skill 1" then
                            skillNumber = 1
                        elseif skillName == "Skill 2" then
                            skillNumber = 2
                        elseif skillName == "Skill 3" then
                            skillNumber = 3
                        elseif skillName == "Skill 4" then
                            skillNumber = 4
                        end

                        if skillNumber then
                            Skill:FireServer(
                                skillNumber,
                                "tap",
                                Vector3.new(0, 0, 0)
                            )
                        end

                        task.wait(1)
                    end

                    task.wait()
                end
            end)
        end
    end,
})

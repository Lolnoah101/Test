function AutoOuwigaharaController:FindRewardLootPrompt(
    Center,
    Radius
)
    local Character =
        LocalPlayer.Character

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Root then
        return nil
    end

    local Best =
        nil

    local BestDistance =
        math.huge

    local function Consider(
        Prompt
    )
        if not Prompt
            or not Prompt.Parent
            or not Prompt:IsA(
                "ProximityPrompt"
            )
            or not IsCollectiblePrompt(
                Prompt
            )
        then
            return
        end

        local IsSoul =
            IsSoulPrompt(
                Prompt
            )

        if not IsSoul
            and not Prompt.Enabled
        then
            return
        end

        local PromptCFrame =
            LootMoveState:GetPromptCFrame(
                Prompt
            )

        if not PromptCFrame then
            return
        end

        if typeof(
            Center
        ) == "Vector3"
            and (
                PromptCFrame.Position
                - Center
            ).Magnitude
                > Radius
        then
            return
        end

        local Distance =
            (
                PromptCFrame.Position
                - Root.Position
            ).Magnitude

        if Distance
            < BestDistance
        then
            BestDistance =
                Distance

            Best =
                Prompt
        end
    end

    local LootFolder =
        GetLootFolder()

    if LootFolder then
        for _,
            Object in ipairs(
                LootFolder:GetDescendants()
            )
        do
            if IsLootPrompt(
                Object
            ) then
                Consider(
                    Object
                )
            end
        end
    end

    local Debree =
        GetDebreeFolder()

    if Debree then
        for _,
            Drop in ipairs(
                Debree:GetChildren()
            )
        do
            if Drop.Name
                == "Weak Soul"
                or Drop.Name
                    == "Strong Soul"
            then
                local Prompt =
                    Drop:FindFirstChild(
                        "SoulPrompt",
                        true
                    )

                if Prompt then
                    Consider(
                        Prompt
                    )
                end
            end
        end
    end

    return Best
end


function AutoOuwigaharaController:CollectRewardLoot(
    Center
)
    local StartedAt =
        os.clock()

    local SawLoot =
        false

    local LastFoundAt =
        nil

    self:SetStatus(
        "waiting for reward loot"
    )

    while HubRunning
        and Settings.AutoRewardChests
        and os.clock()
            - StartedAt
            < self.RewardLootMaxWait
    do
        local Prompt =
            self:FindRewardLootPrompt(
                Center,
                self.RewardLootRadius
            )

        if Prompt then
            SawLoot =
                true

            LastFoundAt =
                os.clock()

            self:SetStatus(
                "collecting reward loot"
            )

            local Picked =
                PickUpCollectiblePrompt(
                    Prompt,
                    true
                )

            if Picked then
                HubDebug(
                    "[Combat Hub] Reward loot: collected "
                        .. tostring(
                            Prompt.ObjectText
                            or Prompt.Name
                        )
                )
            end

            task.wait(
                0.10
            )
        elseif not SawLoot then
            if os.clock()
                - StartedAt
                >= self.RewardLootSpawnWait
            then
                HubDebug(
                    "[Combat Hub] Reward loot: no drops appeared after spawn wait"
                )

                break
            end

            task.wait(
                0.10
            )
        else
            local QuietFor =
                os.clock()
                - (
                    LastFoundAt
                    or StartedAt
                )

            if QuietFor
                >= self.RewardLootQuietWindow
            then
                HubDebug(
                    "[Combat Hub] Reward loot: clear • quiet "
                        .. string.format(
                            "%.2fs",
                            QuietFor
                        )
                )

                break
            end

            task.wait(
                0.10
            )
        end
    end

    local BusyStarted =
        os.clock()

    while (
        CollectibleInteractionBusy
        or LootMoveState.Busy
    )
        and os.clock()
            - BusyStarted
            < 4
    do
        task.wait(
            0.08
        )
    end

    Settings.__LootFarmBusy =
        false

    CollectibleInteractionBusy =
        false

    return SawLoot
end


function AutoOuwigaharaController:GetLeavePad()
    local Map =
        workspace:FindFirstChild(
            "Map"
        )

    local Shops =
        Map
        and Map:FindFirstChild(
            "Shops"
        )

    local LeavePad =
        Shops
        and Shops:FindFirstChild(
            "LeavePad",
            true
        )

    if not LeavePad
        or not LeavePad:IsA(
            "BasePart"
        )
    then
        return nil,
            nil
    end

    local Prompt =
        LeavePad:FindFirstChild(
            "Ouwigahara",
            true
        )

    if Prompt
        and not Prompt:IsA(
            "ProximityPrompt"
        )
    then
        Prompt =
            nil
    end

    if not Prompt then
        for _,
            Object in ipairs(
                LeavePad:GetDescendants()
            )
        do
            if Object:IsA(
                "ProximityPrompt"
            )
                and (
                    string.lower(
                        tostring(
                            Object.ObjectText
                            or ""
                        )
                    ) == "ouwigahara"
                    or string.lower(
                        tostring(
                            Object.ActionText
                            or ""
                        )
                    ) == "leave"
                )
            then
                Prompt =
                    Object

                break
            end
        end
    end

    return LeavePad,
        Prompt
end

function AutoOuwigaharaController:LeaveRewardLobby()
    local Character,
        Root =
        self:WaitForRewardCharacter(
            self.RewardCharacterWait
        )

    if not Character
        or not Root
    then
        return false
    end

    local StartedAt =
        os.clock()

    local LeavePad,
        Prompt =
        self:GetLeavePad()

    while HubRunning
        and self:IsRewardAutomationEnabled()
        and (
            not LeavePad
            or not Prompt
        )
        and os.clock()
            - StartedAt
            < self.LeavePromptWait
    do
        LeavePad,
            Prompt =
            self:GetLeavePad()

        task.wait(
            0.12
        )
    end

    if not LeavePad
        or not Prompt
    then
        self:SetStatus(
            "rewards done • waiting for LeavePad"
        )

        return false
    end

    Settings.__DungeonEntryBusy =
        true

    QuestFarmController:ResetTarget()

    local Attempts =
        0

    while HubRunning
        and Settings.AutoLeaveDungeon
        and Attempts
            < self.LeaveTriggerRetries
    do
        Attempts +=
            1

        LeavePad,
            Prompt =
            self:GetLeavePad()

        if not LeavePad
            or not Prompt
        then
            task.wait(
                0.20
            )

            continue
        end

        pcall(function()
            workspace:RequestStreamAroundAsync(
                LeavePad.Position
            )
        end)

        local Destination =
            LeavePad.CFrame
            * CFrame.new(
                0,
                2.5,
                0
            )

        local Moved =
            pcall(function()
                Character:PivotTo(
                    Destination
                )

                Root.CFrame =
                    Destination

                Root.AssemblyLinearVelocity =
                    Vector3.zero

                Root.AssemblyAngularVelocity =
                    Vector3.zero
            end)

        if not Moved then
            task.wait(
                0.15
            )

            continue
        end

        self:SetStatus(
            "leaving reward lobby"
        )

        task.wait(
            0.15
        )

        local Triggered =
            self:TriggerWorldPrompt(
                Prompt
            )

        if Triggered then
            local ConfirmStarted =
                os.clock()

            while HubRunning
                and os.clock()
                    - ConfirmStarted
                    < 3
            do
                if not self:IsInRewardShops()
                    or not LeavePad.Parent
                then
                    self.PostRunPending =
                        false

                    self.WasDungeonRunning =
                        false

                    self.LeaveCooldownUntil =
                        os.clock()
                        + 4

                    table.clear(
                        self.ProcessedRewardPrompts
                    )

                    Settings.__DungeonEntryBusy =
                        false

                    return true
                end

                task.wait(
                    0.10
                )
            end
        end

        task.wait(
            0.20
        )
    end

    Settings.__DungeonEntryBusy =
        false

    return false
end

function AutoOuwigaharaController:HandlePostRunRewards()
    if not Settings.AutoRewardChests then
        return false
    end

    if self.RewardBusy then
        return true
    end

    self.RewardBusy =
        true

    Settings.__DungeonEntryBusy =
        true

    Settings.__RewardRoomBusy =
        true

    local function Finish()
        Settings.__DungeonEntryBusy =
            false

        Settings.__RewardRoomBusy =
            false

        self.RewardBusy =
            false
    end

    self:SetStatus(
        "post-run rewards"
    )

    local Character,
        Root =
        self:WaitForRewardCharacter(
            self.RewardCharacterWait
        )

    if not Character
        or not Root
    then
        Finish()

        return false
    end

    local ExpectedCaches =
        self:GetExpectedCacheCount()

    ----------------------------------------------------------
    -- INITIAL REWARD REPLICATION WAIT
    ----------------------------------------------------------

    local WaitStarted =
        os.clock()

    while HubRunning
        and Settings.AutoRewardChests
        and os.clock()
            - WaitStarted
            < self.RewardSpawnWait
    do
        local Free,
            Paid =
            self:GetRewardChestPrompts()

        -- Start as soon as any actionable reward appears. ExpectedCaches is
        -- still used below to keep waiting for late free caches.
        if #Free > 0
            or #Paid > 0
        then
            break
        end

        task.wait(
            0.12
        )
    end

    ----------------------------------------------------------
    -- 1) FREE CACHES
    --
    -- CRITICAL:
    -- Do NOT mark a cache processed because TriggerWorldPrompt() merely
    -- returned true. That only means the local input call succeeded.
    -- Confirm the chest disabled/opened/disappeared first.
    ----------------------------------------------------------

    local FreePhaseStarted =
        os.clock()

    local FreeEmptySince =
        nil

    local ConfirmedFreeOpened =
        0

    local ConfirmedPrompt =
        {}

    while HubRunning
        and Settings.AutoRewardChests
    do
        local Free =
            self:GetRewardChestPrompts()

        local NextPrompt =
            Free[1]

        if NextPrompt then
            FreeEmptySince =
                nil

            local ChestCFrame =
                self:GetPromptWorldCFrame(
                    NextPrompt
                )

            local Container =
                self:GetChestContainer(
                    NextPrompt
                )

            local FreeName =
                Container
                and Container.Name
                or NextPrompt.ObjectText
                or "Free Reward"

            self:SetStatus(
                "opening free reward • "
                    .. tostring(
                        FreeName
                    )
            )

            local Opened =
                self:TriggerAndConfirmRewardChest(
                    NextPrompt,
                    self.FreeChestOpenConfirmWait
                )

            if Opened then
                if not ConfirmedPrompt[
                    NextPrompt
                ]
                then
                    ConfirmedPrompt[
                        NextPrompt
                    ] =
                        true

                    ConfirmedFreeOpened +=
                        1
                end

                self.ProcessedRewardPrompts[
                    NextPrompt
                ] =
                    true

                task.wait(
                    0.20
                )

                self:CollectRewardLoot(
                    ChestCFrame
                    and ChestCFrame.Position
                    or nil
                )

                task.wait(
                    0.12
                )
            else
                -- Still enabled / still present = it was NOT opened.
                -- Retry the exact same cache instead of skipping it forever.
                self.ProcessedRewardPrompts[
                    NextPrompt
                ] =
                    nil

                self:SetStatus(
                    "retrying free reward • "
                        .. tostring(
                            FreeName
                        )
                )

                task.wait(
                    0.25
                )
            end
        else
            if FreeEmptySince == nil then
                FreeEmptySince =
                    os.clock()
            end

            local EmptyFor =
                os.clock()
                - FreeEmptySince

            local FreePhaseAge =
                os.clock()
                - FreePhaseStarted

            local ExpectedSatisfied =
                ExpectedCaches <= 0
                or ConfirmedFreeOpened
                    >= ExpectedCaches

            if EmptyFor
                >= self.FreeChestEmptyConfirmTime
                and (
                    ExpectedSatisfied
                    or FreePhaseAge
                        >= self.FreeChestRetryMaxWait
                )
            then
                local FinalFree =
                    self:GetRewardChestPrompts()

                if #FinalFree == 0 then
                    break
                end

                FreeEmptySince =
                    nil
            end

            task.wait(
                0.10
            )
        end
    end

    ----------------------------------------------------------
    -- 2) PAID 30K OUWIGAHARA CHEST
    --
    -- Deterministic transition:
    --   enough RunPoints -> keep acquiring/retrying paid chest
    --   not enough       -> reward pass is complete, then LeavePad
    ----------------------------------------------------------

    local PaidAcquireStarted =
        os.clock()

    local PaidTriggerFailures =
        0

    while HubRunning
        and Settings.AutoRewardChests
    do
        local FreeCheck =
            self:GetRewardChestPrompts()

        if #FreeCheck > 0 then
            self.RewardPassComplete =
                false

            Finish()

            return true
        end

        local CurrentPoints =
            self:GetRunPoints()

        local DefaultCost =
            30000

        if CurrentPoints
            < DefaultCost
        then
            -- Nothing affordable remains. Advance to leave handling.
            break
        end

        local Entry =
            self:WaitForPaidRewardPrompt(
                math.min(
                    self.PaidPromptRespawnWait,
                    2.0
                )
            )

        if not Entry then
            if os.clock()
                - PaidAcquireStarted
                < self.PaidAcquireRetryWindow
            then
                self:SetStatus(
                    "waiting for 30k Ouwigahara Chest"
                )

                task.wait(
                    0.20
                )

                continue
            end

            -- We still have enough points, so DO NOT call the reward pass
            -- complete or leave. Let the next controller step retry again.
            self.RewardPassComplete =
                false

            Finish()

            return true
        end

        PaidAcquireStarted =
            os.clock()

        local Cost =
            tonumber(
                Entry.Cost
            )
            or DefaultCost

        CurrentPoints =
            self:GetRunPoints()

        if CurrentPoints
            < Cost
        then
            break
        end

        local ChestCFrame =
            self:GetPromptWorldCFrame(
                Entry.Prompt
            )

        local BeforePoints =
            CurrentPoints

        self:SetStatus(
            "opening paid chest • "
                .. tostring(
                    Cost
                )
                .. " points"
        )

        local Triggered =
            self:TriggerWorldPrompt(
                Entry.Prompt
            )

        if not Triggered then
            PaidTriggerFailures +=
                1

            if PaidTriggerFailures
                >= self.PaidTriggerRetryLimit
            then
                self.RewardPassComplete =
                    false

                Finish()

                return true
            end

            task.wait(
                0.30
            )

            continue
        end

        ------------------------------------------------------
        -- CONFIRM SERVER ACCEPTED PURCHASE BY POINT DEDUCTION
        ------------------------------------------------------

        local Deducted =
            false

        local DeductStarted =
            os.clock()

        while HubRunning
            and Settings.AutoRewardChests
            and os.clock()
                - DeductStarted
                < 4
        do
            if self:GetRunPoints()
                < BeforePoints
            then
                Deducted =
                    true

                break
            end

            task.wait(
                0.08
            )
        end

        if not Deducted then
            PaidTriggerFailures +=
                1

            self:SetStatus(
                "retrying paid Ouwigahara Chest"
            )

            if PaidTriggerFailures
                >= self.PaidTriggerRetryLimit
            then
                self.RewardPassComplete =
                    false

                Finish()

                return true
            end

            task.wait(
                0.35
            )

            continue
        end

        PaidTriggerFailures =
            0

        local AfterPoints =
            self:GetRunPoints()

        task.wait(
            0.20
        )

        self:CollectRewardLoot(
            ChestCFrame
            and ChestCFrame.Position
            or nil
        )

        ------------------------------------------------------
        -- If another free cache appears, go back through the free pass.
        ------------------------------------------------------

        local FreeAfterPaid =
            self:GetRewardChestPrompts()

        if #FreeAfterPaid > 0 then
            self.RewardPassComplete =
                false

            Finish()

            return true
        end

        ------------------------------------------------------
        -- If we can afford another paid chest, wait for the 6s reseal.
        ------------------------------------------------------

        if AfterPoints
            >= Cost
        then
            self:SetStatus(
                "waiting for paid chest reseal"
            )

            local ResealStarted =
                os.clock()

            while HubRunning
                and Settings.AutoRewardChests
                and os.clock()
                    - ResealStarted
                    < self.PaidResealSeconds
            do
                local FreeDuringReseal =
                    self:GetRewardChestPrompts()

                if #FreeDuringReseal > 0 then
                    self.RewardPassComplete =
                        false

                    Finish()

                    return true
                end

                task.wait(
                    0.10
                )
            end

            -- Loop naturally reacquires the paid prompt.
        else
            break
        end
    end

    ----------------------------------------------------------
    -- 3) FINAL FREE / LOOT SAFETY
    ----------------------------------------------------------

    local FinalSafetyStarted =
        os.clock()

    while HubRunning
        and Settings.AutoRewardChests
        and os.clock()
            - FinalSafetyStarted
            < self.FreeChestEmptyConfirmTime
    do
        local FinalFree =
            self:GetRewardChestPrompts()

        if #FinalFree > 0 then
            self.RewardPassComplete =
                false

            Finish()

            return true
        end

        if CollectibleInteractionBusy
            or LootMoveState.Busy
            or Settings.__LootFarmBusy
        then
            FinalSafetyStarted =
                os.clock()
        end

        task.wait(
            0.10
        )
    end

    ----------------------------------------------------------
    -- 4) REWARD PASS COMPLETE
    ----------------------------------------------------------

    self.RewardPassComplete =
        true

    self.PostRunPending =
        true

    ----------------------------------------------------------
    -- If Auto Leave Dungeon is enabled, transition immediately instead
    -- of waiting for an unrelated future state change.
    ----------------------------------------------------------

    if Settings.AutoLeaveDungeon then
        self:SetStatus(
            "rewards complete • leaving"
        )

        local Left =
            self:LeaveRewardLobby()

        if Left then
            self.RewardPassComplete =
                false

            self.PostRunPending =
                false
        end
    end

    Finish()

    return true
end

function AutoOuwigaharaController:Step()
    if not HubRunning
        or not self:IsWorkerNeeded()
    then
        Settings.__DungeonEntryBusy =
            false

        Settings.__RewardRoomBusy =
            false

        return
    end

    local State =
        self:GetMinigameState()

    local InShops =
        self:IsInRewardShops()

    local CacheModel,
        PaidModel,
        DeepCacheModel =
        self:GetRewardModelState()

    ----------------------------------------------------------
    -- 1) REWARD SHOPS
    ----------------------------------------------------------

    if InShops
        or self:IsRewardRoomAvailable()
    then
        self.AutoDieTriggeredThisRun =
            false

        self.WasDungeonRunning =
            false

        if self:IsRewardAutomationEnabled() then
            self.PostRunPending =
                true

            self:SetStatus(
                "reward shops • InShops="
                    .. tostring(
                        InShops
                    )
                    .. " • cache="
                    .. tostring(
                        CacheModel ~= nil
                    )
                    .. " • deep="
                    .. tostring(
                        DeepCacheModel ~= nil
                    )
                    .. " • paid="
                    .. tostring(
                        PaidModel ~= nil
                    )
                    .. " • RunPoints="
                    .. tostring(
                        self:GetRunPoints()
                    )
            )

            if Settings.AutoRewardChests
                and not self.RewardPassComplete
            then
                Settings.__RewardRoomBusy =
                    true

                self:HandlePostRunRewards()

                return
            end

            if Settings.AutoLeaveDungeon then
                if Settings.AutoRewardChests
                    and not self.RewardPassComplete
                then
                    return
                end

                if Settings.AutoRewardChests then
                    local FreeBeforeLeave =
                        self:GetRewardChestPrompts()

                    if #FreeBeforeLeave > 0
                        or self:HasActionableRewardChest()
                    then
                        self.RewardPassComplete =
                            false

                        return
                    end
                end

                if CollectibleInteractionBusy
                    or LootMoveState.Busy
                    or Settings.__LootFarmBusy
                then
                    self:SetStatus(
                        "waiting for reward loot before leaving"
                    )

                    return
                end

                Settings.__RewardRoomBusy =
                    true

                local Left =
                    self:LeaveRewardLobby()

                Settings.__RewardRoomBusy =
                    false

                if Left then
                    self.RewardPassComplete =
                        false

                    self.PostRunPending =
                        false
                end

                return
            end

            Settings.__RewardRoomBusy =
                false

            return
        end
    end

    ----------------------------------------------------------
    -- 2) ACTIVE CLIMB
    ----------------------------------------------------------

    if State == "Climbing"
        or self:IsDungeonRunning()
    then
        self.WasDungeonRunning =
            true

        self.PostRunPending =
            false

        self.RewardPassComplete =
            false

        table.clear(
            self.ProcessedRewardPrompts
        )

        Settings.__DungeonEntryBusy =
            false

        Settings.__RewardRoomBusy =
            false

        self:SetStatus(
            "dungeon active • state="
                .. tostring(
                    State
                )
                .. " • Hearts="
                .. tostring(
                    self:GetHearts()
                    or "?"
                )
                .. " • RunPoints="
                .. tostring(
                    self:GetRunPoints()
                )
        )

        self:CheckAutoDieAtPoints()

        return
    end

    Settings.__RewardRoomBusy =
        false

    ----------------------------------------------------------
    -- 3) QUEUE / READYUP
    ----------------------------------------------------------

    if not Settings.AutoOuwigaharaNormal then
        Settings.__DungeonEntryBusy =
            false

        return
    end

    local StartPad,
        ReadyUp =
        self:GetStartPad()

    if StartPad then
        self:SetStatus(
            ReadyUp
                and "pre-run lobby found"
                or "pre-run lobby • waiting for ReadyUp"
        )

        self:TriggerReadyUp(
            StartPad,
            ReadyUp
        )

        return
    end

    Settings.__DungeonEntryBusy =
        false

    if self:IsMenuReadyForQueue() then
        self:QueueNormal()

        return
    end

    self:SetStatus(
        "waiting • MinigameState="
            .. tostring(
                State
            )
    )
end

function AutoOuwigaharaController:Start()
    if self.Running then
        return
    end

    if not self:IsWorkerNeeded() then
        return
    end

    self.Running =
        true

    self.LoopID +=
        1

    self.LastQueueAttempt =
        0

    self.LastReadyAttempt =
        0

    self.LastStatus =
        nil

    self.TeleportHelperQueued =
        false

    self.WasDungeonRunning =
        false

    self.PostRunPending =
        false

    self.RewardBusy =
        false

    self.RewardPassComplete =
        false

    self.AutoDieBusy =
        false

    self.AutoDieTriggeredThisRun =
        false

    self.AutoDieSequenceId +=
        1

    self.LeaveCooldownUntil =
        0

    Settings.__RewardRoomBusy =
        false

    table.clear(
        self.ProcessedRewardPrompts
    )

    local MyLoopID =
        self.LoopID

    task.spawn(function()
        while HubRunning
            and self:IsWorkerNeeded()
            and self.Running
            and MyLoopID
                == self.LoopID
        do
            self:Step()

            task.wait(
                0.30
            )
        end

        if MyLoopID
            == self.LoopID
        then
            self.Running =
                false

            Settings.__DungeonEntryBusy =
                false

            Settings.__RewardRoomBusy =
                false
        end
    end)
end


function AutoOuwigaharaController:Stop()
    Settings.__DungeonEntryBusy =
        false

    Settings.__RewardRoomBusy =
        false

    self.Running =
        false

    self.LoopID +=
        1

    self.LastStatus =
        nil

    self.WasDungeonRunning =
        false

    self.PostRunPending =
        false

    self.RewardBusy =
        false

    self.RewardPassComplete =
        false

    self.AutoDieBusy =
        false

    self.AutoDieTriggeredThisRun =
        false

    self.AutoDieSequenceId +=
        1

    self.LeaveCooldownUntil =
        0

    table.clear(
        self.ProcessedRewardPrompts
    )
end


--// ============================================================
--// AUTO SKIP WAVE
--// ============================================================
--
-- Dungeon UI:
-- PlayerGui.ComponentsHolder.MainNotificationFrame
--     .OuwigaharaTopBar.Skip.Button
--
-- The controller reads the visible "Skip 0/1" style progress text and only
-- presses while the current votes are below the required amount.

local AutoSkipWaveController = {
    LoopID = 0,
    Running = false,
    LastClickAt = 0,
    ClickRetryDelay = 1.0,
}


function AutoSkipWaveController:GetSkipObjects()
    local PlayerGui =
        LocalPlayer:FindFirstChild(
            "PlayerGui"
        )

    if not PlayerGui then
        return nil,
            nil
    end

    local ComponentsHolder =
        PlayerGui:FindFirstChild(
            "ComponentsHolder"
        )

    local MainNotificationFrame =
        ComponentsHolder
        and ComponentsHolder:FindFirstChild(
            "MainNotificationFrame"
        )

    local TopBar =
        MainNotificationFrame
        and MainNotificationFrame:FindFirstChild(
            "OuwigaharaTopBar"
        )

    local Skip =
        TopBar
        and TopBar:FindFirstChild(
            "Skip"
        )

    local Button =
        Skip
        and Skip:FindFirstChild(
            "Button"
        )

    if not Button
        or not Button:IsA(
            "GuiButton"
        )
    then
        return Skip,
            nil
    end

    return Skip,
        Button
end


function AutoSkipWaveController:IsActuallyVisible(
    Object
)
    if not Object
        or not Object.Parent
    then
        return false
    end

    local Current =
        Object

    while Current
        and Current ~= game
    do
        if Current:IsA(
            "GuiObject"
        )
            and not Current.Visible
        then
            return false
        end

        if Current:IsA(
            "LayerCollector"
        )
            and not Current.Enabled
        then
            return false
        end

        Current =
            Current.Parent
    end

    return true
end


function AutoSkipWaveController:GetSkipProgress(
    Skip
)
    if not Skip then
        return nil,
            nil,
            nil
    end

    local TextCandidates = {}

    if Skip:IsA(
        "TextLabel"
    )
        or Skip:IsA(
            "TextButton"
        )
    then
        table.insert(
            TextCandidates,
            Skip
        )
    end

    for _,
        Descendant in ipairs(
            Skip:GetDescendants()
        )
    do
        if Descendant:IsA(
            "TextLabel"
        )
            or Descendant:IsA(
                "TextButton"
            )
        then
            table.insert(
                TextCandidates,
                Descendant
            )
        end
    end

    for _,
        Object in ipairs(
            TextCandidates
        )
    do
        local Text =
            tostring(
                Object.Text
                or ""
            )

        local Current,
            Required =
            string.match(
                Text,
                "(%d+)%s*/%s*(%d+)"
            )

        if Current
            and Required
        then
            return tonumber(
                Current
            ),
                tonumber(
                    Required
                ),
                Text
        end
    end

    return nil,
        nil,
        nil
end


function AutoSkipWaveController:PressButton(
    Button
)
    if not Button
        or not Button.Parent
    then
        return false
    end

    local Success =
        false

    if type(
        firesignal
    ) == "function"
    then
        local Ok =
            pcall(function()
                firesignal(
                    Button.MouseButton1Click
                )
            end)

        if Ok then
            Success =
                true
        end
    end

    if not Success then
        local Ok =
            pcall(function()
                Button:Activate()
            end)

        if Ok then
            Success =
                true
        end
    end

    if Success then
        self.LastClickAt =
            os.clock()
    end

    return Success
end


function AutoSkipWaveController:Step()
    if not HubRunning
        or not Settings.AutoSkipWave
    then
        return
    end

    local Skip,
        Button =
        self:GetSkipObjects()

    if not Skip
        or not Button
    then
        return
    end

    if not self:IsActuallyVisible(
        Skip
    )
        or not self:IsActuallyVisible(
            Button
        )
    then
        return
    end

    if not Button.Active then
        return
    end

    local Current,
        Required,
        DisplayText =
        self:GetSkipProgress(
            Skip
        )

    -- If the game exposes the vote count, only click while a vote is still
    -- needed. Example: Skip 0/1 -> click; Skip 1/1 -> wait.
    if Current
        and Required
    then
        if Required <= 0
            or Current >= Required
        then
            return
        end
    end

    if os.clock()
        - self.LastClickAt
        < self.ClickRetryDelay
    then
        return
    end

    if self:PressButton(
        Button
    )
    then
        HubDebug(
            "[Combat Hub] Auto Skip Wave pressed"
                .. (
                    DisplayText
                    and (
                        " • "
                        .. tostring(
                            DisplayText
                        )
                    )
                    or ""
                )
        )
    end
end


function AutoSkipWaveController:Start()
    if self.Running then
        return
    end

    Settings.AutoSkipWave =
        true

    self.Running =
        true

    self.LoopID +=
        1

    self.LastClickAt =
        0

    local MyLoopID =
        self.LoopID

    task.spawn(function()
        while HubRunning
            and Settings.AutoSkipWave
            and self.Running
            and MyLoopID
                == self.LoopID
        do
            self:Step()

            task.wait(
                0.20
            )
        end
    end)
end


function AutoSkipWaveController:Stop()
    Settings.AutoSkipWave =
        false

    self.Running =
        false

    self.LoopID +=
        1

    self.LastClickAt =
        0
end




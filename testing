local AutomationFlags = {
    "AutoWater",
    "AutoFarmFish",
    "AutoHomeWhenFull",
    "AutoSellFish",
    "AutoOpenEgg",
    "AutoCollectCash",
    "AutoBuyBestAura",
    "AutoBuyBestPump",
    "AutoBuyUpgrades",
    "AutoRebirth"
}

local function CountActiveAutomation()
    local Count = 0

    if Settings.AutoWater then Count += 1 end
    if Settings.AutoFarmFish then Count += 1 end
    if Settings.AutoHome then Count += 1 end
    if Settings.AutoSellFish then Count += 1 end
    if Settings.AutoOpenEgg then Count += 1 end
    if Settings.AutoCollectCash then Count += 1 end
    if Settings.AutoBuyBestAura then Count += 1 end
    if Settings.AutoBuyBestPump then Count += 1 end
    if Settings.AutoBuyUpgrades then Count += 1 end
    if Settings.AutoRebirth then Count += 1 end

    return Count
end

local function StopAllAutomation()
    for _, Flag in ipairs(AutomationFlags) do
        pcall(function()
            Window:Set(Flag, false)
        end)
    end

    Log("All automation stopped.")
    Toast("Automation stopped", "Every active toggle was disabled.")
end


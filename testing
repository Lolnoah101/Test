--// ============================================================
--// AUTO JOIN OUWIGAHARA NORMAL
--// ============================================================
--
-- Flow:
--   Main menu / HUB mode menu
--       -> QueueSignal("Queue", "Normal", false, false)
--   Ouwigahara lobby
--       -> teleport to workspace.Map["Minigame Map"].StartPad
--       -> trigger StartPad.ReadyUp
--   Active dungeon
--       -> hands control back to the regular dungeon systems.
--
-- The Rayfield flag is auto-saved by the hub's configuration, so if the
-- hub is auto-executed/re-run after a place teleport this toggle can resume.

local AutoOuwigaharaController = {
    LoopID = 0,
    Running = false,

    LastQueueAttempt = 0,
    QueueRetryDelay = 8.0,

    LastReadyAttempt = 0,
    ReadyRetryDelay = 2.0,

    LastStatus = nil,
    TeleportHelperQueued = false,

    -- Post-run reward state.
    WasDungeonRunning = false,
    PostRunPending = false,
    RewardBusy = false,
    RewardPassComplete = false,
    ProcessedRewardPrompts = {},
    RewardSpawnWait = 20,
    RewardCharacterWait = 15,

    -- Free caches can replicate a little later than the first batch.
    -- Never advance to the paid chest until the free list has stayed empty
    -- for this entire window.
    FreeChestEmptyConfirmTime = 2.25,

    -- A successful local prompt call is NOT treated as an opened cache.
    -- Confirm the cache actually opened/disappeared/disabled first.
    FreeChestOpenConfirmWait = 2.75,

    -- Keep retrying missing / late free caches for a while before allowing
    -- the reward state to advance.
    FreeChestRetryMaxWait = 35,

    -- Reward drops can appear after the chest prompt disappears. Give the
    -- first drop time to spawn, then require a quiet period after the last
    -- collected prompt before moving on.
    RewardLootRadius = 55,
    RewardLootSpawnWait = 2.75,
    RewardLootQuietWindow = 1.35,
    RewardLootMaxWait = 16,

    -- Require the Points balance to stay affordable briefly before moving
    -- to the paid Ouwigahara Chest.
    PaidAffordabilityConfirmTime = 0.40,

    -- Ouwigahara Shop reseals/unlocks the paid chest after 6 seconds.
    PaidResealSeconds = 6.25,
    PaidPromptRespawnWait = 7.50,

    -- If we can still afford the 30k chest, do not mark rewards finished
    -- just because its prompt is temporarily missing/disabled.
    PaidAcquireRetryWindow = 20,
    PaidTriggerRetryLimit = 8,

    LeavePromptWait = 8,
    LeaveTriggerRetries = 6,
    LeaveCooldownUntil = 0,

    -- Auto Die at X Points state.
    AutoDieBusy = false,
    AutoDieTriggeredThisRun = false,
    AutoDieSequenceId = 0,
    AutoDieRespawnCount = 3,
    AutoDieCharacterWait = 15,
}


function AutoOuwigaharaController:IsRewardAutomationEnabled()
    return Settings.AutoRewardChests
        or Settings.AutoLeaveDungeon
end


function AutoOuwigaharaController:IsWorkerNeeded()
    -- Queue/ReadyUp and reward-room actions share one lightweight worker,
    -- but each feature is now controlled by its own toggle.
    return Settings.AutoOuwigaharaNormal
        or Settings.AutoRewardChests
        or Settings.AutoLeaveDungeon
        or Settings.AutoDieAtPoints
end


function AutoOuwigaharaController:RefreshRunState()
    if self:IsWorkerNeeded() then
        self:Start()
    else
        self:Stop()
    end
end


function AutoOuwigaharaController:IsGuiActuallyVisible(
    Object
)
    if not Object
        or not Object.Parent
    then
        return false
    end

    local Current =
        Object

    while Current
        and Current ~= game
    do
        if Current:IsA(
            "GuiObject"
        )
            and not Current.Visible
        then
            return false
        end

        if Current:IsA(
            "LayerCollector"
        )
            and not Current.Enabled
        then
            return false
        end

        Current =
            Current.Parent
    end

    return true
end


function AutoOuwigaharaController:FindVisibleText(
    Root,
    Wanted
)
    if not Root then
        return false
    end

    Wanted =
        string.upper(
            tostring(
                Wanted
                or ""
            )
        )

    for _,
        Object in ipairs(
            Root:GetDescendants()
        )
    do
        if (
            Object:IsA(
                "TextLabel"
            )
            or Object:IsA(
                "TextButton"
            )
            or Object:IsA(
                "TextBox"
            )
        )
            and self:IsGuiActuallyVisible(
                Object
            )
        then
            local Text =
                string.upper(
                    tostring(
                        Object.Text
                        or ""
                    )
                )

            if string.find(
                Text,
                Wanted,
                1,
                true
            ) then
                return true
            end
        end
    end

    return false
end


function AutoOuwigaharaController:IsMenuReadyForQueue()
    local PlayerGui =
        LocalPlayer:FindFirstChild(
            "PlayerGui"
        )

    if not PlayerGui then
        return false
    end

    local Components =
        PlayerGui:FindFirstChild(
            "Components"
        )

    if not Components
        or not Components:IsA(
            "LayerCollector"
        )
        or not Components.Enabled
    then
        return false
    end

    -- Main menu screenshot:
    -- PLAY / CUSTOMIZE / HUB / SLOTS
    local MainMenu =
        self:FindVisibleText(
            Components,
            "PLAY"
        )
        and self:FindVisibleText(
            Components,
            "HUB"
        )

    if MainMenu then
        return true
    end

    -- If the user manually opened HUB first, still recognize the
    -- Ouwigahara Normal selection screen.
    return self:FindVisibleText(
        Components,
        "OUWIGAHARA"
    )
        and self:FindVisibleText(
            Components,
            "NORMAL"
        )
end



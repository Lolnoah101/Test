-- Every weapon uses the same 1 -> 5 combo structure.
-- The equipped weapon name is read from Items_ConfigServer.Last and sent
-- as the second Combat_Service argument.
--
-- Verified timings:
--   Fists/Combat = shared captured 1 -> 5 combo
--   Regular Katana = exact captured 1 -> 5 combo below
-- Dynamic remote combat test.
--
-- Keep the same direct Combat_Service method that already works, but
-- resolve new weapons from the game's own Items + Combat_presets data.
--
-- The hardcoded profiles stay as a fallback for the two captures we
-- already verified.

local SharedComboTimings = {
    [1] = 0.13,
    [2] = 0,
    [3] = 0,
    [4] = 0,
    [5] = 0.15,
}

local WeaponTimingOverrides = {
    ["Regular Katana"] = {
        [1] = 0.12500000000000003,
        [2] = 0.06500000000000003,
        [3] = 0.06500000000000003,
        [4] = 0.10000000000000001,
        [5] = 0.075000000000000011,
    },
}


local DynamicCombatData = nil
local DynamicCombatLoadTried = false
local DynamicCombatLoadError = nil


local function GetDynamicCombatData()
    if DynamicCombatData then
        return DynamicCombatData
    end

    if DynamicCombatLoadTried then
        return nil,
            DynamicCombatLoadError
    end

    DynamicCombatLoadTried =
        true

    local Success,
        Result =
        pcall(function()
            local CAM =
                ReplicatedStorage
                    :WaitForChild("CAM")

            local Global =
                CAM
                    :WaitForChild("Global")

            return {
                CombatPresets =
                    require(
                        Global
                            :WaitForChild(
                                "Combat_presets"
                            )
                    ),

                Items =
                    require(
                        Global
                            :WaitForChild(
                                "Collectibles"
                            )
                            :WaitForChild(
                                "Items"
                            )
                    ),

                Swings =
                    ReplicatedStorage
                        :WaitForChild("Effects")
                        :WaitForChild("Swings"),
            }
        end)

    if not Success
        or type(Result) ~= "table"
    then
        DynamicCombatLoadError =
            tostring(
                Result
            )

        return nil,
            DynamicCombatLoadError
    end

    DynamicCombatData =
        Result

    return DynamicCombatData
end


local function GetLastEquippedItemName()
    local ConfigServer =
        LocalPlayer:FindFirstChild(
            "Items_ConfigServer"
        )

    local Last =
        ConfigServer
        and ConfigServer:FindFirstChild(
            "Last"
        )

    if Last
        and Last:IsA(
            "StringValue"
        )
    then
        local Value =
            tostring(
                Last.Value
                or ""
            )

        if Value ~= "" then
            return Value
        end
    end

    return "Combat"
end


local function ResolveCombatContext()
    local EquippedName =
        GetLastEquippedItemName()

    local Data =
        GetDynamicCombatData()

    if not Data
        or not Data.CombatPresets
        or not Data.CombatPresets.Presets
    then
        return {
            EquippedName =
                EquippedName,

            RemoteName =
                EquippedName,

            AlternateSwing =
                nil,

            Preset =
                nil,

            Dynamic =
                false,
        }
    end

    local Presets =
        Data.CombatPresets
            .Presets

    -- Same general resolution pattern seen in the game's Combat script:
    -- 1) direct preset by equipped name
    -- 2) otherwise use the item's CombatPreset
    -- 3) combat-capable items without one fall back to Regular Katana
    local DirectPreset =
        Presets[
            EquippedName
        ]

    if DirectPreset then
        return {
            EquippedName =
                EquippedName,

            RemoteName =
                EquippedName,

            AlternateSwing =
                nil,

            Preset =
                DirectPreset,

            Dynamic =
                true,
        }
    end

    local ItemData =
        Data.Items
        and Data.Items[
            EquippedName
        ]

    if ItemData then
        local RemoteName =
            ItemData.CombatPreset

        if not RemoteName
            and (
                ItemData.HasCombat
                or ItemData.Breathing
            )
        then
            RemoteName =
                "Regular Katana"
        end

        if RemoteName
            and Presets[
                RemoteName
            ]
        then
            local AlternateSwing =
                nil

            if Data.Swings
                and Data.Swings
                    :FindFirstChild(
                        EquippedName
                        .. "_Swings"
                    )
            then
                AlternateSwing =
                    EquippedName
            end

            return {
                EquippedName =
                    EquippedName,

                RemoteName =
                    RemoteName,

                AlternateSwing =
                    AlternateSwing,

                Preset =
                    Presets[
                        RemoteName
                    ],

                Dynamic =
                    true,
            }
        end
    end

    return {
        EquippedName =
            EquippedName,

        RemoteName =
            EquippedName,

        AlternateSwing =
            nil,

        Preset =
            nil,

        Dynamic =
            false,
    }
end


local function GetFallbackCombatTiming(
    RemoteName,
    Stage
)
    local Override =
        WeaponTimingOverrides[
            RemoteName
        ]

    if Override
        and Override[
            Stage
        ] ~= nil
    then
        return Override[
            Stage
        ]
    end

    return SharedComboTimings[
        Stage
    ]
end


local function GetDynamicCombatTiming(
    Context,
    Stage
)
    if not Context
        or not Context.Dynamic
        or not Context.Preset
    then
        return nil
    end

    local Data =
        GetDynamicCombatData()

    if not Data
        or not Data.CombatPresets
    then
        return nil
    end

    local Preset =
        Context.Preset

    -- Normal ground M1 path:
    -- runHitPreset(Preset, false) normally returns the same preset,
    -- but call it because the game's combat script does.
    local ActivePreset =
        Preset

    if type(
        Data.CombatPresets
            .runHitPreset
    ) == "function"
    then
        local Success,
            Result =
            pcall(
                Data.CombatPresets
                    .runHitPreset,
                Preset,
                false
            )

        if Success
            and type(Result)
                == "table"
        then
            ActivePreset =
                Result
        end
    end

    local BeforeSwingTable =
        ActivePreset
            .delay_before_swing

    local BeforeSwing =
        (
            BeforeSwingTable
            and BeforeSwingTable[
                Stage
            ]
        )
        or ActivePreset
            .default_before_swing
        or Data.CombatPresets
            .Default_Swing_Wait
        or 0

    local BeforeHitTable =
        ActivePreset
            .delay_before_hit

    local BeforeHit =
        (
            BeforeHitTable
            and BeforeHitTable[
                Stage
            ]
        )
        or ActivePreset
            .default_before_hit
        or BeforeSwing

    local AttackSpeed =
        1

    if type(
        Data.CombatPresets
            .attackSpeedMult
    ) == "function"
    then
        local Success,
            Result =
            pcall(
                Data.CombatPresets
                    .attackSpeedMult,
                LocalPlayer
            )

        if Success
            and tonumber(
                Result
            )
        then
            AttackSpeed =
                tonumber(
                    Result
                )
        end
    end

    if AttackSpeed == 0 then
        AttackSpeed =
            1
    end

    -- Exact normal-ground formula from Main_Combat_Script_Client:
    -- (delay_before_hit - delay_before_swing) / attackSpeedMult
    local Timing =
        (
            BeforeHit
            - BeforeSwing
        )
        / AttackSpeed

    return Timing
end


local function GetCombatTiming(
    Context,
    Stage
)
    local DynamicTiming =
        GetDynamicCombatTiming(
            Context,
            Stage
        )

    if DynamicTiming ~= nil then
        return DynamicTiming,
            true
    end

    return GetFallbackCombatTiming(
        Context
            and Context.RemoteName
            or "Combat",
        Stage
    ),
        false
end


local function EquipWeaponSlot(
    Slot
)
    Slot =
        math.clamp(
            tonumber(Slot)
                or 1,
            1,
            5
        )

    Settings.WeaponSlot =
        Slot

    local ItemsConfig =
        LocalPlayer:FindFirstChild(
            "Items_Config"
        )

    local Equipped =
        ItemsConfig
        and ItemsConfig:FindFirstChild(
            "Equipped"
        )

    if Equipped
        and Equipped:IsA(
            "IntValue"
        )
    then
        -- The game's toolbar code listens to Equipped.Changed and
        -- sends Item_Equip with this value.
        if Equipped.Value ~= Slot then
            Equipped.Value =
                Slot
        else
            -- If the slot is already selected locally, send one exact
            -- captured equip request so selecting the dropdown still
            -- refreshes the equipped slot.
            pcall(function()
                CombatEvent:FireServer(
                    "Item_Equip",
                    Slot
                )
            end)
        end

        return true
    end

    -- Fallback if Items_Config has not replicated yet.
    local Success =
        pcall(function()
            CombatEvent:FireServer(
                "Item_Equip",
                Slot
            )
        end)

    return Success
end



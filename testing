local function ResolveAggroNpcModel(
    Object
)
    if not Object
        or not Object.Parent
    then
        return nil
    end

    local Candidate =
        Object

    if Candidate:IsA(
        "Humanoid"
    ) then
        Candidate =
            Candidate.Parent
    elseif Candidate:IsA(
        "BasePart"
    ) then
        Candidate =
            Candidate:FindFirstAncestorOfClass(
                "Model"
            )
    end

    if Candidate
        and Candidate:IsA(
            "Model"
        )
    then
        local Humanoid =
            Candidate:FindFirstChildWhichIsA(
                "Humanoid",
                true
            )

        if Humanoid
            and Humanoid.Health > 0
            and Candidate
                ~= LocalPlayer.Character
            and not Players:GetPlayerFromCharacter(
                Candidate
            )
        then
            return Candidate
        end
    end

    -- ObjectValues can occasionally point at an outer NPC folder/model.
    -- Find the living inner model if needed.
    for _,
        Descendant in ipairs(
            Object:GetDescendants()
        )
    do
        if Descendant:IsA(
            "Model"
        )
        then
            local Humanoid =
                Descendant:FindFirstChildWhichIsA(
                    "Humanoid",
                    true
                )

            if Humanoid
                and Humanoid.Health > 0
                and not Players:GetPlayerFromCharacter(
                    Descendant
                )
            then
                return Descendant
            end
        end
    end

    return nil
end


local function GetAggroNpcRoot(
    Model
)
    if not Model
        or not Model.Parent
    then
        return nil
    end

    return Model:FindFirstChild(
        "HumanoidRootPart",
        true
    )
        or Model.PrimaryPart
        or Model:FindFirstChildWhichIsA(
            "BasePart",
            true
        )
end


local function FindAggroedEnemyTarget()
    local Character =
        LocalPlayer.Character

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Character
        or not Root
    then
        return nil
    end

    local Best =
        nil

    local BestDistance =
        math.huge

    local Seen =
        {}

    local function Consider(
        Object
    )
        local Model =
            ResolveAggroNpcModel(
                Object
            )

        if not Model
            or Seen[
                Model
            ]
        then
            return
        end

        Seen[
            Model
        ] =
            true

        local Humanoid =
            Model:FindFirstChildWhichIsA(
                "Humanoid",
                true
            )

        local NpcRoot =
            GetAggroNpcRoot(
                Model
            )

        if not Humanoid
            or Humanoid.Health <= 0
            or not NpcRoot
        then
            return
        end

        local Distance =
            (
                NpcRoot.Position
                - Root.Position
            ).Magnitude

        if Distance
            < BestDistance
        then
            BestDistance =
                Distance

            Best =
                Model
        end
    end

    ----------------------------------------------------------
    -- BEST SIGNAL:
    -- Character.NpcsFollowing contains NPC ObjectValues that are actively
    -- following/targeting this player.
    ----------------------------------------------------------

    local Following =
        Character:FindFirstChild(
            "NpcsFollowing"
        )

    if Following then
        for _,
            ValueObject in ipairs(
                Following:GetChildren()
            )
        do
            if ValueObject:IsA(
                "ObjectValue"
            )
                and ValueObject.Value
            then
                Consider(
                    ValueObject.Value
                )
            end
        end
    end

    if Best then
        return Best
    end

    ----------------------------------------------------------
    -- FALLBACK:
    -- Some NPC implementations expose Aggroed=true directly.
    -- Only run this wider scan when NpcsFollowing gave us nothing.
    ----------------------------------------------------------

    local Humanoids =
        workspace:FindFirstChild(
            "Humanoids"
        )

    local Regions =
        Humanoids
        and Humanoids:FindFirstChild(
            "Regions"
        )

    if Regions then
        for _,
            Object in ipairs(
                Regions:GetDescendants()
            )
        do
            if Object:IsA(
                "Model"
            )
                and Object:GetAttribute(
                    "Aggroed"
                ) == true
            then
                Consider(
                    Object
                )
            end
        end
    end

    return Best
end


function LootMoveState:CancelTween()

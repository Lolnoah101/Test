    local Weight =
        tonumber(Tool:GetAttribute("Weight"))
        or tonumber(Tool:GetAttribute("BaseWeight"))

    if Weight then
        return Weight
    end

    -- Fallback for tools whose weight is embedded in the display name.
    local FromName =
        tostring(Tool.Name):match(
            "%[([%d%.]+)%s*[Kk][Gg]%]"
        )

    return tonumber(FromName) or 0
end


local function GetBackpackEggNames()
    local Seen = {}
    local Names = {}

    -- Include equipped egg too, so the dropdown does not lose it
    -- while placement is in progress.
    local Character = LocalPlayer.Character

    local function AddFrom(Container)
        if not Container then
            return
        end

        for _, Child in ipairs(Container:GetChildren()) do
            if IsEggTool(Child) and not Seen[Child.Name] then
                Seen[Child.Name] = true
                table.insert(Names, Child.Name)
            end
        end
    end

    AddFrom(Backpack)
    AddFrom(Character)

    table.sort(Names)

    return Names
end


local function NormalizeNameSelection(Value)
    local Selected = {}

    if typeof(Value) == "string" then
        Selected[Value] = true
        return Selected
    end

    if typeof(Value) ~= "table" then
        return Selected
    end

    for Key, Entry in pairs(Value) do
        if typeof(Key) == "number" and typeof(Entry) == "string" then
            Selected[Entry] = true

        elseif typeof(Key) == "string" then
            if Entry == true then
                Selected[Key] = true

            elseif typeof(Entry) == "string" then
                Selected[Entry] = true
            end
        end
    end

    return Selected
end


local function GetSelectedNameText(Selection)
    local Names = {}

    for Name, Enabled in pairs(Selection) do
        if Enabled then
            table.insert(Names, Name)
        end
    end

    table.sort(Names)

    if #Names == 0 then
        return "None"
    end

    return table.concat(Names, ", ")
end


local function FindSelectedEggTool(Selection)
    local Candidates = {}

    local function AddFrom(Container)
        if not Container then
            return
        end

        for _, Child in ipairs(Container:GetChildren()) do
            if IsEggTool(Child)
                and Selection[Child.Name]
            then
                table.insert(Candidates, Child)
            end
        end
    end

    AddFrom(LocalPlayer.Character)
    AddFrom(Backpack)

    table.sort(
        Candidates,
        function(A, B)
            local APriority =
                PreferredEggPriority[A.Name] or 999

            local BPriority =
                PreferredEggPriority[B.Name] or 999

            -- Cherub Egg always wins, then Blackhole Egg.
            if APriority ~= BPriority then
                return APriority < BPriority
            end

            -- For two eggs of the same tier, use the heavier egg first.
            local AWeight = GetEggWeight(A)
            local BWeight = GetEggWeight(B)

            if AWeight ~= BWeight then
                return AWeight > BWeight
            end

            return A.Name < B.Name
        end
    )

    return Candidates[1]
end

local function EquipSelectedEggTool(Selection)
    local Character = GetCharacter()
    local Humanoid =
        Character and Character:FindFirstChildOfClass("Humanoid")

    local Tool =
        FindSelectedEggTool(Selection)

    if not Humanoid or not Tool then
        return nil
    end

    if Tool.Parent ~= Character then
        pcall(function()
            Humanoid:EquipTool(Tool)
        end)

        task.wait(0.08)
    end

    if Tool.Parent == Character then
        return Tool
    end

    return nil
end


local function AutoPlaceOneEgg(Force)
    if not Force and not Settings.AutoPlaceEgg then
        return false, "Auto Place Egg is disabled."
    end

    local Plot =
        GetPlayerPlot()

    if not Plot then
        return false, "Your plot could not be found."
    end

    -- The updated game uses free placement instead of nests.
    if LocalPlayer:GetAttribute("NoNest") ~= true then
        return false, "Free plot egg placement is not active yet."
    end

    local BeforeCount =
        GetPlacedEggCountForPlot(Plot)

    if BeforeCount >= MAX_PLOT_EGGS then
        return false, "Plot already has 10 eggs."
    end

    if next(Settings.SelectedPlaceEggs) == nil then
        return false, "No backpack egg types are selected."
    end

    local PlantPosition =
        GetNextPlotPlacementPosition(Plot)

    if not PlantPosition then
        return false, "No clear placement spot was found inside your plot."
    end

    local Tool =
        EquipSelectedEggTool(
            Settings.SelectedPlaceEggs
        )

    if not Tool then
        return false, "No selected egg Tool is currently in your Backpack."
    end

    local ToolName = Tool.Name

    Log(
        "Placing "
            .. tostring(ToolName)
            .. " on plot • "
            .. tostring(BeforeCount + 1)
            .. "/"
            .. tostring(MAX_PLOT_EGGS)
    )

    local Success, ErrorMessage =
        pcall(function()
            EggPlacedEvent:FireServer({
                PlantPosition = PlantPosition
            })
        end)

    if not Success then
        return false, tostring(ErrorMessage)
    end

    -- Wait for the plot's Eggs folder to confirm another egg appeared.
    local Started = os.clock()

    while os.clock() - Started < 2 do
        local CurrentCount =
            GetPlacedEggCountForPlot(Plot)

        if CurrentCount > BeforeCount then
            Log(
                tostring(ToolName)
                    .. " placed on plot • "
                    .. tostring(CurrentCount)
                    .. "/"
                    .. tostring(MAX_PLOT_EGGS)
            )

            return true, PlantPosition, ToolName
        end

        task.wait(0.05)
    end

    -- The request was sent; replication may simply be delayed.
    return true, PlantPosition, ToolName
end



--==================================================
-- ENEMY CHECK
--==================================================

local function isEntityAlive(entity)
    if not entity or not entity.Parent then
        return false
    end

    local humanoid = entity:FindFirstChildOfClass("Humanoid")

    if humanoid then
        return humanoid.Health > 0
    end

    if entity:GetAttribute("Dead") == true then
        return false
    end

    local health = entity:GetAttribute("Health")

    if health ~= nil then
        local numericHealth = tonumber(health)

        if numericHealth then
            return numericHealth > 0
        end
    end

    return false
end

--==================================================
-- NPC FOLDER
--==================================================

local function getNPCFolder()
    for _, object in ipairs(workspace:GetChildren()) do
        if string.find(object.Name, "Generated_") then

            local folder = object:FindFirstChild("NPCs")

            if folder then
                return folder
            end
        end
    end

    return nil
end

--==================================================
-- GET ENEMIES
--==================================================

local function getAllEnemies()
    local enemies = {}

    local npcFolder = getNPCFolder()

    if not npcFolder then
        return enemies
    end

    for _, enemy in ipairs(npcFolder:GetChildren()) do

        if isEntityAlive(enemy) then

            local root =
                enemy:FindFirstChild("HumanoidRootPart")
                or enemy:FindFirstChildWhichIsA("BasePart")

            if root then
                table.insert(enemies, enemy)
            end
        end
    end

    return enemies
end

--==================================================
-- CLOSEST ENEMY
--==================================================

local function getClosestEnemy()
    local character = LocalPlayer.Character

    if not character then
        return nil
    end

    local hrp = character:FindFirstChild("HumanoidRootPart")

    if not hrp then
        return nil
    end

    local closest = nil
    local closestDistance = math.huge

    for _, enemy in ipairs(getAllEnemies()) do

        local root =
            enemy:FindFirstChild("HumanoidRootPart")
            or enemy:FindFirstChildWhichIsA("BasePart")

        if root and isEntityAlive(enemy) then

            local dist =
                (hrp.Position - root.Position).Magnitude

            if dist < closestDistance then

                closestDistance = dist

                closest = {
                    entity = enemy,
                    part = root,
                    distance = dist
                }
            end
        end
    end

    return closest
end

--==================================================
-- CLEANUP MOVEMENT
--==================================================

local function cleanupMovement()

    if farmConnection then
        farmConnection:Disconnect()
        farmConnection = nil
    end

    if bodyPosition then
        bodyPosition:Destroy()
        bodyPosition = nil
    end

    if bodyGyro then
        bodyGyro:Destroy()
        bodyGyro = nil
    end

    local character = LocalPlayer.Character

    if character then
        local humanoid =
            character:FindFirstChildOfClass("Humanoid")

        if humanoid then
            humanoid.AutoRotate = true
        end
    end

    currentTarget = nil
end

--==================================================
-- CREATE MOVEMENT
--==================================================

local function createMovement(hrp)

    cleanupMovement()

    if not hrp then
        return
    end

    local character = hrp.Parent

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    -- Stop Roblox from changing our rotation
    if humanoid then
        humanoid.AutoRotate = false
    end

    -- POSITION
    bodyPosition = Instance.new("BodyPosition")

    bodyPosition.Name = "AutoFarmPosition"

    bodyPosition.MaxForce =
        Vector3.new(
            math.huge,
            math.huge,
            math.huge
        )

    bodyPosition.P = 25000
    bodyPosition.D = 1500
    bodyPosition.Position = hrp.Position

    bodyPosition.Parent = hrp

    -- ROTATION
    bodyGyro = Instance.new("BodyGyro")

    bodyGyro.Name = "AutoFarmGyro"

    bodyGyro.MaxTorque =
        Vector3.new(
            math.huge,
            math.huge,
            math.huge
        )

    bodyGyro.P = 25000
    bodyGyro.D = 1500
    bodyGyro.CFrame = hrp.CFrame

    bodyGyro.Parent = hrp
end

--==================================================
-- TARGET POSITION
--==================================================

local function getTargetPosition(targetPart)

    if not targetPart or not targetPart.Parent then
        return nil, nil
    end

    local enemyPosition = targetPart.Position

    local targetPosition

    if selectedMode == "Above" then

        targetPosition =
            enemyPosition +
            Vector3.new(0, distance, 0)

    elseif selectedMode == "Below" then

        targetPosition =
            enemyPosition -
            Vector3.new(0, distance, 0)

    elseif selectedMode == "Behind" then

        local lookVector =
            targetPart.CFrame.LookVector

        targetPosition =
            enemyPosition -
            lookVector * distance

    elseif selectedMode == "Circle" then

        local angle = os.clock() * 3

        targetPosition =
            enemyPosition +
            Vector3.new(
                math.cos(angle) * distance,
                1,
                math.sin(angle) * distance
            )
    end

    return targetPosition, enemyPosition
end

--==================================================
-- FACE ENEMY
--==================================================

local function faceEnemy(hrp, enemyPosition)

    if not bodyGyro then
        return
    end

    if not hrp then
        return
    end

    local direction =
        enemyPosition - hrp.Position

    if direction.Magnitude < 0.01 then
        return
    end

    -- This makes the character's front point
    -- directly toward the enemy.
    bodyGyro.CFrame =
        CFrame.lookAt(
            hrp.Position,
            enemyPosition
        )
end

--==================================================
-- UPDATE FARM
--==================================================

local function updateFarm()

    if not getgenv().AutoFarm then
        return
    end

    local character = LocalPlayer.Character

    if not character then
        return
    end

    local hrp =
        character:FindFirstChild("HumanoidRootPart")

    if not hrp then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    -- Keep AutoRotate disabled
    if humanoid then
        humanoid.AutoRotate = false
    end

    -- Recreate movement if necessary
    if not bodyPosition
        or bodyPosition.Parent ~= hrp
        or not bodyGyro
        or bodyGyro.Parent ~= hrp then

        createMovement(hrp)
    end

    --==================================================
    -- CHECK CURRENT TARGET
    --==================================================

    if currentTarget then

        local enemy = currentTarget.entity

        if not isEntityAlive(enemy) then

            currentTarget = nil

        else

            local root =
                enemy:FindFirstChild("HumanoidRootPart")
                or enemy:FindFirstChildWhichIsA("BasePart")

            if root then

                currentTarget.part = root

                local targetPosition, enemyPosition =
                    getTargetPosition(root)

                if targetPosition then

                    -- Move toward target
                    bodyPosition.Position =
                        targetPosition

                    -- CONSTANTLY FACE TARGET
                    faceEnemy(
                        hrp,
                        enemyPosition
                    )
                end

                return
            end

            currentTarget = nil
        end
    end

    --==================================================
    -- FIND NEW TARGET
    --==================================================

    local newTarget = getClosestEnemy()

    if newTarget then

        currentTarget = newTarget

        print(
            "[AutoFarm] Target:",
            newTarget.entity.Name
        )

        local targetPosition, enemyPosition =
            getTargetPosition(newTarget.part)

        if targetPosition then

            bodyPosition.Position =
                targetPosition

            faceEnemy(
                hrp,
                enemyPosition
            )
        end
    end
end


        )
        or string.find(
            Name,
            "critical",
            1,
            true
        )
        or string.find(
            Name,
            "crit",
            1,
            true
        )
    then
        return 0
    end

    return 0.10
end


function AutoBestEquipmentController:GetPriorityWeight(
    StatName
)
    if self:GetPriority()
        == "Health"
    then
        return self:GetHealthWeight(
            StatName
        )
    end

    return self:GetDamageWeight(
        StatName
    )
end


function AutoBestEquipmentController:IsLowerBetterStat(
    StatName
)
    local Name =
        self:NormalizeStatName(
            StatName
        )

    -- Explicit positive reduction bonuses should NOT be inverted.
    if string.find(
        Name,
        "reduction",
        1,
        true
    )
    then
        return false
    end

    return string.find(
        Name,
        "cost",
        1,
        true
    ) ~= nil
        or string.find(
            Name,
            "delay",
            1,
            true
        ) ~= nil
        or string.find(
            Name,
            "damage taken",
            1,
            true
        ) ~= nil
        or string.find(
            Name,
            "damage received",
            1,
            true
        ) ~= nil
        or string.find(
            Name,
            "incoming damage",
            1,
            true
        ) ~= nil
end


function AutoBestEquipmentController:ScoreStats(
    Stats,
    ItemName,
    ItemInstance,
    Definition
)
    if type(
        Stats
    ) ~= "table"
    then
        return 0,
            0,
            0
    end

    local RefineLevel =
        self:GetRefineLevel(
            ItemInstance
        )

    local SeriesMultiplier =
        self:GetSeriesMultiplier(
            ItemInstance
        )

    local Score =
        0

    local RelevantStats =
        0

    local TotalStats =
        0

    for StatName,
        RawValue in pairs(
            Stats
        )
    do
        if type(
            RawValue
        ) == "number"
            and RawValue ~= 0
        then
            TotalStats +=
                1

            local Value =
                RawValue

            if Definition.Refinable
                == true
            then
                Value *=
                    self:GetRefinementMultiplier(
                        ItemName,
                        StatName,
                        RefineLevel
                    )
            end

            Value *=
                SeriesMultiplier

            local Weight =
                self:GetPriorityWeight(
                    StatName
                )

            if Weight > 0 then
                local Magnitude =
                    self:NormalizeStatMagnitude(
                        StatName,
                        Value
                    )

                if self:IsLowerBetterStat(
                    StatName
                )
                then
                    Magnitude =
                        -Magnitude
                end

                Score +=
                    Magnitude
                    * Weight

                if Weight >= 1 then
                    RelevantStats +=
                        1
                end
            end
        elseif RawValue
            == true
        then
            TotalStats +=
                1

            local Weight =
                self:GetPriorityWeight(
                    StatName
                )

            if Weight > 0 then
                Score +=
                    5
                    * Weight

                if Weight >= 1 then
                    RelevantStats +=
                        1
                end
            end
        end
    end

    return Score,
        RelevantStats,
        TotalStats
end


function AutoBestEquipmentController:BuildGearCandidate(
    ItemInstance
)
    if not ItemInstance
        or not ItemInstance.Parent
    then
        return nil
    end

    local ItemName =
        ItemInstance.Name

    local Definition =
        self.Items[
            ItemName
        ]

    if type(
        Definition
    ) ~= "table"
    then
        return nil
    end

    local Types =
        self.Menum.ItemEquipType

    if type(
        Types
    ) ~= "table"
    then
        return nil
    end

    local EquipType =
        Definition.EquipType

    local IsGear =
        EquipType
            == Types.Accessory
        or EquipType
            == Types.Costume
        or EquipType
            == Types.Clothing

    if not IsGear then
        return nil
    end

    if type(
        Definition.Stats
    ) ~= "table"
    then
        return nil
    end

    local Id =
        self:GetItemId(
            ItemInstance
        )

    if not Id then
        return nil
    end

    local Score,
        RelevantStats,
        TotalStats =
        self:ScoreStats(
            Definition.Stats,
            ItemName,
            ItemInstance,
            Definition
        )

    local DamageVector =
        self:GetDamageComparisonVector(
            Definition.Stats,
            ItemName,
            ItemInstance,
            Definition
        )

    if TotalStats <= 0 then
        return nil
    end

    local Rarity =
        tonumber(
            Definition.Rarity
        )
        or 0

    local RefineLevel =
        self:GetRefineLevel(
            ItemInstance
        )

    -- Priority stats determine the winner. Rarity/refine are deliberately
    -- tiny tie-breakers so "Damage" and "Health" actually mean what they say.
    Score +=
        Rarity
        * 0.0001
        + RefineLevel
        * 0.00001

    return {
        Name =
            ItemName,

        Id =
            Id,

        Score =
            Score,

        DamageVector =
            DamageVector,

        RelevantStats =
            RelevantStats,

        TotalStats =
            TotalStats,

        Rarity =
            Rarity,

        RefineLevel =
            RefineLevel,

        -- InventoryCategory is diagnostic only. Multiple gear pieces from
        -- the same category are allowed and are NOT filtered out.
        InventoryCategory =
            Definition.InventoryCategory,

        EquipType =
            EquipType,

        Instance =
            ItemInstance,
    }
end


function AutoBestEquipmentController:GetInventoryItemById(
    Data,
    ItemId
)
    ItemId =
        tonumber(
            ItemId
        )

    if not ItemId
        or ItemId == 0
    then
        return nil
    end

    -- The game's Inventory UI uses Character_info_provider.GetItemFromId
    -- for equipped accessory IDs. Prefer the same lookup here.
    if self.CharacterInfo
        and type(
            self.CharacterInfo.GetItemFromId
        ) == "function"
    then
        local Success,
            Item =
            pcall(
                self.CharacterInfo.GetItemFromId,
                LocalPlayer,
                ItemId
            )

        if Success
            and Item
        then
            return Item
        end
    end

    -- Fallback to scanning the inventory data tree.
    local Inventory =
        Data
        and Data.Inventory
        and Data.Inventory.Inventory

    if not Inventory then
        return nil
    end

    for _,
        ItemInstance in ipairs(
            Inventory:GetChildren()
        )
    do
        local Id =
            ItemInstance:FindFirstChild(
                "Id"
            )

        if Id
            and Id:IsA(
                "ValueBase"
            )
            and tonumber(
                Id.Value
            ) == ItemId
        then
            return ItemInstance
        end
    end

    return nil
end

function AutoBestEquipmentController:GetInventoryItemNameById(
    Data,
    ItemId
)
    local ItemInstance =
        self:GetInventoryItemById(
            Data,
            ItemId
        )

    return ItemInstance
        and ItemInstance.Name
        or nil
end


function AutoBestEquipmentController:GetConflictKey(
    NameA,
    NameB
)
    NameA =
        tostring(
            NameA
            or ""
        )

    NameB =
        tostring(
            NameB
            or ""
        )

    if NameA == ""
        or NameB == ""
        or NameA == NameB
    then
        return nil
    end

    if NameA < NameB then
        return NameA
            .. "\0"
            .. NameB
    end

    return NameB
        .. "\0"
        .. NameA
end


function AutoBestEquipmentController:HasConflict(
    NameA,
    NameB
)
    local Key =
        self:GetConflictKey(
            NameA,
            NameB
        )

    return Key ~= nil
        and self.ConflictPairs[
            Key
        ] == true
end


function AutoBestEquipmentController:LearnConflict(
    NameA,
    NameB
)
    local Key =
        self:GetConflictKey(
            NameA,
            NameB
        )

    if not Key then
        return false
    end

    if self.ConflictPairs[
        Key
    ] then
        return false
    end

    self.ConflictPairs[
        Key
    ] =
        true

    warn(
        "[Combat Hub] Auto Best Equipment: learned SPECIFIC gear conflict • "
            .. tostring(
                NameA
            )
            .. " ↔ "
            .. tostring(
                NameB
            )
            .. " • this is NOT a category restriction"
    )

    return true
end

function AutoBestEquipmentController:BuildCompatibleDesiredSet(
    Candidates
)
    local Desired =
        {}

    local UsedCategories =
        {}

    for _,
        Candidate in ipairs(
            Candidates
        )
    do
        local Category =
            Candidate.InventoryCategory

        local CategoryKey

        if Category ~= nil
            and tostring(
                Category
            ) ~= ""
        then
            CategoryKey =
                tostring(
                    Category
                )
        else
            -- If an item definition is missing InventoryCategory, do not
            -- incorrectly merge it with unrelated gear.
            CategoryKey =
                "__ITEM__"
                .. tostring(
                    Candidate.Name
                )
        end

        if not UsedCategories[
            CategoryKey
        ]
        then
            UsedCategories[
                CategoryKey
            ] =
                true

            table.insert(
                Desired,
                Candidate
            )

            if #Desired >= 5 then
                break
            end
        end
    end

    return Desired
end

function AutoBestEquipmentController:FindCandidateByName(
    Candidates,
    Name
)
    for _,
        Candidate in ipairs(
            Candidates
        )
    do
        if Candidate.Name == Name then
            return Candidate
        end
    end

    return nil
end


function AutoBestEquipmentController:SnapshotStatsSlots(
    Data,
    StatsSlots
)
    local Snapshot =
        {}

    for _,
        SlotName in ipairs(
            self.SlotNames
        )
    do
        local Slot =
            StatsSlots:FindFirstChild(
                SlotName
            )

        local Id =
            Slot
            and tonumber(
                Slot.Value
            )
            or 0

        Snapshot[
            SlotName
        ] = {
            Id =
                Id,

            Name =
                Id ~= 0
                and self:GetInventoryItemNameById(
                    Data,
                    Id
                )
                or nil,
        }
    end

    return Snapshot
end


function AutoBestEquipmentController:TryEquipAndDetectConflict(
    Data,
    StatsSlots,
    SlotName,
    Candidate,
    Candidates
)
    local Before =
        self:SnapshotStatsSlots(
            Data,
            StatsSlots
        )

    local Sent =
        self:SendAccessoryEquip(
            SlotName,
            Candidate.Id
        )

    if not Sent then
        return false,
            false
    end

    local Applied =
        self:WaitForStatsSlot(
            StatsSlots,
            SlotName,
            Candidate.Id,
            1.50
        )

    if not Applied then
        return false,
            false
    end

    task.wait(
        self.ConflictSettleWait
    )

    ----------------------------------------------------------
    -- SAME-CATEGORY DISPLACEMENT IS EXPECTED.
    --
    -- The game allows only one Stats item from each inventory
    -- category. Because BuildCompatibleDesiredSet already chooses
    -- the highest-scoring item in each category, a same-category
    -- displacement is not treated as an unknown conflict.
    ----------------------------------------------------------

    local LearnedAny =
        false

    for _,
        OtherSlotName in ipairs(
            self.SlotNames
        )
    do
        if OtherSlotName
            ~= SlotName
        then
            local BeforeInfo =
                Before[
                    OtherSlotName
                ]

            local OtherSlot =
                StatsSlots:FindFirstChild(
                    OtherSlotName
                )

            local AfterId =
                OtherSlot
                and tonumber(
                    OtherSlot.Value
                )
                or 0

            if BeforeInfo
                and BeforeInfo.Id ~= 0
                and BeforeInfo.Id ~= AfterId
                and BeforeInfo.Name
                and BeforeInfo.Name
                    ~= Candidate.Name
            then
                local Displaced =
                    self:FindCandidateByName(
                        Candidates,
                        BeforeInfo.Name
                    )

                local SameCategory =
                    Displaced
                    and Candidate.InventoryCategory ~= nil
                    and Displaced.InventoryCategory ~= nil
                    and tostring(
                        Candidate.InventoryCategory
                    ) == tostring(
                        Displaced.InventoryCategory
                    )

                if SameCategory then
                    HubDebug(
                        "[Combat Hub] Auto Best Equipment: category replacement • "
                            .. tostring(
                                Candidate.InventoryCategory
                            )
                            .. " • "
                            .. tostring(
                                BeforeInfo.Name
                            )
                            .. " → "
                            .. tostring(
                                Candidate.Name
                            )
                    )
                else
                    -- Keep the learned-pair fallback only for unexpected
                    -- cross-category restrictions.
                    if self:LearnConflict(
                        Candidate.Name,
                        BeforeInfo.Name
                    )
                    then
                        LearnedAny =
                            true
                    end

                    warn(
                        "[Combat Hub] Auto Best Equipment: unexpected cross-category displacement • "
                            .. tostring(
                                BeforeInfo.Name
                            )
                            .. " → "
                            .. tostring(
                                Candidate.Name
                            )
                    )
                end
            end
        end
    end

    return true,
        LearnedAny
end

function AutoBestEquipmentController:GetGearCandidates()
    local Data =
        self:GetData()

    local Inventory =
        Data
        and Data.Inventory
        and Data.Inventory.Inventory

    if not Inventory then
        return nil,
            {}
    end

    local BestByName =
        {}

    local Priority =
        self:GetPriority()

    local function Better(
        A,
        B
    )
        if B == nil then
            return true
        end

        if Priority
            == "Damage"
        then
            return self:IsDamageCandidateBetter(
                A,
                B
            )
        end

        if A.Score
            ~= B.Score
        then
            return A.Score
                > B.Score
        end

        if A.RelevantStats
            ~= B.RelevantStats
        then
            return A.RelevantStats
                > B.RelevantStats
        end

        if A.RefineLevel
            ~= B.RefineLevel
        then
            return A.RefineLevel
                > B.RefineLevel
        end

        if A.Rarity
            ~= B.Rarity
        then
            return A.Rarity
                > B.Rarity
        end

        return A.Id
            < B.Id
    end

    for _,
        ItemInstance in ipairs(
            Inventory:GetChildren()
        )
    do
        local Candidate =
            self:BuildGearCandidate(
                ItemInstance
            )

        if Candidate then
            local Existing =
                BestByName[
                    Candidate.Name
                ]

            if Better(
                Candidate,
                Existing
            )
            then
                BestByName[
                    Candidate.Name
                ] =
                    Candidate
            end
        end
    end

    local Gear =
        {}

    for _,
        Candidate in pairs(
            BestByName
        )
    do
        table.insert(
            Gear,
            Candidate
        )
    end

    table.sort(
        Gear,
        function(A, B)
            return Better(
                A,
                B
            )
        end
    )

    return Data,
        Gear
end

function AutoBestEquipmentController:WaitForStatsSlot(
    StatsSlots,
    SlotName,
    ItemId,
    Timeout
)
    local Slot =
        StatsSlots
        and StatsSlots:FindFirstChild(
            SlotName
        )

    if not Slot then
        return false
    end

    local StartedAt =
        os.clock()

    Timeout =
        tonumber(
            Timeout
        )
        or 1.25

    while HubRunning
        and Settings.AutoEquipBestEquipment
        and os.clock()
            - StartedAt
            < Timeout
    do
        if tonumber(
            Slot.Value
        ) == ItemId
        then
            return true
        end

        task.wait(
            0.08
        )
    end

    return tonumber(
        Slot.Value
    ) == ItemId
end


function AutoBestEquipmentController:SendAccessoryEquip(
    SlotName,
    ItemId
)
    if not self.SignalEvent
        or type(
            self.SignalEvent.ToServer
        ) ~= "function"
    then
        return false
    end

    local Success =
        pcall(
            self.SignalEvent.ToServer,
            "AccessoryEquip",
            SlotName,
            ItemId,
            "Stats"
        )

    return Success
end


function AutoBestEquipmentController:EquipBestGear(
    Data,
    Candidates
)
    local StatsSlots =
        Data
        and Data.Inventory
        and Data.Inventory.Accessories
        and Data.Inventory.Accessories.Stats

    if not StatsSlots then
        warn(
            "[Combat Hub] Auto Best Equipment: Stats slots missing"
        )

        return 0
    end

    ----------------------------------------------------------
    -- REAL GAME RULE:
    -- ONLY ONE EQUIPPED ITEM PER InventoryCategory.
    --
    -- Candidates are already sorted best -> worst for the selected
    -- Damage/Health priority, so this keeps the BEST item from each
    -- category until up to five valid categories are filled.
    ----------------------------------------------------------

    local Desired =
        self:BuildCompatibleDesiredSet(
            Candidates
        )

    if #Desired <= 0 then
        return 0
    end

    local DesiredById =
        {}

    local DesiredByName =
        {}

    local DesiredByCategory =
        {}

    for _,
        Candidate in ipairs(
            Desired
        )
    do
        DesiredById[
            Candidate.Id
        ] =
            Candidate

        DesiredByName[
            Candidate.Name
        ] =
            Candidate

        if Candidate.InventoryCategory ~= nil then
            DesiredByCategory[
                tostring(
                    Candidate.InventoryCategory
                )
            ] =
                Candidate
        end
    end

    local Current =
        self:SnapshotStatsSlots(
            Data,
            StatsSlots
        )

    ----------------------------------------------------------
    -- PHASE 1:
    -- If a category is already equipped but not with its BEST item,
    -- replace that category IN PLACE.
    ----------------------------------------------------------

    for _,
        SlotName in ipairs(
            self.SlotNames
        )
    do
        local Info =
            Current[
                SlotName
            ]

        if Info
            and Info.Id ~= 0
            and Info.Name
        then
            local CurrentCandidate =
                self:FindCandidateByName(
                    Candidates,
                    Info.Name
                )

            local Category =
                CurrentCandidate
                and CurrentCandidate.InventoryCategory

            local BestForCategory =
                Category ~= nil
                and DesiredByCategory[
                    tostring(
                        Category
                    )
                ]
                or nil

            if BestForCategory
                and Info.Id
                    ~= BestForCategory.Id
            then
                local Extra =
                    ""

                if self:GetPriority()
                    == "Damage"
                then
                    local V =
                        BestForCategory.DamageVector
                        or {}

                    Extra =
                        " • flat="
                        .. string.format(
                            "%.3f",
                            tonumber(
                                V.FlatAdditionalDamage
                            )
                            or 0
                        )
                        .. " factorBonus="
                        .. string.format(
                            "%.3f",
                            tonumber(
                                V.AdditionalDamageFactor
                            )
                            or 0
                        )
                end

                HubDebug(
                    "[Combat Hub] Auto Best Equipment ["
                        .. tostring(
                            self:GetPriority()
                        )
                        .. "]: upgrading category "
                        .. tostring(
                            Category
                        )
                        .. " • "
                        .. tostring(
                            Info.Name
                        )
                        .. " → "
                        .. tostring(
                            BestForCategory.Name
                        )
                        .. Extra
                )

                local Applied =
                    self:TryEquipAndDetectConflict(
                        Data,
                        StatsSlots,
                        SlotName,
                        BestForCategory,
                        Candidates
                    )

                return Applied
                    and 1
                    or 0
            end
        end
    end

    ----------------------------------------------------------
    -- WHICH DESIRED CATEGORIES ARE ALREADY EQUIPPED?
    ----------------------------------------------------------

    local EquippedCategories =
        {}

    for _,
        SlotName in ipairs(
            self.SlotNames
        )
    do
        local Info =
            Current[
                SlotName
            ]

        if Info
            and Info.Id ~= 0
            and Info.Name
        then
            local CurrentCandidate =
                self:FindCandidateByName(
                    Candidates,
                    Info.Name
                )

            local Category =
                CurrentCandidate
                and CurrentCandidate.InventoryCategory

            if Category ~= nil then
                EquippedCategories[
                    tostring(
                        Category
                    )
                ] =
                    true
            end
        end
    end

    local Missing =
        {}

    for _,
        Candidate in ipairs(
            Desired
        )
    do
        local CategoryKey =
            Candidate.InventoryCategory ~= nil
            and tostring(
                Candidate.InventoryCategory
            )
            or (
                "__ITEM__"
                .. tostring(
                    Candidate.Name
                )
            )

        if not EquippedCategories[
            CategoryKey
        ]
        then
            table.insert(
                Missing,
                Candidate
            )
        end
    end

    if #Missing <= 0 then
        return 0
    end

    ----------------------------------------------------------
    -- PHASE 2:
    -- FILL EMPTY SLOT WITH BEST MISSING CATEGORY.
    ----------------------------------------------------------

    for _,
        SlotName in ipairs(
            self.SlotNames
        )
    do
        local Info =
            Current[
                SlotName
            ]

        if Info
            and Info.Id == 0
        then
            local Candidate =
                Missing[
                    1
                ]

            if not Candidate then
                return 0
            end

            HubDebug(
                "[Combat Hub] Auto Best Equipment: filling empty "
                    .. tostring(
                        SlotName
                    )
                    .. " → "
                    .. tostring(
                        Candidate.Name
                    )
                    .. " ["
                    .. tostring(
                        Candidate.InventoryCategory
                        or "Unknown"
                    )
                    .. "]"
            )

            local Applied =
                self:TryEquipAndDetectConflict(
                    Data,
                    StatsSlots,
                    SlotName,
                    Candidate,
                    Candidates
                )

            return Applied
                and 1
                or 0
        end
    end

    ----------------------------------------------------------
    -- PHASE 3:
    -- ALL SLOTS FULL.
    -- Replace a category/item that is NOT in the desired valid set.
    ----------------------------------------------------------

    for _,
        SlotName in ipairs(
            self.SlotNames
        )
    do
        local Info =
            Current[
                SlotName
            ]

        if Info
            and Info.Id ~= 0
            and Info.Name
        then
            local CurrentCandidate =
                self:FindCandidateByName(
                    Candidates,
                    Info.Name
                )

            local CurrentCategoryKey =
                CurrentCandidate
                and CurrentCandidate.InventoryCategory ~= nil
                and tostring(
                    CurrentCandidate.InventoryCategory
                )
                or (
                    "__ITEM__"
                    .. tostring(
                        Info.Name
                    )
                )

            local DesiredForCategory =
                DesiredByCategory[
                    CurrentCategoryKey
                ]

            local ShouldReplace =
                not DesiredForCategory
                or DesiredForCategory.Id
                    ~= Info.Id

            if ShouldReplace then
                local Candidate =
                    Missing[
                        1
                    ]

                if not Candidate then
                    return 0
                end

                HubDebug(
                    "[Combat Hub] Auto Best Equipment: replacing "
                        .. tostring(
                            Info.Name
                        )
                        .. " ["
                        .. tostring(
                            CurrentCategoryKey
                        )
                        .. "] → "
                        .. tostring(
                            Candidate.Name
                        )
                        .. " ["
                        .. tostring(
                            Candidate.InventoryCategory
                            or "Unknown"
                        )
                        .. "]"
                )

                local Applied =
                    self:TryEquipAndDetectConflict(
                        Data,
                        StatsSlots,
                        SlotName,
                        Candidate,
                        Candidates
                    )

                return Applied
                    and 1
                    or 0
            end
        end
    end

    return 0
end

function AutoBestEquipmentController:Step()
    if not HubRunning
        or not Settings.AutoEquipBestEquipment
    then
        return
    end

    if not self:LoadModules() then
        return
    end

    if self:IsLoadoutChangeDenied() then
        if os.clock()
            - self.LastDeniedLog
            >= 5
        then
            self.LastDeniedLog =
                os.clock()

            HubDebug(
                "[Combat Hub] Auto Best Equipment: loadout changes currently denied • waiting"
            )
        end

        return
    end

    local Data,
        Gear =
        self:GetGearCandidates()

    if not Data then
        if os.clock()
            - self.LastDeniedLog
            >= 5
        then
            self.LastDeniedLog =
                os.clock()

            warn(
                "[Combat Hub] Auto Best Equipment: inventory data tree not ready"
            )
        end

        return
    end

    if #Gear <= 0 then
        if os.clock()
            - self.LastDeniedLog
            >= 5
        then
            self.LastDeniedLog =
                os.clock()

            local Inventory =
                Data.Inventory
                and Data.Inventory.Inventory

            warn(
                "[Combat Hub] Auto Best Equipment: no Stats gear candidates • inventory="
                    .. tostring(
                        Inventory
                        and #Inventory:GetChildren()
                        or 0
                    )
                    .. " • priority="
                    .. tostring(
                        self:GetPriority()
                    )
            )
        end

        return
    end

    local Changed =
        self:EquipBestGear(
            Data,
            Gear
        )

    local Priority =
        self:GetPriority()

    local Names =
        {}

    local CompatibleGear =
        self:BuildCompatibleDesiredSet(
            Gear
        )

    for Index = 1,
        math.min(
            5,
            #CompatibleGear
        )
    do
        table.insert(
            Names,
            CompatibleGear[
                Index
            ].Name
        )
    end

    local Summary =
        Priority
        .. "|"
        .. table.concat(
            Names,
            ","
        )

    if Summary
        ~= self.LastSummary
    then
        self.LastSummary =
            Summary

        HubDebug(
            "[Combat Hub] Auto Best Equipment ["
                .. tostring(
                    Priority
                )
                .. "] best gear • one per category: "
                .. (
                    #Names > 0
                    and table.concat(
                        Names,
                        ", "
                    )
                    or "none"
                )
        )
    end

    if Changed > 0 then
        task.wait(
            0.20
        )
    end
end



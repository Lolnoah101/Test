local TimeTrialAutoLeaveFired = false
local LastObservedTimeTrialStage = nil


local function IsLocalTimeTrialActiveForLeave()
    local TimeTrialFolder =
        GetTimeTrialMapFolder()

    if not TimeTrialFolder then
        return false
    end

    -- Strong Raid guard: both the server enemy folder and the
    -- local Raid map folder must be absent before this can be treated
    -- as a local Time Trial.
    if GetGamemodeRaidEnemyFolder()
        ~= nil
        or GetLocalRaidFolder()
            ~= nil
        or IsInsideLocalRaid()
    then
        return false
    end

    -- The previous version only trusted Start.Label visibility.
    -- Use the active gamemode container as a fallback so a hidden
    -- label does not block Auto Leave.
    return IsLocalGamemodeContainerActive()
end


local function TryAutoLeaveTimeTrial()
    local LocalTimeTrialActive =
        IsLocalTimeTrialActiveForLeave()

    local Stage =
        LocalTimeTrialActive
        and GetCurrentTimeTrialStage()
        or nil

    -- Detect a fresh run when Current goes back to an earlier stage.
    if Stage
        and LastObservedTimeTrialStage
        and Stage < LastObservedTimeTrialStage
    then
        TimeTrialAutoLeaveFired =
            false
    end

    if not LocalTimeTrialActive then
        TimeTrialAutoLeaveFired =
            false

        LastObservedTimeTrialStage =
            nil

        return false
    end

    if Stage then
        LastObservedTimeTrialStage =
            Stage
    end

    if not Settings.AutoLeaveTimeTrial
        or TimeTrialAutoLeaveFired
        or IsRaidResultsVisible()
    then
        return false
    end

    local TargetStage =
        math.max(
            1,
            math.floor(
                tonumber(
                    Settings.TimeTrialLeaveStage
                )
                or 1
            )
        )

    if not Stage
        or Stage < TargetStage
    then
        return false
    end

    TimeTrialAutoLeaveFired =
        true

    local Success, ErrorMessage =
        QuitCurrentGamemode(
            "TimeTrialAutoLeave"
        )

    if not Success then
        TimeTrialAutoLeaveFired =
            false

        warn(
            "[Anime Breaker] Auto Leave Time Trial: "
                .. tostring(
                    ErrorMessage
                )
        )

        return false
    end

    LogUI(
        "Time Trial Auto Leave • Stage "
        .. tostring(Stage)
        .. " / Target "
        .. tostring(TargetStage)
    )

    return true
end


task.spawn(function()
    while HubRunning do

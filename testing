local Fluent = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/dawid-scripts/Fluent/master/main.lua"
))()

local Window = Fluent:CreateWindow({
    Title = "[NEW GAME]",
    SubTitle = "Combat Hub",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})

--==================================================
-- TABS
--==================================================

local Tabs = {
    Combat = Window:AddTab({
        Title = "Combat",
        Icon = "sword"
    })
}

local Options = Fluent.Options

--==================================================
-- SERVICES
--==================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

--==================================================
-- REMOTES
--==================================================

local Remotes = {
    Attack = ReplicatedStorage
        :WaitForChild("Player")
        :WaitForChild("Remotes")
        :WaitForChild("Inputs")
        :WaitForChild("Attack"),

    Skill = ReplicatedStorage
        :WaitForChild("Player")
        :WaitForChild("Remotes")
        :WaitForChild("Inputs")
        :WaitForChild("Skill")
}

print("[Combat] Attack remote found!")
print("[Combat] Skill remote found!")

--==================================================

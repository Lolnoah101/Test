local function GetPossibleGuiRoots()
    local Roots = {
        game:GetService("CoreGui"),
    }

    if type(
        gethui
    ) == "function"
    then
        local Success,
            HiddenUi =
            pcall(
                gethui
            )

        if Success
            and HiddenUi
        then
            table.insert(
                Roots,
                HiddenUi
            )
        end
    end

    return Roots
end


local function GuiLooksLikeHollowMoonHub(
    Object
)
    if not Object
        or not Object.Parent
    then
        return false
    end

    local Name =
        string.lower(
            tostring(
                Object.Name
                or ""
            )
        )

    if string.find(
        Name,
        "hollowmoon",
        1,
        true
    )
    then
        return true
    end

    local Checked =
        0

    for _,
        Descendant in ipairs(
            Object:GetDescendants()
        )
    do
        Checked +=
            1

        if Checked > 600 then
            break
        end

        if Descendant:IsA(
            "TextLabel"
        )
            or Descendant:IsA(
                "TextButton"
            )
        then
            local Text =
                string.lower(
                    tostring(
                        Descendant.Text
                        or ""
                    )
                )

            if Text == "hollowmoonhub"
                or string.find(
                    Text,
                    "hollowmoonhub",
                    1,
                    true
                )
            then
                return true
            end
        end
    end

    return false
end


local function DestroyHollowMoonHubGuiFallback()
    local Destroyed =
        0

    for _,
        Root in ipairs(
            GetPossibleGuiRoots()
        )
    do
        for _,
            Child in ipairs(
                Root:GetChildren()
            )
        do
            if (
                Child:IsA(
                    "ScreenGui"
                )
                or Child:IsA(
                    "Folder"
                )
            )
                and GuiLooksLikeHollowMoonHub(
                    Child
                )
            then
                local Success =
                    pcall(function()
                        Child:Destroy()
                    end)

                if Success then
                    Destroyed +=
                        1
                end
            end
        end
    end

    return Destroyed
end


local function DestroyRayfieldWindow()
    local Destroyed =
        false

    ----------------------------------------------------------
    -- Gen2 builds can expose lifecycle methods in different places.
    ----------------------------------------------------------

    local WindowMethods = {
        "Destroy",
        "Unload",
        "Close",
    }

    for _,
        MethodName in ipairs(
            WindowMethods
        )
    do
        if Window
            and type(
                Window[
                    MethodName
                ]
            ) == "function"
        then
            local Success =
                pcall(function()
                    Window[
                        MethodName
                    ](
                        Window
                    )
                end)

            Destroyed =
                Destroyed
                or Success
        end
    end

    local LibraryMethods = {
        "Destroy",
        "Unload",
    }

    for _,
        MethodName in ipairs(
            LibraryMethods
        )
    do
        if Rayfield
            and type(
                Rayfield[
                    MethodName
                ]
            ) == "function"
        then
            local Success =
                pcall(function()
                    Rayfield[
                        MethodName
                    ](
                        Rayfield
                    )
                end)

            Destroyed =
                Destroyed
                or Success
        end
    end

    task.wait(
        0.05
    )

    local FallbackDestroyed =
        DestroyHollowMoonHubGuiFallback()

    return Destroyed
        or FallbackDestroyed > 0
end



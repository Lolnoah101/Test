--// ============================================================
--// ANTI RAGDOLL
--// ============================================================
--
-- The game's RagdollHandler enables ragdoll when the local Humanoid enters
-- HumanoidStateType.Physics, then detaches the Motor6D Part1 references kept
-- inside Character.RagdollConstraints.<Constraint>.RigidJoint.
--
-- Anti Ragdoll keeps Physics disabled locally and repairs those Motor6D
-- Part1 links immediately if a ragdoll transition still gets through.
--
-- NOTE: this prevents/repairs the local ragdoll pose and movement state.
-- A server-authoritative stun/debuff can still exist independently.

local AntiRagdollController = {
    HeartbeatConnection = nil,
    StateConnection = nil,
    CharacterConnection = nil,

    Humanoid = nil,
    Character = nil,

    LastRepairAt = 0,
    RepairInterval = 0.05,
}


function AntiRagdollController:RestoreRagdollJoints(
    Character
)
    if not Character
        or not Character.Parent
    then
        return
    end

    local Constraints =
        Character:FindFirstChild(
            "RagdollConstraints"
        )

    if not Constraints then
        return
    end

    for _,
        Constraint in ipairs(
            Constraints:GetChildren()
        )
    do
        if Constraint:IsA(
            "Constraint"
        ) then
            local RigidJoint =
                Constraint:FindFirstChild(
                    "RigidJoint"
                )

            local Attachment1 =
                Constraint.Attachment1

            local Motor =
                RigidJoint
                and RigidJoint:IsA(
                    "ObjectValue"
                )
                and RigidJoint.Value
                or nil

            local DesiredPart1 =
                Attachment1
                and Attachment1.Parent
                or nil

            if Motor
                and Motor:IsA(
                    "Motor6D"
                )
                and DesiredPart1
                and Motor.Part1
                    ~= DesiredPart1
            then
                pcall(function()
                    Motor.Part1 =
                        DesiredPart1
                end)
            end
        end
    end
end


function AntiRagdollController:RecoverNow()
    if not Settings.AntiRagdoll then
        return
    end

    local Character =
        LocalPlayer.Character

    local Humanoid =
        Character
        and Character:FindFirstChildOfClass(
            "Humanoid"
        )

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Character
        or not Humanoid
        or Humanoid.Health <= 0
    then
        return
    end

    pcall(function()
        Humanoid:SetStateEnabled(
            Enum.HumanoidStateType.Physics,
            false
        )
    end)

    pcall(function()
        Humanoid.PlatformStand =
            false
    end)

    local State =
        Humanoid:GetState()

    if State
        == Enum.HumanoidStateType.Physics
        or State
            == Enum.HumanoidStateType.Ragdoll
        or State
            == Enum.HumanoidStateType.FallingDown
    then
        pcall(function()
            Humanoid:ChangeState(
                Enum.HumanoidStateType.GettingUp
            )
        end)
    end

    self:RestoreRagdollJoints(
        Character
    )

    if Root then
        Root.AssemblyAngularVelocity =
            Vector3.zero
    end
end


function AntiRagdollController:BindCharacter(
    Character
)
    if self.StateConnection then
        self.StateConnection:Disconnect()
        self.StateConnection =
            nil
    end

    self.Character =
        Character

    self.Humanoid =
        Character
        and Character:FindFirstChildOfClass(
            "Humanoid"
        )
        or nil

    if not self.Humanoid then
        return
    end

    pcall(function()
        self.Humanoid:SetStateEnabled(
            Enum.HumanoidStateType.Physics,
            false
        )
    end)

    self.StateConnection =
        self.Humanoid.StateChanged:Connect(
            function(_OldState, NewState)
                if not HubRunning
                    or not Settings.AntiRagdoll
                then
                    return
                end

                if NewState
                    == Enum.HumanoidStateType.Physics
                    or NewState
                        == Enum.HumanoidStateType.Ragdoll
                    or NewState
                        == Enum.HumanoidStateType.FallingDown
                then
                    task.defer(function()
                        self:RecoverNow()
                    end)
                end
            end
        )

    self:RecoverNow()
end


function AntiRagdollController:Start()
    Settings.AntiRagdoll =
        true

    if self.HeartbeatConnection then
        self.HeartbeatConnection:Disconnect()
        self.HeartbeatConnection =
            nil
    end

    if self.CharacterConnection then
        self.CharacterConnection:Disconnect()
        self.CharacterConnection =
            nil
    end

    self:BindCharacter(
        LocalPlayer.Character
    )

    self.CharacterConnection =
        LocalPlayer.CharacterAdded:Connect(
            function(Character)
                task.wait(
                    0.10
                )

                if HubRunning
                    and Settings.AntiRagdoll
                then
                    self:BindCharacter(
                        Character
                    )
                end
            end
        )

    self.HeartbeatConnection =
        RunService.Heartbeat:Connect(
            function()
                if not HubRunning
                    or not Settings.AntiRagdoll
                then
                    return
                end

                if os.clock()
                    - self.LastRepairAt
                    < self.RepairInterval
                then
                    return
                end

                self.LastRepairAt =
                    os.clock()

                self:RecoverNow()
            end
        )
end


function AntiRagdollController:Stop()
    Settings.AntiRagdoll =
        false

    if self.HeartbeatConnection then
        self.HeartbeatConnection:Disconnect()
        self.HeartbeatConnection =
            nil
    end

    if self.StateConnection then
        self.StateConnection:Disconnect()
        self.StateConnection =
            nil
    end

    if self.CharacterConnection then
        self.CharacterConnection:Disconnect()
        self.CharacterConnection =
            nil
    end

    local Character =
        LocalPlayer.Character

    local Humanoid =
        Character
        and Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if Humanoid then
        pcall(function()
            Humanoid:SetStateEnabled(
                Enum.HumanoidStateType.Physics,
                true
            )
        end)
    end

    self.Humanoid =
        nil

    self.Character =
        nil
end




        and PlayerGui:FindFirstChild(
            "ComponentsHolder"
        )

    local MainNotificationFrame =
        ComponentsHolder
        and ComponentsHolder:FindFirstChild(
            "MainNotificationFrame"
        )

    local Offers =
        MainNotificationFrame
        and MainNotificationFrame:FindFirstChild(
            "OuwigaharaOffers"
        )

    local BBCards =
        Offers
        and Offers:FindFirstChild(
            "BBCards"
        )

    local Cards =
        BBCards
        and BBCards:FindFirstChild(
            "Cards"
        )

    return BBCards,
        Cards
end


function AutoCardController:IsActuallyVisible(
    Object
)
    if not Object
        or not Object.Parent
    then
        return false
    end

    local Current =
        Object

    while Current
        and Current ~= game
    do
        if Current:IsA(
            "GuiObject"
        )
            and not Current.Visible
        then
            return false
        end

        if Current:IsA(
            "LayerCollector"
        )
            and not Current.Enabled
        then
            return false
        end

        Current =
            Current.Parent
    end

    return true
end


function AutoCardController:FindNamedText(
    Root,
    Name
)
    if not Root then
        return nil
    end

    if Root.Name == Name
        and (
            Root:IsA(
                "TextLabel"
            )
            or Root:IsA(
                "TextButton"
            )
            or Root:IsA(
                "TextBox"
            )
        )
    then
        return Root
    end

    for _,
        Descendant in ipairs(
            Root:GetDescendants()
        )
    do
        if Descendant.Name == Name
            and (
                Descendant:IsA(
                    "TextLabel"
                )
                or Descendant:IsA(
                    "TextButton"
                )
                or Descendant:IsA(
                    "TextBox"
                )
            )
        then
            return Descendant
        end
    end

    return nil
end


function AutoCardController:FindClickButton(
    Root
)
    if not Root then
        return nil
    end

    if Root.Name == "Click"
        and Root:IsA(
            "GuiButton"
        )
    then
        return Root
    end

    for _,
        Descendant in ipairs(
            Root:GetDescendants()
        )
    do
        if Descendant.Name == "Click"
            and Descendant:IsA(
                "GuiButton"
            )
        then
            return Descendant
        end
    end

    return nil
end


function AutoCardController:GetCardEntries()
    local BBCards,
        Cards =
        self:GetBBCards()

    if not BBCards
        or not Cards
        or not self:IsActuallyVisible(
            BBCards
        )
    then
        return {},
            nil
    end

    local Entries =
        {}

    for _,
        Slot in ipairs(
            Cards:GetChildren()
        )
    do
        local SlotNumber =
            tonumber(
                Slot.Name
            )

        if SlotNumber then
            local TitleObject =
                self:FindNamedText(
                    Slot,
                    "Title"
                )

            local BottomObject =
                self:FindNamedText(
                    Slot,
                    "Bottom"
                )

            local ClickButton =
                self:FindClickButton(
                    Slot
                )

            local Title =
                TitleObject
                and tostring(
                    TitleObject.Text
                    or ""
                )
                or ""

            local Bottom =
                BottomObject
                and tostring(
                    BottomObject.Text
                    or ""
                )
                or ""

            if ClickButton
                and Title ~= ""
                and self:IsActuallyVisible(
                    ClickButton
                )
            then
                table.insert(
                    Entries,
                    {
                        Slot =
                            SlotNumber,

                        Root =
                            Slot,

                        Title =
                            Title,

                        Bottom =
                            Bottom,

                        Button =
                            ClickButton,
                    }
                )
            end
        end
    end

    table.sort(
        Entries,
        function(A, B)
            return A.Slot
                < B.Slot
        end
    )

    return Entries,
        BBCards
end


function AutoCardController:GetOfferSignature(
    Entries
)
    if type(
        Entries
    ) ~= "table"
        or #Entries == 0
    then
        return nil
    end

    local Parts =
        {}

    for _,
        Entry in ipairs(
            Entries
        )
    do
        table.insert(
            Parts,
            tostring(
                Entry.Slot
            )
                .. ":"
                .. string.lower(
                    Entry.Title
                )
        )
    end

    return table.concat(
        Parts,
        "|"
    )
end


function AutoCardController:GetHealthPercent()
    local Character =
        LocalPlayer.Character

    local Humanoid =
        Character
        and Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not Humanoid
        or Humanoid.MaxHealth <= 0
    then
        return 100
    end

    return math.clamp(
        (
            Humanoid.Health
            / Humanoid.MaxHealth
        )
            * 100,
        0,
        100
    )
end


function AutoCardController:IsSecondWind(
    Entry
)

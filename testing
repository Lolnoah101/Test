                        )
                    )

                if skillNumber then

                    pcall(function()

                        Skill:FireServer(
                            skillNumber,
                            "tap",
                            Vector3.new(0, 0, 0)
                        )

                    end)
                end
            end
        end

        task.wait(0.1)
    end
end)


local function GetClientEnemyPosition(
    ClientEnemy
)
    if not ClientEnemy
        or not ClientEnemy.Parent
    then
        return nil
    end

    if ClientEnemy:IsA("BasePart") then
        return ClientEnemy.Position
    end

    if ClientEnemy:IsA("Model") then
        local Root =
            ClientEnemy:FindFirstChild(
                "HumanoidRootPart"
            )
            or ClientEnemy.PrimaryPart

        if Root
            and Root:IsA("BasePart")
        then
            return Root.Position
        end

        local Success, Pivot =
            pcall(function()
                return ClientEnemy:GetPivot()
            end)

        if Success then
            return Pivot.Position
        end
    end

    local Part =
        ClientEnemy:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    return Part
        and Part.Position
        or nil
end


local function GetSelectedGlobalPriorityTarget()
    local Root =
        GetRootPart()

    local Enemies =
        Workspace:FindFirstChild(
            "_ENEMIES"
        )

    local Server =
        Enemies
        and Enemies:FindFirstChild(
            "Server"
        )

    local ClientFolder =
        GetClientEnemyFolder()

    if not Root
        or not Server
    then
        return nil, nil, nil
    end

    local BestUUID = nil
    local BestTarget = nil
    local BestArea = nil
    local BestDistance = math.huge

    local LegitMode =
        Settings.FarmMode == "Legit"

    local CurrentArea =
        LegitMode
        and GetCurrentAreaName()
        or nil

    for _, AreaFolder in ipairs(
        Server:GetChildren()
    ) do
        -- Teleport/Tween can use global Secret targets.
        -- Legit walking only targets the zone the player is already in.
        if AreaFolder.Name ~= "Gamemode"
            and (
                not LegitMode
                or AreaFolder.Name == CurrentArea
            )
        then
            for _, ServerEnemy in ipairs(
                AreaFolder:GetChildren()
            ) do
                if IsServerEnemyAlive(
                    ServerEnemy
                )
                    and IsSelectedPriorityEnemy(
                        ServerEnemy
                    )
                then
                    local UUID =
                        ServerEnemy.Name

                    local ClientEnemy =
                        ClientFolder
                        and ClientFolder:FindFirstChild(
                            UUID
                        )

                    -- Prefer the live client model if it exists.
                    -- Otherwise use the replicated Server enemy object,
                    -- which lets Teleport mode move across zones before
                    -- the client model has streamed/loaded.
                    local Target

                    if LegitMode then
                        -- Legit mode walks to the rendered/local enemy only.
                        -- Do not try to walk toward an off-zone server proxy.
                        Target =
                            ClientEnemy
                    else
                        Target =
                            ClientEnemy
                            or ServerEnemy
                    end

                    local Position =
                        GetClientEnemyPosition(
                            Target
                        )

                    if Position then
                        local Distance =
                            (
                                Root.Position
                                - Position
                            ).Magnitude

                        if Distance < BestDistance then
                            BestDistance =
                                Distance

                            BestUUID =
                                UUID

                            BestTarget =
                                Target

                            BestArea =
                                AreaFolder.Name
                        end
                    end
                end
            end
        end
    end

    return BestUUID,
        BestTarget,
        BestArea
end


local function GetSelectedFarmTarget()
    -- Selected Secret priority always wins globally.
    local PriorityUUID,
        PriorityTarget,
        PriorityArea =
        GetSelectedGlobalPriorityTarget()

    if PriorityUUID
        and PriorityTarget
        and PriorityArea
    then
        return PriorityUUID,
            PriorityTarget,
            PriorityArea
    end

    -- No selected priority Secret is alive.
    -- Normal Auto Farm is also global now, so selected mobs can be
    -- farmed across DBZ, AOT, and other normal map folders.
    local Root =
        GetRootPart()

    local Enemies =
        Workspace:FindFirstChild(
            "_ENEMIES"
        )

    local Server =
        Enemies
        and Enemies:FindFirstChild(
            "Server"
        )

    local ClientFolder =
        GetClientEnemyFolder()

    if not Root
        or not Server
    then
        return nil, nil, nil
    end

    local BestUUID = nil
    local BestTarget = nil
    local BestArea = nil
    local BestDistance = math.huge

    local LegitMode =
        Settings.FarmMode == "Legit"

    local CurrentArea =
        LegitMode
        and GetCurrentAreaName()
        or nil

    for _, AreaFolder in ipairs(
        Server:GetChildren()
    ) do
        if AreaFolder.Name ~= "Gamemode"
            and (
                not LegitMode
                or AreaFolder.Name == CurrentArea
            )
        then
            for _, ServerEnemy in ipairs(
                AreaFolder:GetChildren()
            ) do
                local DisplayName =
                    GetEnemyDisplayName(
                        ServerEnemy
                    )

                if DisplayName
                    and Settings.SelectedEnemies[
                        DisplayName
                    ] == true
                    and IsServerEnemyAlive(
                        ServerEnemy
                    )
                then
                    local UUID =
                        ServerEnemy.Name

                    local ClientEnemy =
                        ClientFolder
                        and ClientFolder:FindFirstChild(
                            UUID
                        )

                    local Target

                    if LegitMode then
                        Target =
                            ClientEnemy
                    else
                        Target =
                            ClientEnemy
                            or ServerEnemy
                    end

                    local Position =
                        GetClientEnemyPosition(
                            Target
                        )

                    if Position then
                        local Distance =
                            (
                                Root.Position
                                - Position
                            ).Magnitude

                        if Distance < BestDistance then
                            BestDistance =
                                Distance

                            BestUUID =
                                UUID

                            BestTarget =
                                Target

                            BestArea =
                                AreaFolder.Name
                        end
                    end
                end
            end
        end
    end

    return BestUUID,
        BestTarget,
        BestArea
end


local function IsCurrentFarmTargetValid()
    if not CurrentFarmUUID
        or not CurrentFarmArea
    then
        return false
    end

    local ServerFolder =
        GetServerEnemyAreaFolder(
            CurrentFarmArea
        )

    if not ServerFolder then
        return false
    end

    local ServerEnemy =
        ServerFolder:FindFirstChild(
            CurrentFarmUUID
        )

    if not ServerEnemy
        or not IsServerEnemyAlive(
            ServerEnemy
        )
    then
        return false
    end

    if Settings.FarmMode == "Legit"
        and GetCurrentAreaName()
            ~= CurrentFarmArea
    then
        return false
    end

    -- Teleport/Tween can keep a selected Secret locked across zones.
    -- Legit stays inside the player's current zone.
    if IsSelectedPriorityEnemy(
        ServerEnemy
    ) then
        return true
    end

    -- Normal selected enemies are global too, so keep the target
    -- locked while crossing zones/maps.
    local DisplayName =
        GetEnemyDisplayName(
            ServerEnemy
        )

    return DisplayName ~= nil
        and Settings.SelectedEnemies[
            DisplayName
        ] == true
end



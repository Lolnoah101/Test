local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local Window = Rayfield:CreateWindow({
    name = "Testing",
    subtitle = "Combat",
    theme = "default",

    configuration = {
        autoSave = true,
        autoLoad = true,
        fileName = "TestingHubV2",
    },
})

local CombatTab = Window:CreateTab({
    name = "Combat",
})

local Remotes = game:GetService("ReplicatedStorage").Player.Remotes.Inputs
local Attack = Remotes.Attack
local Skill = Remotes.Skill

local AutoM1 = false
local AutoSkill = false

local SelectedSkills = {
    "Skill 1"
}

-- M1
CombatTab:CreateToggle({
    name = "Auto M1",
    flag = "AutoM1",

    callback = function(value)
        AutoM1 = value

        if value then
            task.spawn(function()
                while AutoM1 do
                    Attack:FireServer(Vector3.new(0, 0, 0))
                    task.wait(0.1)
                end
            end)
        end
    end,
})

-- MULTI SELECT SKILLS
CombatTab:CreateDropdown({
    name = "Select Skills",

    multiSelect = true,

    options = {
        "Skill 1",
        "Skill 2",
        "Skill 3",
        "Skill 4",
    },

    value = {
        "Skill 1"
    },

    callback = function(selected)
        SelectedSkills = selected

        print("Selected skills:")
        for _, skillName in ipairs(selected) do
            print(skillName)
        end
    end,
})

-- AUTO SKILL
CombatTab:CreateToggle({
    name = "Auto Skill",
    flag = "AutoSkill",

    callback = function(value)
        AutoSkill = value

        if value then
            task.spawn(function()
                while AutoSkill do

                    for _, skillName in ipairs(SelectedSkills) do
                        if not AutoSkill then
                            break
                        end

                        local skillNumber = tonumber(
                            string.match(skillName, "%d+")
                        )

                        if skillNumber then
                            Skill:FireServer(
                                skillNumber,
                                "tap",
                                Vector3.new(0, 0, 0)
                            )
                        end

                        task.wait(0.1)
                    end

                    task.wait(0.1)
                end
            end)
        end
    end,
})

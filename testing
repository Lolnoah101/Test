    local BestUUID = nil
    local BestTarget = nil
    local BestDistance = math.huge

    for _, ServerEnemy in ipairs(
        ServerFolder:GetChildren()
    ) do
        if IsServerEnemyAlive(
            ServerEnemy
        ) then
            local UUID =
                ServerEnemy.Name

            local ClientEnemy =

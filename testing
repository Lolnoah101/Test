-- =========================
-- AUTO FARM TOGGLE (with Tween)
-- =========================
FarmTab:CreateToggle({
    name = "Auto Farm",
    flag = "AutoFarm",

    callback = function(Value)
        getgenv().AutoFarm = Value
        if Value then
            task.spawn(function()
                print("[AutoFarm] Enabled")
                while getgenv().AutoFarm do
                    -- Check if current target is still alive
                    if currentTarget and currentTarget.entity and currentTarget.entity.Parent and isEntityAlive(currentTarget.entity) then
                        -- Target still alive, keep moving to it
                        local targetCF = getTargetCFrame(currentTarget.part)
                        if targetCF then
                            moveToTarget(targetCF)
                        end
                        task.wait(0.15)  -- Match tween duration
                        continue
                    end

                    -- Get new target
                    local closest = getClosestEnemy()
                    if closest then
                        currentTarget = closest
                        print("[AutoFarm] New target:", closest.entity.Name)
                        local targetCF = getTargetCFrame(closest.part)
                        if targetCF then
                            moveToTarget(targetCF)
                        end
                    else
                        print("[AutoFarm] No enemies")
                        task.wait(1)
                    end
                    task.wait(0.15)
                end
                if currentTween then
                    currentTween:Cancel()
                    currentTween = nil
                end
                currentTarget = nil
                print("[AutoFarm] Disabled")
            end)
        else
            if currentTween then
                currentTween:Cancel()
                currentTween = nil
            end
            currentTarget = nil
        end
    end
})


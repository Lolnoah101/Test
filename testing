local UpgradeBusy = false
local UpgradeCycleIndex = {}
local UpgradeGroupCursor = 1

local UpgradeGroupOrder = {
    "Time Trial Upgrades",
    "Warrior Upgrades",
    "Offline Upgrades",
    "Ninja Progression",
    "Commandment Totem",
}


local function GetSelectedUpgradeGroups()
    local Selected = {}

    for _, GroupName in ipairs(
        UpgradeGroupOrder
    ) do
        if Settings.SelectedUpgradeGroups[
            GroupName
        ] then
            table.insert(
                Selected,
                GroupName
            )
        end
    end

    return Selected
end


local function GetSelectedUpgradeText()
    local Selected =
        GetSelectedUpgradeGroups()

    if #Selected == 0 then
        return "None"
    end

    return table.concat(
        Selected,
        ", "
    )
end


local function ResetUpgradeCycles()
    UpgradeCycleIndex = {}
    UpgradeGroupCursor = 1
end


local function RunSelectedUpgradeStep()
    if not HubRunning then
        return false, "Hub unloaded"
    end

    if UpgradeBusy then
        return false, "Busy"
    end

    local SelectedGroups =
        GetSelectedUpgradeGroups()

    if #SelectedGroups == 0 then
        return false, "No upgrade group selected"
    end

    if UpgradeGroupCursor > #SelectedGroups then
        UpgradeGroupCursor = 1
    end

    local GroupName =
        SelectedGroups[
            UpgradeGroupCursor
        ]

    local Group =
        UpgradeGroups[
            GroupName
        ]

    if not Group
        or #Group.Upgrades == 0
    then
        UpgradeGroupCursor =
            UpgradeGroupCursor
                % #SelectedGroups
                + 1

        return false, "Invalid upgrade group"
    end

    local Index =
        UpgradeCycleIndex[
            GroupName
        ]
        or 1

    if Index > #Group.Upgrades then
        Index = 1
    end

    local UpgradeId =
        Group.Upgrades[
            Index
        ]

    UpgradeBusy =
        true

    local Success, ErrorMessage =
        pcall(function()
            DataRemoteEvent:FireServer({
                {
                    "UpgradeSystem",
                    "Buy",
                    Group.Shop,
                    UpgradeId,
                    n = 4,
                },
                "\x02",
            })
        end)

    UpgradeBusy =
        false

    -- Advance this group's own upgrade cycle.
    UpgradeCycleIndex[
        GroupName
    ] =
        Index % #Group.Upgrades
        + 1

    -- Then move to the next selected upgrade group.
    UpgradeGroupCursor =
        UpgradeGroupCursor
            % #SelectedGroups
            + 1

    if not Success then
        warn(
            "[Energy Hub] Upgrade "
                .. tostring(GroupName)
                .. " / "
                .. tostring(UpgradeId)
                .. ": "
                .. tostring(ErrorMessage)
        )

        return false, ErrorMessage
    end

    return true,
        GroupName,
        UpgradeId
end


task.spawn(function()
    while HubRunning do
        if Settings.AutoUpgrade
            and not UpgradeBusy
        then
            RunSelectedUpgradeStep()
        end

        -- Faster round-robin across selected upgrade groups without
        -- bursting every upgrade remote in the same scheduler slice.
        task.wait(0.45)
    end
end)



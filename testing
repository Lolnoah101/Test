function AutoOuwigaharaController:QueueLobbyReadyHelper()
    if self.TeleportHelperQueued then
        return
    end

    local QueueFunction =
        rawget(
            getgenv(),
            "queue_on_teleport"
        )
        or rawget(
            getgenv(),
            "queueonteleport"
        )

    if type(
        QueueFunction
    ) ~= "function"
        and type(
            syn
        ) == "table"
    then
        QueueFunction =
            syn.queue_on_teleport
    end

    if type(
        QueueFunction
    ) ~= "function"
    then
        return
    end

    -- Small self-contained lobby helper. This means the queue -> lobby
    -- ReadyUp step can still work on executors that support queue_on_teleport
    -- even if the full hub itself is not in the executor's autoexec folder.
    local Source = [=[
task.spawn(function()
    local Players = game:GetService("Players")
    local Workspace = game:GetService("Workspace")
    local Player = Players.LocalPlayer
    local StartedAt = os.clock()

    while os.clock() - StartedAt < 90 do
        local Map = Workspace:FindFirstChild("Map")
        local MinigameMap = Map and Map:FindFirstChild("Minigame Map")
        local StartPad = MinigameMap and MinigameMap:FindFirstChild("StartPad")
        local Character = Player.Character
        local Root = Character and Character:FindFirstChild("HumanoidRootPart")

        if StartPad and StartPad:IsA("BasePart") and Root then
            pcall(function()
                Workspace:RequestStreamAroundAsync(StartPad.Position)
            end)

            Root.CFrame = StartPad.CFrame * CFrame.new(0, 2.5, 0)
            Root.AssemblyLinearVelocity = Vector3.zero
            Root.AssemblyAngularVelocity = Vector3.zero
            task.wait(0.25)

            local Prompt = StartPad:FindFirstChild("ReadyUp")

            if Prompt and Prompt:IsA("ProximityPrompt") then
                if (tonumber(Prompt.HoldDuration) or 0) > 0 then
                    pcall(function()
                        Prompt:InputHoldBegin()
                        task.wait((tonumber(Prompt.HoldDuration) or 0) + 0.12)
                        if Prompt.Parent then
                            Prompt:InputHoldEnd()
                        end
                    end)
                elseif type(fireproximityprompt) == "function" then
                    pcall(function()
                        fireproximityprompt(Prompt)
                    end)
                else
                    pcall(function()
                        Prompt:InputHoldBegin()
                        task.wait(0.12)
                        if Prompt.Parent then
                            Prompt:InputHoldEnd()
                        end
                    end)
                end

                break
            end
        end

        task.wait(0.5)
    end
end)
]=]

    local Success =
        pcall(
            QueueFunction,
            Source
        )

    if Success then
        self.TeleportHelperQueued =
            true

        HubDebug(
            "[Combat Hub] Auto Ouwigahara: queued cross-teleport lobby ReadyUp helper"
        )
    end
end


function AutoOuwigaharaController:QueueNormal()
    if os.clock()
        - self.LastQueueAttempt
        < self.QueueRetryDelay
    then
        return false
    end

    local Remote =
        self:GetQueueRemote()

    if not Remote then
        self:SetStatus(
            "waiting for QueueSignal"
        )

        return false
    end

    self.LastQueueAttempt =
        os.clock()

    self:QueueLobbyReadyHelper()

    self:SetStatus(
        "queueing Normal"
    )

    local Success,
        Result =
        pcall(function()
            return Remote:InvokeServer(
                "Queue",
                "Normal",
                false,
                false
            )
        end)

    if not Success then
        warn(
            "[Combat Hub] Auto Ouwigahara queue failed: "
                .. tostring(
                    Result
                )
        )

        return false
    end

    HubDebug(
        "[Combat Hub] Auto Ouwigahara: Normal queue request sent"
    )

    return true
end


function AutoOuwigaharaController:TriggerReadyUp(
    StartPad,
    Prompt
)
    if os.clock()
        - self.LastReadyAttempt
        < self.ReadyRetryDelay
    then
        return false
    end

    local Character =
        LocalPlayer.Character

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Root
        or not StartPad
        or not StartPad.Parent
    then
        return false
    end

    self.LastReadyAttempt =
        os.clock()

    Settings.__DungeonEntryBusy =
        true

    QuestFarmController:ResetTarget()

    pcall(function()
        workspace:RequestStreamAroundAsync(
            StartPad.Position
        )
    end)

    Root.CFrame =
        StartPad.CFrame
        * CFrame.new(
            0,
            2.5,
            0
        )

    Root.AssemblyLinearVelocity =
        Vector3.zero

    Root.AssemblyAngularVelocity =
        Vector3.zero

    task.wait(
        0.20
    )

    if not Prompt
        or not Prompt.Parent
    then
        local FreshStartPad,
            FreshPrompt =
            self:GetStartPad()

        StartPad =
            FreshStartPad
            or StartPad

        Prompt =
            FreshPrompt
    end

    if not Prompt
        or not Prompt.Parent
    then
        Settings.__DungeonEntryBusy =
            false

        self:SetStatus(
            "on StartPad • waiting for ReadyUp prompt"
        )

        return false
    end

    self:SetStatus(
        "pressing ReadyUp"
    )

    local HoldDuration =
        tonumber(
            Prompt.HoldDuration
        )
        or 0

    local Success,
        ErrorMessage

    if HoldDuration > 0 then
        Success,
            ErrorMessage =
            pcall(function()
                Prompt:InputHoldBegin()

                task.wait(
                    HoldDuration
                    + 0.12
                )

                if Prompt.Parent then
                    Prompt:InputHoldEnd()
                end
            end)
    elseif type(
        fireproximityprompt
    ) == "function"
    then
        Success,
            ErrorMessage =
            pcall(function()
                fireproximityprompt(
                    Prompt
                )
            end)
    else
        Success,
            ErrorMessage =
            pcall(function()
                Prompt:InputHoldBegin()

                task.wait(
                    0.12
                )

                if Prompt.Parent then
                    Prompt:InputHoldEnd()
                end
            end)
    end

    task.wait(
        0.10
    )

    Settings.__DungeonEntryBusy =
        false

    if not Success then
        warn(
            "[Combat Hub] Auto Ouwigahara ReadyUp failed: "
                .. tostring(
                    ErrorMessage
                )
        )

        return false
    end

    HubDebug(
        "[Combat Hub] Auto Ouwigahara: ReadyUp triggered"
    )

    return true
end


function AutoOuwigaharaController:GetPromptWorldCFrame(
    Prompt
)
    if not Prompt
        or not Prompt.Parent
    then
        return nil
    end

    local Parent =
        Prompt.Parent

    if Parent:IsA(
        "Attachment"
    ) then
        return Parent.WorldCFrame
    end

    if Parent:IsA(
        "BasePart"
    ) then
        return Parent.CFrame
    end

    local Part =
        Parent:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    if Part then
        return Part.CFrame
    end

    local Model =
        Parent:FindFirstAncestorOfClass(
            "Model"
        )

    if Model then
        local Root =
            Model.PrimaryPart
            or Model:FindFirstChildWhichIsA(
                "BasePart",
                true
            )

        if Root then
            return Root.CFrame
        end
    end

    return nil
end


function AutoOuwigaharaController:TeleportNearPrompt(
    Prompt
)
    if not Prompt
        or not Prompt.Parent
    then
        return false
    end

    local Character =
        LocalPlayer.Character

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Character
        or not Root
    then
        return false
    end

    Settings.__DungeonEntryBusy =
        true

    Settings.__RewardRoomBusy =
        true

    QuestFarmController:ResetTarget()

    local Container =
        self:GetChestContainer(
            Prompt
        )

    local ChestRoot =
        Container
        and (
            Container:FindFirstChild(
                "RootPart"
            )
            or Container.PrimaryPart
        )

    local PromptCFrame =
        self:GetPromptWorldCFrame(
            Prompt
        )

    if not PromptCFrame
        and not ChestRoot
    then
        warn(
            "[Combat Hub] Reward teleport: no prompt/root CFrame"
        )

        return false
    end

    local StreamPosition =
        ChestRoot
        and ChestRoot:IsA(
            "BasePart"
        )
        and ChestRoot.Position
        or PromptCFrame.Position

    pcall(function()
        workspace:RequestStreamAroundAsync(
            StreamPosition
        )
    end)

    local MaxDistance =
        tonumber(
            Prompt.MaxActivationDistance
        )
        or 12

    local RequiredDistance =
        math.max(
            1,
            MaxDistance - 0.75
        )

    local RotationOnly =
        Root.CFrame
        - Root.Position

    for Attempt = 1, 6 do
        if not Character.Parent
            or not Root.Parent
            or not Prompt.Parent
        then
            return false
        end

        local FreshPromptCFrame =
            self:GetPromptWorldCFrame(
                Prompt
            )

        local TargetPosition

        if ChestRoot
            and ChestRoot.Parent
            and ChestRoot:IsA(
                "BasePart"
            )
        then
            -- Screenshot-confirmed reward models use RootPart as PrimaryPart.
            TargetPosition =
                ChestRoot.Position
                + Vector3.new(
                    0,
                    2.5,
                    0
                )
        elseif FreshPromptCFrame then
            TargetPosition =
                FreshPromptCFrame.Position
                + Vector3.new(
                    0,
                    1.75,
                    0
                )
        else
            return false
        end

        local Destination =
            CFrame.new(
                TargetPosition
            )
            * RotationOnly

        local Moved =
            pcall(function()
                Character:PivotTo(
                    Destination
                )

                Root.CFrame =
                    Destination

                Root.AssemblyLinearVelocity =
                    Vector3.zero

                Root.AssemblyAngularVelocity =
                    Vector3.zero
            end)

        if Moved then
            task.wait(
                0.12
            )

            FreshPromptCFrame =
                self:GetPromptWorldCFrame(
                    Prompt
                )

            local Distance =
                FreshPromptCFrame
                and (
                    Root.Position
                    - FreshPromptCFrame.Position
                ).Magnitude
                or math.huge

            HubDebug(
                "[Combat Hub] Reward teleport attempt "
                    .. tostring(
                        Attempt
                    )
                    .. " • "
                    .. tostring(
                        Container
                        and Container.Name
                        or Prompt.ObjectText
                        or Prompt.Name
                    )
                    .. " • distance="
                    .. string.format(
                        "%.2f",
                        Distance
                    )
            )

            if Distance
                <= RequiredDistance
            then
                return true
            end
        end

        task.wait(
            0.08
        )
    end

    warn(
        "[Combat Hub] Reward teleport FAILED • "
            .. tostring(
                Container
                and Container.Name
                or Prompt.ObjectText
                or Prompt.Name
            )
    )

    return false
end


function AutoOuwigaharaController:TriggerWorldPrompt(
    Prompt
)
    if not Prompt
        or not Prompt.Parent
        or not Prompt.Enabled
    then
        return false
    end

    if not self:TeleportNearPrompt(
        Prompt
    ) then
        return false
    end

    if not Prompt.Parent
        or not Prompt.Enabled
    then
        return false
    end

    local HoldDuration =
        tonumber(
            Prompt.HoldDuration
        )
        or 0

    local Success =
        false

    if HoldDuration > 0 then
        Success =
            pcall(function()
                Prompt:InputHoldBegin()

                task.wait(
                    HoldDuration
                    + 0.12
                )

                if Prompt.Parent then
                    Prompt:InputHoldEnd()
                end
            end)
    elseif type(
        fireproximityprompt
    ) == "function"
    then
        Success =
            pcall(function()
                fireproximityprompt(
                    Prompt
                )
            end)
    else
        Success =
            pcall(function()
                Prompt:InputHoldBegin()

                task.wait(
                    0.10
                )

                if Prompt.Parent then
                    Prompt:InputHoldEnd()
                end
            end)
    end

    task.wait(
        0.15
    )

    return Success
end


function AutoOuwigaharaController:WaitForAliveGameCharacter(
    Timeout,
    PreviousCharacter
)
    local StartedAt =
        os.clock()

    Timeout =
        tonumber(
            Timeout
        )
        or self.AutoDieCharacterWait

    while HubRunning
        and Settings.AutoDieAtPoints
        and os.clock()
            - StartedAt
            < Timeout
    do
        local Character =
            LocalPlayer.Character

        local Humanoid =
            Character
            and Character:FindFirstChildOfClass(
                "Humanoid"
            )

        local Root =
            Character
            and Character:FindFirstChild(
                "HumanoidRootPart"
            )

        if Character
            and Character ~= PreviousCharacter
            and Humanoid
            and Humanoid.Health > 0
            and Root
        then
            return Character,
                Humanoid,
                Root
        end

        task.wait(
            0.10
        )
    end

    return nil,
        nil,
        nil
end


function AutoOuwigaharaController:ResetCurrentGameCharacter(
    Character
)
    Character =
        Character
        or LocalPlayer.Character

    if not Character
        or not Character.Parent
    then
        return false
    end

    local Humanoid =
        Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not Humanoid
        or Humanoid.Health <= 0
    then
        return false
    end

    local Success =
        pcall(function()
            Humanoid.Health =
                0
        end)

    task.wait(
        0.35
    )

    -- Fallback for games where directly setting local Humanoid.Health is
    -- delayed/ignored. This only resets the local Roblox character.
    if Character.Parent
        and Humanoid.Parent
        and Humanoid.Health > 0
    then
        pcall(function()
            Character:BreakJoints()
        end)
    end

    return Success
end


function AutoOuwigaharaController:RunAutoDieSequence(
    CurrentPoints,
    Threshold
)
    if self.AutoDieBusy
        or self.AutoDieTriggeredThisRun
        or not Settings.AutoDieAtPoints
    then
        return false
    end

    self.AutoDieTriggeredThisRun =
        true

    self.AutoDieBusy =
        true

    self.AutoDieSequenceId +=
        1

    local MySequenceId =
        self.AutoDieSequenceId

    HubDebug(
        "[Combat Hub] Auto Die triggered • RunPoints="
            .. tostring(
                CurrentPoints
            )
            .. " threshold="
            .. tostring(
                Threshold
            )
            .. " Hearts="
            .. tostring(
                self:GetHearts()
                or "?"
            )
            .. " • up to "
            .. tostring(
                self.AutoDieRespawnCount
            )
            .. " life losses"
    )

    task.spawn(function()
        local PreviousCharacter =
            nil

        for DeathIndex = 1,
            self.AutoDieRespawnCount
        do
            if not HubRunning
                or not Settings.AutoDieAtPoints
                or MySequenceId
                    ~= self.AutoDieSequenceId
            then
                break
            end

            if self:IsInRewardShops()
                or LocalPlayer:GetAttribute(
                    "Spectating"
                ) == true
            then
                break
            end

            local HeartsBefore =
                self:GetHearts()

            if HeartsBefore ~= nil
                and HeartsBefore <= 0
            then
                break
            end

            local Character,
                Humanoid =
                self:WaitForAliveGameCharacter(
                    self.AutoDieCharacterWait,
                    PreviousCharacter
                )

            if not Character
                or not Humanoid
            then
                warn(
                    "[Combat Hub] Auto Die: timed out waiting for living character"
                )

                break
            end

            HubDebug(
                "[Combat Hub] Auto Die: life-loss "
                    .. tostring(
                        DeathIndex
                    )
                    .. "/"
                    .. tostring(
                        self.AutoDieRespawnCount
                    )
                    .. " • Hearts before="
                    .. tostring(
                        HeartsBefore
                        or "?"
                    )
            )

            PreviousCharacter =
                Character

            self:ResetCurrentGameCharacter(
                Character
            )

            local LifeStarted =
                os.clock()

            while HubRunning
                and Settings.AutoDieAtPoints
                and MySequenceId
                    == self.AutoDieSequenceId
                and os.clock()
                    - LifeStarted
                    < self.AutoDieCharacterWait
            do
                local HeartsNow =
                    self:GetHearts()

                if self:IsInRewardShops()
                    or LocalPlayer:GetAttribute(
                        "Spectating"
                    ) == true
                    or (
                        HeartsNow ~= nil
                        and HeartsNow <= 0
                    )
                then
                    break
                end

                if HeartsBefore ~= nil
                    and HeartsNow ~= nil
                    and HeartsNow < HeartsBefore
                then
                    break
                end

                task.wait(
                    0.10
                )
            end

            local HeartsAfter =
                self:GetHearts()

            HubDebug(
                "[Combat Hub] Auto Die: Hearts after="
                    .. tostring(
                        HeartsAfter
                        or "?"
                    )
            )

            if self:IsInRewardShops()
                or LocalPlayer:GetAttribute(
                    "Spectating"
                ) == true
                or (
                    HeartsAfter ~= nil
                    and HeartsAfter <= 0
                )
            then
                break
            end

            if DeathIndex
                < self.AutoDieRespawnCount
            then
                local NewCharacter =
                    self:WaitForAliveGameCharacter(
                        self.AutoDieCharacterWait,
                        PreviousCharacter
                    )

                if not NewCharacter then
                    warn(
                        "[Combat Hub] Auto Die: next respawn never appeared"
                    )

                    break
                end

                PreviousCharacter =
                    nil

                task.wait(
                    0.45
                )
            end
        end

        if MySequenceId
            == self.AutoDieSequenceId
        then
            self.AutoDieBusy =
                false
        end
    end)

    return true
end

function AutoOuwigaharaController:CheckAutoDieAtPoints()
    if not Settings.AutoDieAtPoints
        or self.AutoDieBusy
        or self.AutoDieTriggeredThisRun
        or self:IsInRewardShops()
        or LocalPlayer:GetAttribute(
            "Spectating"
        ) == true
    then
        return false
    end

    local Threshold =
        math.max(
            1,
            math.floor(
                tonumber(
                    Settings.DieAtPoints
                )
                or 30000
            )
        )

    local CurrentPoints =
        self:GetRunPoints()

    if CurrentPoints
        < Threshold
    then
        return false
    end

    local Hearts =
        self:GetHearts()

    if Hearts ~= nil
        and Hearts <= 0
    then
        return false
    end

    return self:RunAutoDieSequence(
        CurrentPoints,
        Threshold
    )
end

function AutoOuwigaharaController:WaitForRewardCharacter(
    Timeout
)
    local StartedAt =
        os.clock()

    Timeout =
        tonumber(
            Timeout
        )
        or self.RewardCharacterWait

    while HubRunning
        and self:IsRewardAutomationEnabled()
        and os.clock()
            - StartedAt
            < Timeout
    do
        local Character =
            LocalPlayer.Character

        local Humanoid =
            Character
            and Character:FindFirstChildOfClass(
                "Humanoid"
            )

        local Root =
            Character
            and Character:FindFirstChild(
                "HumanoidRootPart"
            )

        if Character
            and Humanoid
            and Humanoid.Health > 0
            and Root
        then
            return Character,
                Root
        end

        task.wait(
            0.15
        )
    end

    return nil,
        nil
end


function AutoOuwigaharaController:GetExactRewardModel(
    Name
)
    local Chests =
        workspace:FindFirstChild(
            "Chests"
        )

    if not Chests then
        return nil
    end

    local Model =
        Chests:FindFirstChild(
            Name
        )

    if Model
        and Model:IsA(
            "Model"
        )
    then
        return Model
    end

    return nil
end


function AutoOuwigaharaController:GetChestPromptFromModel(
    Model
)
    if not Model
        or not Model.Parent
    then
        return nil
    end

    local Root =
        Model:FindFirstChild(
            "RootPart"
        )
        or Model.PrimaryPart

    local Anchor =
        Root
        and Root:FindFirstChild(
            "ChestPromptAnchor"
        )

    local Prompt =
        Anchor
        and Anchor:FindFirstChild(
            "ChestPrompt"
        )

    if Prompt
        and Prompt:IsA(
            "ProximityPrompt"
        )
    then
        return Prompt
    end

    Prompt =
        Model:FindFirstChild(
            "ChestPrompt",
            true
        )

    if Prompt
        and Prompt:IsA(
            "ProximityPrompt"
        )
    then
        return Prompt
    end

    return nil
end


function AutoOuwigaharaController:GetRewardModelState()
    local Cache =
        self:GetExactRewardModel(
            "Ouwigahara Cache"
        )

    local Chest =
        self:GetExactRewardModel(
            "Ouwigahara Chest"
        )

    local DeepCache =
        self:GetExactRewardModel(
            "Ouwigahara Deep Cache"
        )

    return Cache,
        Chest,
        DeepCache
end

function AutoOuwigaharaController:HasRewardRoomModels()
    local Cache,
        Chest,
        DeepCache =
        self:GetRewardModelState()

    return Cache ~= nil
        or DeepCache ~= nil
        or Chest ~= nil
end

function AutoOuwigaharaController:GetChestContainer(
    Prompt
)
    local Chests =
        workspace:FindFirstChild(
            "Chests"
        )

    if not Chests
        or not Prompt
    then
        return nil
    end

    local Current =
        Prompt

    while Current
        and Current.Parent
        and Current ~= Chests
    do
        if Current.Parent
            == Chests
        then
            return Current
        end

        Current =
            Current.Parent
    end

    return nil
end


function AutoOuwigaharaController:IsRewardChestOpen(
    Container,
    Prompt
)
    -- Destroyed/replaced chest after an interaction counts as opened.
    if Container
        and not Container.Parent
    then
        return true
    end

    if Container then
        if Container:GetAttribute(
            "IsOpen"
        ) == true
        then
            return true
        end

        local State =
            string.lower(
                tostring(
                    Container:GetAttribute(
                        "ChestState"
                    )
                    or Container:GetAttribute(
                        "State"
                    )
                    or ""
                )
            )

        if State == "opened"
            or State == "despawned"
        then
            return true
        end
    end

    -- Chest prompts normally disable/disappear after the server accepts
    -- the open. This is a stronger confirmation than pcall succeeding.
    if not Prompt
        or not Prompt.Parent
        or not Prompt.Enabled
    then
        return true
    end

    return false
end


function AutoOuwigaharaController:WaitForRewardChestOpened(
    Prompt,
    Container,
    Timeout
)
    Timeout =
        tonumber(
            Timeout
        )
        or self.FreeChestOpenConfirmWait

    local StartedAt =
        os.clock()

    while HubRunning
        and Settings.AutoRewardChests
        and os.clock()
            - StartedAt
            < Timeout
    do
        if self:IsRewardChestOpen(
            Container,
            Prompt
        )
        then
            return true
        end

        task.wait(
            0.08
        )
    end

    return self:IsRewardChestOpen(
        Container,
        Prompt
    )
end


function AutoOuwigaharaController:TriggerAndConfirmRewardChest(
    Prompt,
    Timeout
)
    if not Prompt
        or not Prompt.Parent
    then
        return false
    end

    local Container =
        self:GetChestContainer(
            Prompt
        )

    local Triggered =
        self:TriggerWorldPrompt(
            Prompt
        )

    if not Triggered then
        return false
    end

    return self:WaitForRewardChestOpened(
        Prompt,
        Container,
        Timeout
    )
end


function AutoOuwigaharaController:GetRewardChestPrompts()
    local Free =
        {}

    local Paid =
        {}

    local Chests =
        workspace:FindFirstChild(
            "Chests"
        )

    if not Chests then
        return Free,
            Paid
    end

    local Seen =
        {}

    local function AddFree(
        Prompt
    )
        if not Prompt
            or not Prompt.Parent
            or not Prompt:IsA(
                "ProximityPrompt"
            )
            or not Prompt.Enabled
            or Seen[
                Prompt
            ]
        then
            return
        end

        local Container =
            self:GetChestContainer(
                Prompt
            )

        if self:IsRewardChestOpen(
            Container,
            Prompt
        )
        then
            return
        end

        Seen[
            Prompt
        ] =
            true

        table.insert(
            Free,
            Prompt
        )
    end

    local function AddPaid(
        Prompt,
        Container
    )
        if not Prompt
            or not Prompt.Parent
            or not Prompt:IsA(
                "ProximityPrompt"
            )
            or not Prompt.Enabled
            or Seen[
                Prompt
            ]
        then
            return
        end

        if self:IsRewardChestOpen(
            Container
            or self:GetChestContainer(
                Prompt
            ),
            Prompt
        )
        then
            return
        end

        Seen[
            Prompt
        ] =
            true

        local NormalizedAction =
            string.lower(
                string.gsub(
                    tostring(
                        Prompt.ActionText
                        or ""
                    ),
                    ",",
                    ""
                )
            )

        local Cost =
            tonumber(
                string.match(
                    NormalizedAction,
                    "(%d+)%s*points"
                )
            )
            or 30000

        table.insert(
            Paid,
            {
                Prompt =
                    Prompt,

                Cost =
                    Cost,

                Container =
                    Container,
            }
        )
    end

    ----------------------------------------------------------
    -- EXACT OUWIGAHARA REWARD MODELS
    ----------------------------------------------------------

    local Cache =
        self:GetExactRewardModel(
            "Ouwigahara Cache"
        )

    if Cache then
        AddFree(
            self:GetChestPromptFromModel(
                Cache
            )
        )
    end

    local DeepCache =
        self:GetExactRewardModel(
            "Ouwigahara Deep Cache"
        )

    if DeepCache then
        AddFree(
            self:GetChestPromptFromModel(
                DeepCache
            )
        )
    end

    local Chest =
        self:GetExactRewardModel(
            "Ouwigahara Chest"
        )

    if Chest then
        AddPaid(
            self:GetChestPromptFromModel(
                Chest
            ),
            Chest
        )
    end

    ----------------------------------------------------------
    -- FALLBACK: any other Floor ## reward prompts
    ----------------------------------------------------------

    for _,
        Object in ipairs(
            Chests:GetDescendants()
        )
    do
        if Object:IsA(
            "ProximityPrompt"
        )
            and Object.Name
                == "ChestPrompt"
            and Object.Enabled
            and not Seen[
                Object
            ]
        then
            local Container =
                self:GetChestContainer(
                    Object
                )

            local ContainerName =
                Container
                and string.lower(
                    tostring(
                        Container.Name
                    )
                )
                or ""

            local ObjectText =
                tostring(
                    Object.ObjectText
                    or ""
                )

            local LowerObjectText =
                string.lower(
                    ObjectText
                )

            local NormalizedAction =
                string.lower(
                    string.gsub(
                        tostring(
                            Object.ActionText
                            or ""
                        ),
                        ",",
                        ""
                    )
                )

            local Cost =
                tonumber(
                    string.match(
                        NormalizedAction,
                        "(%d+)%s*points"
                    )
                )

            if ContainerName
                == "ouwigahara chest"
                or LowerObjectText
                    == "ouwigahara chest"
            then
                AddPaid(
                    Object,
                    Container
                )
            elseif ContainerName
                == "ouwigahara cache"
                or ContainerName
                    == "ouwigahara deep cache"
                or LowerObjectText
                    == "ouwigahara cache"
                or LowerObjectText
                    == "ouwigahara deep cache"
                or string.match(
                    ObjectText,
                    "^Floor%s+%d+"
                )
            then
                AddFree(
                    Object
                )
            elseif Cost then
                AddPaid(
                    Object,
                    Container
                )
            end
        end
    end

    table.sort(
        Free,
        function(A, B)
            if A == B then
                return false
            end

            local AContainer =
                self:GetChestContainer(
                    A
                )

            local BContainer =
                self:GetChestContainer(
                    B
                )

            local AIsCache =
                AContainer
                and (
                    AContainer.Name
                        == "Ouwigahara Cache"
                    or AContainer.Name
                        == "Ouwigahara Deep Cache"
                )
                or false

            local BIsCache =
                BContainer
                and (
                    BContainer.Name
                        == "Ouwigahara Cache"
                    or BContainer.Name
                        == "Ouwigahara Deep Cache"
                )
                or false

            if AIsCache
                ~= BIsCache
            then
                return AIsCache
            end

            local ANumber =
                tonumber(
                    string.match(
                        tostring(
                            A.ObjectText
                            or ""
                        ),
                        "(%d+)"
                    )
                )
                or 0

            local BNumber =
                tonumber(
                    string.match(
                        tostring(
                            B.ObjectText
                            or ""
                        ),
                        "(%d+)"
                    )
                )
                or 0

            if ANumber
                ~= BNumber
            then
                return ANumber
                    < BNumber
            end

            return false
        end
    )

    return Free,
        Paid
end


function AutoOuwigaharaController:HasRewardChests()
    local Free,
        Paid =
        self:GetRewardChestPrompts()

    return #Free > 0
        or #Paid > 0
end


function AutoOuwigaharaController:HasFreeRewardChests()
    local Free =
        self:GetRewardChestPrompts()

    return #Free > 0
end


function AutoOuwigaharaController:WaitForPaidRewardPrompt(
    Timeout
)
    local StartedAt =
        os.clock()

    Timeout =
        tonumber(
            Timeout
        )
        or self.PaidPromptRespawnWait

    while HubRunning
        and self:IsRewardAutomationEnabled()
        and os.clock()
            - StartedAt
            < Timeout
    do
        local _,
            Paid =
            self:GetRewardChestPrompts()

        if Paid[1]
            and Paid[1].Prompt
            and Paid[1].Prompt.Parent
        then
            return Paid[1]
        end

        -- If the model exists but its prompt is still resealing/streaming,
        -- keep its area loaded instead of immediately abandoning the paid
        -- chest path.
        local PaidModel =
            self:GetExactRewardModel(
                "Ouwigahara Chest"
            )

        if PaidModel
            and PaidModel.Parent
        then
            local Root =
                PaidModel:FindFirstChild(
                    "RootPart"
                )
                or PaidModel.PrimaryPart
                or PaidModel:FindFirstChildWhichIsA(
                    "BasePart",
                    true
                )

            if Root then
                pcall(function()
                    workspace:RequestStreamAroundAsync(
                        Root.Position
                    )
                end)
            end
        end

        task.wait(
            0.10
        )
    end

    return nil
end

function AutoOuwigaharaController:IsRewardRoomAvailable()
    if self:IsInRewardShops() then
        return true
    end

    if self:IsRewardResultsVisible() then
        return true
    end

    if self:HasRewardRoomModels()
        or self:HasRewardChests()
    then
        return true
    end

    -- Ended timestamp is secondary only; combine it with local transition
    -- state so an old server timestamp cannot misclassify the lobby.
    if workspace:GetAttribute(
        "MinigameRunEnded"
    ) ~= nil
        and (
            self.WasDungeonRunning
            or self.PostRunPending
            or self.RewardPassComplete
        )
    then
        return true
    end

    return false
end

function AutoOuwigaharaController:HasActionableRewardChest()
    local Free,
        Paid =
        self:GetRewardChestPrompts()

    if #Free > 0 then
        return true
    end

    local Entry =
        Paid[1]

    if not Entry then
        return false
    end

    local Cost =
        tonumber(
            Entry.Cost
        )
        or 30000

    return self:GetRunPoints()
        >= Cost
end

function AutoOuwigaharaController:GetAffordablePaidChest(
    ConfirmTime
)
    local _,
        Paid =
        self:GetRewardChestPrompts()

    local Entry =
        Paid[1]

    if not Entry
        or not Entry.Prompt
        or not Entry.Prompt.Parent
    then
        return nil,
            self:GetRunPoints(),
            30000
    end

    local CurrentPoints =
        self:GetRunPoints()

    local Cost =
        tonumber(
            Entry.Cost
        )
        or 30000

    if CurrentPoints
        < Cost
    then
        return nil,
            CurrentPoints,
            Cost
    end

    ConfirmTime =
        tonumber(
            ConfirmTime
        )
        or self.PaidAffordabilityConfirmTime

    local StartedAt =
        os.clock()

    while HubRunning
        and Settings.AutoRewardChests
        and os.clock()
            - StartedAt
            < ConfirmTime
    do
        local FreeNow =
            self:GetRewardChestPrompts()

        if #FreeNow > 0 then
            return nil,
                self:GetRunPoints(),
                Cost
        end

        CurrentPoints =
            self:GetRunPoints()

        if CurrentPoints
            < Cost
        then
            return nil,
                CurrentPoints,
                Cost
        end

        task.wait(
            0.08
        )
    end

    return Entry,
        CurrentPoints,
        Cost
end

function AutoOuwigaharaController:GetPointsValue()
    local Leaderstats =
        LocalPlayer:FindFirstChild(

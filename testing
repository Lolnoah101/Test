--// ============================================================
--// PRICE PARSER
--// ============================================================

local PriceSuffixes = {

    [""] = 1,

    ["k"] = 1e3,
    ["m"] = 1e6,
    ["b"] = 1e9,
    ["t"] = 1e12,

    ["qa"] = 1e15,
    ["qi"] = 1e18,

    ["sx"] = 1e21,
    ["sp"] = 1e24,

    ["oc"] = 1e27,
    ["no"] = 1e30,

    ["dc"] = 1e33
}


local function ParsePrice(
    Text
)

    if typeof(Text)
        ~= "string"
    then

        return nil
    end


    local Clean =
        string.lower(
            Text
        )


    Clean =
        Clean:gsub(",", "")

    Clean =
        Clean:gsub("%$", "")

    Clean =
        Clean:gsub("%s+", "")


    local NumberText, Suffix =
        Clean:match(
            "^([%d%.]+)([%a]*)$"
        )


    if not NumberText then
        return nil
    end


    local Number =
        tonumber(
            NumberText
        )


    local Multiplier =
        PriceSuffixes[
            Suffix
        ]


    if
        not Number
        or not Multiplier
    then

        return nil
    end


    return
        Number
        * Multiplier
end


--// ============================================================
--// AURA
--// ============================================================

local function GetAuraInfo(
    Card
)

    local ID =
        tonumber(
            Card.Name
        )


    if not ID then
        return nil
    end


    local Sellall =
        Card:FindFirstChild(
            "Sellall"
        )


    if not Sellall then
        return nil
    end


    local Name =
        "Aura "
        .. tostring(ID)


    local Flame =
        Sellall:FindFirstChild(
            "Flame"
        )


    local NameLabel =
        Flame
        and Flame:FindFirstChild(
            "name"
        )


    if NameLabel then

        Name =
            NameLabel.Text

    end


    local Owned =
        false


    local EquipFolder =
        Sellall:FindFirstChild(
            "zhuangbei"
        )


    local EquipBian =
        EquipFolder
        and EquipFolder:FindFirstChild(
            "Bian"
        )


    local EquipLabel =
        EquipBian
        and EquipBian:FindFirstChild(
            "TextLabel"
        )


    if EquipLabel then

        local Text =
            string.lower(
                tostring(
                    EquipLabel.Text
                )
            )


        Owned =

            Text == "equip"

            or Text == "unequip"

    end


    local Sell1 =
        Sellall:FindFirstChild(
            "Sell1"
        )


    local PriceBian =
        Sell1
        and Sell1:FindFirstChild(
            "Bian"
        )


    local PriceLabel =
        PriceBian
        and PriceBian:FindFirstChild(
            "TextLabel"
        )


    local PriceText =
        PriceLabel
        and PriceLabel.Text


    return {

        id = ID,

        name = Name,

        owned = Owned,

        price =
            PriceText
            and ParsePrice(
                PriceText
            ),

        card = Card
    }
end


local function FindNextAura()

    local List = {}


    for _, Card in ipairs(
        AuraScrollingFrame:GetChildren()
    ) do

        local Info =
            GetAuraInfo(
                Card
            )


        if Info then

            table.insert(
                List,
                Info
            )

        end

    end


    table.sort(
        List,

        function(A, B)

            return A.id < B.id

        end
    )


    for _, Info in ipairs(
        List
    ) do

        if
            not Info.owned
            and Info.price
        then

            return Info

        end

    end


    return nil
end


local CurrentAuraTarget =
    nil


local AuraBuying =
    false


local function RefreshAuraTarget()

    CurrentAuraTarget =
        FindNextAura()
end


local function BuyTargetAura()

    if
        not HubRunning
        or not Settings.AutoBuyBestAura
        or AuraBuying
    then

        return
    end


    if not CurrentAuraTarget then

        RefreshAuraTarget()

    end


    local Aura =
        CurrentAuraTarget


    if not Aura then
        return
    end


    local Updated =
        GetAuraInfo(
            Aura.card
        )


    if
        Updated
        and Updated.owned
    then

        RefreshAuraTarget()

        Aura =
            CurrentAuraTarget

    end


    if not Aura then
        return
    end


    local Cash =
        tonumber(
            CashValue.Value
        ) or 0


    if Cash < Aura.price then
        return
    end


    AuraBuying =
        true


    local CashBefore =

local function IsRayfieldLibrary(Value)
    return type(Value) == "table"
        and type(
            Value.CreateWindow
        ) == "function"
end


local function LoadRayfield()
    local Environment =
        type(getgenv) == "function"
        and getgenv()
        or _G

    local CachedLibrary =
        Environment
            .__HOLLOWMOON_RAYFIELD_GEN2

    if IsRayfieldLibrary(
        CachedLibrary
    ) then
        return CachedLibrary
    end

    local CacheFolder =
        "HollowMoonHub"

    local CacheFile =
        CacheFolder
        .. "/RayfieldGen2Cache.lua"

    local function RunSource(
        Source,
        Origin
    )
        if type(Source) ~= "string"
            or Source == ""
        then
            return nil,
                tostring(Origin)
                .. " returned an empty response"
        end

        local Chunk,
            CompileError =
            loadstring(
                Source
            )

        if not Chunk then
            return nil,
                tostring(Origin)
                .. " compile failed: "
                .. tostring(
                    CompileError
                )
        end

        local RunSuccess,
            Library =
            pcall(
                Chunk
            )

        if not RunSuccess then
            return nil,
                tostring(Origin)
                .. " runtime failed: "
                .. tostring(
                    Library
                )
        end

        if not IsRayfieldLibrary(
            Library
        ) then
            return nil,
                tostring(Origin)
                .. " did not return CreateWindow"
        end

        Environment
            .__HOLLOWMOON_RAYFIELD_GEN2 =
                Library

        return Library
    end

    local function SaveSourceCache(
        Source
    )
        if type(writefile) ~= "function"
            or type(Source) ~= "string"
            or Source == ""
        then
            return
        end

        pcall(function()
            if type(isfolder) == "function"
                and type(makefolder) == "function"
                and not isfolder(
                    CacheFolder
                )
            then
                makefolder(
                    CacheFolder
                )
            end

            writefile(
                CacheFile,
                Source
            )
        end)
    end

    local function LoadDiskCache()
        if type(readfile) ~= "function" then
            return nil
        end

        if type(isfile) == "function"
            and not isfile(
                CacheFile
            )
        then
            return nil
        end

        local ReadSuccess,
            Source =
            pcall(
                readfile,
                CacheFile
            )

        if not ReadSuccess
            or type(Source) ~= "string"
            or Source == ""
        then
            return nil
        end

        local Library =
            RunSource(
                Source,
                "Rayfield disk cache"
            )

        return Library
    end

    -- If a previous successful launch saved Gen2 locally, use it first.
    -- That keeps the hub usable during temporary Sirius/CDN outages.
    local DiskLibrary =
        LoadDiskCache()

    if DiskLibrary then
        return DiskLibrary
    end

    local URLs = {
        "https://sirius.menu/gen2",
        "https://sirius.menu/gen2-preview",
    }

    local LastError =
        "Unknown Rayfield loader error"

    local function FetchWithHttpGet(
        URL
    )
        local Success,
            Source =
            pcall(function()
                -- false asks supported executors not to reuse a stale HTTP cache.
                return game:HttpGet(
                    URL,
                    false
                )
            end)

        if not Success then
            return nil,
                tostring(
                    Source
                )
        end

        if type(Source) ~= "string"
            or Source == ""
        then
            return nil,
                "empty response"
        end

        return Source
    end

    local function FetchWithRequest(
        URL
    )
        local Request =
            (
                type(request) == "function"
                and request
            )
            or (
                type(http_request) == "function"
                and http_request
            )
            or (
                syn
                and type(syn.request) == "function"
                and syn.request
            )

        if type(Request) ~= "function" then
            return nil,
                "request API unavailable"
        end

        local Success,
            Response =
            pcall(
                Request,
                {
                    Url = URL,
                    Method = "GET",
                    Headers = {
                        ["Cache-Control"] = "no-cache",
                        ["Pragma"] = "no-cache",
                    },
                }
            )

        if not Success then
            return nil,
                tostring(
                    Response
                )
        end

        local Body =
            type(Response) == "table"
            and (
                Response.Body
                or Response.body
            )
            or nil

        if type(Body) ~= "string"
            or Body == ""
        then
            return nil,
                "empty response"
        end

        return Body
    end

    for _, URL in ipairs(
        URLs
    ) do
        for Attempt = 1, 6 do
            local Source,
                FetchError =
                FetchWithHttpGet(
                    URL
                )

            if not Source then
                Source,
                    FetchError =
                    FetchWithRequest(
                        URL
                    )
            end

            if Source then
                local Library,
                    LoadError =
                    RunSource(
                        Source,
                        URL
                    )

                if Library then
                    SaveSourceCache(
                        Source
                    )

                    return Library
                end

                LastError =
                    tostring(
                        LoadError
                    )
            else
                LastError =
                    URL
                    .. ": "
                    .. tostring(
                        FetchError
                    )
            end

            if Attempt < 6 then
                task.wait(
                    math.min(
                        Attempt,
                        3
                    )
                )
            end
        end
    end

    -- One final cache check in case another copy of the hub/library
    -- finished writing the source while the network attempts were running.
    DiskLibrary =
        LoadDiskCache()

    if DiskLibrary then
        return DiskLibrary
    end

    error(
        "[Auto Click] Rayfield Gen2 could not be loaded. "
            .. "Both Sirius endpoints returned no usable source and no local cache exists. "
            .. "Last error: "
            .. tostring(
                LastError
            ),
        0
    )
end


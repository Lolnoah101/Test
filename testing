--// ============================================================

local AutoWaterLoopID = 0


local function WaterOnce()

    if not HubRunning then
        return false
    end

    local Success = pcall(function()

        WaterEvent:FireServer(
            163
        )

    end)

    return Success
end


local function StartAutoWater()

    AutoWaterLoopID += 1

    local ID =
        AutoWaterLoopID

    task.spawn(function()

        while
            HubRunning
            and Settings.AutoWater
            and ID == AutoWaterLoopID
        do

            -- Don't spam the water remote while the farm is returning
            -- home, equipping, selling, or waiting for backpack space.
            if
                not BackpackSequenceBusy
                and not FarmWaitingForBackpack
            then

                WaterOnce()

            end

            task.wait(
                math.max(
                    tonumber(Settings.WaterInterval) or 0.10,
                    0.03
                )
            )

        end

    end)
end


local function StopAutoWater()

    Settings.AutoWater =
        false

    AutoWaterLoopID += 1
end



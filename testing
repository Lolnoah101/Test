    local Server =
        Enemies
        and Enemies:FindFirstChild(
            "Server"
        )

    if not Server then
        return {}
    end

    local Seen = {}
    local Options = {}

    for _, AreaFolder in ipairs(
        Server:GetChildren()
    ) do
        -- Skip Raid / Time Trial server folders.
        if AreaFolder.Name ~= "Gamemode" then
            for _, Enemy in ipairs(
                AreaFolder:GetChildren()
            ) do
                if IsSecretEnemy(
                    Enemy
                ) then
                    local Name =
                        GetEnemyDisplayName(
                            Enemy
                        )

                    if Name
                        and not Seen[
                            Name
                        ]
                    then
                        Seen[
                            Name
                        ] = true

                        table.insert(
                            Options,
                            Name
                        )
                    end
                end
            end
        end
    end

    table.sort(
        Options
    )

    return Options,
        Signature
end



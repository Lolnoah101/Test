-- =========================
-- ENEMY DETECTION
-- =========================
local function isEntityAlive(entity)
    if not entity or not entity.Parent then return false end
    local humanoid = entity:FindFirstChildOfClass("Humanoid")
    if humanoid then return humanoid.Health > 0 end
    if entity:GetAttribute("Dead") == true then return false end
    local healthAttr = entity:GetAttribute("Health")
    if healthAttr and tonumber(healthAttr) then return tonumber(healthAttr) > 0 end
    return false
end

local function getAllEnemies()
    local enemies = {}
    
    local generatedFolder = nil
    for _, child in ipairs(workspace:GetChildren()) do
        if string.find(child.Name, "Generated_") then
            generatedFolder = child
            break
        end
    end
    
    if not generatedFolder then
        return enemies
    end
    
    local npcsFolder = generatedFolder:FindFirstChild("NPCs")
    if not npcsFolder then
        return enemies
    end
    
    for _, enemy in ipairs(npcsFolder:GetChildren()) do
        if isEntityAlive(enemy) then
            table.insert(enemies, enemy)
        end
    end
    
    return enemies
end

local function hasAliveTargets()
    return #getAllEnemies() > 0
end

local function getClosestEnemy()
    local character = LocalPlayer.Character
    if not character then return nil end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local enemies = getAllEnemies()
    local closest = nil
    local closestDist = math.huge

    for _, enemy in ipairs(enemies) do
        local root = enemy:FindFirstChild("HumanoidRootPart") or enemy:FindFirstChildWhichIsA("BasePart")
        if root then
            local dist = (hrp.Position - root.Position).Magnitude
            if dist < closestDist then
                closestDist = dist
                closest = {
                    part = root,
                    entity = enemy,
                    dist = dist
                }
            end
        end
    end
    return closest
end

-- =========================
-- MOVEMENT (FROM WORKING SCRIPT)
-- =========================
local function getTargetCFrameSnap(enemyCF)
    local player = LocalPlayer
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    if selectedMode == "Behind" then
        local lookVector = enemyCF.LookVector
        if lookVector.Magnitude < 0.1 then
            lookVector = (hrp.Position - enemyCF.Position).Unit
        end
        return CFrame.lookAt(enemyCF.Position - lookVector * distance + Vector3.new(0,2,0), enemyCF.Position)
    elseif selectedMode == "Above" then
        return CFrame.lookAt(enemyCF.Position + Vector3.new(0,distance,0), enemyCF.Position + Vector3.new(0,2,0))
    elseif selectedMode == "Below" then
        return CFrame.lookAt(enemyCF.Position - Vector3.new(0,distance,0), enemyCF.Position)
    end
    return nil
end

local function startFollow(targetData)
    if not targetData or not targetData.part then return end
    if followConnection then followConnection:Disconnect() end

    local player = LocalPlayer
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then print("[AutoFarm] No HRP"); return end

    print("[AutoFarm] Following", targetData.entity.Name)
    local circleAngle = 0

    followConnection = RunService.Heartbeat:Connect(function(dt)
        if not targetData.part or not targetData.part.Parent or not isEntityAlive(targetData.entity) then
            followConnection:Disconnect()
            followConnection = nil
            currentTarget = nil
            return
        end
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local targetCF
        if selectedMode == "Circle" then
            circleAngle = circleAngle + circleSpeed * dt
            local x = math.cos(circleAngle) * distance
            local z = math.sin(circleAngle) * distance
            targetCF = CFrame.lookAt(targetData.part.Position + Vector3.new(x,1,z), targetData.part.Position)
        else
            targetCF = getTargetCFrameSnap(targetData.part.CFrame)
        end
        if targetCF then hrp.CFrame = targetCF end
    end)
end


local function IsGuiActuallyVisible(Object)
    if not Object then
        return false
    end

    local Current =
        Object

    while Current
        and Current ~= LocalPlayer:FindFirstChild("PlayerGui")
    do
        if Current:IsA("GuiObject")
            and not Current.Visible
        then
            return false
        end

        if Current:IsA("LayerCollector")
            and Current.Enabled == false
        then
            return false
        end

        Current =
            Current.Parent
    end

    return true
end


local function GetResultsReturnButton()
    local PlayerGui =
        LocalPlayer:FindFirstChild(
            "PlayerGui"
        )

    local Results =
        PlayerGui
        and PlayerGui:FindFirstChild(
            "Results"
        )

    if not Results then
        return nil
    end

    -- Prefer the normal path used by the game's Results screen.
    local Content =
        Results:FindFirstChild(
            "Content"
        )

    local Buttons =
        Content
        and Content:FindFirstChild(
            "Buttons"
        )

    local Button =
        Buttons
        and Buttons:FindFirstChild(
            "Return"
        )

    if Button
        and Button:IsA("GuiButton")
    then
        return Button
    end

    -- Fallback for other result types/layouts (Raid, Time Trial, etc.).
    local RecursiveButton =
        Results:FindFirstChild(
            "Return",
            true
        )

    if RecursiveButton
        and RecursiveButton:IsA(
            "GuiButton"
        )
    then
        return RecursiveButton
    end

    return nil
end


local function TryClickResultsReturn()
    local Button =
        GetResultsReturnButton()

    if not Button
        or not Button:IsA("GuiButton")
        or not IsGuiActuallyVisible(Button)
    then
        return false
    end

    local Clicked = false

    -- UI-only activation. These do NOT move or press the user's mouse,
    -- so Rayfield dropdowns/toggles remain fully usable.
    pcall(function()
        Button:Activate()
        Clicked = true
    end)

    if type(firesignal) == "function" then
        pcall(function()
            firesignal(
                Button.MouseButton1Click
            )

            Clicked = true
        end)

        pcall(function()
            firesignal(
                Button.Activated
            )

            Clicked = true
        end)
    end

    return Clicked
end


task.spawn(function()

local function GetCharacter()

    local Character =
        LocalPlayer.Character


    if not Character then

        Character =
            LocalPlayer.CharacterAdded:Wait()

    end


    return Character
end


local function GetRoot()

    local Character =
        LocalPlayer.Character


    if not Character then
        return nil
    end


    return Character:FindFirstChild(
        "HumanoidRootPart"
    )
end


local function TeleportToCFrame(
    Target
)

    local Character =
        GetCharacter()


    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )


    if not Root then
        return false
    end


    Character:PivotTo(
        Target
    )


    return true
end



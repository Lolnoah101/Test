local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local Window = Rayfield:CreateWindow({
    name = "Testing",
    subtitle = "Combat",
    theme = "default",

    configuration = {
        autoSave = true,
        autoLoad = true,
        fileName = "TestingHubV3",
    },
})

local CombatTab = Window:CreateTab({
    name = "Combat",
})

local Remotes = game:GetService("ReplicatedStorage").Player.Remotes.Inputs
local Attack = Remotes.Attack
local Skill = Remotes.Skill

local AutoM1 = false
local AutoSkill1 = false
local AutoSkill2 = false
local AutoSkill3 = false
local AutoSkill4 = false

-- =========================
-- AUTO M1
-- =========================
CombatTab:CreateToggle({
    name = "Auto M1",
    flag = "AutoM1",

    callback = function(value)
        AutoM1 = value

        if value then
            task.spawn(function()
                while AutoM1 do
                    Attack:FireServer(Vector3.new(0, 0, 0))
                    task.wait(0.1)
                end
            end)
        end
    end,
})


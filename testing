local function PetIncomeOf(PetToolOrModel)
    if not PetToolOrModel then
        return 0
    end

    local PetName =
        PetToolOrModel:GetAttribute("PetName")
        or PetToolOrModel.Name

    local Data =
        PetsData[PetName]

    local BaseIncome =
        Data and tonumber(Data.Income) or 0

    if BaseIncome <= 0 then
        return 0
    end

    local Weight =
        tonumber(
            PetToolOrModel:GetAttribute("Weight")
        ) or 1

    local MutationFactor =
        Mutations.CombinedFactor(
            PetToolOrModel:GetAttribute("Mutation"),
            PetToolOrModel:GetAttribute("SpawnMutation")
        )

    local Income =
        math.floor(
            BaseIncome
            * (
                Weight
                / PetAging.WeightStandardKG
            )
        )
        * MutationFactor

    return math.floor(Income)
end


local function FindPetTool(PetKey)
    for _, Container in ipairs({
        LocalPlayer.Character,
        Backpack,
    }) do
        if Container then
            for _, Child in ipairs(
                Container:GetChildren()
            ) do
                if Child:IsA("Tool")
                    and Child:GetAttribute("PetKey") == PetKey
                then
                    return Child
                end
            end
        end
    end

    return nil
end


CollectOwnedPets = function()
    local Result = {}

    -- Already placed pets.
    local Success, AllRendered =
        pcall(function()
            return PetRenderer.GetAll()
        end)

    if Success and AllRendered then
        for _, PetInfo in pairs(AllRendered) do
            if PetInfo.OwnerUserId == LocalPlayer.UserId
                and PetInfo.Model
                and PetInfo.Model.Parent
            then
                table.insert(
                    Result,
                    {
                        Placed = true,
                        Key = PetInfo.PetKey,
                        Income =
                            tonumber(PetInfo.DisplayIncome)
                            or 0,
                        Position =
                            PetInfo.Model:GetPivot().Position,
                    }
                )
            end
        end
    end

    -- Pets in character / backpack.
    for _, Container in ipairs({
        LocalPlayer.Character,
        Backpack,
    }) do
        if Container then
            for _, Child in ipairs(
                Container:GetChildren()
            ) do
                if Child:IsA("Tool")
                    and Child:HasTag("Pet")
                    and Child:GetAttribute("PetKey")
                then
                    table.insert(
                        Result,
                        {
                            Placed = false,
                            Key =
                                Child:GetAttribute("PetKey"),
                            Income =
                                PetIncomeOf(Child),
                            Tool = Child,
                        }
                    )
                end
            end
        end
    end

    table.sort(
        Result,
        function(A, B)
            return A.Income > B.Income
        end
    )

    return Result
end


local function GetPetPlacementPosition(
    Root,
    Index
)
    local Row =
        math.floor(
            (Index - 1) / 3
        )

    local Forward =
        Row * 4 + 8

    local Position =
        (
            Root.CFrame
            * CFrame.new(
                (
                    (Index - 1) % 3
                    - 1
                ) * 4,
                0,
                -Forward
            )
        ).Position

    local Plot =
        GeneralService:GetPlot(
            LocalPlayer
        )

    local Baseplate =
        Plot
        and Plot:FindFirstChild(
            "Baseplate"
        )

    if not Baseplate then
        return Position
    end

    local LocalPosition =
        Baseplate.CFrame:PointToObjectSpace(
            Position
        )

    local XLimit =
        Baseplate.Size.X / 2 - 2

    local ZLimit =
        Baseplate.Size.Z / 2 - 2

    return Baseplate.CFrame:PointToWorldSpace(
        Vector3.new(
            math.clamp(
                LocalPosition.X,
                -XLimit,
                XLimit
            ),
            LocalPosition.Y,
            math.clamp(
                LocalPosition.Z,
                -ZLimit,
                ZLimit
            )
        )
    )
end


local function PlaceBestPetsOnce(
    ShowNotification
)
    if BestPetsBusy then
        return false, "Best-pet placement is already running."
    end

    BestPetsBusy = true

    local Character =
        LocalPlayer.Character

    local Humanoid =
        Character
        and Character:FindFirstChildOfClass(
            "Humanoid"
        )

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Humanoid
        or not Root
        or Humanoid.Health <= 0
    then
        BestPetsBusy = false
        return false, "Character is not ready."
    end

    local MaxPets =
        tonumber(
            LocalPlayer:GetAttribute("MaxPets")
        ) or 5

    local Owned =
        CollectOwnedPets()

    if #Owned == 0 then
        BestPetsBusy = false
        return false, "No pets were found."
    end

    local Desired = {}
    local DesiredKeys = {}

    for Index = 1,
        math.min(
            MaxPets,
            #Owned
        )
    do
        local Pet =
            Owned[Index]

        Desired[Index] = Pet
        DesiredKeys[Pet.Key] = true
    end

    -- Save positions of pets being removed, matching the game's own
    -- Place Best behavior so replacement pets can reuse those spots.
    local ReusablePositions = {}
    local RemovedCount = 0

    for _, Pet in ipairs(Owned) do
        if Pet.Placed
            and not DesiredKeys[Pet.Key]
        then
            table.insert(
                ReusablePositions,
                Pet.Position
            )

            pcall(function()
                PetRenderer.Remove(
                    LocalPlayer.UserId,
                    Pet.Key
                )
            end)

            PickupPetEvent:FireServer(
                Pet.Key
            )

            RemovedCount += 1

            task.wait(0.20)
        end
    end

    local PlacedCount = 0

    for Index, Pet in ipairs(Desired) do
        if not Pet.Placed then
            local Tool =
                Pet.Tool

            if not Tool or not Tool.Parent then
                Tool =
                    FindPetTool(
                        Pet.Key
                    )
            end

            if Tool then
                pcall(function()
                    Humanoid:EquipTool(
                        Tool
                    )
                end)

                local Timeout =
                    os.clock() + 2

                while Tool.Parent ~= Character
                    and os.clock() < Timeout
                do
                    task.wait()
                end

                if Tool.Parent == Character then
                    local Position =
                        table.remove(
                            ReusablePositions,
                            1
                        )
                        or GetPetPlacementPosition(
                            Root,
                            Index
                        )

                    PlacePetEvent:FireServer(
                        Pet.Key,
                        Position
                    )

                    PlacedCount += 1

                    task.wait(0.20)
                end
            end
        end
    end

    if PlacedCount > 0
        and LocalPlayer:GetAttribute("IsRiding") ~= true
    then
        pcall(function()
            Humanoid:UnequipTools()
        end)
    end

    BestPetsBusy = false

    if ShowNotification then
        if PlacedCount == 0
            and RemovedCount == 0
        then
            Toast(
                "Best Pets",
                "Best pets are already placed"
            )
        else
            Toast(
                "Best Pets",
                "Placed "
                    .. tostring(PlacedCount)
                    .. " • Removed "
                    .. tostring(RemovedCount)
            )
        end
    end

    Log(
        "Best pets refresh: placed "
            .. tostring(PlacedCount)
            .. ", removed "
            .. tostring(RemovedCount)
    )

    return true,
        {
            Placed = PlacedCount,
            Removed = RemovedCount,
        }
end



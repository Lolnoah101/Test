local function LoadRayfield()
    local Environment =
        type(getgenv) == "function"
        and getgenv()
        or _G

    local function IsRayfieldLibrary(
        Value
    )
        return type(Value) == "table"
            and type(
                Value.CreateWindow
            ) == "function"
    end

    -- Reuse the library if this executor session already loaded it.
    local CachedLibrary =
        Environment
            .__HOLLOWMOON_RAYFIELD_GEN2

    if IsRayfieldLibrary(
        CachedLibrary
    ) then
        return CachedLibrary
    end

    local CacheFolder =
        "HollowMoonHub"

    local CacheFile =
        CacheFolder
        .. "/RayfieldGen2Cache.lua"

    local LastError =
        "No usable Rayfield source was returned"

    local function RunSource(
        Source,
        Origin
    )
        if type(Source) ~= "string"
            or Source == ""
        then
            return nil,
                "Empty source from "
                .. tostring(
                    Origin
                )
        end

        local Chunk,
            CompileError =
            loadstring(
                Source
            )

        if type(Chunk) ~= "function" then
            return nil,
                "Compile failed from "
                .. tostring(
                    Origin
                )
                .. ": "
                .. tostring(
                    CompileError
                )
        end

        local RunSuccess,
            Library =
            pcall(
                Chunk
            )

        if not RunSuccess then
            return nil,
                "Run failed from "
                .. tostring(
                    Origin
                )
                .. ": "
                .. tostring(
                    Library
                )
        end

        if not IsRayfieldLibrary(
            Library
        ) then
            return nil,
                "Rayfield CreateWindow API missing from "
                .. tostring(
                    Origin
                )
        end

        Environment
            .__HOLLOWMOON_RAYFIELD_GEN2 =
                Library

        return Library
    end

    local function SaveSourceCache(
        Source
    )
        if type(writefile) ~= "function"
            or type(Source) ~= "string"
            or Source == ""
        then
            return
        end

        pcall(function()
            if type(isfolder) == "function"
                and type(makefolder) == "function"
                and not isfolder(
                    CacheFolder
                )
            then
                makefolder(
                    CacheFolder
                )
            end

            writefile(
                CacheFile,
                Source
            )
        end)
    end

    local function LoadDiskCache()
        if type(readfile) ~= "function" then
            return nil
        end

        if type(isfile) == "function"
            and not isfile(
                CacheFile
            )
        then
            return nil
        end

        local ReadSuccess,
            Source =
            pcall(
                readfile,
                CacheFile
            )

        if not ReadSuccess then
            return nil
        end

        local Library,
            CacheError =
            RunSource(
                Source,
                "local cache"
            )

        if not Library then
            LastError =
                CacheError
        end

        return Library
    end

    -- A previous successful load can keep the UI working even if
    -- sirius.menu is temporarily returning an empty response.
    local DiskLibrary =
        LoadDiskCache()

    if DiskLibrary then
        return DiskLibrary
    end

    local function FetchWithHttpGet(
        Url
    )
        local Success,
            Source =
            pcall(function()
                return game:HttpGet(
                    Url,
                    false
                )
            end)

        if Success
            and type(Source) == "string"
            and Source ~= ""
        then
            return Source
        end

        return nil,
            tostring(
                Source
            )
    end

    local function FetchWithRequest(
        Url
    )
        local RequestFunction =
            (
                type(request) == "function"
                and request
            )
            or (
                type(http_request) == "function"
                and http_request
            )
            or (
                type(syn) == "table"
                and type(syn.request) == "function"
                and syn.request
            )

        if not RequestFunction then
            return nil,
                "request API unavailable"
        end

        local Success,
            Response =
            pcall(
                RequestFunction,
                {
                    Url = Url,
                    Method = "GET",
                    Headers = {
                        ["Cache-Control"] = "no-cache",
                        ["Pragma"] = "no-cache",
                    },
                }
            )

        if not Success then
            return nil,
                tostring(
                    Response
                )
        end

        if type(Response) ~= "table" then
            return nil,
                "request returned no response table"
        end

        local StatusCode =
            tonumber(
                Response.StatusCode
                or Response.Status
            )

        local Body =
            Response.Body
            or Response.body

        if StatusCode
            and (
                StatusCode < 200
                or StatusCode >= 300
            )
        then
            return nil,
                "HTTP "
                .. tostring(
                    StatusCode
                )
        end

        if type(Body) ~= "string"
            or Body == ""
        then
            return nil,
                "empty request body"
        end

        return Body
    end

    local Sources = {
        "https://sirius.menu/gen2",
        "https://sirius.menu/gen2-preview",
    }

    for _, Url in ipairs(
        Sources
    ) do
        for Attempt = 1, 6 do
            local Source,
                FetchError =
                FetchWithHttpGet(
                    Url
                )

            if not Source then
                Source,
                    FetchError =
                    FetchWithRequest(
                        Url
                    )
            end

            if Source then
                local Library,
                    RunError =
                    RunSource(
                        Source,
                        Url
                    )

                if Library then
                    SaveSourceCache(
                        Source
                    )

                    return Library
                end

                LastError =
                    RunError
            else
                LastError =
                    "Fetch failed from "
                    .. tostring(
                        Url
                    )
                    .. ": "
                    .. tostring(
                        FetchError
                    )
            end

            if Attempt < 6 then
                task.wait(
                    math.min(
                        0.35
                        * Attempt,
                        1.50
                    )
                )
            end
        end
    end

    -- One final cache attempt in case another copy of the hub wrote
    -- the cache while the network retries were running.
    DiskLibrary =
        LoadDiskCache()

    if DiskLibrary then
        return DiskLibrary
    end

    error(
        "[Anime Breaker] Rayfield Gen2 could not be loaded. "
        .. "Both Sirius endpoints returned no usable source and "
        .. "no valid local cache exists. Last error: "
        .. tostring(
            LastError
        ),
        0
    )
end



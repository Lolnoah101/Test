-- =========================
-- MAIN LOOP (Handles Farm + M1 + Skills)
-- =========================
task.spawn(function()
    while true do
        -- ===== AUTO FARM (Movement) =====
        if AutoFarm then
            local hrp = getLocalHRP()
            if hrp then
                -- Check if current target is still alive
                if currentTarget then
                    if not currentTarget.entity or not currentTarget.entity.Parent or not isEntityAlive(currentTarget.entity) then
                        currentTarget = nil
                        print("[AutoFarm] Target dead, finding new one...")
                    end
                end

                -- Get a new target if we don't have one
                if not currentTarget then
                    currentTarget = getClosestEnemy()
                    if currentTarget then
                        print("[AutoFarm] Locked onto:", currentTarget.entity.Name)
                    else
                        -- No enemies, wait a bit
                        task.wait(0.5)
                    end
                end

                -- Move to target if we have one
                if currentTarget and currentTarget.part then
                    local targetPart = currentTarget.part
                    local targetCF

                    if selectedMode == "Circle" then
                        circleAngle = circleAngle + circleSpeed * 0.1
                        local x = math.cos(circleAngle) * distance
                        local z = math.sin(circleAngle) * distance
                        targetCF = CFrame.lookAt(targetPart.Position + Vector3.new(x, 1, z), targetPart.Position)
                    else
                        targetCF = getTargetCFrame(targetPart)
                    end

                    if targetCF then
                        -- Smooth movement: only update if the position is significantly different
                        local currentPos = hrp.Position
                        local targetPos = targetCF.Position
                        local dist = (currentPos - targetPos).Magnitude
                        
                        if dist > 0.5 then
                            hrp.CFrame = targetCF
                        end
                    end
                end
            end
        else
            currentTarget = nil
        end

        -- ===== AUTO M1 =====
        if AutoM1 then
            pcall(function()
                Attack:FireServer(Vector3.new(0, 0, 0))
            end)
        end

        -- ===== AUTO SKILLS =====
        if AutoSkills then
            for _, skillName in ipairs(SelectedSkills) do
                local skillNumber = tonumber(string.match(skillName, "%d+"))
                if skillNumber then
                    pcall(function()
                        Skill:FireServer(skillNumber, "tap", Vector3.new(0, 0, 0))
                    end)
                end
            end
        end

        task.wait(0.1)
    end
end)


    task.spawn(function()

        local Started =
            os.clock()


        while
            HubRunning
            and os.clock() - Started < 3
        do

            task.wait(0.1)


            local Info =
                GetPumpInfo(
                    Pump.card
                )


            local NewCash =
                tonumber(
                    CashValue.Value
                ) or 0


            if
                (
                    Info
                    and Info.owned
                )
                or NewCash < CashBefore
            then

                PumpBuying =
                    false


                RefreshPumpTarget()

                BuyTargetPump()

                return

            end

        end


        PumpBuying =
            false

    end)

local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local Window = Rayfield:CreateWindow({
    name = "Testing",
    subtitle = "Combat",
    theme = "default",

    configuration = {
        autoSave = true,
        autoLoad = true,
        fileName = "TestingHub",
    },
})

local CombatTab = Window:CreateTab({
    name = "Combat",
})

local Remotes = game:GetService("ReplicatedStorage").Player.Remotes.Inputs
local Attack = Remotes.Attack
local Skill = Remotes.Skill

local AutoM1 = false
local AutoSkill = false
local SelectedSkill = 1

-- =========================
-- AUTO M1
-- =========================

CombatTab:CreateToggle({
    name = "Auto M1",
    flag = "AutoM1",

    callback = function(value)
        AutoM1 = value

        if value then
            task.spawn(function()
                while AutoM1 do
                    Attack:FireServer(
                        Vector3.new(0, 0, 0)
                    )

                    task.wait(0.1)
                end
            end)
        end
    end,
})

-- =========================
-- SKILL SELECTOR
-- =========================

CombatTab:CreateDropdown({
    name = "Select Skill",
    flag = "SelectedSkill",

    options = {
        "Skill 1",
        "Skill 2",
        "Skill 3",
        "Skill 4",
    },

    value = "Skill 1",

    callback = function(value)
        if value == "Skill 1" then
            SelectedSkill = 1

        elseif value == "Skill 2" then
            SelectedSkill = 2

        elseif value == "Skill 3" then
            SelectedSkill = 3

        elseif value == "Skill 4" then
            SelectedSkill = 4
        end
    end,
})

-- =========================
-- AUTO SKILL
-- =========================

CombatTab:CreateToggle({
    name = "Auto Skill",
    flag = "AutoSkill",

    callback = function(value)
        AutoSkill = value

        if value then
            task.spawn(function()
                while AutoSkill do
                    Skill:FireServer(
                        SelectedSkill,
                        "tap",
                        Vector3.new(0, 0, 0)
                    )

                    task.wait(1)
                end
            end)
        end
    end,
})

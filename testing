--==================================================

task.spawn(function()

    while true do

        --==================================================
        -- M1
        --==================================================

        if getgenv().AutoM1
            and hasAliveTargets() then

            pcall(function()

                Attack:FireServer(
                    Vector3.new(0, 0, 0)
                )

            end)
        end

        --==================================================
        -- SKILLS
        --==================================================

        if getgenv().AutoSkills
            and hasAliveTargets()
            and #SelectedSkills > 0 then

            for _, skillName in ipairs(
                SelectedSkills
            ) do

                local skillNumber =
                    tonumber(
                        string.match(
                            skillName,
                            "%d+"
                        )
                    )

                if skillNumber then

                    pcall(function()

                        Skill:FireServer(
                            skillNumber,
                            "tap",
                            Vector3.new(0, 0, 0)
                        )

                    end)
                end
            end
        end

        task.wait(0.1)
    end
end)


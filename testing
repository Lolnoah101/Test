-- =========================
-- ENEMY DETECTION
-- =========================
local function isEntityAlive(entity)
    if not entity or not entity.Parent then return false end
    local humanoid = entity:FindFirstChildOfClass("Humanoid")
    if humanoid then return humanoid.Health > 0 end
    if entity:GetAttribute("Dead") == true then return false end
    local healthAttr = entity:GetAttribute("Health")
    if healthAttr and tonumber(healthAttr) then return tonumber(healthAttr) > 0 end
    return false
end

local function getAllEnemies()
    local enemies = {}
    
    local generatedFolder = nil
    for _, child in ipairs(workspace:GetChildren()) do
        if string.find(child.Name, "Generated_") then
            generatedFolder = child
            break
        end
    end
    
    if not generatedFolder then
        return enemies
    end
    
    local npcsFolder = generatedFolder:FindFirstChild("NPCs")
    if not npcsFolder then
        return enemies
    end
    
    for _, enemy in ipairs(npcsFolder:GetChildren()) do
        if isEntityAlive(enemy) then
            table.insert(enemies, enemy)
        end
    end
    
    return enemies
end

local function hasAliveTargets()
    return #getAllEnemies() > 0
end

local function getClosestEnemy()
    local character = LocalPlayer.Character
    if not character then return nil end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local enemies = getAllEnemies()
    local closest = nil
    local closestDist = math.huge

    for _, enemy in ipairs(enemies) do
        local root = enemy:FindFirstChild("HumanoidRootPart") or enemy:FindFirstChildWhichIsA("BasePart")
        if root then
            local dist = (hrp.Position - root.Position).Magnitude
            if dist < closestDist then
                closestDist = dist
                closest = {
                    part = root,
                    entity = enemy,
                    dist = dist
                }
            end
        end
    end
    return closest
end

-- =========================
-- MOVEMENT WITH TWEEN
-- =========================
local function getTargetCFrame(targetPart)
    local player = LocalPlayer
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local enemyPos = targetPart.Position
    local enemyCF = targetPart.CFrame

    if selectedMode == "Behind" then
        local lookVector = enemyCF.LookVector
        if lookVector.Magnitude < 0.1 then
            lookVector = (hrp.Position - enemyPos).Unit
        end
        local targetPos = enemyPos - lookVector * distance + Vector3.new(0,2,0)
        return CFrame.lookAt(targetPos, enemyPos)
    elseif selectedMode == "Above" then
        -- Position above enemy head, looking DOWN at them
        local targetPos = enemyPos + Vector3.new(0, distance, 0)
        return CFrame.lookAt(targetPos, enemyPos)
    elseif selectedMode == "Below" then
        local targetPos = enemyPos - Vector3.new(0, distance, 0)
        return CFrame.lookAt(targetPos, enemyPos)
    end
    return nil
end

local function moveToTarget(targetCF)
    local player = LocalPlayer
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Cancel any existing tween
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end

    -- Create tween info (smooth movement)
    local tweenInfo = TweenInfo.new(
        0.15,  -- duration
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out
    )

    -- Create and play tween
    currentTween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCF})
    currentTween:Play()

    -- Clear tween reference when done
    currentTween.Completed:Connect(function()
        currentTween = nil
    end)
end


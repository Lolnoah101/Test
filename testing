--// ============================================================
--// ANTI AFK
--// ============================================================

local function AntiAFKPulse()
    if not HubRunning
        or not Settings.AntiAFK
    then
        return false
    end

    local Success = false
    local ErrorMessage = nil

    -- Anime Breaker's own AFKController resets its timer whenever
    -- Library.UserInput.InputBegan fires. Trigger that signal directly
    -- when the executor supports firesignal. This avoids touching the
    -- visible mouse/touch UI and directly resets the game's AFK timer.
    local GameSignalSuccess,
        GameSignalError =
        pcall(function()
            if type(firesignal) ~= "function" then
                error(
                    "firesignal is unavailable"
                )
            end

            local Framework =
                ReplicatedStorage
                    :WaitForChild(
                        "Framework"
                    )

            local LibraryModule =
                Framework:WaitForChild(
                    "Library"
                )

            local Library =
                require(
                    LibraryModule
                )

            local UserInput =
                Library
                and Library.UserInput

            local InputBegan =
                UserInput
                and UserInput.InputBegan

            if not InputBegan then
                error(
                    "Library.UserInput.InputBegan was not found"
                )
            end

            -- AFKController's listener ignores the InputObject arguments;
            -- firing the signal is enough to reset its internal timestamp.
            firesignal(
                InputBegan
            )
        end)

    if GameSignalSuccess then
        Success = true

        Settings.__AntiAFKMethod =
            "Game AFKController"
    else
        ErrorMessage =
            GameSignalError

        -- Fallback for environments where the executor cannot firesignal
        -- the game's input signal.
        local FallbackSuccess,
            FallbackError =
            pcall(function()
                local Camera =
                    Workspace.CurrentCamera

                local CameraCFrame =
                    Camera
                    and Camera.CFrame
                    or CFrame.new()

                VirtualUser:CaptureController()

                VirtualUser:Button2Down(
                    Vector2.new(0, 0),
                    CameraCFrame
                )

                task.wait(0.05)

                VirtualUser:Button2Up(
                    Vector2.new(0, 0),
                    CameraCFrame
                )
            end)

        if FallbackSuccess then
            Success = true

            Settings.__AntiAFKMethod =
                "VirtualUser fallback"

            ErrorMessage = nil
        else
            ErrorMessage =
                tostring(
                    GameSignalError
                )
                .. " | fallback: "
                .. tostring(
                    FallbackError
                )
        end
    end

    if Success then
        Settings.__LastAntiAFKPulse =
            os.clock()

        Settings.__AntiAFKPulseCount =
            (
                tonumber(
                    Settings.__AntiAFKPulseCount
                )
                or 0
            )
            + 1

        Settings.__AntiAFKLastError =
            nil
    else
        Settings.__AntiAFKLastError =
            tostring(
                ErrorMessage
            )

        local Now =
            os.clock()

        local LastWarn =
            tonumber(
                Settings.__AntiAFKLastWarn
            )
            or 0

        if Now - LastWarn >= 30 then
            Settings.__AntiAFKLastWarn =
                Now

            warn(
                "[Anime Breaker] Anti AFK pulse failed: "
                    .. tostring(
                        ErrorMessage
                    )
            )
        end
    end

    return Success
end


-- Primary trigger: react whenever Roblox marks the client idle.
AntiAFKConnection =
    LocalPlayer.Idled:Connect(function()
        AntiAFKPulse()
    end)


-- Fallback trigger: pulse frequently enough that Roblox should not
-- normally reach its idle timeout. This only prevents Roblox inactivity;
-- it cannot stop Android/iOS from suspending or closing Roblox/executor.
task.spawn(function()
    while HubRunning do
        if Settings.AntiAFK then
            AntiAFKPulse()

            task.wait(
                DeviceTiming.AntiAFK
            )
        else
            task.wait(1)
        end
    end
end)


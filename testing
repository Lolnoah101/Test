        CreateCode = "DBZ",
        Difficulty = "Easy",
        StartId = LocalPlayer.UserId,
    },

    ["Titan Raid"] = {
        CreateCode = "AOT",
        Difficulty = "Easy",
        StartId = LocalPlayer.UserId,
    },

    ["Sin Raid"] = {
        CreateCode = "Nanatsu",
        Difficulty = "Easy",
        StartId = LocalPlayer.UserId,
    },
}

local function GetGamemodeFolder()
    local Map =
        Workspace:FindFirstChild("_MAP")

    return Map
        and Map:FindFirstChild("Gamemode")
end


local function GetLocalRaidFolder()
    local Gamemode =
        GetGamemodeFolder()

    if not Gamemode then
        return nil
    end

    return Gamemode:FindFirstChild(
        "Raid_"
        .. tostring(
            LocalPlayer.UserId
        )
    )
end


local function IsInsideLocalRaid()
    -- Treat the raid as actively running only while its server enemy folder
    -- exists. This is more reliable for reruns than the _MAP folder, which
    -- can remain around during transitions/results.
    return GetGamemodeRaidEnemyFolder() ~= nil
end


local RaidBusy = false
local LastRaidResult = "Idle"


local function GetSelectedRaidConfig()
    return RaidConfigs[
        Settings.SelectedRaid
    ]
end


local function CreateSelectedRaid()
    if not HubRunning then
        return false, "Hub unloaded"
    end

    if IsInsideLocalRaid() then
        return false, "Already inside raid"
    end

    local Config =
        GetSelectedRaidConfig()

    if not Config then
        return false, "Unknown raid"
    end

    local Success, ErrorMessage =
        pcall(function()
            DataRemoteEvent:FireServer({
                {
                    "GamemodeSystem",
                    "Create",
                    "Raid",
                    Config.CreateCode,
                    Config.Difficulty,
                    true,
                    n = 6,
                },
                "\x02",
            })
        end)

    if not Success then
        LastRaidResult =
            "Create failed: "
            .. tostring(ErrorMessage)

        return false, ErrorMessage
    end

    LastRaidResult =
        Settings.SelectedRaid
        .. " create packet sent"

    return true
end


local function StartSelectedRaid()
    if not HubRunning then
        return false, "Hub unloaded"
    end

    -- Do not reject Start merely because raid objects/folders appeared
    -- after the Create packet. The captured flow is Create -> delay -> Start.
    local Config =
        GetSelectedRaidConfig()

    if not Config then
        return false, "Unknown raid"
    end

    local Success, ErrorMessage =
        pcall(function()
            DataRemoteEvent:FireServer({
                {
                    "GamemodeSystem",
                    "Start",
                    "Raid",
                    Config.StartId,
                    n = 4,
                },
                "\x02",
            })
        end)

    if not Success then
        LastRaidResult =
            "Start failed: "
            .. tostring(ErrorMessage)

        return false, ErrorMessage
    end

    LastRaidResult =
        Settings.SelectedRaid
        .. " start packet sent"

    return true
end


local function CreateAndStartSelectedRaid()
    if RaidBusy then
        return false, "Raid sequence already running"
    end

    RaidBusy = true

    local Created, CreateError =
        CreateSelectedRaid()

    if not Created then
        RaidBusy = false
        return false, CreateError
    end

    -- Fixed Create -> Start delay requested by the user.
    task.wait(1)

    -- Create can take a moment to initialize the raid lobby.
    -- Retry the exact captured Start packet a few times instead of relying
    -- on one single Start request.
    local Started = false
    local StartError = nil

    for Attempt = 1, 4 do
        if not HubRunning then
            break
        end

        local Success, ErrorMessage =
            StartSelectedRaid()

        if Success then
            Started = true
        else
            StartError =
                ErrorMessage
        end

        -- If the raid enemy folder appears, the run has started.
        if GetGamemodeRaidEnemyFolder() then
            Started = true
            break
        end

        if Attempt < 4 then
            task.wait(0.50)
        end
    end

    RaidBusy = false

    if not Started then
        return false,
            StartError
            or "Start packet did not begin raid"
    end

    LastRaidResult =
        Settings.SelectedRaid
        .. " created + started"

    return true
end


local function RunAutoStartRaid()
    if not Settings.AutoStartRaid
        or RaidBusy
    then
        return
    end

    task.spawn(function()
        local Success, Result =
            CreateAndStartSelectedRaid()

        if not Success then
            warn(
                "[Energy Hub] Auto Start Raid: "
                .. tostring(Result)
            )
        end
    end)
end


local LastRaidRerunAttempt = 0
local RAID_RERUN_COOLDOWN = 3.0


local function IsRaidResultsVisible()
    local Button =
        GetResultsReturnButton()

    return Button ~= nil
        and Button:IsA("GuiButton")
        and IsGuiActuallyVisible(Button)
end


local TimeTrialConfigs = {
    ["The Hallway"] = {
        Name = "The Hallway",

        Difficulties = {
            "Easy",
            "Medium",
            "Hard",
        },
    },
}


local function GetSelectedTimeTrialConfig()
    return TimeTrialConfigs[
        Settings.SelectedTimeTrial
    ]
end


local TIME_TRIAL_RETRY_DELAY = 0.50
local LastTimeTrialAttempt = 0
local TimeTrialBusy = false


local function EnterTimeTrial()
    if not HubRunning then
        return false, "Hub unloaded"
    end

    if TimeTrialBusy then
        return false, "Busy"
    end

    local Config =
        GetSelectedTimeTrialConfig()

    if not Config then
        return false, "Unknown Time Trial"
    end

    local Difficulty =
        Settings.SelectedTimeTrialDifficulty
        or "Easy"

    TimeTrialBusy =
        true

    local Success, ErrorMessage =
        pcall(function()
            DataRemoteEvent:FireServer({
                {
                    "GamemodeSystem",
                    "Enter",
                    "Time Trial",
                    Config.Name,
                    Difficulty,
                    n = 5,
                },
                "\x02",
            })
        end)

    TimeTrialBusy =
        false

    if not Success then
        warn(
            "[Energy Hub] Time Trial Join: "
                .. tostring(ErrorMessage)
        )

        return false, ErrorMessage
    end

    return true
end


local function GetLocalGamemodeLabel()
    local PlayerGui =
        LocalPlayer:FindFirstChild(
            "PlayerGui"
        )

    local GamemodeGui =
        PlayerGui
        and PlayerGui:FindFirstChild(
            "Gamemode"
        )

    local Content =
        GamemodeGui
        and GamemodeGui:FindFirstChild(
            "Content"
        )

    local Start =
        Content
        and Content:FindFirstChild(
            "Start"
        )

    return Start
        and Start:FindFirstChild(
            "Label"
        )
end


local function IsLocalGamemodeActive()
    local Label =
        GetLocalGamemodeLabel()

    return Label ~= nil
        and IsGuiActuallyVisible(Label)
end


local function IsLocalGamemodeContainerActive()
    local PlayerGui =
        LocalPlayer:FindFirstChild(
            "PlayerGui"
        )

    local GamemodeGui =
        PlayerGui
        and PlayerGui:FindFirstChild(
            "Gamemode"
        )

    local Content =
        GamemodeGui
        and GamemodeGui:FindFirstChild(
            "Content"
        )

    local Start =
        Content
        and Content:FindFirstChild(
            "Start"
        )

    -- Prefer the exact label check when it is available, but
    -- accept the active Start container too. This is more reliable
    -- for Time Trial stages where the Label itself can stop being
    -- considered visible.
    return IsLocalGamemodeActive()
        or (
            Start ~= nil
            and IsGuiActuallyVisible(
                Start
            )
        )
end


-- Time Trial auto join:
--
-- PRIORITY:
-- Time Trial > Raid > Commandment Fragment > Normal Farm
--
-- IMPORTANT RAID GUARD:
-- Auto Leave Raid is NOT the only system allowed to send GamemodeSystem/Quit.
-- Time Trial priority can also leave a Raid, but ONLY when the actual Time
-- Trial popup is visibly confirmed on-screen right now.
--
-- Detection is intentionally strict:
--   * "Time Trial is open!" must be visible
--   * selected trial name must be in the SAME popup subtree
--   * selected difficulty must be in the SAME popup subtree
--   * "join now" must be in the SAME popup subtree
--   * popup must stay visible briefly before a Raid can be interrupted
--
-- A short grace period is still allowed AFTER the Raid is gone so the script
-- can finish joining if the popup disappears during the transition.
task.spawn(function()
    local LastRaidQuitForTimeTrial =
        0

    local RAID_QUIT_RETRY_DELAY =
        0.75

    local LastJoinPopupSeenAt =
        0

    local PopupFirstSeenAt =
        nil

    local JOIN_POPUP_GRACE =
        1.50

    local RAID_INTERRUPT_CONFIRM_TIME =
        0.35

    local function GetVisibleGuiText(
        Object
    )
        if not Object
            or not (
                Object:IsA("TextLabel")
                or Object:IsA("TextButton")
                or Object:IsA("TextBox")
            )
            or not IsGuiActuallyVisible(
                Object
            )
        then
            return ""
        end

        local Value = ""

        pcall(function()
            Value =
                Object.ContentText
        end)

        if typeof(Value) ~= "string"
            or Value == ""
        then
            pcall(function()
                Value =
                    Object.Text
            end)
        end

        return string.lower(
            tostring(
                Value or ""
            )
        )
    end

    local function PopupSubtreeMatches(
        Root,
        TrialName,
        Difficulty
    )
        if not Root
            or not Root.Parent
        then
            return false
        end

        if Root:IsA("GuiObject")
            and not IsGuiActuallyVisible(
                Root
            )
        then
            return false
        end

        local HasOpenHeader =
            false

        local HasSelectedTrial =
            false

        local HasSelectedDifficulty =
            false

        local HasJoinText =
            false

        local Objects = {
            Root,
        }

        for _, Descendant in ipairs(
            Root:GetDescendants()
        ) do
            table.insert(
                Objects,
                Descendant
            )
        end

        for _, Object in ipairs(
            Objects
        ) do
            if Object:IsA("TextLabel")
                or Object:IsA("TextButton")
                or Object:IsA("TextBox")
            then
                local GuiText =
                    GetVisibleGuiText(
                        Object
                    )

                if GuiText ~= "" then
                    if string.find(
                        GuiText,
                        "time trial is open",
                        1,
                        true
                    ) then
                        HasOpenHeader =
                            true
                    end

                    if string.find(
                        GuiText,
                        TrialName,
                        1,
                        true
                    ) then
                        HasSelectedTrial =
                            true
                    end

                    if string.find(
                        GuiText,
                        Difficulty,
                        1,
                        true
                    ) then
                        HasSelectedDifficulty =
                            true
                    end

                    if string.find(
                        GuiText,
                        "join now",
                        1,
                        true
                    ) then
                        HasJoinText =
                            true
                    end
                end
            end
        end

        return HasOpenHeader
            and HasSelectedTrial
            and HasSelectedDifficulty
            and HasJoinText
    end

    local function IsTimeTrialJoinPopupVisible()
        local PlayerGui =
            LocalPlayer:FindFirstChild(
                "PlayerGui"
            )

        local Config =
            GetSelectedTimeTrialConfig()

        if not PlayerGui
            or not Config
        then
            return false
        end

        local TrialName =
            string.lower(
                tostring(
                    Config.Name
                )
            )

        local Difficulty =
            string.lower(
                tostring(
                    Settings.SelectedTimeTrialDifficulty
                    or "Easy"
                )
            )

        -- First locate the visible header itself.
        for _, Object in ipairs(
            PlayerGui:GetDescendants()
        ) do
            if Object:IsA("TextLabel")
                or Object:IsA("TextButton")
                or Object:IsA("TextBox")
            then
                local GuiText =
                    GetVisibleGuiText(
                        Object
                    )

                if string.find(
                    GuiText,
                    "time trial is open",
                    1,
                    true
                ) then
                    -- Then only inspect nearby ancestors of THAT header.
                    -- This prevents unrelated GUI text elsewhere in PlayerGui
                    -- from combining into a false positive.
                    local Candidate =
                        Object

                    for _ = 1, 7 do
                        Candidate =
                            Candidate
                            and Candidate.Parent

                        if not Candidate
                            or Candidate == PlayerGui
                            or Candidate:IsA(
                                "LayerCollector"
                            )
                        then
                            break
                        end

                        if PopupSubtreeMatches(
                            Candidate,
                            TrialName,
                            Difficulty
                        ) then
                            return true
                        end
                    end
                end
            end
        end

        return false
    end

    local function QuitRaidForTimeTrial()
        -- This is separate from Auto Leave Raid.
        -- It is ONLY allowed when the user has explicitly enabled
        -- Time Trial raid interruption.
        if not Settings.AutoJoinTimeTrial
            or not Settings.TimeTrialInterruptRaid
            or not Settings.__TimeTrialJoinPromptOpen
        then
            return false
        end

        if not (
            IsInsideLocalRaid()
            or GetLocalRaidFolder() ~= nil
        ) then
            return false
        end

        local Now =
            os.clock()

        if Now - LastRaidQuitForTimeTrial
            < RAID_QUIT_RETRY_DELAY
        then
            return false
        end

        LastRaidQuitForTimeTrial =
            Now

        Settings.__MovementPriorityState =
            "Time Trial • Leaving Raid"

        Settings.__LastGamemodeQuitReason =
            "Time Trial Priority"

        Settings.__LastGamemodeQuitAt =
            os.clock()

        local Config =
            GetSelectedTimeTrialConfig()

        Toast(
            "Time Trial Priority",
            "Leaving Raid for "
                .. tostring(
                    Config
                    and Config.Name
                    or "Time Trial"
                )
        )

        LogUI(
            "Gamemode Quit • Reason: Time Trial Priority"
        )

        local Success,
            ErrorMessage =
            pcall(function()
                DataRemoteEvent:FireServer({
                    {
                        "GamemodeSystem",
                        "Quit",
                        n = 2,
                    },
                    "\x02",
                })
            end)

        if not Success then
            warn(
                "[Anime Breaker] Time Trial Priority Raid Quit: "
                    .. tostring(
                        ErrorMessage
                    )
            )

            return false
        end

        return true
    end

    while HubRunning do
        local PopupVisible =
            false

        if Settings.AutoJoinTimeTrial then
            PopupVisible =
                IsTimeTrialJoinPopupVisible()

            if PopupVisible then
                LastJoinPopupSeenAt =
                    os.clock()

                if not PopupFirstSeenAt then
                    PopupFirstSeenAt =
                        os.clock()
                end
            else
                PopupFirstSeenAt =
                    nil
            end
        else
            PopupFirstSeenAt =
                nil
        end

        local JoinWindowActive =
            Settings.AutoJoinTimeTrial
            and (
                PopupVisible
                or (
                    LastJoinPopupSeenAt > 0
                    and os.clock()
                        - LastJoinPopupSeenAt
                        <= JOIN_POPUP_GRACE
                )
            )

        Settings.__TimeTrialJoinPromptOpen =
            JoinWindowActive

        if JoinWindowActive
            and not TimeTrialBusy
        then
            local LocalRaidActive =
                IsInsideLocalRaid()
                or GetLocalRaidFolder()
                    ~= nil

            if LocalRaidActive then
                -- CRITICAL:
                -- Do NOT use the grace window to leave a Raid.
                -- A Raid may only be interrupted while the popup is
                -- visibly present RIGHT NOW and has stayed visible long
                -- enough to rule out a one-frame/stale GUI detection.
                local PopupConfirmed =
                    PopupVisible
                    and PopupFirstSeenAt ~= nil
                    and os.clock()
                        - PopupFirstSeenAt
                        >= RAID_INTERRUPT_CONFIRM_TIME

                if PopupConfirmed
                    and Settings.TimeTrialInterruptRaid
                then
                    QuitRaidForTimeTrial()
                end

            elseif not IsLocalGamemodeContainerActive()
                and not IsRaidResultsVisible()
            then
                -- Once the Raid is gone, the grace window is okay here.
                -- It only helps finish the join transition; it can no
                -- longer kick the player out of a Raid.
                local Now =
                    os.clock()

                if Now - LastTimeTrialAttempt
                    >= TIME_TRIAL_RETRY_DELAY
                then
                    LastTimeTrialAttempt =
                        Now

                    Settings.__MovementPriorityState =
                        "Time Trial • Joining"

                    EnterTimeTrial()
                end
            end
        end

        task.wait(
            DeviceTiming.UiPoll
        )
    end

    Settings.__TimeTrialJoinPromptOpen =
        false
end)



--// ============================================================
--// AUTO COLLECT COMMANDMENT FRAGMENTS
--// Priority: Time Trial / Raid > Fragment > Normal Farm
--// ============================================================

do
    local PromptLastAttempt = {}
    local CurrentFragment = nil

    local function GetSpawnItemTitle(
        SpawnItem
    )
        if not SpawnItem
            or not SpawnItem.Parent
        then
            return ""
        end

        local Gui =
            SpawnItem:FindFirstChild(
                "Gui"
            )

        local Title =
            Gui
            and Gui:FindFirstChild(
                "Title"
            )

        if not Title
            or not (
                Title:IsA("TextLabel")
                or Title:IsA("TextButton")
                or Title:IsA("TextBox")
            )
        then
            return ""
        end

        local Text =
            Title.ContentText

        if typeof(Text) ~= "string"
            or Text == ""
        then
            Text =
                Title.Text
        end

        return tostring(
            Text or ""
        )
    end


    local function IsCommandmentFragment(
        SpawnItem
    )
        local Title =
            string.lower(
                GetSpawnItemTitle(
                    SpawnItem
                )
            )

        return string.find(
            Title,
            "commandment",
            1,
            true
        ) ~= nil
            and string.find(
                Title,
                "fragment",
                1,
                true
            ) ~= nil
    end


    local function IsPlayerInProtectedGamemode()
        -- These are LOCAL-player checks. A Time Trial existing globally
        -- for somebody else does not block fragment collection.
        return IsLocalGamemodeContainerActive()
            or IsInsideLocalRaid()
            or GetLocalRaidFolder() ~= nil
            or IsRaidResultsVisible()
    end


    local function GetFragmentRoot(
        SpawnItem
    )
        if not SpawnItem then
            return nil
        end

        local Root =
            SpawnItem:FindFirstChild(
                "Root"
            )

        if Root
            and Root:IsA(
                "BasePart"
            )
        then
            return Root
        end

        return Root
            and Root:FindFirstChildWhichIsA(
                "BasePart",
                true
            )
            or nil
    end


    local function GetNearestFragment()
        local SpawnItems =
            Workspace:FindFirstChild(
                "_SPAWNITEMS"
            )

        local PlayerRoot =
            GetRootPart()

        if not SpawnItems
            or not PlayerRoot
        then
            return nil
        end

        local BestItem = nil
        local BestDistance =
            math.huge

        for _, SpawnItem in ipairs(
            SpawnItems:GetChildren()
        ) do
            if IsCommandmentFragment(
                SpawnItem
            ) then
                local FragmentRoot =
                    GetFragmentRoot(
                        SpawnItem
                    )

                if FragmentRoot then
                    local Distance =
                        (
                            PlayerRoot.Position
                            - FragmentRoot.Position
                        ).Magnitude

                    if Distance
                        < BestDistance
                    then
                        BestDistance =
                            Distance

                        BestItem =
                            SpawnItem
                    end
                end
            end
        end

        return BestItem
    end


    local function TeleportAndCollect(
        SpawnItem
    )
        if not SpawnItem
            or not SpawnItem.Parent
        then
            return false
        end

        local FragmentRoot =
            GetFragmentRoot(
                SpawnItem
            )

        local Prompt =
            FragmentRoot
            and FragmentRoot:FindFirstChildWhichIsA(
                "ProximityPrompt",
                true
            )

        local PlayerRoot =
            GetRootPart()

        if not FragmentRoot
            or not Prompt
            or not Prompt.Enabled
            or not PlayerRoot
        then
            return false
        end

        local Now =
            os.clock()

        local LastAttempt =
            PromptLastAttempt[
                Prompt
            ]
            or 0

        if Now - LastAttempt
            < 0.25
        then
            return false
        end

        PromptLastAttempt[
            Prompt
        ] =
            Now

        -- Fragment owns movement over NORMAL Auto Farm.
        Settings.__FragmentPriorityActive =
            true

        Settings.__MovementPriorityState =
            "Commandment Fragment"

        ResetCurrentFarmTarget()

        CancelFarmTween()
        StopLegitMovement()

        local RotationOnly =
            PlayerRoot.CFrame
            - PlayerRoot.Position

        -- Put the player close enough for the prompt, slightly above
        -- the fragment instead of directly inside its Root part.
        PlayerRoot.CFrame =
            CFrame.new(
                FragmentRoot.Position
                + Vector3.new(
                    0,
                    2,
                    0
                )
            )
            * RotationOnly

        PlayerRoot.AssemblyLinearVelocity =
            Vector3.zero

        PlayerRoot.AssemblyAngularVelocity =
            Vector3.zero

        task.wait(0.06)

        if not SpawnItem.Parent
            or not Prompt.Parent
            or not Prompt.Enabled
        then
            return false
        end

        local Success,
            ErrorMessage =
            pcall(function()
                if type(
                    fireproximityprompt
                ) ~= "function"
                then
                    error(
                        "fireproximityprompt is unavailable"
                    )
                end

                fireproximityprompt(
                    Prompt
                )
            end)

        if not Success then
            warn(
                "[Anime Breaker] Commandment Fragment: "
                    .. tostring(
                        ErrorMessage
                    )
            )
        end

        return Success
    end


    task.spawn(function()
        while HubRunning do
            if not Settings.AutoCollectCommandmentFragments then
                Settings.__FragmentPriorityActive =
                    false

                CurrentFragment =
                    nil

                task.wait(0.25)

            elseif IsPlayerInProtectedGamemode() then
                -- Never let fragment collection steal movement from
                -- Time Trial or Raid.
                Settings.__FragmentPriorityActive =
                    false

                CurrentFragment =
                    nil

                task.wait(
                    DeviceTiming.FastPoll
                )

            else
                if not CurrentFragment
                    or not CurrentFragment.Parent
                    or not IsCommandmentFragment(
                        CurrentFragment
                    )
                then
                    CurrentFragment =
                        GetNearestFragment()
                end

                if CurrentFragment then
                    Settings.__FragmentPriorityActive =
                        true

                    TeleportAndCollect(
                        CurrentFragment
                    )
                else
                    Settings.__FragmentPriorityActive =
                        false

                    if Settings.AutoFarm then
                        Settings.__MovementPriorityState =
                            "Normal Farm"
                    else
                        Settings.__MovementPriorityState =
                            "Idle"
                    end
                end

                for Prompt in pairs(
                    PromptLastAttempt
                ) do
                    if not Prompt
                        or not Prompt.Parent
                    then
                        PromptLastAttempt[
                            Prompt
                        ] =
                            nil
                    end
                end

                task.wait(
                    DeviceTiming.FastPoll
                )
            end
        end

        Settings.__FragmentPriorityActive =
            false
    end)
end


local function CanAutoStartSelectedRaid()
    if not HubRunning
        or not Settings.AutoStartRaid
        or RaidBusy
    then
        return false
    end

    -- Priority rule: the visible Time Trial join window owns the next
    -- gamemode slot before Auto Raid. The global map folder is not used
    -- as the readiness signal because it can appear only after somebody joins.
    if Settings.AutoJoinTimeTrial
        and Settings.__TimeTrialJoinPromptOpen
    then
        return false
    end

    -- Never start a raid while this player is already inside any
    -- active gamemode.
    if IsLocalGamemodeContainerActive() then
        return false
    end

    if IsInsideLocalRaid()
        or GetLocalRaidFolder() ~= nil
    then
        return false
    end

    if IsRaidResultsVisible() then
        return false
    end

    return true
end


local function TryAutoStartSelectedRaid()
    if not CanAutoStartSelectedRaid() then
        return
    end

    local Now =
        os.clock()

    if Now - LastRaidRerunAttempt
        < RAID_RERUN_COOLDOWN
    then
        return
    end

    LastRaidRerunAttempt =
        Now

    task.spawn(function()
        local Success, Result =
            CreateAndStartSelectedRaid()

        if not Success then
            warn(
                "[Energy Hub] Auto Start/Rerun Raid: "
                    .. tostring(Result)
            )
        end
    end)
end


task.spawn(function()
    while HubRunning do
        TryAutoStartSelectedRaid()
        task.wait(
            IS_MOBILE and 0.50 or 0.35
        )
    end
end)


--// ============================================================
--// RAID AUTO LEAVE AT WAVE
--// ============================================================

local function GetRaidWaveLabel()
    return GetLocalGamemodeLabel()
end


local function GetCurrentRaidWave()
    local Label =
        GetRaidWaveLabel()

    if not Label then
        return nil
    end

    local Text = nil

    -- ContentText gives the visible plain text even when .Text uses RichText.
    pcall(function()
        Text =
            Label.ContentText
    end)

    if typeof(Text) ~= "string"
        or Text == ""
    then
        pcall(function()
            Text =
                Label.Text
        end)
    end

    if typeof(Text) ~= "string"
        or Text == ""
    then
        return nil
    end

    -- Expected visible format:
    -- "Wave: 12"
    local WaveText =
        Text:match(
            "[Ww]ave%s*:%s*(%d+)"
        )

    if not WaveText then
        return nil
    end

    return tonumber(
        WaveText
    )
end


local function QuitCurrentGamemode(
    Reason
)
    if not HubRunning then
        return false, "Hub unloaded"
    end

    Reason =
        tostring(
            Reason or "Unknown"
        )

    if Reason == "RaidAutoLeave" then
        -- A wave-based Raid quit is impossible unless the actual
        -- Auto Leave Raid toggle is ON and a local Raid still exists.
        if not Settings.AutoLeaveRaid then
            return false,
                "Auto Leave Raid is disabled"
        end

        if not (
            IsInsideLocalRaid()
            or GetLocalRaidFolder() ~= nil
        ) then
            return false,
                "No local Raid is active"
        end

    elseif Reason == "TimeTrialAutoLeave" then
        -- Never allow the Time Trial leave worker to quit a Raid.
        -- The old detection could temporarily confuse a Raid HUD with
        -- a Time Trial when global Time Trial objects also existed.
        if not Settings.AutoLeaveTimeTrial then
            return false,
                "Auto Leave Time Trial is disabled"
        end

        if IsInsideLocalRaid()
            or GetLocalRaidFolder() ~= nil
        then
            return false,
                "Blocked Time Trial leave while Raid is active"
        end

        if not GetTimeTrialMapFolder()
            or not IsLocalGamemodeContainerActive()
        then
            return false,
                "No confirmed local Time Trial"
        end

    else
        return false,
            "Blocked unrecognized quit reason: "
            .. Reason
    end

    Settings.__LastGamemodeQuitReason =
        Reason

    Settings.__LastGamemodeQuitAt =
        os.clock()

    LogUI(
        "Gamemode Quit • Reason: "
        .. Reason
    )

    local Success, ErrorMessage =
        pcall(function()
            DataRemoteEvent:FireServer({
                {
                    "GamemodeSystem",
                    "Quit",
                    n = 2,
                },
                "\x02",
            })
        end)

    if not Success then
        warn(
            "[Anime Breaker] Gamemode Quit "
                .. Reason
                .. ": "
                .. tostring(
                    ErrorMessage
                )
        )

        return false, ErrorMessage
    end

    return true
end


local RaidAutoLeaveFired = false
local LastObservedRaidWave = nil


task.spawn(function()
    while HubRunning do
        local RaidFolder =
            GetGamemodeRaidEnemyFolder()

        local RaidMap =
            GetLocalRaidFolder()

        local RaidActive =
            RaidFolder ~= nil
            or RaidMap ~= nil

        local Wave =
            RaidActive
            and GetCurrentRaidWave()
            or nil

        -- A fresh raid should start back at an earlier wave.
        -- Reset the one-shot latch when that happens.
        if Wave
            and LastObservedRaidWave
            and Wave < LastObservedRaidWave
        then
            RaidAutoLeaveFired =
                false
        end

        if not RaidActive then
            RaidAutoLeaveFired =
                false

            LastObservedRaidWave =
                nil
        elseif Wave then
            LastObservedRaidWave =
                Wave
        end

        -- This is the normal wave-based Auto Leave path.
        -- It cannot fire unless the Auto Leave Raid toggle itself is enabled.
        if Settings.AutoLeaveRaid
            and RaidActive
            and not RaidAutoLeaveFired
            and not IsRaidResultsVisible()
        then
            local TargetWave =
                math.max(
                    1,
                    math.floor(
                        tonumber(
                            Settings.RaidLeaveWave
                        )
                        or 1
                    )
                )

            if Wave
                and Wave >= TargetWave
            then
                RaidAutoLeaveFired =
                    true

                local Success, ErrorMessage =
                    QuitCurrentGamemode(
                        "RaidAutoLeave"
                    )

                if not Success then
                    RaidAutoLeaveFired =
                        false

                    warn(
                        "[Energy Hub] Auto Leave Raid: "
                            .. tostring(ErrorMessage)
                    )
                end
            end
        end

        task.wait(
            DeviceTiming.RaidPoll
        )
    end
end)



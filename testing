--==================================================
-- COMBAT LOOP
--==================================================

task.spawn(function()

    while true do

        if getgenv().AutoM1 and hasAliveTargets() then

            pcall(function()

                Attack:FireServer(
                    Vector3.new(0, 0, 0)
                )

            end)
        end

        if getgenv().AutoSkills
            and hasAliveTargets()
            and #SelectedSkills > 0 then

            -- Fire every selected skill during
            -- the same combat update.

            for _, skillName in ipairs(SelectedSkills) do

                local skillNumber =
                    tonumber(
                        string.match(
                            skillName,
                            "%d+"
                        )
                    )

                if skillNumber then

                    pcall(function()

                        Skill:FireServer(
                            skillNumber,
                            "tap",
                            Vector3.new(0, 0, 0)
                        )

                    end)
                end
            end
        end

        task.wait(0.1)
    end
end)


local function FindNextPump()

    local List = {}


    for _, Card in ipairs(
        PumpScrollingFrame:GetChildren()
    ) do

        local Info =
            GetPumpInfo(
                Card
            )


        if Info then

            table.insert(
                List,
                Info
            )

        end

    end


    table.sort(
        List,

        function(A, B)

            return A.id < B.id

        end
    )


    for _, Info in ipairs(
        List
    ) do

        if
            not Info.owned
            and Info.price
        then

            return Info

        end

    end


    return nil
end


local CurrentPumpTarget =
    nil


local PumpBuying =
    false


local function RefreshPumpTarget()

    CurrentPumpTarget =

function LootMoveState:RestoreNoclip()
    for Part, OriginalValue in pairs(
        self.NoclipStates
    ) do
        if Part
            and Part.Parent
            and Part:IsA("BasePart")
        then
            pcall(function()
                Part.CanCollide =
                    OriginalValue
            end)
        end
    end

    table.clear(
        self.NoclipStates
    )
end


function LootMoveState:GetPromptCFrame(
    Prompt
)
    if not Prompt
        or not Prompt.Parent
    then
        return nil
    end

    local Parent =
        Prompt.Parent

    -- This catches the soul layout immediately because SoulPrompt
    -- is parented to the soul's Root BasePart.
    if Parent:IsA("Attachment") then
        return Parent.WorldCFrame
    end

    if Parent:IsA("BasePart") then
        return Parent.CFrame
    end

    local Drop =
        GetLootDropFromPrompt(
            Prompt
        )
        or GetSoulDropFromPrompt(
            Prompt
        )

    if Drop then
        if Drop:IsA("BasePart") then
            return Drop.CFrame
        end

        if Drop:IsA("Model") then
            local Part =
                Drop.PrimaryPart
                or Drop:FindFirstChildWhichIsA(
                    "BasePart",
                    true
                )

            if Part then
                return Part.CFrame
            end

            return Drop:GetPivot()
        end

        local Part =
            Drop:FindFirstChildWhichIsA(
                "BasePart",
                true
            )

        if Part then
            return Part.CFrame
        end
    end

    return nil
end


function LootMoveState:IsPromptInRange(
    Prompt,
    Root
)
    if not Prompt
        or not Prompt.Parent
        or not Root
    then
        return false,
            math.huge
    end

    local TargetCFrame =
        self:GetPromptCFrame(
            Prompt
        )

    if not TargetCFrame then
        return false,
            math.huge
    end

    local Distance =
        (
            TargetCFrame.Position
            - Root.Position
        ).Magnitude

    local MaxDistance =
        tonumber(
            Prompt.MaxActivationDistance
        )
        or 10

    -- Stay slightly inside the actual MaxActivationDistance so tiny
    -- replication/physics changes do not move us out of range mid-hold.
    local SafeDistance =
        math.max(
            MaxDistance
                - COLLECTIBLE_RANGE_PADDING,
            2
        )

    return Distance <= SafeDistance,
        Distance
end


function LootMoveState:TeleportToPrompt(
    Prompt
)
    if self.Busy
        or not Prompt
        or not Prompt.Parent
    then
        return false
    end

    local Character =
        LocalPlayer.Character

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    local TargetCFrame =
        self:GetPromptCFrame(
            Prompt
        )

    if not Character
        or not Root
        or not TargetCFrame
    then
        return false
    end

    Settings.__LootFarmBusy =
        true

    -- If we're already within the real prompt activation range,
    -- do not teleport/nudge the player again.
    local AlreadyInRange =
        self:IsPromptInRange(
            Prompt,
            Root
        )

    if AlreadyInRange then
        Root.Anchored =
            false

        Root.AssemblyLinearVelocity =
            Vector3.zero

        Root.AssemblyAngularVelocity =
            Vector3.zero

        return Prompt.Parent ~= nil
    end

    self.Busy =
        true

    -- Release any farm/raid anchor before instant loot movement.
    Root.Anchored =
        false

    Root.AssemblyLinearVelocity =
        Vector3.zero

    Root.AssemblyAngularVelocity =
        Vector3.zero

    -- No tween for Auto Pick Up Loot/Souls anymore.
    self:CancelTween()

    local RotationOnly =
        Root.CFrame
        - Root.Position

    -- Teleport just inside the prompt range rather than directly into
    -- the exact item center. This keeps ProximityPrompt range reliable.
    local MaxDistance =
        tonumber(
            Prompt.MaxActivationDistance
        )
        or 10

    local SafeOffset =
        math.clamp(
            MaxDistance
                - COLLECTIBLE_RANGE_PADDING
                - 0.5,
            1.5,
            4
        )

    local Destination =
        CFrame.new(
            TargetCFrame.Position
            + Vector3.new(
                0,
                math.min(
                    SafeOffset,
                    2
                ),
                0
            )
        )
        * RotationOnly

    local Success,
        ErrorMessage =
        pcall(function()
            Character:PivotTo(
                Destination
            )

            Root.CFrame =
                Destination

            Root.AssemblyLinearVelocity =
                Vector3.zero

            Root.AssemblyAngularVelocity =
                Vector3.zero
        end)

    self.Busy =
        false

    if not Success then
        warn(
            "[Combat Hub] Loot teleport failed: "
                .. tostring(
                    ErrorMessage
                )
        )

        return false
    end

    -- Give Roblox one scheduler step to update prompt distance/state.
    task.wait(
        0.015
    )

    return Prompt.Parent ~= nil
end

local function WaitForPromptEnabled(
    Prompt,
    Timeout
)
    local Deadline =
        os.clock()
        + (
            tonumber(Timeout)
            or 0
        )

    while Prompt
        and Prompt.Parent
        and not Prompt.Enabled
        and os.clock() < Deadline
    do
        task.wait(0.02)
    end

    return Prompt
        and Prompt.Parent
        and Prompt.Enabled
end


local function HoldPromptKey(
    Prompt
)
    if not Prompt
        or not Prompt.Parent
    then
        return false,
            "Prompt disappeared before hold"
    end

    -- SoulPrompt can replicate disabled and then get enabled once the
    -- player reaches it. Give that game-side state a short chance to update.
    WaitForPromptEnabled(
        Prompt,
        SOUL_ENABLE_WAIT
    )

    local OriginalEnabled =
        Prompt.Enabled

    -- If it is still disabled locally, enable it for the interaction attempt.
    -- Restore the original state afterward if the soul/drop still exists.
    if not Prompt.Enabled then
        pcall(function()
            Prompt.Enabled =
                true
        end)
    end

    local KeyCode =
        Prompt.KeyboardKeyCode

    if KeyCode == Enum.KeyCode.Unknown then
        KeyCode =
            Enum.KeyCode.T
    end

    local HoldDuration =
        math.max(
            tonumber(
                Prompt.HoldDuration
            )
            or 0,
            0
        )

    -- Your SoulPrompt uses T with HoldDuration = 1. This sends a real
    -- key-down, keeps it down for the prompt's required duration, then
    -- releases it instead of using a one-shot fireproximityprompt call.
    local KeyDownSuccess,
        KeyDownError =
        pcall(function()
            VirtualInputManager:SendKeyEvent(
                true,
                KeyCode,
                false,
                game
            )
        end)

    if KeyDownSuccess then
        task.wait(
            HoldDuration
            + HOLD_INPUT_EXTRA
        )

        pcall(function()
            VirtualInputManager:SendKeyEvent(
                false,
                KeyCode,
                false,
                game
            )
        end)
    else
        -- Fallback for environments where VirtualInputManager key events
        -- are unavailable: use Roblox's prompt hold API directly.
        local HoldSuccess,
            HoldError =
            pcall(function()
                Prompt:InputHoldBegin()

                task.wait(
                    HoldDuration
                    + HOLD_INPUT_EXTRA
                )

                if Prompt.Parent then
                    Prompt:InputHoldEnd()
                end
            end)

        if not HoldSuccess then
            if Prompt.Parent
                and not OriginalEnabled
            then
                pcall(function()
                    Prompt.Enabled =
                        false
                end)
            end

            return false,
                tostring(
                    HoldError
                    or KeyDownError
                )
        end
    end

    task.wait(0.10)

    if Prompt.Parent
        and not OriginalEnabled
    then
        pcall(function()
            Prompt.Enabled =
                false
        end)
    end

    return true
end


local function TriggerCollectiblePrompt(
    Prompt,
    IsSoul
)
    if not Prompt
        or not Prompt.Parent
    then
        return false,
            "Collectible prompt disappeared"
    end

    -- Use the prompt's actual HoldDuration.
    --
    -- Normal drops usually have HoldDuration = 0, so they still use
    -- instant fireproximityprompt below.
    --
    -- Souls and sealed-cache drops can require a real hold (for example
    -- the sealed-cache prompt currently exposes HoldDuration = 2 and T).
    -- Those must use an actual key hold or the server may ignore the claim.
    local HoldDuration =
        tonumber(
            Prompt.HoldDuration
        )
        or 0

    if IsSoul
        or HoldDuration > 0
    then
        return HoldPromptKey(
            Prompt
        )
    end

    local Success,
        ErrorMessage =
        pcall(function()
            if type(
                fireproximityprompt
            ) ~= "function"
            then
                error(
                    "fireproximityprompt is unavailable"
                )
            end

            fireproximityprompt(
                Prompt
            )
        end)

    return Success,
        ErrorMessage
end


local function PickUpCollectiblePrompt(
    Prompt,
    Force
)
    if not HubRunning
        or (
            not Settings.AutoPickUpLoot
            and not Force
        )
        or LootMoveState.Busy
        or CollectibleInteractionBusy
        or not IsCollectiblePrompt(Prompt)
    then
        return false
    end

    -- Normal world loot must wait until every currently-aggroed NPC is
    -- dealt with. Forced reward-room collection bypasses this because those
    -- systems intentionally own the entire post-run sequence.
    if not Force then
        local AggroTarget =
            FindAggroedEnemyTarget()

        if AggroTarget then
            Settings.__LootAggroCleanup =
                true

            Settings.__LootFarmBusy =
                false

            return false
        end
    end

    local IsSoul =
        IsSoulPrompt(
            Prompt
        )

    -- Normal LootDrop prompts still need to be enabled before collection.
    -- SoulPrompt is allowed through even when it first replicates disabled,
    -- because it is handled by HoldPromptKey after we reach it.
    if not IsSoul
        and not Prompt.Enabled
    then
        return false
    end

    -- Rarity filtering only applies to normal LootDrops.
    -- Weak/Strong souls are always eligible when this toggle is enabled.
    if not IsSoul
        and not Force
    then
        local LootDrop =
            GetLootDropFromPrompt(
                Prompt
            )

        if not LootDrop
            or not LootMatchesSelection(
                LootDrop
            )
        then
            return false
        end
    end

    local LastAttempt =
        LootPromptLastAttempt[Prompt]
        or 0

    if os.clock() - LastAttempt
        < PROMPT_RETRY_DELAY
    then
        return false
    end

    CollectibleInteractionBusy =
        true

    -- Loot/souls have movement priority over quest/general farming.
    Settings.__LootFarmBusy =
        true

    local Reached =
        LootMoveState:TeleportToPrompt(
            Prompt
        )

    if not Reached
        or not Prompt.Parent
    then
        LootPromptLastAttempt[Prompt] =
            os.clock()

        CollectibleInteractionBusy =
            false

        return false
    end

    -- Instant prompts stay instant. Hold prompts (souls / some sealed
    -- cache drops) get one tiny settle before the real key hold starts.
    if IsSoul
        or (
            tonumber(
                Prompt.HoldDuration
            )
            or 0
        ) > 0
    then
        task.wait(
            0.03
        )
    else
        task.wait(
            0.01
        )
    end

    local Success,
        ErrorMessage =
        TriggerCollectiblePrompt(
            Prompt,
            IsSoul
        )

    -- Start the retry cooldown AFTER the hold finishes. Previously a
    -- 1-second hold could outlive the cooldown and be retried instantly.
    LootPromptLastAttempt[Prompt] =
        os.clock()

    CollectibleInteractionBusy =
        false

    if not Success then
        warn(
            "[Combat Hub] Auto Loot/Souls: "
                .. tostring(
                    ErrorMessage
                )
        )

        return false
    end

    return true
end

local function ScanExistingLoot(
    FilterCenter,
    FilterRadius
)
    -- While Auto Raid Chest is collecting, make the normal
    -- Auto Pick Up Loot/Souls loop use the same chest-local filter.
    -- This lets the raid controller and the user's existing loot toggle
    -- share one collector without pulling the player to unrelated drops.
    if Settings.__RaidCollecting then
        if typeof(FilterCenter) ~= "Vector3"
            and typeof(Settings.__RaidLootCenter) == "Vector3"
        then
            FilterCenter =
                Settings.__RaidLootCenter
        end

        if not tonumber(FilterRadius)
            and tonumber(Settings.__RaidLootRadius)
        then
            FilterRadius =
                Settings.__RaidLootRadius
        end
    end

    -- World-boss post-kill collection uses the same normal collector but
    -- constrains it to the boss/chest area so an unrelated old drop cannot
    -- pull us away before the next boss.
    if Settings.__BossRewardCollecting then
        if typeof(
            FilterCenter
        ) ~= "Vector3"
            and typeof(
                Settings.__BossLootCenter
            ) == "Vector3"
        then
            FilterCenter =
                Settings.__BossLootCenter
        end

        if not tonumber(
            FilterRadius
        )
            and tonumber(
                Settings.__BossLootRadius
            )
        then
            FilterRadius =
                Settings.__BossLootRadius
        end
    end

    -- Auto Raid Chest owns movement while fighting. The normal collector
    -- waits until the raid controller explicitly enters its collection stage.
    if Settings.__RaidFarmBusy
        and not Settings.__RaidCollecting
    then
        Settings.__LootFarmBusy =
            false

        return
    end

    if LootMoveState.Busy
        or CollectibleInteractionBusy
    then
        return
    end

    local Character =
        LocalPlayer.Character

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Root then
        Settings.__LootFarmBusy =
            false

        return
    end

    local BestPrompt =
        nil

    local BestDistance =
        math.huge

    local function ConsiderPrompt(
        Prompt
    )
        if not Prompt
            or not Prompt.Parent
            or not Prompt:IsA("ProximityPrompt")
            or not IsCollectiblePrompt(
                Prompt
            )
        then
            return
        end

        local SoulPrompt =
            IsSoulPrompt(
                Prompt
            )

        if not SoulPrompt
            and not Prompt.Enabled
        then
            return
        end

        -- Souls bypass the normal loot-rarity selector.
        if IsLootPrompt(Prompt) then
            local LootDrop =
                GetLootDropFromPrompt(
                    Prompt
                )

            if not LootDrop
                or not LootMatchesSelection(
                    LootDrop
                )
            then
                return
            end
        end

        local TargetCFrame =
            LootMoveState:GetPromptCFrame(
                Prompt
            )

        if not TargetCFrame then
            return
        end

        -- Raid collection only takes drops close to the chest that was
        -- just cleared, instead of dragging the player to unrelated loot
        -- somewhere else on the map.
        if typeof(FilterCenter) == "Vector3"
            and tonumber(FilterRadius)
            and (
                TargetCFrame.Position
                - FilterCenter
            ).Magnitude > tonumber(FilterRadius)
        then
            return
        end

        local Distance =
            (
                TargetCFrame.Position
                - Root.Position
            ).Magnitude

        if Distance < BestDistance then
            BestDistance =
                Distance

            BestPrompt =
                Prompt
        end
    end

    ----------------------------------------------------------
    -- NORMAL LOOT
    ----------------------------------------------------------

    local LootFolder =
        GetLootFolder()

    if LootFolder then
        for _, Object in ipairs(
            LootFolder:GetDescendants()
        ) do
            if IsLootPrompt(Object) then
                ConsiderPrompt(
                    Object
                )
            end
        end
    end

    ----------------------------------------------------------
    -- SOULS
    -- Weak Soul / Strong Soul are direct children of Debree.
    ----------------------------------------------------------

    local Debree =
        GetDebreeFolder()

    if Debree then
        for _, Drop in ipairs(
            Debree:GetChildren()
        ) do
            if Drop.Name == "Weak Soul"
                or Drop.Name == "Strong Soul"
            then
                local Prompt =
                    Drop:FindFirstChild(
                        "SoulPrompt",
                        true
                    )

                if Prompt then
                    ConsiderPrompt(
                        Prompt
                    )
                end
            end
        end
    end

    ----------------------------------------------------------
    -- COMBAT BEFORE COLLECTION
    ----------------------------------------------------------

    if BestPrompt then
        local AggroTarget =
            FindAggroedEnemyTarget()

        if AggroTarget then
            -- IMPORTANT:
            -- Do NOT steal movement for loot. Let QuestFarmController move
            -- onto this attacker and finish it first.
            Settings.__LootAggroCleanup =
                true

            Settings.__LootFarmBusy =
                false

            return
        end
    end

    Settings.__LootAggroCleanup =
        false

    -- Hold quest/general farm movement only once it is actually safe to
    -- leave combat and collect.
    Settings.__LootFarmBusy =
        BestPrompt ~= nil

    if BestPrompt then
        PickUpCollectiblePrompt(
            BestPrompt
        )
    end
end


local function CountEligibleCollectiblesNear(
    Center,
    Radius
)
    if typeof(
        Center
    ) ~= "Vector3"
    then
        return 0
    end

    Radius =
        tonumber(
            Radius
        )
        or 55

    local Count =
        0

    local Seen =
        {}

    local function Consider(
        Prompt
    )
        if not Prompt
            or Seen[
                Prompt
            ]
            or not Prompt.Parent
            or not Prompt:IsA(
                "ProximityPrompt"
            )
            or not IsCollectiblePrompt(
                Prompt
            )
        then
            return
        end

        Seen[
            Prompt
        ] =
            true

        local Soul =
            IsSoulPrompt(
                Prompt
            )

        if not Soul
            and not Prompt.Enabled
        then
            return
        end

        if IsLootPrompt(
            Prompt
        )
        then
            local Drop =
                GetLootDropFromPrompt(
                    Prompt
                )

            if not Drop
                or not LootMatchesSelection(
                    Drop
                )
            then
                return
            end
        end

        local PromptCFrame =
            LootMoveState:GetPromptCFrame(
                Prompt
            )

        if not PromptCFrame
            or (
                PromptCFrame.Position
                - Center
            ).Magnitude
                > Radius
        then
            return
        end

        Count +=
            1
    end

    local LootFolder =
        GetLootFolder()

    if LootFolder then
        for _,
            Object in ipairs(
                LootFolder:GetDescendants()
            )
        do
            if IsLootPrompt(
                Object
            )
            then
                Consider(
                    Object
                )
            end
        end
    end

    local Debree =
        GetDebreeFolder()

    if Debree then
        for _,
            Drop in ipairs(
                Debree:GetChildren()
            )
        do
            if Drop.Name == "Weak Soul"
                or Drop.Name == "Strong Soul"
            then
                local Prompt =
                    Drop:FindFirstChild(
                        "SoulPrompt",
                        true
                    )

                if Prompt then
                    Consider(
                        Prompt
                    )
                end
            end
        end
    end

    return Count
end


local function StartAutoPickUpLoot()
    AutoLootLoopID += 1

    local LoopID =
        AutoLootLoopID

    table.clear(
        LootPromptLastAttempt
    )

    -- Immediate pass for loot/souls that already exist.
    ScanExistingLoot()

    task.spawn(function()
        while HubRunning
            and Settings.AutoPickUpLoot
            and LoopID == AutoLootLoopID
        do
            ScanExistingLoot()

            for Prompt in pairs(
                LootPromptLastAttempt
            ) do
                if not Prompt
                    or not Prompt.Parent
                then
                    LootPromptLastAttempt[Prompt] =
                        nil
                end
            end

            task.wait(
                LOOT_SCAN_INTERVAL
            )
        end
    end)
end


local function StopAutoPickUpLoot()
    Settings.AutoPickUpLoot =
        false

    Settings.__LootFarmBusy =
        false

    Settings.__LootAggroCleanup =
        false

    AutoLootLoopID += 1

    LootMoveState:CancelTween()
    LootMoveState:RestoreNoclip()
    LootMoveState.Busy =
        false

    CollectibleInteractionBusy =
        false

    table.clear(
        LootPromptLastAttempt
    )
end


-- Watch the whole workspace because loot appears under LootDrops while
-- Weak/Strong Souls appear under workspace.Debree.
LootAddedConnection =
    workspace.DescendantAdded:Connect(
        function(Object)
            if not HubRunning
                or not Settings.AutoPickUpLoot
            then
                return
            end

            local Relevant =
                IsLootPrompt(
                    Object
                )
                or IsSoulPrompt(
                    Object
                )

            -- Soul models can replicate Root first and SoulPrompt a moment later,
            -- so also react when either soul container itself is added.
            if not Relevant then
                local Debree =
                    GetDebreeFolder()

                Relevant =
                    Debree
                    and Object.Parent == Debree
                    and (
                        Object.Name == "Weak Soul"
                        or Object.Name == "Strong Soul"
                    )
            end

            if not Relevant then
                return
            end

            task.delay(
                0.04,
                function()
                    if HubRunning
                        and Settings.AutoPickUpLoot
                    then
                        ScanExistingLoot()
                    end
                end
            )
        end
    )

local function AntiAFK()
    if not HubRunning
        or not Settings.AntiAFK
    then
        return
    end

    pcall(function()
        local Camera = workspace.CurrentCamera
        local CameraCFrame =
            Camera
            and Camera.CFrame
            or CFrame.new()

        VirtualUser:CaptureController()
        VirtualUser:Button2Down(
            Vector2.new(0, 0),
            CameraCFrame
        )
        task.wait(0.05)
        VirtualUser:Button2Up(
            Vector2.new(0, 0),
            CameraCFrame
        )
    end)
end

AntiAFKConnection =
    LocalPlayer.Idled:Connect(AntiAFK)



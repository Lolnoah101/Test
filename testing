--// ============================================================
--// AUTO EQUIP BEST EQUIPMENT
--// ============================================================
--
-- GEAR ONLY:
--   Data.Inventory.Accessories.Stats.One ... Five
--
-- Exact captured equip call:
--   SignalEvent.ToServer("AccessoryEquip", SlotName, ItemId, "Stats")
--
-- This controller NEVER touches:
--   * Toolbar slots
--   * WeaponSlot
--   * Items_Config.Equipped
--   * Toolbar_Equip
--   * Vanity
--   * Bait
--
-- Priority modes:
--   Damage -> offensive combat stats
--   Health -> survivability / defensive combat stats
--
-- EQUIP RULE:
--   Only one Stats item from each InventoryCategory can be equipped.
--   The highest-scoring item in each category is selected.
--
-- Refinement + Series scaling follows the game's ItemViewer behavior.

local AutoBestEquipmentController = {
    Running = false,
    LoopID = 0,

    ScanDelay = 1.50,

    -- Only make one equipment change per scan. This lets the server/data
    -- tree fully settle before the next decision and prevents slot ping-pong.
    MaxChangesPerScan = 1,

    -- Some Stats gear pieces are mutually exclusive even though the UI has
    -- five generic slots. Learn those conflicts from actual server slot
    -- changes instead of guessing every hidden gear category.
    ConflictPairs = {},
    ConflictSettleWait = 0.75,

    LastDeniedLog = 0,
    LastSummary = "",

    SlotNames = {
        "One",
        "Two",
        "Three",
        "Four",
        "Five",
    },

    ModulesLoaded = false,
    ModulesFailed = false,

    Items = nil,
    Menum = nil,
    Utility = nil,
    Refinement = nil,
    Series = nil,
    Checker = nil,
    CharacterInfo = nil,
    SignalEvent = nil,
}


function AutoBestEquipmentController:LoadModules()
    if self.ModulesLoaded then
        return true
    end

    if self.ModulesFailed then
        return false
    end

    local CAM =
        ReplicatedStorage:FindFirstChild(
            "CAM"
        )

    local Global =
        CAM
        and CAM:FindFirstChild(
            "Global"
        )

    local Collectibles =
        Global
        and Global:FindFirstChild(
            "Collectibles"
        )

    local ItemsModule =
        Collectibles
        and Collectibles:FindFirstChild(
            "Items"
        )

    local MenumModule =
        Global
        and Global:FindFirstChild(
            "Menum"
        )

    local UtilityModule =
        Global
        and Global:FindFirstChild(
            "Utility"
        )

    local RefinementModule =
        Global
        and Global:FindFirstChild(
            "Refinement"
        )

    local SeriesModule =
        Global
        and Global:FindFirstChild(
            "Series"
        )

    local CheckerModule =
        Global
        and Global:FindFirstChild(
            "Checker"
        )

    local CharacterInfoModule =
        Global
        and Global:FindFirstChild(
            "Character_info_provider"
        )

    local Communication =
        ReplicatedStorage:FindFirstChild(
            "Communication"
        )

    local ServerAndClient =
        Communication
        and Communication:FindFirstChild(
            "ServerAndClient"
        )

    local Signals =
        ServerAndClient
        and ServerAndClient:FindFirstChild(
            "Signals"
        )

    local SignalEventModule =
        Signals
        and Signals:FindFirstChild(
            "SignalEvent"
        )

    if not ItemsModule
        or not MenumModule
        or not UtilityModule
        or not SignalEventModule
    then
        self.ModulesFailed =
            true

        warn(
            "[Combat Hub] Auto Best Equipment: required inventory modules not found"
        )

        return false
    end

    local ItemsOk,
        Items =
        pcall(
            require,
            ItemsModule
        )

    local MenumOk,
        Menum =
        pcall(
            require,
            MenumModule
        )

    local UtilityOk,
        Utility =
        pcall(
            require,
            UtilityModule
        )

    local SignalOk,
        SignalEvent =
        pcall(
            require,
            SignalEventModule
        )

    if not ItemsOk
        or type(
            Items
        ) ~= "table"
        or not MenumOk
        or type(
            Menum
        ) ~= "table"
        or not UtilityOk
        or type(
            Utility
        ) ~= "table"
        or not SignalOk
        or type(
            SignalEvent
        ) ~= "table"
    then
        self.ModulesFailed =
            true

        warn(
            "[Combat Hub] Auto Best Equipment: failed to load inventory modules"
        )

        return false
    end

    self.Items =
        Items

    self.Menum =
        Menum

    self.Utility =
        Utility

    self.SignalEvent =
        SignalEvent

    if RefinementModule then
        local Ok,
            Result =
            pcall(
                require,
                RefinementModule
            )

        if Ok
            and type(
                Result
            ) == "table"
        then
            self.Refinement =
                Result
        end
    end

    if SeriesModule then
        local Ok,
            Result =
            pcall(
                require,
                SeriesModule
            )

        if Ok
            and type(
                Result
            ) == "table"
        then
            self.Series =
                Result
        end
    end

    if CheckerModule then
        local Ok,
            Result =
            pcall(
                require,
                CheckerModule
            )

        if Ok
            and type(
                Result
            ) == "table"
        then
            self.Checker =
                Result
        end
    end

    if CharacterInfoModule then
        local Ok,
            Result =
            pcall(
                require,
                CharacterInfoModule
            )

        if Ok
            and type(
                Result
            ) == "table"
        then
            self.CharacterInfo =
                Result
        end
    end

    self.ModulesLoaded =
        true

    return true
end


function AutoBestEquipmentController:GetData()
    if not self:LoadModules()
        or type(
            self.Utility.GetData
        ) ~= "function"
    then
        return nil
    end

    local Success,
        Data =
        pcall(
            self.Utility.GetData,
            LocalPlayer,
            true
        )

    if not Success
        or Data == nil
    then
        return nil
    end

    -- The game's own Inventory module immediately uses Data.Inventory...
    -- so this is an Instance-like data tree, not necessarily a Lua table.
    local Inventory =
        Data.Inventory

    if Inventory == nil
        or Inventory.Inventory == nil
        or Inventory.Accessories == nil
        or Inventory.Accessories.Stats == nil
    then
        return nil
    end

    return Data
end


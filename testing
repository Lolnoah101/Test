local function GetExportedMaxPetAge()
    for _, Key in ipairs({
        "MaxAge",
        "MAX_AGE",
        "MaximumAge",
        "MaxLevel",
        "MAX_LEVEL",
    }) do
        local Value =
            tonumber(PetAging[Key])

        if Value and Value > 0 then
            return Value
        end
    end

    return nil
end


local function HasExplicitMaxFlag(Object)
    if not Object then
        return false
    end

    for _, AttributeName in ipairs({
        "Maxed",
        "IsMaxed",
        "MaxXP",
        "MaxEXP",
        "MaxLevel",
    }) do
        if Object:GetAttribute(AttributeName) == true then
            return true
        end
    end

    return false
end


local function GetPetGrowthState(PetKey)
    local Info =
        GetPetRendererInfo(PetKey)

    local Model =
        Info and Info.Model or nil

    local Tool =
        FindPetToolForGrowth(PetKey)

    if HasExplicitMaxFlag(Model)
        or HasExplicitMaxFlag(Tool)
    then
        return {
            IsMaxed = true,
            Reason = "explicit max flag",
        }
    end

    local BirthTime =
        Info and Info.BirthTime
        or (
            Model
            and Model:GetAttribute("BirthTime")
        )
        or (
            Tool
            and Tool:GetAttribute("BirthTime")
        )

    local Age = nil
    local CurrentXP = nil
    local RequiredXP = nil

    if BirthTime ~= nil then
        local Success, A, XP, Requirement =
            pcall(
                PetAging.StateFrom,
                BirthTime
            )

        if Success then
            Age = tonumber(A)
            CurrentXP = tonumber(XP)
            RequiredXP = tonumber(Requirement)
        end
    end

    if Age == nil then
        Age =
            tonumber(
                Model
                and Model:GetAttribute("Age")
            )
            or tonumber(
                Tool
                and Tool:GetAttribute("Age")
            )
    end

    if CurrentXP == nil then
        CurrentXP =
            tonumber(
                Model
                and (
                    Model:GetAttribute("EXP")
                    or Model:GetAttribute("XP")
                )
            )
            or tonumber(
                Tool
                and (
                    Tool:GetAttribute("EXP")
                    or Tool:GetAttribute("XP")
                )
            )
    end

    if RequiredXP == nil and Age ~= nil then
        local Success, Requirement =
            pcall(
                PetAging.RequirementFor,
                Age
            )

        if Success then
            RequiredXP =
                tonumber(Requirement)
        end
    end

    local MaxAge =
        GetExportedMaxPetAge()

    if MaxAge
        and Age
        and Age >= MaxAge
    then
        return {
            IsMaxed = true,
            Age = Age,
            CurrentXP = CurrentXP,
            RequiredXP = RequiredXP,
            Reason = "max age",
        }
    end

    -- A zero/negative requirement normally means there is no next
    -- growth step left.
    if RequiredXP ~= nil
        and RequiredXP <= 0
    then
        return {
            IsMaxed = true,
            Age = Age,
            CurrentXP = CurrentXP,
            RequiredXP = RequiredXP,
            Reason = "no next XP requirement",
        }
    end

    -- StateFrom normalizes normal levels below their requirement.
    -- If it reports the progress at/above the requirement and the
    -- state does not roll into another level, treat it as capped.
    if CurrentXP ~= nil
        and RequiredXP ~= nil
        and RequiredXP > 0
        and CurrentXP >= RequiredXP
    then
        return {
            IsMaxed = true,
            Age = Age,
            CurrentXP = CurrentXP,
            RequiredXP = RequiredXP,
            Reason = "XP cap reached",
        }
    end

    return {
        IsMaxed = false,
        Age = Age,
        CurrentXP = CurrentXP,
        RequiredXP = RequiredXP,
    }
end


local function GetBestPetKeys()
    if not CollectOwnedPets then
        return {}
    end

    local Owned = CollectOwnedPets()

    local MaxPets =
        tonumber(
            LocalPlayer:GetAttribute("MaxPets")
        ) or 5

    local Keys = {}

    for Index = 1, math.min(MaxPets, #Owned) do
        local Pet = Owned[Index]

        if Pet and Pet.Key then
            table.insert(Keys, Pet.Key)
        end
    end

    return Keys
end


local LastAllBestPetsMaxed = false


local function FeedBestPetsOnce()
    if AutoFeedBestPetsBusy then
        return false, "Busy"
    end

    if not Settings.AutoFeedBestPets then
        return false, "Disabled"
    end

    local SelectedFoods =
        GetSelectedPetFoodList()

    if #SelectedFoods == 0 then
        return false, "No food selected."
    end

    local BestPetKeys =
        GetBestPetKeys()

    if #BestPetKeys == 0 then
        return false, "No pets found."
    end

    local HasAvailableFood = false

    for _, FoodName in ipairs(SelectedFoods) do
        if FindFoodTool(FoodName) then
            HasAvailableFood = true
            break
        end
    end

    if not HasAvailableFood then
        return false,
            "None of the selected foods are available."
    end

    AutoFeedBestPetsBusy = true

    local FeedCalls = 0
    local FoodsUsed = {}
    local MaxedPetCount = 0

    for _, PetKey in ipairs(BestPetKeys) do
        if not HubRunning
            or not Settings.AutoFeedBestPets
        then
            break
        end

        local GrowthState =
            GetPetGrowthState(PetKey)

        if GrowthState.IsMaxed then
            MaxedPetCount += 1

        else
            for _, FoodName in ipairs(SelectedFoods) do
                if not HubRunning
                    or not Settings.AutoFeedBestPets
                then
                    break
                end

                -- Recheck before every food. A previous food may have
                -- finished this pet's XP.
                GrowthState =
                    GetPetGrowthState(PetKey)

                if GrowthState.IsMaxed then
                    MaxedPetCount += 1
                    break
                end

                local FoodTool =
                    FindFoodTool(FoodName)

                if FoodTool then
                    local EquippedTool =
                        EquipFoodTool(FoodName)

                    if EquippedTool then
                        local Success, ErrorMessage =
                            pcall(function()
                                FeedPetEvent:FireServer(
                                    PetKey,
                                    FoodName,
                                    true
                                )
                            end)

                        if Success then
                            FeedCalls += 1
                            FoodsUsed[FoodName] = true

                            -- Give the replicated pet state a moment
                            -- to update, then stop feeding this pet if
                            -- that food maxed it.
                            task.wait(0.15)

                            GrowthState =
                                GetPetGrowthState(PetKey)

                            if GrowthState.IsMaxed then
                                MaxedPetCount += 1

                                Log(
                                    "Pet "
                                        .. tostring(PetKey)
                                        .. " reached max XP • stopping feed"
                                )

                                break
                            end
                        else
                            Log(
                                "FeedPet failed for "
                                    .. tostring(PetKey)
                                    .. " with "
                                    .. tostring(FoodName)
                                    .. ": "
                                    .. tostring(ErrorMessage)
                            )
                        end
                    end
                end
            end
        end
    end

    AutoFeedBestPetsBusy = false

    local UsedList = {}

    for _, FoodName in ipairs(PetFoodOptions) do
        if FoodsUsed[FoodName] then
            table.insert(UsedList, FoodName)
        end
    end

    local AllBestPetsMaxed =
        #BestPetKeys > 0
        and MaxedPetCount >= #BestPetKeys

    if AllBestPetsMaxed then
        if not LastAllBestPetsMaxed then
            Log(
                "Auto Feed: all current best pets are max XP • waiting for a new best pet"
            )

            Toast(
                "Auto Feed Best Pets",
                "All current best pets are max XP"
            )
        end

        LastAllBestPetsMaxed = true
    else
        LastAllBestPetsMaxed = false
    end

    Log(
        "Auto Feed Best Pets • "
            .. tostring(FeedCalls)
            .. " feed call(s) • "
            .. tostring(MaxedPetCount)
            .. "/"
            .. tostring(#BestPetKeys)
            .. " best pets maxed"
            .. (
                #UsedList > 0
                and (
                    " • "
                    .. table.concat(UsedList, ", ")
                )
                or ""
            )
    )

    return true, FeedCalls
end

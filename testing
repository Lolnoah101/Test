function QuestController:GetConfig()
    return self.Configs[
        Settings.SelectedQuest
    ]
end


function QuestController:GetQuestHolder()
    if self.QuestHolder
        and self.QuestHolder.Parent
    then
        return self.QuestHolder
    end

    if not GameUtilityModule
        or type(
            GameUtilityModule.GetData
        ) ~= "function"
    then
        return nil
    end

    local Success,
        Data =
        pcall(
            GameUtilityModule.GetData,
            LocalPlayer,
            true
        )

    if not Success
        or not Data
    then
        return nil
    end

    local QuestsFolder =
        Data:FindFirstChild(
            "Quests"
        )

    local Holder =
        QuestsFolder
        and QuestsFolder:FindFirstChild(
            "Holder"
        )

    if Holder then
        self.QuestDataRoot =
            QuestsFolder

        self.QuestHolder =
            Holder
    end

    return Holder
end


function QuestController:NormalizeQuestText(
    Value
)
    return string.lower(
        tostring(
            Value
            or ""
        )
    )
end


function QuestController:GetQuestIdentityStrings(
    Quest
)
    local Results = {}

    if not Quest then
        return Results
    end

    table.insert(
        Results,
        tostring(
            Quest.Name
            or ""
        )
    )

    local QuestString =
        Quest:FindFirstChild(
            "QuestString"
        )

    if QuestString
        and QuestString:IsA(
            "StringValue"
        )
    then
        table.insert(
            Results,
            tostring(
                QuestString.Value
                or ""
            )
        )
    end

    local Tasks =
        Quest:FindFirstChild(
            "Tasks"
        )

    if Tasks then
        for _,
            Task in ipairs(
                Tasks:GetChildren()
            )
        do
            table.insert(
                Results,
                tostring(
                    Task.Name
                    or ""
                )
            )
        end
    end

    return Results
end


function QuestController:DataQuestMatches(
    Quest,
    Config
)
    if not Quest
        or not Config
    then
        return false
    end

    local Identities =
        self:GetQuestIdentityStrings(
            Quest
        )

    local ExactCandidates = {
        Config.Request,
        Config.PanelName,
        Config.QuestString,
    }

    for _,
        Identity in ipairs(
            Identities
        )
    do
        local LowerIdentity =
            self:NormalizeQuestText(
                Identity
            )

        for _,
            Candidate in ipairs(
                ExactCandidates
            )
        do
            if Candidate
                and LowerIdentity
                    == self:NormalizeQuestText(
                        Candidate
                    )
            then
                return true
            end
        end

    end

    local Terms =
        Config.MatchTerms
        or {}

    if #Terms > 0 then
        local Combined =
            self:NormalizeQuestText(
                table.concat(
                    Identities,
                    " "
                )
            )

        local AllTerms =
            true

        for _,
            Term in ipairs(
                Terms
            )
        do
            if not string.find(
                Combined,
                self:NormalizeQuestText(
                    Term
                ),
                1,
                true
            )
            then
                AllTerms =
                    false

                break
            end
        end

        if AllTerms then
            return true
        end
    end

    return false
end


function QuestController:FindQuestData(
    Config
)
    local Holder =
        self:GetQuestHolder()

    if not Holder then
        return nil
    end

    for _,
        Quest in ipairs(
            Holder:GetChildren()
        )
    do
        if self:DataQuestMatches(
            Quest,
            Config
        )
        then
            return Quest
        end
    end

    return nil
end


function QuestController:ReadQuestDataProgress(
    Quest
)
    if not Quest then
        return nil,
            nil,
            {}
    end

    local Tasks =
        Quest:FindFirstChild(
            "Tasks"
        )

    if not Tasks then
        return nil,
            nil,
            {}
    end

    local CurrentTotal =
        0

    local MaxTotal =
        0

    local Details = {}

    for _,
        Task in ipairs(
            Tasks:GetChildren()
        )
    do
        local Value =
            Task:FindFirstChild(
                "Value"
            )

        local Max =
            Task:FindFirstChild(
                "Max"
            )

        if Value
            and Max
            and tonumber(
                Value.Value
            )
            and tonumber(
                Max.Value
            )
        then
            local Current =
                tonumber(
                    Value.Value
                )
                or 0

            local Maximum =
                tonumber(
                    Max.Value
                )
                or 0

            CurrentTotal +=
                math.min(
                    Current,
                    Maximum
                )

            MaxTotal +=
                Maximum

            local Need =
                Task:FindFirstChild(
                    "Need"
                )

            local NeedName =
                Need
                and tostring(
                    Need.Value
                    or ""
                )
                or ""

            local NeedMet =
                NeedName == ""

            if GameQuestModule
                and type(
                    GameQuestModule.TaskNeedMet
                ) == "function"
            then
                local Success,
                    Result =
                    pcall(
                        GameQuestModule.TaskNeedMet,
                        Task
                    )

                if Success then
                    NeedMet =
                        Result == true
                end
            elseif NeedName ~= "" then
                local RequiredTask =
                    Tasks:FindFirstChild(
                        NeedName
                    )

                local RequiredValue =
                    RequiredTask
                    and RequiredTask:FindFirstChild(
                        "Value"
                    )

                local RequiredMax =
                    RequiredTask
                    and RequiredTask:FindFirstChild(
                        "Max"
                    )

                if RequiredValue
                    and RequiredMax
                then
                    local RequiredCurrent =
                        tonumber(
                            RequiredValue.Value
                        )

                    local RequiredMaximum =
                        tonumber(
                            RequiredMax.Value
                        )

                    NeedMet =
                        RequiredCurrent ~= nil
                        and RequiredMaximum ~= nil
                        and RequiredCurrent
                            >= RequiredMaximum
                end
            end

            table.insert(
                Details,
                {
                    Name =
                        Task.Name,

                    Current =
                        Current,

                    Max =
                        Maximum,

                    Complete =
                        Maximum > 0
                        and Current
                            >= Maximum,

                    Need =
                        NeedName,

                    NeedMet =
                        NeedMet,
                }
            )
        end
    end

    if MaxTotal <= 0 then
        return nil,
            nil,
            Details
    end

    return CurrentTotal,
        MaxTotal,
        Details
end


function QuestController:IsQuestDataComplete(
    Quest
)
    local Current,
        Total =
        self:ReadQuestDataProgress(
            Quest
        )

    return Current ~= nil
        and Total ~= nil
        and Total > 0
        and Current >= Total
end


function QuestController:GetActionableQuestTask(
    Quest
)
    local _,
        _,
        Details =
        self:ReadQuestDataProgress(
            Quest
        )

    for _,
        TaskInfo in ipairs(
            Details
            or {}
        )
    do
        if not TaskInfo.Complete
            and TaskInfo.NeedMet
        then
            return TaskInfo
        end
    end

    return nil
end



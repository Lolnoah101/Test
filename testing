function AutoBlockController:GetCharacterRoot()
    local Character =
        LocalPlayer.Character

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    local Humanoid =
        Character
        and Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not Character
        or not Root
        or not Humanoid
        or Humanoid.Health <= 0
    then
        return nil,
            nil,
            nil
    end

    return Character,
        Root,
        Humanoid
end


function AutoBlockController:GetValuesFolder()
    local Utility =
        GetAutoBlockUtility()

    if Utility
        and type(
            Utility.getvaluesfolder
        ) == "function"
    then
        local Success,
            Folder =
            pcall(
                Utility.getvaluesfolder,
                LocalPlayer
            )

        if Success
            and Folder
        then
            return Folder
        end
    end

    return nil
end


function AutoBlockController:IsServerBlocking()
    local ValuesFolder =
        self:GetValuesFolder()

    return ValuesFolder
        and ValuesFolder:FindFirstChild(
            "Blocking"
        ) ~= nil
        or false
end


function AutoBlockController:GetModelFromHumanoid(
    Humanoid
)
    if not Humanoid
        or not Humanoid:IsA(
            "Humanoid"
        )
    then
        return nil
    end

    local Model =
        Humanoid.Parent

    if not Model
        or not Model:IsA(
            "Model"
        )
    then
        return nil
    end

    if Model
        == LocalPlayer.Character
    then
        return nil
    end

    -- Do not auto-block because another PLAYER near us animates.
    if Players:GetPlayerFromCharacter(
        Model
    ) then
        return nil
    end

    return Model
end


function AutoBlockController:GetNpcRoot(
    Model
)
    if not Model
        or not Model.Parent
    then
        return nil
    end

    return Model:FindFirstChild(
        "HumanoidRootPart"
    )
        or Model.PrimaryPart
        or Model:FindFirstChildWhichIsA(
            "BasePart",
            true
        )
end


function AutoBlockController:IsNpcThreatInRange(
    Model
)
    local _,
        PlayerRoot =
        self:GetCharacterRoot()

    local NpcRoot =
        self:GetNpcRoot(
            Model
        )

    if not PlayerRoot
        or not NpcRoot
    then
        return false,
            nil
    end

    local Distance =
        (
            NpcRoot.Position
            - PlayerRoot.Position
        ).Magnitude

    if Distance
        > self.ThreatRange
    then
        return false,
            NpcRoot
    end

    local Humanoid =
        Model:FindFirstChildOfClass(
            "Humanoid"
        )

    if not Humanoid
        or Humanoid.Health <= 0
    then
        return false,
            NpcRoot
    end

    return true,
        NpcRoot
end


function AutoBlockController:GetFollowingFolder()
    local Character =
        LocalPlayer.Character

    return Character
        and Character:FindFirstChild(
            "NpcsFollowing"
        )
        or nil
end


function AutoBlockController:IsFollowingPlayer(
    Model
)
    if not Model
        or not Model.Parent
    then
        return false
    end

    local Folder =
        self:GetFollowingFolder()

    if not Folder then
        return false
    end

    for _,
        Child in ipairs(
            Folder:GetChildren()
        )
    do
        if Child:IsA(
            "ObjectValue"
        ) then
            local Value =
                Child.Value

            if Value then
                if Value == Model
                    or Model:IsDescendantOf(
                        Value
                    )
                    or Value:IsDescendantOf(
                        Model
                    )
                then
                    return true
                end
            end
        end
    end

    return false
end


function AutoBlockController:IsNpcFacingPlayer(
    Model,
    NpcRoot,
    PlayerRoot
)
    if not Model
        or not NpcRoot
        or not PlayerRoot
    then
        return false,
            -1
    end

    local ToPlayer =
        PlayerRoot.Position
        - NpcRoot.Position

    local FlatToPlayer =
        Vector3.new(
            ToPlayer.X,
            0,
            ToPlayer.Z
        )

    if FlatToPlayer.Magnitude
        < 0.001
    then
        return true,
            1
    end

    local FlatLook =
        Vector3.new(
            NpcRoot.CFrame.LookVector.X,
            0,
            NpcRoot.CFrame.LookVector.Z
        )

    if FlatLook.Magnitude
        < 0.001
    then
        return false,
            -1
    end

    local Dot =
        FlatLook.Unit:Dot(
            FlatToPlayer.Unit
        )

    return Dot
        >= self.ProactiveFacingDot,
        Dot
end


function AutoBlockController:IsObservableSkillActive(
    Model
)
    if not Model
        or not Model.Parent
    then
        return false
    end

    -- Some NPC implementations expose their internal AI state as a
    -- replicated Attribute/Value even though others keep it only in Lua.
    -- Use it when present, but never depend on it.
    local Names = {
        "IsDoingSkill",
        "DoingSkill",
        "Attacking",
        "IsAttacking",
    }

    for _,
        Name in ipairs(
            Names
        )
    do
        local Attribute =
            Model:GetAttribute(
                Name
            )

        if Attribute == true
            or tonumber(
                Attribute
            ) == 1
        then
            return true
        end

        local ValueObject =
            Model:FindFirstChild(
                Name,
                true
            )

        if ValueObject then
            if ValueObject:IsA(
                "BoolValue"
            )
                and ValueObject.Value
            then
                return true
            end

            if (
                ValueObject:IsA(
                    "IntValue"
                )
                or ValueObject:IsA(
                    "NumberValue"
                )
            )
                and ValueObject.Value
                    > 0
            then
                return true
            end
        end
    end

    return false
end


function AutoBlockController:GetCurrentAnimName(
    Model
)
    if not Model
        or not Model.Parent
    then
        return ""
    end

    local ClientAnimatorServer =
        Model:FindFirstChild(
            "ClientAnimatorServer"
        )

    local CurrentAnim =
        ClientAnimatorServer
        and ClientAnimatorServer:FindFirstChild(
            "CurrentAnim"
        )

    if CurrentAnim
        and (
            CurrentAnim:IsA(
                "StringValue"
            )
            or CurrentAnim:IsA(
                "IntValue"
            )
        )
    then
        return string.lower(
            tostring(
                CurrentAnim.Value
            )
        )
    end

    return ""
end


function AutoBlockController:IsIgnoredAnimationName(
    AnimationName
)
    local Text =
        string.lower(
            tostring(
                AnimationName
                or ""
            )
        )

    if Text == "" then
        return false
    end

    for _,
        Word in ipairs(
            self.IgnoreWords
        )
    do
        if string.find(
            Text,
            Word,
            1,
            true
        ) then
            return true
        end
    end

    return false
end


function AutoBlockController:IsAttackAnimationName(
    AnimationName
)
    local Text =
        string.lower(
            tostring(
                AnimationName
                or ""
            )
        )

    if Text == ""
        or self:IsIgnoredAnimationName(
            Text
        )
    then
        return false
    end

    for _,
        Word in ipairs(
            self.AttackWords
        )
    do
        if string.find(
            Text,
            Word,
            1,
            true
        ) then
            return true
        end
    end

    return false
end


function AutoBlockController:IsNpcAggroedToUs(
    Model
)
    if not Model
        or not Model.Parent
    then
        return false
    end

    return self:IsFollowingPlayer(
        Model
    )
        or Model:GetAttribute(
            "Aggroed"
        ) == true
end


function AutoBlockController:WatchClientAnimatorState(
    Model
)
    if not Model
        or not Model.Parent
        or self.NpcAnimStateWatchers[
            Model
        ]
    then
        return
    end

    local ClientAnimatorServer =
        Model:FindFirstChild(
            "ClientAnimatorServer"
        )

    local CurrentAnim =
        ClientAnimatorServer
        and ClientAnimatorServer:FindFirstChild(
            "CurrentAnim"
        )

    if not CurrentAnim
        or not (
            CurrentAnim:IsA(
                "StringValue"
            )
            or CurrentAnim:IsA(
                "IntValue"
            )
        )
    then
        return
    end

    local Info = {
        CurrentAnim =
            CurrentAnim,

        Connection =
            nil,
    }

    local function CheckCurrentAnim()
        if not HubRunning
            or not Settings.AutoBlock
            or not Model.Parent
            or not CurrentAnim.Parent
        then
            return
        end

        local AnimationName =
            tostring(
                CurrentAnim.Value
            )

        if self:IsIgnoredAnimationName(
            AnimationName
        )
        then
            self.RecentAnimThreatUntil[
                Model
            ] =
                nil

            return
        end

        if not self:IsAttackAnimationName(
            AnimationName
        )
        then
            -- Unknown/generic CurrentAnim names are handled by the
            -- Action-priority track fallback in FindActiveThreat.
            return
        end

        local InRange =
            self:IsNpcThreatInRange(
                Model
            )

        if not InRange then
            return
        end

        -- Only trust replicated attack-state names from NPCs that are
        -- actually aggroed/following the local player.
        if not self:IsNpcAggroedToUs(
            Model
        )
        then
            return
        end

        -- CurrentAnim changes before/independently of the local animation
        -- track being fully visible. Hold a short threat window immediately.
        self.RecentAnimThreatUntil[
            Model
        ] =
            os.clock()
            + 0.70

        self:MarkThreat(
            Model
        )

        HubDebug(
            "[Combat Hub] Auto Block CurrentAnim: "
                .. tostring(
                    Model.Name
                )
                .. " -> "
                .. AnimationName
        )
    end

    Info.Connection =
        CurrentAnim.Changed:Connect(
            CheckCurrentAnim
        )

    self.NpcAnimStateWatchers[
        Model
    ] =
        Info

    -- Check current state in case Auto Block was enabled mid-swing.
    CheckCurrentAnim()
end


function AutoBlockController:GetTrackSearchText(
    Track
)
    local Pieces = {}

    if Track then
        Pieces[
            #Pieces + 1
        ] =
            tostring(
                Track.Name
                or ""
            )

        local Animation =
            Track.Animation

        if Animation then
            Pieces[
                #Pieces + 1
            ] =
                tostring(
                    Animation.Name
                    or ""
                )

            Pieces[
                #Pieces + 1
            ] =
                tostring(
                    Animation.AnimationId
                    or ""
                )
        end
    end

    return string.lower(
        table.concat(
            Pieces,
            " "
        )
    )
end


function AutoBlockController:IsAttackTrack(
    Track,
    IsTargetingPlayer,
    Model
)
    if not Track
        or not Track.IsPlaying
    then
        return false
    end

    local Text =
        self:GetTrackSearchText(
            Track
        )

    -- Track-level movement/evasion names always win.
    for _,
        Word in ipairs(
            self.IgnoreWords
        )
    do
        if string.find(
            Text,
            Word,
            1,
            true
        ) then
            return false
        end
    end

    -- Also reject the Action-priority fallback if the NPC's replicated
    -- CurrentAnim says it is dashing/dodging/rolling/etc. This catches
    -- cases where the Roblox AnimationTrack itself has a generic name.
    local CurrentAnimName =
        self:GetCurrentAnimName(
            Model
        )

    local CurrentAnimIgnored =
        self:IsIgnoredAnimationName(
            CurrentAnimName
        )

    if CurrentAnimIgnored then
        return false
    end

    -- Strongest signal: descriptive attack/skill name.
    for _,
        Word in ipairs(
            self.AttackWords
        )
    do
        if string.find(
            Text,
            Word,
            1,
            true
        ) then
            return true
        end
    end

    -- Many NPC attacks use generic Animation instances, so their Track.Name
    -- and Animation.Name contain no useful "attack" word. Restore Roblox
    -- Action-priority detection ONLY for an NPC that is actually targeting
    -- the local player, after all movement/evasion filters above passed.
    if IsTargetingPlayer then
        local Priority =
            Track.Priority

        if typeof(
            Priority
        ) == "EnumItem"
            and Priority.Value
                >= Enum.AnimationPriority.Action.Value
        then
            return true
        end
    end

    return false
end


function AutoBlockController:GetBlockPosition(
    ThreatModel
)
    local _,
        PlayerRoot =
        self:GetCharacterRoot()

    local ThreatRoot =
        self:GetNpcRoot(
            ThreatModel
        )

    if ThreatRoot then
        return ThreatRoot.Position
    end

    if PlayerRoot then
        return PlayerRoot.Position
            + (
                PlayerRoot.CFrame.LookVector
                * 8
            )
    end

    return Vector3.zero
end


function AutoBlockController:SendBlockState(
    Action,
    ThreatModel
)
    local Position =
        self:GetBlockPosition(
            ThreatModel
        )

    local Success,
        ErrorMessage =
        pcall(function()
            if Action == "UnHold" then
                CombatEvent:FireServer(
                    "server_skill_controller_signaler",
                    "Blocking",
                    "UnHold",
                    Position,
                    nil
                )
            else
                CombatEvent:FireServer(
                    "server_skill_controller_signaler",
                    "Blocking",
                    "Hold",
                    Position
                )
            end
        end)

    if not Success then
        warn(
            "[Combat Hub] Auto Block "
                .. tostring(Action)
                .. ": "
                .. tostring(
                    ErrorMessage
                )
        )
    end

    return Success
end


function AutoBlockController:BeginBlock(
    ThreatModel
)
    if not Settings.AutoBlock then
        return false
    end

    local _,
        Root,
        Humanoid =
        self:GetCharacterRoot()

    if not Root
        or not Humanoid
    then
        return false
    end

    self.LastThreatAt =
        os.clock()

    self.CurrentThreat =
        ThreatModel
        or self.CurrentThreat

    -- If server replication already says we are blocking, don't keep
    -- repeating Hold every frame.
    if self:IsServerBlocking() then
        self.BlockingRequested =
            true

        return true
    end

    local Now =
        os.clock()

    if self.BlockingRequested
        and Now - self.LastHoldAt
            < self.HoldRetryInterval
    then
        return true
    end

    if Now - self.LastHoldAt
        < self.HoldRetryInterval
    then
        return false
    end

    self.LastHoldAt =
        Now

    local Success =
        self:SendBlockState(
            "Hold",
            self.CurrentThreat
        )

    if Success then
        self.BlockingRequested =
            true
    end

    return Success
end


function AutoBlockController:EndBlock(
    Force
)
    local ActualBlocking =
        self:IsServerBlocking()

    if not Force
        and not self.BlockingRequested
        and not ActualBlocking
    then
        return true
    end

    local Now =
        os.clock()

    if not Force
        and Now - self.LastReleaseAt
            < self.ReleaseRetryInterval
    then
        return false
    end

    self.LastReleaseAt =
        Now

    local Success =
        self:SendBlockState(
            "UnHold",
            self.CurrentThreat
        )

    if Success
        or Force
    then
        self.BlockingRequested =
            false

        self.CurrentThreat =
            nil
    end

    return Success
end


function AutoBlockController:MarkThreat(
    Model
)
    if not Settings.AutoBlock then
        return
    end

    local InRange =
        self:IsNpcThreatInRange(
            Model
        )

    if not InRange then
        return
    end

    self.LastThreatAt =
        os.clock()

    Settings.__AutoBlockThreatActive =
        true

    self.CurrentThreat =
        Model

    self:BeginBlock(
        Model
    )
end


function AutoBlockController:WatchAnimator(
    Animator,
    Model
)
    if not Animator
        or not Animator.Parent
        or not Model
        or not Model.Parent
    then
        return
    end

    if self.Watchers[
        Animator
    ] then
        return
    end

    local Info = {
        Model = Model,
        Connection = nil,
    }

    Info.Connection =
        Animator.AnimationPlayed:Connect(
            function(Track)
                if not HubRunning
                    or not Settings.AutoBlock
                then
                    return
                end

                -- Animation priority can be assigned on the same frame that
                -- AnimationPlayed fires. Check immediately and once again
                -- next scheduler slice.
                local function Check()
                    if not Track
                        or not Track.IsPlaying
                        or not Model.Parent
                    then
                        return
                    end

                    local TargetingPlayer =
                        self:IsNpcAggroedToUs(
                            Model
                        )

                    if self:IsAttackTrack(
                        Track,
                        TargetingPlayer,
                        Model
                    )
                    then
                        self:MarkThreat(
                            Model
                        )
                    end
                end

                Check()

                task.defer(
                    Check
                )
            end
        )

    self.Watchers[
        Animator
    ] =
        Info
end


function AutoBlockController:RefreshWatchers()
    -- Clean dead replicated CurrentAnim watchers first.
    for Model,
        Info in pairs(
            self.NpcAnimStateWatchers
        )
    do
        if not Model
            or not Model.Parent
            or not Info.CurrentAnim
            or not Info.CurrentAnim.Parent
        then
            if Info.Connection then
                Info.Connection:Disconnect()
            end

            self.NpcAnimStateWatchers[
                Model
            ] =
                nil

            self.RecentAnimThreatUntil[
                Model
            ] =
                nil
        end
    end

    -- Clean dead Animator watchers.
    for Animator,
        Info in pairs(
            self.Watchers
        )
    do
        if not Animator
            or not Animator.Parent
            or not Info.Model
            or not Info.Model.Parent
        then
            if Info.Connection then
                Info.Connection:Disconnect()
            end

            self.Watchers[
                Animator
            ] =
                nil
        end
    end

    local SeenHumanoids = {}

    local function ConsiderHumanoid(
        Humanoid
    )
        if not Humanoid
            or SeenHumanoids[
                Humanoid
            ]
        then
            return
        end

        SeenHumanoids[
            Humanoid
        ] =
            true

        local Model =
            self:GetModelFromHumanoid(
                Humanoid
            )

        if not Model then
            return
        end

        self:WatchClientAnimatorState(
            Model
        )

        local Animator =
            Humanoid:FindFirstChildOfClass(
                "Animator"
            )

        if Animator then
            self:WatchAnimator(
                Animator,
                Model
            )
        end
    end

    -- The game's own overhead controller uses the "Humanoids" tag, so use
    -- that as the fast path.
    for _,
        Tagged in ipairs(
            CollectionService:GetTagged(
                "Humanoids"
            )
        )
    do
        if Tagged:IsA(
            "Humanoid"
        ) then
            ConsiderHumanoid(
                Tagged
            )
        elseif Tagged:IsA(
            "Model"
        ) then
            ConsiderHumanoid(
                Tagged:FindFirstChildOfClass(
                    "Humanoid"
                )
            )
        else
            local Model =
                Tagged:FindFirstAncestorOfClass(
                    "Model"
                )

            if Model then
                ConsiderHumanoid(
                    Model:FindFirstChildOfClass(
                        "Humanoid"
                    )
                )
            end
        end
    end

    -- Fallback for NPCs that haven't received the CollectionService tag yet.
    local HumanoidsFolder =
        workspace:FindFirstChild(
            "Humanoids"
        )

    if HumanoidsFolder then
        for _,
            Object in ipairs(
                HumanoidsFolder:GetDescendants()
            )
        do
            if Object:IsA(
                "Humanoid"
            ) then
                ConsiderHumanoid(
                    Object
                )
            end
        end
    end
end


function AutoBlockController:FindActiveThreat()
    local BestModel =
        nil

    local BestDistance =
        math.huge

    local _,
        PlayerRoot =
        self:GetCharacterRoot()

    if not PlayerRoot then
        return nil
    end

    for Animator,
        Info in pairs(
            self.Watchers
        )
    do
        local Model =
            Info.Model

        if Animator
            and Animator.Parent
            and Model
            and Model.Parent
        then
            local InRange,
                NpcRoot =
                self:IsNpcThreatInRange(
                    Model
                )

            if InRange
                and NpcRoot
            then
                local Distance =
                    (
                        NpcRoot.Position
                        - PlayerRoot.Position
                    ).Magnitude

                local TargetingPlayer =
                    self:IsNpcAggroedToUs(
                        Model
                    )

                local CurrentAnimThreat =
                    (
                        self.RecentAnimThreatUntil[
                            Model
                        ]
                        or 0
                    ) > os.clock()

                local CurrentAnimName =
                    self:GetCurrentAnimName(
                        Model
                    )

                local CurrentAnimIgnored =
                    self:IsIgnoredAnimationName(
                        CurrentAnimName
                    )

                local ObservableSkill =
                    not CurrentAnimIgnored
                    and self:IsObservableSkillActive(
                        Model
                    )
                    or false

                local Offensive =
                    (
                        not CurrentAnimIgnored
                        and CurrentAnimThreat
                    )
                    or ObservableSkill

                local Success,
                    Tracks =
                    pcall(
                        Animator.GetPlayingAnimationTracks,
                        Animator
                    )

                if Success
                    and type(
                        Tracks
                    ) == "table"
                then
                    for _,
                        Track in ipairs(
                            Tracks
                        )
                    do
                        if self:IsAttackTrack(
                            Track,
                            TargetingPlayer,
                            Model
                        ) then
                            Offensive =
                                true

                            break
                        end
                    end
                end

                -- Do NOT block merely because a targeted NPC is close or
                -- facing us. That used to leave Blocking held continuously,
                -- which prevented Combat_Service attacks from doing damage.
                -- NpcsFollowing still improves classification, but an actual
                -- offensive animation / observable skill must be active.
                if Offensive then
                    if Distance
                        < BestDistance
                    then
                        BestDistance =
                            Distance

                        BestModel =
                            Model
                    end
                end
            end
        end
    end

    return BestModel
end


function AutoBlockController:HeartbeatStep()
    if not HubRunning
        or not Settings.AutoBlock
    then
        return
    end

    local Now =
        os.clock()

    if Now
        - self.LastWatcherRefresh
        >= self.WatcherRefreshInterval
    then
        self.LastWatcherRefresh =
            Now

        self:RefreshWatchers()
    end

    local Threat =
        self:FindActiveThreat()

    if Threat then
        self.LastThreatAt =
            Now

        Settings.__AutoBlockThreatActive =
            true

        self.CurrentThreat =
            Threat

        if Now
            - self.LastDebugThreatAt
            >= 0.75
        then
            self.LastDebugThreatAt =
                Now

            local CurrentAnimName =
                self:GetCurrentAnimName(
                    Threat
                )

            HubDebug(
                "[Combat Hub] Auto Block threat: "
                    .. tostring(
                        Threat.Name
                    )
                    .. " [targeting="
                    .. tostring(
                        self:IsNpcAggroedToUs(
                            Threat
                        )
                    )
                    .. ", anim="
                    .. tostring(
                        CurrentAnimName
                    )
                    .. "]"
            )
        end

        self:BeginBlock(
            Threat
        )

        return
    end

    if Now
        - self.LastThreatAt
        >= self.ReleaseGrace
    then
        -- Offensive animation is over. Allow Auto Click / Raid to resume
        -- immediately, then clear the actual Blocking state.
        Settings.__AutoBlockThreatActive =
            false

        if self.BlockingRequested
            or self:IsServerBlocking()
        then
            self:EndBlock(
                false
            )
        end
    end
end


function AutoBlockController:Start()
    self.LoopID += 1

    Settings.AutoBlock =
        true

    Settings.__AutoBlockThreatActive =
        false

    self.LastThreatAt =
        0

    self.LastHoldAt =
        0

    self.LastReleaseAt =
        0

    self.LastWatcherRefresh =
        0

    self.LastDebugThreatAt =
        0

    self:RefreshWatchers()

    if self.HeartbeatConnection then
        self.HeartbeatConnection:Disconnect()
        self.HeartbeatConnection =
            nil
    end

    self.HeartbeatConnection =
        RunService.Heartbeat:Connect(
            function()
                local Success,
                    ErrorMessage =
                    pcall(function()
                        self:HeartbeatStep()
                    end)

                if not Success then
                    warn(
                        "[Combat Hub] Auto Block recovered: "
                            .. tostring(
                                ErrorMessage
                            )
                    )
                end
            end
        )
end


function AutoBlockController:Stop()
    Settings.AutoBlock =
        false

    Settings.__AutoBlockThreatActive =
        false

    self.LoopID += 1

    if self.HeartbeatConnection then
        self.HeartbeatConnection:Disconnect()
        self.HeartbeatConnection =
            nil
    end

    self:EndBlock(
        true
    )

    for Model,
        Info in pairs(
            self.NpcAnimStateWatchers
        )
    do
        if Info.Connection then
            Info.Connection:Disconnect()
        end

        self.NpcAnimStateWatchers[
            Model
        ] =
            nil

        self.RecentAnimThreatUntil[
            Model
        ] =
            nil
    end

    for Animator,
        Info in pairs(
            self.Watchers
        )
    do
        if Info.Connection then
            Info.Connection:Disconnect()
        end

        self.Watchers[
            Animator
        ] =
            nil
    end

    self.BlockingRequested =
        false

    self.CurrentThreat =
        nil
end



--// ============================================================
--// AUTO SKILLS
--// ============================================================
--
-- The game's skill HUD listens to:
--   Skills_1st ... Skills_10th
--
-- Mobile uses:
--   InputHandler.VirtualPress("Skills_1st")
--   InputHandler.VirtualRelease("Skills_1st")
--
-- We resolve the user's selected physical keys (Z/X/C/V/B/N/K) back to
-- whichever Skills_* action currently owns that key, then use the exact
-- same virtual press/release pathway.
--
-- Smart skill handling:
--   * Skills_Provider resolves the real skill assigned to each selected key.
--   * Skills_Module.Can_Skill filters cooldown/stamina/aura/mode requirements.
--   * SHC is watched to confirm the skill actually started and finished.
--   * Hold-capable does NOT mean hold-required.
--   * Max_Hold / Holdable / CanHold alone are NOT enough to keep a key held.
--   * Skills are tapped once by default.
--   * Only explicit continuous/channel/repeat-while-held metadata is held.
--   * SHC is still watched AFTER release so taps do not overlap incorrectly.
--   * Round-robin skips unavailable/cooldown skills and advances immediately.

local AutoSkillController = {
    Running = false,
    LoopID = 0,

    ActionNames = {
        "Skills_1st",
        "Skills_2nd",
        "Skills_3rd",
        "Skills_4th",
        "Skills_5th",
        "Skills_6th",
        "Skills_7th",
        "Skills_8th",
        "Skills_9th",
        "Skills_10th",
    },

    KeyOrder = {
        "Z",
        "X",
        "C",
        "V",
        "B",
        "N",
        "K",
    },

    InputHandler = nil,
    SkillsProvider = nil,
    SkillsModule = nil,
    SkillController = nil,
    ManageCooldown = nil,

    LastAttempt = {},
    RetryDelay = 0.30,

    -- Smart timing values.
    --
    -- IMPORTANT:
    -- Non-hold skills are TAP-RELEASED immediately. SHC staying active after
    -- the tap only means the skill is still executing; it does NOT mean the
    -- physical key should remain held.
    SkillStartTimeout = 0.40,
    NaturalSkillTimeout = 3.50,
    HoldSafetyMargin = 0.25,
    TapReleaseDelay = 0.055,
    TapTransitionTimeout = 0.45,

    -- Round-robin cursor. After one selected skill successfully casts,
    -- the next pass starts from the following selected key instead of
    -- always restarting at Z.
    CycleCursor = 1,

    NearbyScanAt = 0,
    NearbyScanResult = false,
    NearbyScanInterval = 0.20,
    NearbyRange = 45,

    -- Only use this for a skill proven to BENEFIT from continuous holding
    -- (for example, repeating/ticking attacks while the button stays down).
    -- A skill merely supporting hold input is NOT enough.
    ForceHoldSkills = {
    },
}


function AutoSkillController:LoadModules()
    if self.InputHandler
        and self.SkillsProvider
    then
        return true
    end

    local CAM =
        ReplicatedStorage:FindFirstChild(
            "CAM"
        )

    if not CAM then
        return false
    end

    local Client =
        CAM:FindFirstChild(
            "Client"
        )

    local Components =
        Client
        and Client:FindFirstChild(
            "Components"
        )

    local ClientComponents =
        Components
        and Components:FindFirstChild(
            "Client"
        )

    local InputHandlerModule =
        ClientComponents
        and ClientComponents:FindFirstChild(
            "InputHandler"
        )

    local Controllers =
        Client
        and Client:FindFirstChild(
            "Controllers"
        )

    local SkillsProviderModule =
        Controllers
        and Controllers:FindFirstChild(
            "Skills_Provider"
        )

    local SkillControllerModule =
        Controllers
        and Controllers:FindFirstChild(
            "Skill_Controller"
        )

    local Global =
        CAM:FindFirstChild(
            "Global"
        )

    local SkillsModuleScript =
        Global
        and Global:FindFirstChild(
            "Skills_Module"
        )

    local Subsets =
        Global
        and Global:FindFirstChild(
            "Subsets"
        )

    local Gameplay =
        Subsets
        and Subsets:FindFirstChild(
            "Gameplay"
        )

    local ManageCooldownModule =
        Gameplay
        and Gameplay:FindFirstChild(
            "manage_cd"
        )

    if not InputHandlerModule
        or not SkillsProviderModule
    then
        return false
    end

    local InputOk,
        InputResult =
        pcall(
            require,
            InputHandlerModule
        )

    local ProviderOk,
        ProviderResult =
        pcall(
            require,
            SkillsProviderModule
        )

    if not InputOk
        or type(
            InputResult
        ) ~= "table"
        or not ProviderOk
        or type(
            ProviderResult
        ) ~= "table"
    then
        return false
    end

    self.InputHandler =
        InputResult

    self.SkillsProvider =
        ProviderResult

    if SkillsModuleScript then
        local SkillsOk,
            SkillsResult =
            pcall(
                require,
                SkillsModuleScript
            )

        if SkillsOk
            and type(
                SkillsResult
            ) == "table"
        then
            self.SkillsModule =
                SkillsResult
        end
    end

    if SkillControllerModule then
        local ControllerOk,
            ControllerResult =
            pcall(
                require,
                SkillControllerModule
            )

        if ControllerOk
            and type(
                ControllerResult
            ) == "table"
        then
            self.SkillController =
                ControllerResult
        end
    end

    if ManageCooldownModule then
        local CooldownOk,
            CooldownResult =
            pcall(
                require,
                ManageCooldownModule
            )

        if CooldownOk
            and type(
                CooldownResult
            ) == "table"
        then
            self.ManageCooldown =
                CooldownResult
        end
    end

    return true
end


function AutoSkillController:GetSelectedKeySet()
    local Result =
        {}

    local Selected =
        Settings.AutoSkillKeys

    if type(
        Selected
    ) == "string"
    then
        Result[
            string.upper(
                Selected
            )
        ] =
            true

        return Result
    end

    if type(
        Selected
    ) ~= "table"
    then
        return Result
    end

    for _,
        KeyName in ipairs(
            Selected
        )
    do
        if type(
            KeyName
        ) == "string"
        then
            Result[
                string.upper(
                    KeyName
                )
            ] =
                true
        end
    end

    return Result
end


function AutoSkillController:GetSelectedKeyList()
    local SelectedSet =
        self:GetSelectedKeySet()

    local Result =
        {}

    for _,
        KeyName in ipairs(
            self.KeyOrder
        )
    do
        if SelectedSet[
            KeyName
        ] then
            table.insert(
                Result,
                KeyName
            )
        end
    end

    return Result
end


function AutoSkillController:ValueContainsKey(
    Value,
    TargetKey,
    Depth
)
    Depth =
        Depth
        or 0

    if Depth > 4 then
        return false
    end

    local ValueType =
        typeof(
            Value
        )

    if ValueType
        == "EnumItem"
    then
        return Value
            == TargetKey
    end

    if ValueType
        == "string"
    then
        return string.upper(
            Value
        )
            == string.upper(
                TargetKey.Name
            )
    end

    if ValueType
        ~= "table"
    then
        return false
    end

    for Key,
        Nested in pairs(
            Value
        )
    do
        if self:ValueContainsKey(
            Key,
            TargetKey,
            Depth + 1
        )
            or self:ValueContainsKey(
                Nested,
                TargetKey,
                Depth + 1
            )
        then
            return true
        end
    end

    return false
end


function AutoSkillController:GetActionForKey(
    KeyName
)
    if not self:LoadModules() then
        return nil,
            nil
    end

    local TargetKey =
        Enum.KeyCode[
            KeyName
        ]

    if not TargetKey then
        return nil,
            nil
    end

    if type(
        self.InputHandler.GetMapping
    ) ~= "function"
    then
        return nil,
            nil
    end

    for Index,
        ActionName in ipairs(
            self.ActionNames
        )
    do
        local Success,
            Mapping =
            pcall(
                self.InputHandler.GetMapping,
                ActionName
            )

        if Success
            and type(
                Mapping
            ) == "table"
        then
            for _,
                Entry in pairs(
                    Mapping
                )
            do
                if self:ValueContainsKey(
                    Entry,
                    TargetKey
                )
                then
                    return ActionName,
                        Index
                end
            end
        end
    end

    return nil,
        nil
end


function AutoSkillController:GetSkillAtIndex(
    Index
)
    if not self:LoadModules()
        or type(
            self.SkillsProvider.get_current_keys
        ) ~= "function"
    then
        return nil
    end

    local Success,
        Skills =
        pcall(
            self.SkillsProvider.get_current_keys
        )

    if not Success
        or type(
            Skills
        ) ~= "table"
    then
        return nil
    end

    local Skill =
        Skills[
            Index
        ]

    if type(
        Skill
    ) == "string"
    then
        return {
            Name = Skill,
        }
    end

    if type(
        Skill
    ) ~= "table"
    then
        return nil
    end

    return Skill
end


function AutoSkillController:GetTargetRoot(
    Model
)
    if not Model
        or not Model.Parent
    then
        return nil
    end

    return Model:FindFirstChild(
        "HumanoidRootPart"
    )
        or Model.PrimaryPart
        or Model:FindFirstChild(
            "UpperTorso"
        )
        or Model:FindFirstChild(
            "Torso"
        )
end


function AutoSkillController:HasNearbyCombatTarget()
    local Now =
        os.clock()

    if Now
        - self.NearbyScanAt
        < self.NearbyScanInterval
    then
        return self.NearbyScanResult
    end

    self.NearbyScanAt =
        Now

    local Character =
        LocalPlayer.Character

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    local Humanoid =
        Character
        and Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not Root
        or not Humanoid
        or Humanoid.Health <= 0
    then
        self.NearbyScanResult =
            false

        return false
    end

    -- Prefer the target already owned by Auto Farm / Raid / Dungeon.
    local Locked =
        QuestFarmController
        and QuestFarmController.LockTarget

    if Locked
        and Locked.Parent
    then
        local LockedHumanoid =
            Locked:FindFirstChildOfClass(
                "Humanoid"
            )

        local LockedRoot =
            self:GetTargetRoot(
                Locked
            )

        if LockedHumanoid
            and LockedHumanoid.Health > 0
            and LockedRoot
            and (
                LockedRoot.Position
                - Root.Position
            ).Magnitude
                <= self.NearbyRange
        then
            self.NearbyScanResult =
                true

            return true
        end
    end

    local HumanoidsFolder =
        workspace:FindFirstChild(
            "Humanoids"
        )

    if not HumanoidsFolder then
        self.NearbyScanResult =
            false

        return false
    end

    for _,
        EnemyHumanoid in ipairs(
            HumanoidsFolder:GetDescendants()
        )
    do
        if EnemyHumanoid:IsA(
            "Humanoid"
        )
            and EnemyHumanoid.Health > 0
        then
            local Model =
                EnemyHumanoid.Parent

            if Model
                and Model:IsA(
                    "Model"
                )
                and Model ~= Character
                and not Players:GetPlayerFromCharacter(
                    Model
                )
            then
                local ActiveNpcs =
                    Model:FindFirstAncestor(
                        "ActiveNpcs"
                    )

                if ActiveNpcs then
                    local EnemyRoot =
                        self:GetTargetRoot(
                            Model
                        )

                    if EnemyRoot
                        and (
                            EnemyRoot.Position
                            - Root.Position
                        ).Magnitude
                            <= self.NearbyRange
                    then
                        self.NearbyScanResult =
                            true

                        return true
                    end
                end
            end
        end
    end

    self.NearbyScanResult =
        false

    return false
end


function AutoSkillController:GetSkillState()
    local Character =
        LocalPlayer.Character

    if not Character then
        return nil
    end

    return Character:FindFirstChild(
        "SHC"
    )
        or Character:FindFirstChild(
            "SHCS"
        )
end


function AutoSkillController:GetCurrentSkillName()
    local SHC =
        self:GetSkillState()

    if SHC
        and SHC:IsA(
            "ValueBase"
        )
    then
        local Value =
            tostring(
                SHC.Value
                or ""
            )

        if Value ~= "" then
            return Value
        end
    end

    return nil
end


function AutoSkillController:IsCharacterAlive()
    local Character =
        LocalPlayer.Character

    local Humanoid =
        Character
        and Character:FindFirstChildOfClass(
            "Humanoid"
        )

    return Character ~= nil
        and Humanoid ~= nil
        and Humanoid.Health > 0
end


function AutoSkillController:IsCharacterReady()
    if not self:IsCharacterAlive() then
        return false
    end

    -- Keep Auto Skills sequential. A new skill is not started while SHC says
    -- another skill is still active. This prevents a later selected key from
    -- cancelling a charged / wind-up skill early.
    return self:GetCurrentSkillName()
        == nil
end


function AutoSkillController:GetFilteredCooldownName(
    SkillName
)
    if self.ManageCooldown
        and type(
            self.ManageCooldown.filter_cd_name
        ) == "function"
    then
        local Success,
            Result =
            pcall(
                self.ManageCooldown.filter_cd_name,
                LocalPlayer,
                SkillName
            )

        if Success
            and type(
                Result
            ) == "string"
            and Result ~= ""
        then
            return Result
        end
    end

    return SkillName
end


function AutoSkillController:GetCooldownObject(
    SkillName
)
    local SHC =
        self:GetSkillState()

    if not SHC then
        return nil
    end

    local CooldownName =
        self:GetFilteredCooldownName(
            SkillName
        )

    return SHC:FindFirstChild(
        CooldownName
    )
        or SHC:FindFirstChild(
            SkillName
        )
end


function AutoSkillController:IsCooldownActive(
    SkillName
)
    local Cooldown =
        self:GetCooldownObject(
            SkillName
        )

    if not Cooldown then
        return false
    end

    if Cooldown:IsA(
        "NumberValue"
    )
        or Cooldown:IsA(
            "IntValue"
        )
    then
        local Duration =
            tonumber(
                Cooldown.Value
            )

        local Started =
            tonumber(
                Cooldown:GetAttribute(
                    "Started"
                )
            )

        if Duration
            and Started
        then
            return os.clock()
                - Started
                < Duration
        end
    end

    -- The game's HUD treats the presence of the filtered cooldown child as
    -- cooldown-active, even when no numeric timing can be read client-side.
    return true
end


function AutoSkillController:CanUseSkill(
    SkillName
)
    if not self:IsCharacterReady() then
        return false
    end

    if not SkillName
        or SkillName == ""
    then
        return false
    end

    -- Fast local skip so round-robin immediately advances past cooldowns.
    if self:IsCooldownActive(
        SkillName
    ) then
        return false
    end

    if self.SkillsModule
        and type(
            self.SkillsModule.Can_Skill
        ) == "function"
    then
        local Success,
            Allowed =
            pcall(
                self.SkillsModule.Can_Skill,
                LocalPlayer,
                SkillName
            )

        if Success then
            return Allowed
                == true
        end
    end

    -- If the optional validator could not be loaded, VirtualPress still
    -- passes through the game's real Skill_Controller checks.
    return true
end


function AutoSkillController:GetMaxHold(
    Skill
)
    if type(
        Skill
    ) ~= "table"
    then
        return 0
    end

    local MaxHold =
        tonumber(
            Skill.Max_Hold
            or Skill.MaxHold
            or Skill.Max
        )
        or 0

    if MaxHold <= 0 then
        return 0
    end

    return math.clamp(
        MaxHold,
        0,
        8
    )
end


function AutoSkillController:IsHoldKeyForced(
    KeyName
)
    if type(
        Settings.AutoSkillHoldKeys
    ) ~= "table"
    then
        return false
    end

    if Settings.AutoSkillHoldKeys[
        KeyName
    ] == true
    then
        return true
    end

    for _,
        Value in ipairs(
            Settings.AutoSkillHoldKeys
        )
    do
        if tostring(
            Value
        ) == tostring(
            KeyName
        )
        then
            return true
        end
    end

    return false
end


function AutoSkillController:TableSuggestsHoldDamageBenefit(
    Value,
    Depth,
    Seen
)
    if type(
        Value
    ) ~= "table"
    then
        return false
    end

    Depth =
        tonumber(
            Depth
        )
        or 0

    if Depth > 4 then
        return false
    end

    Seen =
        Seen
        or {}

    if Seen[
        Value
    ] then
        return false
    end

    Seen[
        Value
    ] =
        true

    local HoldEvidence =
        false

    local DamageEvidence =
        false

    local MultiStageEvidence =
        false

    local NumericChildren =
        0

    for Key,
        Child in pairs(
            Value
        )
    do
        local KeyText =
            string.lower(
                tostring(
                    Key
                )
            )

        if string.find(
            KeyText,
            "charge",
            1,
            true
        )
            or string.find(
                KeyText,
                "hold",
                1,
                true
            )
            or string.find(
                KeyText,
                "release",
                1,
                true
            )
            or string.find(
                KeyText,
                "stage",
                1,
                true
            )
        then
            HoldEvidence =
                true
        end

        if string.find(
            KeyText,
            "damage",
            1,
            true
        )
            or string.find(
                KeyText,
                "dmg",
                1,
                true
            )
            or string.find(
                KeyText,
                "hit",
                1,
                true
            )
            or string.find(
                KeyText,
                "multiplier",
                1,
                true
            )
            or string.find(
                KeyText,
                "animation",
                1,
                true
            )
            or string.find(
                KeyText,
                "anim",
                1,
                true
            )
        then
            DamageEvidence =
                true
        end

        if type(
            Key
        ) == "number"
        then
            NumericChildren +=
                1

            if NumericChildren >= 2 then
                MultiStageEvidence =
                    true
            end
        end

        if type(
            Child
        ) == "table"
            and self:TableSuggestsHoldDamageBenefit(
                Child,
                Depth + 1,
                Seen
            )
        then
            return true
        end
    end

    return HoldEvidence
        and (
            DamageEvidence
            or MultiStageEvidence
        )
end


function AutoSkillController:ShouldHoldSkill(
    Skill,
    KeyName
)
    if type(
        Skill
    ) ~= "table"
    then
        return false,
            0
    end

    local MaxHold =
        self:GetMaxHold(
            Skill
        )

    ----------------------------------------------------------
    -- MANUAL PHYSICAL-KEY OVERRIDE
    ----------------------------------------------------------

    if KeyName
        and self:IsHoldKeyForced(
            KeyName
        )
    then
        return true,
            MaxHold
    end

    ----------------------------------------------------------
    -- Strong explicit continuous / repeat metadata.
    ----------------------------------------------------------

    local ContinuousBooleanFields = {
        "Continuous",
        "IsContinuous",
        "Is_Continuous",

        "Channel",
        "Channelled",
        "Channeled",
        "IsChannel",
        "Is_Channel",

        "RepeatWhileHeld",
        "Repeat_While_Held",
        "RepeatsWhileHeld",
        "Repeats_While_Held",

        "AttackWhileHeld",
        "Attack_While_Held",

        "TickWhileHeld",
        "Tick_While_Held",

        "LoopWhileHeld",
        "Loop_While_Held",
    }

    for _,
        Field in ipairs(
            ContinuousBooleanFields
        )
    do
        if Skill[
            Field
        ] == true
        then
            return true,
                MaxHold
        end
    end

    ----------------------------------------------------------
    -- Max_Hold + staged damage/hit/animation metadata.
    --
    -- Max_Hold by itself still does NOT force a hold, because some skills
    -- merely allow holding without gaining anything. But Max_Hold together
    -- with charge/hold stages that contain damage/hit/animation progression
    -- is treated as a real damaging hold skill.
    ----------------------------------------------------------

    if MaxHold > 0
        and self:TableSuggestsHoldDamageBenefit(
            Skill,
            0,
            {}
        )
    then
        return true,
            MaxHold
    end

    ----------------------------------------------------------
    -- String metadata for continuous/channel/repeat modes.
    ----------------------------------------------------------

    local StringFields = {
        "InputType",
        "Input_Type",
        "ActivationType",
        "Activation_Type",
        "CastType",
        "Cast_Type",
        "SkillType",
        "Skill_Type",
        "Type",
        "Mode",
    }

    local ContinuousWords = {
        "continuous",
        "channel",
        "channeled",
        "channelled",
        "repeat",
        "repeating",
        "sustain",
        "sustained",
        "loop",
        "ticking",
    }

    for _,
        Field in ipairs(
            StringFields
        )
    do
        local Value =
            Skill[
                Field
            ]

        if type(
            Value
        ) == "string"
        then
            local Lower =
                string.lower(
                    Value
                )

            for _,
                Word in ipairs(
                    ContinuousWords
                )
            do
                if string.find(
                    Lower,
                    Word,
                    1,
                    true
                )
                then
                    return true,
                        MaxHold
                end
            end
        end
    end

    return false,
        0
end

function AutoSkillController:WaitAfterTap(
    SkillName
)
    local StartedAt =
        os.clock()

    local SawActive =
        false

    while HubRunning
        and Settings.AutoSkills
        and self:IsCharacterAlive()
        and os.clock()
            - StartedAt
            < self.TapTransitionTimeout
    do
        local Current =
            self:GetCurrentSkillName()

        if Current
            == SkillName
        then
            SawActive =
                true
        elseif SawActive then
            return "tap-finished"
        end

        if self:IsCooldownActive(
            SkillName
        )
        then
            return "tap-cooldown"
        end

        task.wait(
            0.01
        )
    end

    return SawActive
        and "tap-active"
        or "tap"
end


function AutoSkillController:WaitForSkillStart(
    SkillName,
    Timeout,
    AllowCooldownShortcut
)
    local StartedAt =
        os.clock()

    Timeout =
        tonumber(
            Timeout
        )
        or self.SkillStartTimeout

    while HubRunning
        and Settings.AutoSkills
        and self:IsCharacterAlive()
        and os.clock()
            - StartedAt
            < Timeout
    do
        local SHC =
            self:GetSkillState()

        if SHC
            and SHC:IsA(
                "ValueBase"
            )
            and tostring(
                SHC.Value
                or ""
            )
                == SkillName
        then
            return SHC,
                true
        end

        -- Very quick / non-charge skills can enter cooldown before our
        -- polling loop observes SHC.Value. Hold-capable skills deliberately
        -- do NOT use this shortcut because they need a confirmed active SHC
        -- state before we start measuring their charge timer.
        if AllowCooldownShortcut
            and self:IsCooldownActive(
                SkillName
            )
        then
            return SHC,
                true
        end

        task.wait(
            0.01
        )
    end

    return self:GetSkillState(),
        false
end


function AutoSkillController:GetObservedHoldElapsed(
    SHC,
    FallbackStartedAt
)
    if SHC then
        local LastPerformed =
            tonumber(
                SHC:GetAttribute(
                    "last_performed"
                )
            )

        if LastPerformed then
            return math.max(
                0,
                os.clock()
                    - LastPerformed
            )
        end
    end

    return math.max(
        0,
        os.clock()
            - FallbackStartedAt
    )
end


function AutoSkillController:WaitChargedSkill(
    SkillName,
    MaxHold,
    SHC
)
    local ObservedAt =
        os.clock()

    -- This mirrors the game's own HUD/replay logic, which considers a held
    -- skill effectively complete at Max_Hold - 0.25 seconds.
    local ReleaseAt =
        math.max(
            0.08,
            MaxHold
                - self.HoldSafetyMargin
        )

    while HubRunning
        and Settings.AutoSkills
        and self:IsCharacterAlive()
    do
        SHC =
            self:GetSkillState()
            or SHC

        local Current =
            SHC
            and SHC:IsA(
                "ValueBase"
            )
            and tostring(
                SHC.Value
                or ""
            )
            or ""

        if Current ~= ""
            and Current ~= SkillName
        then
            break
        end

        local Elapsed =
            self:GetObservedHoldElapsed(
                SHC,
                ObservedAt
            )

        if Elapsed
            >= ReleaseAt
        then
            return Elapsed,
                "max-hold"
        end

        -- If the skill naturally finishes before the declared maximum, do
        -- not keep holding a dead input.
        if Current == ""
            and Elapsed > 0.08
        then
            return Elapsed,
                "finished-early"
        end

        if Elapsed
            >= math.max(
                MaxHold + 0.75,
                self.NaturalSkillTimeout
            )
        then
            return Elapsed,
                "timeout"
        end

        task.wait(
            0.01
        )
    end

    return self:GetObservedHoldElapsed(
        SHC,
        ObservedAt
    ),
        "interrupted"
end


function AutoSkillController:WaitNaturalSkill(
    SkillName,
    SHC
)
    local StartedAt =
        os.clock()

    local SawActive =
        false

    while HubRunning
        and Settings.AutoSkills
        and self:IsCharacterAlive()
        and os.clock()
            - StartedAt
            < self.NaturalSkillTimeout
    do
        SHC =
            self:GetSkillState()
            or SHC

        local Current =
            SHC
            and SHC:IsA(
                "ValueBase"
            )
            and tostring(
                SHC.Value
                or ""
            )
            or ""

        if Current == SkillName then
            SawActive =
                true
        elseif SawActive then
            -- The skill's own Hold()/wind-up has finished. This is important
            -- for skills that have an internal WINDUP but no Max_Hold value.
            return os.clock()
                - StartedAt,
                "natural-finish"
        elseif self:IsCooldownActive(
            SkillName
        ) then
            return os.clock()
                - StartedAt,
                "cooldown-started"
        end

        task.wait(
            0.01
        )
    end

    -- If SHC never became active after a valid press, treat it like a normal
    -- tap rather than hanging on the key indefinitely.
    return math.min(
        os.clock()
            - StartedAt,
        self.TapReleaseDelay
    ),
        SawActive
            and "natural-timeout"
            or "tap"
end


function AutoSkillController:UseSelectedKey(
    KeyName
)
    if not self:LoadModules()
        or not self:IsCharacterReady()
    then
        return false
    end

    local LastAttempt =
        self.LastAttempt[
            KeyName
        ]
        or 0

    if os.clock()
        - LastAttempt
        < self.RetryDelay
    then
        return false
    end

    local ActionName,
        Index =
        self:GetActionForKey(
            KeyName
        )

    if not ActionName
        or not Index
    then
        return false
    end

    local Skill =
        self:GetSkillAtIndex(
            Index
        )

    local SkillName =
        type(
            Skill
        ) == "table"
        and Skill.Name
        or nil

    if not SkillName
        or SkillName == ""
        or not self:CanUseSkill(
            SkillName
        )
    then
        return false
    end

    self.LastAttempt[
        KeyName
    ] =
        os.clock()

    local ShouldHold,
        MaxHold =
        self:ShouldHoldSkill(
            Skill,
            KeyName
        )

    ----------------------------------------------------------
    -- TAP SKILL
    --
    -- Normal skills should never remain physically held just because SHC
    -- stays active while their animation/effect runs.
    ----------------------------------------------------------

    if not ShouldHold then
        local PressOk =
            pcall(
                self.InputHandler.VirtualPress,
                ActionName
            )

        if not PressOk then
            return false
        end

        task.wait(
            self.TapReleaseDelay
        )

        pcall(
            self.InputHandler.VirtualRelease,
            ActionName
        )

        local FinishReason =
            self:WaitAfterTap(
                SkillName
            )

        HubDebug(
            "[Combat Hub] Auto Skills: "
                .. tostring(
                    KeyName
                )
                .. " → "
                .. tostring(
                    SkillName
                )
                .. " | "
                .. tostring(
                    FinishReason
                )
        )

        task.wait(
            0.035
        )

        return true
    end

    ----------------------------------------------------------
    -- CONFIRMED CONTINUOUS / REPEAT-WHILE-HELD SKILL
    ----------------------------------------------------------

    if self.SkillController
        and MaxHold > 0
    then
        pcall(function()
            self.SkillController.CurrentMax =
                MaxHold
        end)
    end

    local PressOk =
        pcall(
            self.InputHandler.VirtualPress,
            ActionName
        )

    if not PressOk then
        return false
    end

    local SHC,
        Started =
        self:WaitForSkillStart(
            SkillName,
            self.SkillStartTimeout,
            false
        )

    local HeldFor =
        0

    local FinishReason =
        "hold-start-not-observed"

    if Started
        and MaxHold > 0
    then
        HeldFor,
            FinishReason =
            self:WaitChargedSkill(
                SkillName,
                MaxHold,
                SHC
            )

    elseif Started then
        -- Confirmed continuous metadata without a Max_Hold value:
        -- keep the input down only while the game's active skill state says
        -- the continuous skill is still executing.
        HeldFor,
            FinishReason =
            self:WaitNaturalSkill(
                SkillName,
                SHC
            )

    else
        task.wait(
            self.TapReleaseDelay
        )

        HeldFor =
            self.TapReleaseDelay
    end

    pcall(
        self.InputHandler.VirtualRelease,
        ActionName
    )

    local TransitionStarted =
        os.clock()

    while HubRunning
        and Settings.AutoSkills
        and self:GetCurrentSkillName()
            == SkillName
        and os.clock()
            - TransitionStarted
            < 0.35
    do
        task.wait(
            0.01
        )
    end

    HubDebug(
        "[Combat Hub] Auto Skills: "
            .. tostring(
                KeyName
            )
            .. " → "
            .. tostring(
                SkillName
            )
            .. " | "
            .. tostring(
                FinishReason
            )
            .. (
                HeldFor > 0.12
                and (
                    " | "
                    .. string.format(
                        "%.2fs",
                        HeldFor
                    )
                )
                or ""
            )
    )

    task.wait(
        0.05
    )

    return true
end

function AutoSkillController:Step()
    if not HubRunning
        or not Settings.AutoSkills
    then
        return
    end

    local SelectedKeys =
        self:GetSelectedKeyList()

    local Count =
        #SelectedKeys

    if Count <= 0 then
        self.CycleCursor =
            1

        return
    end

    if not self:HasNearbyCombatTarget() then
        return
    end

    if self.CycleCursor < 1
        or self.CycleCursor > Count
    then
        self.CycleCursor =
            1
    end

    local StartIndex =
        self.CycleCursor

    -- Try every selected key exactly once this pass.
    --
    -- CanUseSkill() rejects cooldown / stamina / mode / aura / disabled
    -- skills, so an unavailable skill is skipped immediately and the loop
    -- keeps moving to the next selected key.
    for Offset = 0,
        Count - 1
    do
        local Index =
            (
                (
                    StartIndex
                    - 1
                    + Offset
                )
                % Count
            )
            + 1

        local KeyName =
            SelectedKeys[
                Index
            ]

        if self:UseSelectedKey(
            KeyName
        ) then
            -- Next successful pass begins AFTER the skill we just used.
            self.CycleCursor =
                (
                    Index
                    % Count
                )
                + 1

            return
        end
    end
end


function AutoSkillController:Start()
    if self.Running then
        Settings.AutoSkills =
            true

        return
    end

    Settings.AutoSkills =
        true

    self.Running =
        true

    self.LoopID +=
        1

    self.LastAttempt =
        {}

    self.CycleCursor =
        1

    self.NearbyScanAt =
        0

    self.NearbyScanResult =
        false

    local MyLoopID =
        self.LoopID

    task.spawn(function()
        while HubRunning
            and Settings.AutoSkills
            and self.Running
            and MyLoopID
                == self.LoopID
        do
            self:Step()

            task.wait(
                0.08
            )
        end
    end)
end


function AutoSkillController:Stop()
    Settings.AutoSkills =
        false

    self.Running =
        false

    self.LoopID +=
        1

    self.CycleCursor =
        1

    if self.SkillController then
        pcall(function()
            self.SkillController.CurrentMax =
                nil
        end)
    end

    if self.InputHandler
        and type(
            self.InputHandler.VirtualRelease
        ) == "function"
    then
        for _,
            ActionName in ipairs(
                self.ActionNames
            )
        do
            pcall(
                self.InputHandler.VirtualRelease,
                ActionName
            )
        end
    end
end



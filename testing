local function TweenToEgg(WantedLuck)
    local Egg, Prompt = FindEggByLuck(WantedLuck)

    if not Egg then
        return false, "No " .. tostring(WantedLuck) .. " egg is currently rendered."
    end

    local Target = GetEggTarget(Egg, Prompt)

    if not Target then
        return false, "Egg found, but no usable BasePart was found."
    end

    Log("Tweening to " .. tostring(WantedLuck) .. " egg")

    local Success = TweenToCFrame(
        Target.CFrame * CFrame.new(
            0,
            Settings.EggOffsetY,
            Settings.EggOffsetZ
        ),
        function()
            -- Manual "Tween To Egg" still works when Auto Pickup is off.
            -- During an auto-pickup sequence, turning Auto Pickup off
            -- cancels this movement immediately.
            return (not IsPickingUp) or Settings.AutoPickup
        end
    )

    if not Success then
        return false, "Tween to egg was interrupted."
    end

    return true, Egg, Prompt
end

local function TweenToSelectedEgg()
    local Egg, Prompt, MatchedLuck = FindEggBySelectedLucks()

    if not Egg then
        return false, "None of the selected luck eggs are currently rendered."
    end

    local Target = GetEggTarget(Egg, Prompt)

    if not Target then
        return false, "Egg found, but no usable BasePart was found."
    end

    Log("Tweening to " .. tostring(MatchedLuck) .. " egg")

    local Success = TweenToCFrame(
        Target.CFrame * CFrame.new(
            0,
            Settings.EggOffsetY,
            Settings.EggOffsetZ
        ),
        function()
            return (not IsPickingUp) or Settings.AutoPickup
        end
    )

    if not Success then
        return false, "Tween to egg was interrupted."
    end

    return true, Egg, Prompt, MatchedLuck
end



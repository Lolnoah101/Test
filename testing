local function SendClick()
    if not HubRunning then
        return
    end

    local UUIDs =
        GetInRangeEnemyUUIDs()

    -- Keep combat/energy clicks on their own fast packet.
    -- This runs every Heartbeat so the wall packet cannot slow combat clicks.
    DataRemoteEvent:FireServer({
        {
            "ClickSystem",
            "Execute",
            UUIDs,
            n = 3,
        },
        "\x02",
    })
end


local function GetCurrentWallMapCode()
    local Character =
        LocalPlayer.Character

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    local MapFolder =
        Workspace:FindFirstChild(
            "_MAP"
        )

    if not Root
        or not MapFolder
    then
        return nil
    end

    -- Only use wall codes we have verified.
    for _, MapCode in ipairs({
        "DBZ",
        "AOT",
        "Nanatsu",
    }) do
        local Area =
            MapFolder:FindFirstChild(
                MapCode
            )

        local Zone =
            Area
            and Area:FindFirstChild(
                "Zone"
            )

        if Zone
            and Zone:IsA("BasePart")
        then
            local LocalPosition =
                Zone.CFrame:PointToObjectSpace(
                    Root.Position
                )

            local HalfSize =
                Zone.Size * 0.5

            if math.abs(LocalPosition.X)
                    <= HalfSize.X
                and math.abs(LocalPosition.Y)
                    <= HalfSize.Y
                and math.abs(LocalPosition.Z)
                    <= HalfSize.Z
            then
                return MapCode
            end
        end
    end

    return nil
end


local function SendWallClick()
    if not HubRunning then
        return
    end

    local MapCode =
        GetCurrentWallMapCode()

    if not MapCode then
        return
    end

    DataRemoteEvent:FireServer({
        {
            "WallSystem",
            "Click",
            MapCode,
            n = 3,
        },
        "\x02",
    })
end


-- Desktop can use every Heartbeat. On mobile, throttle to about
-- 25 requests/sec so FPS drops/network scheduler stalls do not cascade
-- into the rest of the automation.
do
    local LastAutoClickAt = 0

    AutoClickConnection =
        RunService.Heartbeat:Connect(function()
            if not HubRunning
                or not Settings.AutoClick
            then
                return
            end

            if DeviceTiming.AutoClick > 0 then
                local Now =
                    os.clock()

                if Now - LastAutoClickAt
                    < DeviceTiming.AutoClick
                then
                    return
                end

                LastAutoClickAt =
                    Now
            end

            local Success, ErrorMessage =
                pcall(SendClick)

            if not Success then
                warn(
                    "[Energy Hub] Auto Click: "
                        .. tostring(ErrorMessage)
                )
            end
        end)
end


-- Wall clicks use the SAME Auto Click toggle, but run separately.
-- Keeping them out of the combat packet prevents the extra WallSystem
-- request from reducing the responsiveness of enemy/energy clicks.
task.spawn(function()
    while HubRunning do
        if Settings.AutoClick then
            local Success, ErrorMessage =
                pcall(SendWallClick)

            if not Success then
                warn(
                    "[Energy Hub] Wall Click: "
                        .. tostring(ErrorMessage)
                )
            end

            task.wait(
                DeviceTiming.WallClick
            )
        else
            task.wait(
                DeviceTiming.FastPoll
            )
        end
    end
end)

local function NormalizeNameSelection(Value)
    local Result = {}

    if typeof(Value) == "table" then
        for Key, Entry in pairs(Value) do
            if typeof(Key) == "string"
                and Entry == true
            then
                Result[Key] = true

            elseif typeof(Entry) == "string" then
                Result[Entry] = true
            end
        end

    elseif typeof(Value) == "string" then
        Result[Value] = true
    end

    return Result
end



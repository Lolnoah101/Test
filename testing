function QuestController:SetStatus(
    Status,
    Detail
)
    local Key =
        tostring(
            Status
            or ""
        )
        .. "|"
        .. tostring(
            Detail
            or ""
        )

    if self.LastStatusKey
        == Key
    then
        return
    end

    self.LastStatusKey =
        Key

    if self.StateChanged then
        self.StateChanged:Fire(
            Status,
            Detail
        )
    end

    HubDebug(
        "[Combat Hub] Quest: "
            .. tostring(
                Status
                or "Unknown"
            )
            .. (
                Detail
                and (
                    " | "
                    .. tostring(
                        Detail
                    )
                )
                or ""
            )
    )
end


function QuestController:DisconnectQuestWatchers()
    for _, Connection in ipairs(
        self.WatchConnections
    ) do
        if Connection
            and typeof(Connection)
                == "RBXScriptConnection"
        then
            Connection:Disconnect()
        end
    end

    table.clear(
        self.WatchConnections
    )
end


function QuestController:AddQuestWatch(
    Signal,
    Callback
)
    if not Signal
        or type(Callback) ~= "function"
    then
        return
    end

    table.insert(
        self.WatchConnections,
        Signal:Connect(
            Callback
        )
    )
end


function QuestController:ScheduleProcess(
    Reason,
    DelaySeconds
)
    if not HubRunning
        or not Settings.AutoQuest
    then
        return
    end

    local Delay =
        tonumber(
            DelaySeconds
        )
        or 0

    if Delay > 0 then
        task.delay(
            Delay,
            function()
                if HubRunning
                    and Settings.AutoQuest
                then
                    self:ProcessSelectedQuest(
                        Reason
                    )
                end
            end
        )

        return
    end

    if self.RefreshScheduled then
        return
    end

    self.RefreshScheduled =
        true

    task.defer(function()
        self.RefreshScheduled =
            false

        if HubRunning
            and Settings.AutoQuest
        then
            self:ProcessSelectedQuest(
                Reason
            )
        end
    end)
end


function QuestController:BindQuestWatchers()
    self:DisconnectQuestWatchers()

    local Holder =
        self:GetQuestHolder()

    if not Holder then
        return false
    end

    local function RebindAndProcess(
        Reason
    )
        task.defer(function()
            if not HubRunning
                or not Settings.AutoQuest
            then
                return
            end

            self:BindQuestWatchers()
            self:ScheduleProcess(
                Reason
            )
        end)
    end

    self:AddQuestWatch(
        Holder.ChildAdded,
        function(Quest)
            RebindAndProcess(
                "quest added: "
                    .. tostring(
                        Quest.Name
                    )
            )
        end
    )

    self:AddQuestWatch(
        Holder.ChildRemoved,
        function(Quest)
            RebindAndProcess(
                "quest removed: "
                    .. tostring(
                        Quest.Name
                    )
            )
        end
    )

    for _, Quest in ipairs(
        Holder:GetChildren()
    ) do
        local QuestString =
            Quest:FindFirstChild(
                "QuestString"
            )

        if QuestString
            and QuestString:IsA(
                "StringValue"
            )
        then
            self:AddQuestWatch(
                QuestString.Changed,
                function()
                    self:ScheduleProcess(
                        "QuestString changed"
                    )
                end
            )
        end

        local Tasks =
            Quest:FindFirstChild(
                "Tasks"
            )

        if Tasks then
            self:AddQuestWatch(
                Tasks.ChildAdded,
                function(Task)
                    RebindAndProcess(
                        "task added: "
                            .. tostring(
                                Task.Name
                            )
                    )
                end
            )

            self:AddQuestWatch(
                Tasks.ChildRemoved,
                function(Task)
                    RebindAndProcess(
                        "task removed: "
                            .. tostring(
                                Task.Name
                            )
                    )
                end
            )

            for _, Task in ipairs(
                Tasks:GetChildren()
            ) do
                local function WatchObject(
                    Name
                )
                    local Object =
                        Task:FindFirstChild(
                            Name
                        )

                    if Object then
                        self:AddQuestWatch(
                            Object.Changed,
                            function()
                                self:ScheduleProcess(
                                    tostring(
                                        Task.Name
                                    )
                                        .. "."
                                        .. Name
                                        .. " changed"
                                )
                            end
                        )
                    end
                end

                WatchObject("Value")
                WatchObject("Max")
                WatchObject("Need")

                self:AddQuestWatch(
                    Task.ChildAdded,
                    function()
                        RebindAndProcess(
                            "task data added"
                        )
                    end
                )

                self:AddQuestWatch(
                    Task.ChildRemoved,
                    function()
                        RebindAndProcess(
                            "task data removed"
                        )
                    end
                )
            end
        end
    end

    return true
end


function QuestController:ProcessSelectedQuest(
    Reason
)
    if not HubRunning
        or not Settings.AutoQuest
        or self.ProcessBusy
    then
        return
    end

    self.ProcessBusy =
        true

    local Success,
        ErrorMessage =
        pcall(function()
            local Config =
                self:GetConfig()

            if not Config then
                return
            end

            local Holder =
                self:GetQuestHolder()

            if Holder then
                local Quest =
                    self:FindQuestData(
                        Config
                    )

                if Quest then
                    -- Any live replicated quest cancels pending AddQuest
                    -- acknowledgement retries.
                    self.AcceptRetryToken += 1

                    local Current,
                        Total,
                        Details =
                        self:ReadQuestDataProgress(
                            Quest
                        )

                    if self:IsQuestDataComplete(
                        Quest
                    ) then
                        if not self.CompletionSeenAt then
                            self.CompletionSeenAt =
                                os.clock()
                        end

                        self:SetStatus(
                            "Complete",
                            "waiting for server to remove active quest"
                        )

                        return
                    end

                    self.CompletionSeenAt =
                        nil

                    self.TeleportedForAcceptance =
                        false

                    local ProgressText =
                        Current
                        and Total
                        and (
                            tostring(Current)
                            .. "/"
                            .. tostring(Total)
                        )
                        or "active"

                    local ActiveTask =
                        self:GetActionableQuestTask(
                            Quest
                        )

                    if ActiveTask then
                        ProgressText =
                            ProgressText
                            .. " | "
                            .. tostring(
                                ActiveTask.Name
                            )
                            .. " "
                            .. tostring(
                                ActiveTask.Current
                            )
                            .. "/"
                            .. tostring(
                                ActiveTask.Max
                            )

                        if ActiveTask.Need
                            and ActiveTask.Need ~= ""
                        then
                            ProgressText =
                                ProgressText
                                .. " | need="
                                .. tostring(
                                    ActiveTask.Need
                                )
                        end
                    elseif Details
                        and #Details > 0
                    then
                        ProgressText =
                            ProgressText
                            .. " | waiting for prerequisite/server update"
                    end

                    self:SetStatus(
                        "Active",
                        ProgressText
                    )

                    return
                end

                self.CompletionSeenAt =
                    nil

                self:AcceptSelected()

                return
            end

            -- Compatibility fallback if replicated quest data is missing.
            local Card =
                self:FindQuestCard(
                    Config
                )

            if Card
                and not self:IsComplete(
                    Card,
                    Config
                )
            then
                self.CompletionSeenAt =
                    nil

                self.TeleportedForAcceptance =
                    false

                local Current,
                    Total =
                    self:ReadProgress(
                        Card,
                        Config
                    )

                self:SetStatus(
                    "Active (UI fallback)",
                    Current
                        and Total
                        and (
                            tostring(Current)
                            .. "/"
                            .. tostring(Total)
                        )
                        or nil
                )

                return
            end

            self:AcceptSelected()
        end)

    self.ProcessBusy =
        false

    if not Success then
        self.Busy =
            false

        warn(
            "[Combat Hub] Auto Quest event update recovered: "
                .. tostring(
                    ErrorMessage
                )
                .. (
                    Reason
                    and (
                        " | "
                        .. tostring(Reason)
                    )
                    or ""
                )
        )
    end
end


function QuestController:GetQuestPanel()
    local PlayerGui =
        LocalPlayer:FindFirstChild(
            "PlayerGui"
        )

    local ComponentsHolder =
        PlayerGui
        and PlayerGui:FindFirstChild(
            "ComponentsHolder"
        )

    local LeftCenter =
        ComponentsHolder
        and ComponentsHolder:FindFirstChild(
            "LeftCenterFramesHolder"
        )

    local QuestsFrame =
        LeftCenter
        and LeftCenter:FindFirstChild(
            "zQuestsFrame"
        )

    return QuestsFrame
        and QuestsFrame:FindFirstChild(
            "Panel"
        )
end


function QuestController:GetTitleObject(Card)
    local ATitle =
        Card
        and Card:FindFirstChild(
            "aTitle"
        )

    local Holder =
        ATitle
        and ATitle:FindFirstChild(
            "Holder"
        )

    return Holder
        and Holder:FindFirstChild(
            "Text"
        )
end


function QuestController:GetTitle(Card)
    local Object =
        self:GetTitleObject(
            Card
        )

    if not Object then
        return ""
    end

    local Value =
        Object.ContentText

    if type(Value) ~= "string"
        or Value == ""
    then
        Value = Object.Text
    end

    return tostring(
        Value or ""
    )
end


function QuestController:TitleMatches(
    Title,
    Config
)
    local Lower =
        string.lower(
            tostring(Title or "")
        )

    if Lower == "" then
        return false
    end

    for _, Term in ipairs(
        Config.MatchTerms or {}
    ) do
        if not string.find(
            Lower,
            string.lower(
                tostring(Term)
            ),
            1,
            true
        ) then
            return false
        end
    end

    return true
end


function QuestController:FindQuestCard(
    Config
)
    local Panel =
        self:GetQuestPanel()

    if not Panel then
        return nil
    end

    if Config.PanelName then
        local Exact =
            Panel:FindFirstChild(
                Config.PanelName
            )

        if Exact then
            return Exact
        end
    end

    for _, Card in ipairs(
        Panel:GetChildren()
    ) do
        local Title =
            self:GetTitle(
                Card
            )

        if self:TitleMatches(
            Title,
            Config
        ) then
            return Card
        end
    end

    return nil
end


function QuestController:ReadProgress(
    Card,
    Config
)
    -- Prefer a known task line when available. Some quest titles expose
    -- overall completion like 0/1, while the task itself contains the
    -- actual kill count (for example "Bear Cubs hunted 0/4").
    if Config.TaskName then
        local Tasks =
            Card:FindFirstChild(
                "cTasksHolder"
            )

        local Task =
            Tasks
            and Tasks:FindFirstChild(
                Config.TaskName
            )

        local Holder =
            Task
            and Task:FindFirstChild(
                "Holder"
            )

        local Txt =
            Holder
            and Holder:FindFirstChild(
                "Txt"
            )

        if Txt then
            local TaskText =
                tostring(
                    Txt.ContentText ~= ""
                    and Txt.ContentText
                    or Txt.Text
                    or ""
                )

            local Current, Total =
                TaskText:match(
                    "(%d+)%s*/%s*(%d+)"
                )

            if Current
                and Total
            then
                return tonumber(Current),
                    tonumber(Total),
                    TaskText
            end
        end
    end

    -- Fallback to title progress such as "Hunt the Bears 0/1".
    local Title =
        self:GetTitle(
            Card
        )

    local Current, Total =
        Title:match(
            "(%d+)%s*/%s*(%d+)"
        )

    if Current
        and Total
    then
        return tonumber(Current),
            tonumber(Total),
            Title
    end

    return nil, nil, Title
end


function QuestController:IsComplete(
    Card,
    Config
)
    local Current, Total =
        self:ReadProgress(
            Card,
            Config
        )

    return Current ~= nil
        and Total ~= nil
        and Total > 0
        and Current >= Total
end


function QuestController:GetObjectFromPath(
    Path
)
    if type(Path) ~= "table" then
        return nil
    end

    local Current =
        workspace

    for _, Name in ipairs(
        Path
    ) do
        Current =
            Current
            and Current:FindFirstChild(
                Name
            )

        if not Current then
            return nil
        end
    end

    return Current
end


function QuestController:GetNPCPaths(
    Config
)
    if Config
        and type(Config.NPCPaths)
            == "table"
        and #Config.NPCPaths > 0
    then
        return Config.NPCPaths
    end

    local SinglePath =
        Config
        and Config.NPCPath
        or self.NPCPath

    if SinglePath then
        return {
            SinglePath,
        }
    end

    return {}
end


function QuestController:GetNPC(
    Config
)
    local Paths =
        self:GetNPCPaths(
            Config
        )

    for _, Path in ipairs(
        Paths
    ) do
        local NPC =
            self:GetObjectFromPath(
                Path
            )

        if NPC then
            return NPC,
                Path
        end
    end

    return nil
end


function QuestController:GetObjectCFrame(
    Object
)
    if not Object then
        return nil
    end

    if Object:IsA(
        "BasePart"
    ) then
        return Object.CFrame
    end

    if Object:IsA(
        "Attachment"
    ) then
        return Object.WorldCFrame
    end

    if Object:IsA(
        "Model"
    ) then
        -- Prefer the NPC's actual body/root instead of Model:GetPivot().
        -- Some NPC models have a pivot that is offset from the visible NPC.
        local Part =
            Object:FindFirstChild(
                "HumanoidRootPart",
                true
            )
            or Object.PrimaryPart
            or Object:FindFirstChild(
                "UpperTorso",
                true
            )
            or Object:FindFirstChild(
                "Torso",
                true
            )
            or Object:FindFirstChild(
                "Head",
                true
            )
            or Object:FindFirstChildWhichIsA(
                "BasePart",
                true
            )

        if Part
            and Part:IsA(
                "BasePart"
            )
        then
            return Part.CFrame
        end

        return Object:GetPivot()
    end

    local Part =
        Object:FindFirstChild(
            "HumanoidRootPart",
            true
        )
        or Object:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    return Part
        and Part.CFrame
        or nil
end


function QuestController:GetNPCCacheKey(
    Config
)
    if Config
        and Config.NPCCacheKey
    then
        return tostring(
            Config.NPCCacheKey
        )
    end

    local Paths =
        self:GetNPCPaths(
            Config
        )

    local Path =
        Paths[1]

    if type(Path) == "table"
        and #Path > 0
    then
        return table.concat(
            Path,
            "/"
        )
    end

    return Config
        and tostring(
            Config.Request
            or Config.RegionName
            or "QuestNPC"
        )
        or "QuestNPC"
end


function QuestController:LoadSavedNPCLocations()
    if type(readfile) ~= "function" then
        return
    end

    if type(isfile) == "function"
        and not isfile(
            self.NPCLocationCacheFile
        )
    then
        return
    end

    local Success,
        Encoded =
        pcall(
            readfile,
            self.NPCLocationCacheFile
        )

    if not Success
        or type(Encoded) ~= "string"
        or Encoded == ""
    then
        return
    end

    local DecodeSuccess,
        Decoded =
        pcall(function()
            return HttpService:JSONDecode(
                Encoded
            )
        end)

    if not DecodeSuccess
        or type(Decoded) ~= "table"
    then
        return
    end

    for Key, Value in pairs(
        Decoded
    ) do
        if type(Key) == "string"
            and type(Value) == "table"
            and tonumber(Value.X)
            and tonumber(Value.Y)
            and tonumber(Value.Z)
        then
            self.NPCLocationCache[
                Key
            ] =
                Vector3.new(
                    tonumber(Value.X),
                    tonumber(Value.Y),
                    tonumber(Value.Z)
                )
        end
    end
end


function QuestController:SaveNPCLocations()
    if type(writefile) ~= "function" then
        return
    end

    local Encodable = {}

    for Key, Position in pairs(
        self.NPCLocationCache
    ) do
        if typeof(Position)
            == "Vector3"
        then
            Encodable[Key] = {
                X = Position.X,
                Y = Position.Y,
                Z = Position.Z,
            }
        end
    end

    local EncodeSuccess,
        Encoded =
        pcall(function()
            return HttpService:JSONEncode(
                Encodable
            )
        end)

    if not EncodeSuccess
        or type(Encoded) ~= "string"
    then
        return
    end

    pcall(function()
        local Folder =
            "HollowMoonHub"

        if type(isfolder) == "function"
            and type(makefolder) == "function"
            and not isfolder(
                Folder
            )
        then
            makefolder(
                Folder
            )
        end

        writefile(
            self.NPCLocationCacheFile,
            Encoded
        )
    end)
end


function QuestController:RememberNPCPosition(
    Config,
    NPC
)
    if not NPC
        or not NPC.Parent
    then
        return false
    end

    local Target =
        self:GetObjectCFrame(
            NPC
        )

    if not Target then
        return false
    end

    local Key =
        self:GetNPCCacheKey(
            Config
        )

    local Position =
        Target.Position

    local Previous =
        self.NPCLocationCache[
            Key
        ]

    self.NPCLocationCache[
        Key
    ] =
        Position

    -- Avoid writing the same stationary NPC position every scan.
    if typeof(Previous)
        ~= "Vector3"
        or (
            Previous
            - Position
        ).Magnitude > 1
    then
        self:SaveNPCLocations()
    end

    return true
end


function QuestController:GetCachedNPCPosition(
    Config
)
    local Key =
        self:GetNPCCacheKey(
            Config
        )

    local Position =
        self.NPCLocationCache[
            Key
        ]

    return typeof(Position)
        == "Vector3"
        and Position
        or nil
end


function QuestController:GetRegionFallbackCFrame(
    Config
)
    if not Config
        or not Config.RegionName
    then
        return nil
    end

    local RegionName =
        tostring(
            Config.RegionName
        )

    -- Try any currently replicated object inside the requested region.
    -- This can be enough to get us into streaming distance even when the
    -- stationary NPC itself has not replicated yet.
    local CandidateRegions = {}

    local Debree =
        workspace:FindFirstChild(
            "Debree"
        )

    local DebreeRegions =
        Debree
        and Debree:FindFirstChild(
            "Regions"
        )

    local DebreeRegion =
        DebreeRegions
        and DebreeRegions:FindFirstChild(
            RegionName
        )

    if DebreeRegion then
        table.insert(
            CandidateRegions,
            DebreeRegion
        )
    end

    local Humanoids =
        workspace:FindFirstChild(
            "Humanoids"
        )

    local HumanoidRegions =
        Humanoids
        and Humanoids:FindFirstChild(
            "Regions"
        )

    local HumanoidRegion =
        HumanoidRegions
        and HumanoidRegions:FindFirstChild(
            RegionName
        )

    if HumanoidRegion then
        table.insert(
            CandidateRegions,
            HumanoidRegion
        )
    end

    for _, Region in ipairs(
        CandidateRegions
    ) do
        local Direct =
            self:GetObjectCFrame(
                Region
            )

        if Direct then
            return Direct
        end

        for _, Object in ipairs(
            Region:GetDescendants()
        ) do
            if Object:IsA("BasePart")
                or Object:IsA("Attachment")
                or Object:IsA("Model")
            then
                local Target =
                    self:GetObjectCFrame(
                        Object
                    )

                if Target then
                    return Target
                end
            end
        end
    end

    return nil
end


function QuestController:GetQuestLoadCFrame(
    Config
)
    if not Config then
        return nil,
            nil
    end

    local LoadPosition =
        Config.LoadPosition

    if typeof(LoadPosition)
        == "CFrame"
    then
        return LoadPosition,
            "configured load position"
    end

    if typeof(LoadPosition)
        == "Vector3"
    then
        return CFrame.new(
            LoadPosition
        ),
            "configured load position"
    end

    local CachedPosition =
        self:GetCachedNPCPosition(
            Config
        )

    if CachedPosition then
        return CFrame.new(
            CachedPosition
            + Vector3.new(
                0,
                3,
                0
            )
        ),
            "saved NPC position"
    end

    local RegionCFrame =
        self:GetRegionFallbackCFrame(
            Config
        )

    if RegionCFrame then
        return CFrame.new(
            RegionCFrame.Position
            + Vector3.new(
                0,
                3,
                0
            )
        ),
            "replicated region object"
    end

    return nil,
        nil
end


function QuestController:MoveCharacterToCFrame(
    Destination
)
    if typeof(Destination)
        ~= "CFrame"
    then
        return false,
            "Invalid destination CFrame"
    end

    local Character =
        LocalPlayer.Character

    if not Character then
        return false,
            "Character was not found"
    end

    local Root =
        Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Root then
        return false,
            "HumanoidRootPart was not found"
    end

    -- Auto Farm's Above mode can leave the root anchored while the
    -- quest changes. Release it before taking movement ownership.
    Root.Anchored =
        false

    Root.AssemblyLinearVelocity =
        Vector3.zero

    Root.AssemblyAngularVelocity =
        Vector3.zero

    local Success,
        ErrorMessage =
        pcall(function()
            Character:PivotTo(
                Destination
            )

            Root.CFrame =
                Destination

            -- One very short settle is enough before the replication scan.
            task.wait(0.02)

            if Root.Parent
                and Character.Parent
            then
                Root.AssemblyLinearVelocity =
                    Vector3.zero

                Root.AssemblyAngularVelocity =
                    Vector3.zero

                Root.CFrame =
                    Destination
            end
        end)

    if not Success then
        return false,
            tostring(
                ErrorMessage
            )
    end

    return true
end


function QuestController:RequestStreamingAround(
    Position
)
    if typeof(Position)
        ~= "Vector3"
    then
        return false
    end

    -- RequestStreamAroundAsync can yield. Run it separately so the quest
    -- thread can teleport and start checking for Krue/Tom immediately.
    -- Keep only one streaming request alive at a time so fast scanning
    -- never creates a pile of yielding requests.
    if self.StreamRequestBusy then
        return true
    end

    self.StreamRequestBusy =
        true

    task.spawn(function()
        pcall(function()
            LocalPlayer:RequestStreamAroundAsync(
                Position,
                4
            )
        end)

        self.StreamRequestBusy =
            false
    end)

    return true
end


function QuestController:WaitForQuestNPC(
    Config,
    LoadPosition
)
    local Timeout =
        tonumber(
            self.NPCStreamTimeout
        )
        or 7

    local RetryInterval =
        tonumber(
            self.NPCStreamRetryInterval
        )
        or 0.12

    local StartedAt =
        os.clock()

    local NextStreamRequestAt =
        0

    while HubRunning
        and Settings.AutoQuest
        and os.clock() - StartedAt < Timeout
    do
        -- Check the path first every pass. This makes the final jump happen
        -- almost immediately on the frame Krue/Tom replicates.
        local NPC =
            self:GetNPC(
                Config
            )

        if NPC then
            self:RememberNPCPosition(
                Config,
                NPC
            )

            return NPC
        end

        local Now =
            os.clock()

        if typeof(LoadPosition)
            == "Vector3"
            and Now >= NextStreamRequestAt
        then
            self:RequestStreamingAround(
                LoadPosition
            )

            NextStreamRequestAt =
                Now
                + (
                    tonumber(
                        self.StreamRequestInterval
                    )
                    or 0.15
                )
        end

        task.wait(
            RetryInterval
        )
    end

    return nil
end


function QuestController:TeleportToQuestNPC(
    Config
)
    Config =
        Config
        or self:GetConfig()

    if not Config then
        return false,
            "Quest configuration was not found"
    end

    ----------------------------------------------------------
    -- 1) Try the NPC immediately. If you're already in range,
    --    no stream/load teleport is needed.
    ----------------------------------------------------------

    local NPC =
        self:GetNPC(
            Config
        )

    if NPC then
        self:RememberNPCPosition(
            Config,
            NPC
        )
    end

    ----------------------------------------------------------
    -- 2) If the NPC is streamed out, move to a known point in
    --    that region, wait for replication, then scan again.
    ----------------------------------------------------------

    if not NPC then
        local LoadCFrame,
            LoadSource =
            self:GetQuestLoadCFrame(
                Config
            )

        if not LoadCFrame then
            local Paths =
                self:GetNPCPaths(
                    Config
                )

            local NPCName =
                Paths[1]
                and Paths[1][
                    #Paths[1]
                ]
                or "quest NPC"

            return false,
                tostring(NPCName)
                .. " is streamed out and no saved/configured load position exists yet. "
                .. "Visit that NPC once while the hub is running so its position can be learned."
        end

        HubDebug(
            "[Combat Hub] Auto Quest: loading "
                .. tostring(
                    Config.RegionName
                    or "quest region"
                )
                .. " using "
                .. tostring(
                    LoadSource
                )
        )

        self:RequestStreamingAround(
            LoadCFrame.Position
        )

        local MoveSuccess,
            MoveError =
            self:MoveCharacterToCFrame(
                LoadCFrame
            )

        if not MoveSuccess then
            return false,
                "Quest region load teleport failed: "
                .. tostring(
                    MoveError
                )
        end

        -- Ask for the region again after physically moving there.
        self:RequestStreamingAround(
            LoadCFrame.Position
        )

        NPC =
            self:WaitForQuestNPC(
                Config,
                LoadCFrame.Position
            )

        if not NPC then
            return false,
                "Reached the quest region, but the configured NPC paths did not replicate within "
                .. tostring(
                    self.NPCStreamTimeout
                )
                .. " seconds"
        end
    end

    ----------------------------------------------------------
    -- 3) Tom/Krue is now actually present. Resolve the NPC's
    --    live CFrame and move beside it before AddQuest fires.
    ----------------------------------------------------------

    local Target =
        self:GetObjectCFrame(
            NPC
        )

    if not Target then
        return false,
            "Quest NPC has no usable body/root part"
    end

    self:RememberNPCPosition(
        Config,
        NPC
    )

    local Destination =
        Target
        * CFrame.new(
            0,
            2.5,
            4
        )

    local MoveSuccess,
        MoveError =
        self:MoveCharacterToCFrame(
            Destination
        )

    if not MoveSuccess then
        return false,
            tostring(
                MoveError
            )
    end

    return true
end


-- Load positions learned during earlier sessions/rejoins.
QuestController:LoadSavedNPCLocations()

-- Continuously learn stationary quest-giver positions whenever they are
-- currently replicated. This means simply visiting Tom/Krue once is enough
-- to make future long-distance quest acceptance stream-aware.
task.spawn(function()
    while HubRunning do
        for _, Config in pairs(
            QuestController.Configs
        ) do
            local NPC =
                QuestController:GetNPC(
                    Config
                )

            if NPC then
                QuestController:RememberNPCPosition(
                    Config,
                    NPC
                )
            end
        end

        task.wait(0.20)
    end
end)


function QuestController:AcceptSelected()
    if not HubRunning
        or not Settings.AutoQuest
        or self.Busy
        or Settings.__LootFarmBusy
        or Settings.__AutoSellBusy
    then
        return false
    end

    local Config =
        self:GetConfig()

    if not Config then
        return false
    end

    -- Never send AddQuest again while the selected quest is still present
    -- in replicated quest data. This prevents duplicate/reaccept spam while
    -- a completed quest is waiting for server-side removal.
    local ExistingQuest =
        self:FindQuestData(
            Config
        )

    if ExistingQuest then
        return false
    end

    -- Keep retrying until the quest is replicated as active, but space
    -- requests enough that we do not hammer the remote every frame.
    if os.clock()
        - self.LastAcceptAt
        < self.AcceptRetryDelay
    then
        return false
    end

    self.Busy = true

    self:SetStatus(
        "Accepting",
        tostring(
            Config.Request
        )
    )

    -- Teleport to the configured quest NPC once per acceptance cycle.
    -- Windy Peak quests use Krue by default; Bamboo Grove bear quests
    -- can provide Tom through Config.NPCPaths.
    if not self.TeleportedForAcceptance then
        if not Config.SkipQuestNPCTeleport then
            local TeleportSuccess,
                TeleportError =
                self:TeleportToQuestNPC(
                    Config
                )

            if not TeleportSuccess then
                self.Busy = false

                warn(
                    "[Combat Hub] Auto Quest: "
                        .. tostring(
                            TeleportError
                        )
                )

                self.AcceptRetryToken += 1
                local RetryToken =
                    self.AcceptRetryToken

                task.delay(
                    math.max(
                        tonumber(
                            self.AcceptRetryDelay
                        ) or 0.25,
                        0.25
                    ),
                    function()
                        if RetryToken
                                == self.AcceptRetryToken
                            and HubRunning
                            and Settings.AutoQuest
                        then
                            self:ScheduleProcess(
                                "quest NPC/stream retry"
                            )
                        end
                    end
                )

                return false
            end

            -- Only wait a fraction of a second for the server to receive
            -- the final NPC-side position before firing AddQuest.
            task.wait(
                tonumber(
                    self.QuestRemoteSettleDelay
                )
                or 0.04
            )
        end

        self.TeleportedForAcceptance =
            true
    end

    local Success, ErrorMessage =
        pcall(function()
            CombatEvent:FireServer(
                "AddQuest",
                Config.Request
            )
        end)

    self.LastAcceptAt =
        os.clock()

    self.Busy = false

    if not Success then
        warn(
            "[Combat Hub] Auto Quest: "
                .. tostring(
                    ErrorMessage
                )
        )
    end

    self.AcceptRetryToken += 1
    local RetryToken =
        self.AcceptRetryToken

    task.delay(
        math.max(
            tonumber(
                self.AcceptRetryDelay
            ) or 0.25,
            0.25
        ),
        function()
            if RetryToken
                    == self.AcceptRetryToken
                and HubRunning
                and Settings.AutoQuest
            then
                self:ScheduleProcess(
                    "accept acknowledgement check"
                )
            end
        end
    )

    return Success
end


function QuestController:ResetState()
    self.Busy = false
    self.LastAcceptAt = 0
    self.CompletionSeenAt = nil
    self.TeleportedForAcceptance = false
    self.LastStatusKey = nil
    self.ProcessBusy = false
    self.RefreshScheduled = false
    self.AcceptRetryToken += 1
end


function QuestController:Start()
    self.LoopID += 1
    self:ResetState()

    -- Event driven: Holder.ChildAdded/Removed and task Value/Max/Need changes
    -- trigger ProcessSelectedQuest immediately.
    self:BindQuestWatchers()
    self:ScheduleProcess(
        "start"
    )
end


function QuestController:Stop()
    Settings.AutoQuest =
        false

    self.LoopID += 1
    self:DisconnectQuestWatchers()
    self:ResetState()
end



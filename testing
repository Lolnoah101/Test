local function LoadRayfield()
    local URL = "https://sirius.menu/gen2"
    local LastError = "Unknown error"

    for Attempt = 1, 3 do
        local HttpSuccess, SourceOrError =
            pcall(function()
                return game:HttpGet(URL)
            end)

        if HttpSuccess and typeof(SourceOrError) == "string" then
            local CompileSuccess, ChunkOrError =
                pcall(function()
                    return loadstring(SourceOrError)
                end)

            if CompileSuccess
                and typeof(ChunkOrError) == "function"
            then
                local RunSuccess, LibraryOrError =
                    pcall(ChunkOrError)

                if RunSuccess
                    and LibraryOrError ~= nil
                    and typeof(LibraryOrError.CreateWindow) == "function"
                then
                    return LibraryOrError
                end

                LastError =
                    RunSuccess
                    and "Rayfield loader returned nil/invalid library."
                    or tostring(LibraryOrError)

            else
                LastError =
                    CompileSuccess
                    and "loadstring did not return a function."
                    or tostring(ChunkOrError)
            end

        else
            LastError =
                HttpSuccess
                and "HttpGet returned a non-string response."
                or tostring(SourceOrError)
        end

        task.wait(0.75)
    end

    error(
        "Failed to load Rayfield Gen2 after 3 attempts: "
            .. tostring(LastError)
    )
end


local function GetBackpackNumbers()

    return

        tonumber(
            AmountValue.Value
        ) or 0,

        tonumber(
            CapacityValue.Value
        ) or 0
end


local function IsBackpackFull()

    local Amount, Capacity =
        GetBackpackNumbers()


    return

        Capacity > 0

        and Amount >= Capacity
end


--// ============================================================
--// AUTO HOME
--// ============================================================

local CheckBackpack


local function WaitForBackpackSpace(Timeout)

    local Started =
        os.clock()

    while
        HubRunning
        and Settings.AutoHome
        and os.clock() - Started < Timeout
    do

        local Amount, Capacity =
            GetBackpackNumbers()

        if
            Capacity > 0
            and Amount < Capacity
        then

            return true

        end

        task.wait(0.10)
    end

    return false
end


CheckBackpack = function()

    if
        not HubRunning
        or not Settings.AutoHome
    then

        return
    end


    local Amount, Capacity =
        GetBackpackNumbers()


    if
        Capacity <= 0
        or Amount < Capacity
    then

        BackpackFullHandled =
            false

        return
    end


    if
        BackpackSequenceBusy
        or BackpackFullHandled
    then

        return
    end


    BackpackSequenceBusy =
        true


    task.spawn(function()

        local Success =
            false


        for Attempt = 1, 3 do

            if
                not HubRunning
                or not Settings.AutoHome
            then

                break
            end


            if TeleportHome() then

                task.wait(
                    Settings.TeleportDelay
                )


                if EquipBestFish() then

                    task.wait(
                        Settings.BestFishDelay
                    )


                    if Settings.AutoSellFish then

                        local SellRequested =
                            SellAllFish()

                        if SellRequested then

                            -- A successful InvokeServer call does not
                            -- guarantee BackpackData has updated yet.
                            -- Wait until we can confirm there is space.
                            if WaitForBackpackSpace(
                                Settings.BackpackResetTimeout
                            ) then

                                Success =
                                    true

                                break
                            end

                        end

                    else

                        -- Auto Home can still be used without Auto Sell.
                        -- In that case stay home and wait for the user
                        -- to manually create backpack space.
                        Success =
                            true

                        break
                    end

                end

            end


            task.wait(0.50)

        end


        BackpackSequenceBusy =
            false


        -- Only keep the "handled" latch set if the backpack is
        -- STILL full. If selling created space, immediately re-arm
        -- the system for the next full backpack.
        BackpackFullHandled =
            Success and IsBackpackFull()


        if
            not Success
            and HubRunning
            and Settings.AutoHome
            and IsBackpackFull()
        then

            task.delay(
                0.75,
                function()

                    if
                        HubRunning
                        and Settings.AutoHome
                        and IsBackpackFull()
                    then

                        BackpackFullHandled =
                            false

                        CheckBackpack()

                    end

                end
            )

        end

    end)
end



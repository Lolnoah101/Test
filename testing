}


function AutoSellController:IsDungeonActive()
    -- Active Ouwigahara run.
    if QuestFarmController
        and type(
            QuestFarmController.IsDungeonUiActive
        ) == "function"
    then
        local Success,
            Active =
            pcall(function()
                return QuestFarmController:IsDungeonUiActive()
            end)

        if Success
            and Active == true
        then
            return true
        end
    end

    -- Ouwigahara lobby. Protect this too so Auto Sell cannot drag the
    -- player to Ginzo while we're waiting at / readying on StartPad.
    local Map =
        workspace:FindFirstChild(
            "Map"
        )

    local MinigameMap =
        Map
        and Map:FindFirstChild(
            "Minigame Map"
        )

    local StartPad =
        MinigameMap
        and MinigameMap:FindFirstChild(
            "StartPad"
        )

    if StartPad then
        return true
    end

    return Settings.__DungeonEntryBusy
        == true
end


function AutoSellController:GetSignalFunction()
    local Communication =
        ReplicatedStorage:FindFirstChild(
            "Communication"
        )

    local ServerAndClient =
        Communication
        and Communication:FindFirstChild(
            "ServerAndClient"
        )

    local Signals =
        ServerAndClient
        and ServerAndClient:FindFirstChild(
            "Signals"
        )

    local SignalFunction =
        Signals
        and Signals:FindFirstChild(
            "SignalFunction"
        )

    return SignalFunction
        and SignalFunction:FindFirstChild(
            "Function"
        )
        or nil
end


function AutoSellController:GetInventoryFolder()
    if not GameUtilityModule
        or type(
            GameUtilityModule.GetData
        ) ~= "function"
    then
        return nil
    end

    local Success,
        Data =
        pcall(
            GameUtilityModule.GetData,
            LocalPlayer,
            true
        )

    if not Success
        or not Data
    then
        return nil
    end

    local Inventory =
        Data:FindFirstChild(
            "Inventory"
        )

    return Inventory
        and Inventory:FindFirstChild(
            "Inventory"
        )
        or nil
end


function AutoSellController:GetCoinAmounts()
    local Result = {}

    for _,
        Name in ipairs(
            self.CoinNames
        )
    do
        Result[Name] =
            0
    end

    local Inventory =
        self:GetInventoryFolder()

    if not Inventory then
        return Result
    end

    for _,
        Item in ipairs(
            Inventory:GetChildren()
        )
    do
        local Name =
            Item.Name

        if self.CoinSet[
            Name
        ]
            and not Item:FindFirstChild(
                "NoSave"
            )
            and not Item:FindFirstChild(
                "QuestGrant"
            )
        then
            local AmountValue =
                Item:FindFirstChild(
                    "Amount"
                )

            local Amount =
                AmountValue
                and tonumber(
                    AmountValue.Value
                )
                or 1

            if Amount
                and Amount > 0
            then
                Result[Name] =
                    (
                        Result[Name]
                        or 0
                    )
                    + math.floor(
                        Amount
                    )
            end
        end
    end

    return Result
end


function AutoSellController:GetTotalCoins(
    Amounts
)
    local Total = 0

    for _,
        Name in ipairs(
            self.CoinNames
        )
    do
        Total +=
            tonumber(
                Amounts[
                    Name
                ]
            )
            or 0
    end

    return Total
end


function AutoSellController:BuildBatch(
    Amounts
)
    local Batch = {}
    local HasAnything = false

    for _,
        Name in ipairs(
            self.CoinNames
        )
    do
        local Amount =
            math.floor(
                tonumber(
                    Amounts[
                        Name
                    ]
                )
                or 0
            )

        if Amount > 0 then
            Batch[Name] =
                math.min(
                    Amount,
                    self.MaxBatchPerItem
                )

            HasAnything =
                true
        end
    end

    return HasAnything
        and Batch
        or nil
end


function AutoSellController:IsSafeCoinBatch(
    Batch
)
    if type(
        Batch
    ) ~= "table"
    then
        return false
    end

    local HasAnything =
        false

    for Name,
        Amount in pairs(
            Batch
        )
    do
        -- Hard whitelist. No equipment, accessory, material, loot, soul,
        -- consumable, or other inventory name may reach SellItems here.
        if self.CoinSet[
            Name
        ] ~= true
        then
            return false
        end

        Amount =
            tonumber(
                Amount
            )

        if not Amount
            or Amount <= 0
            or Amount
                > self.MaxBatchPerItem
        then
            return false
        end

        HasAnything =
            true
    end

    return HasAnything
end


function AutoSellController:WaitForGinzo(
    LoadPosition
)
    local StartedAt =
        os.clock()

    while HubRunning
        and Settings.AutoSellCoins
        and self.Busy
        and not self:IsDungeonActive()
        and os.clock()
            - StartedAt
            < 8
    do
        local NPC =
            QuestController:GetNPC(
                self.SellerConfig
            )

        if NPC then
            QuestController:RememberNPCPosition(
                self.SellerConfig,
                NPC
            )

            return NPC
        end

        if typeof(
            LoadPosition
        ) == "Vector3"
        then
            QuestController:RequestStreamingAround(
                LoadPosition
            )
        end

        task.wait(
            0.12
        )
    end

    return nil
end


function AutoSellController:MoveToGinzo()
    if self:IsDungeonActive() then
        return false,
            "dungeon active; Ginzo travel postponed"
    end

    local NPC =
        QuestController:GetNPC(
            self.SellerConfig
        )

    if NPC then
        QuestController:RememberNPCPosition(
            self.SellerConfig,
            NPC
        )
    end

    if not NPC then
        local LoadCFrame,
            LoadSource =
            QuestController:GetQuestLoadCFrame(
                self.SellerConfig
            )

        if not LoadCFrame then
            return false,
                "Ginzo is streamed out and the configured Mistfall Harbor load position could not be used."
        end

        HubDebug(
            "[Combat Hub] Auto Sell: loading Ginzo / Mistfall Harbor using "
                .. tostring(
                    LoadSource
                )
                .. " @ "
                .. tostring(
                    LoadCFrame.Position
                )
        )

        QuestController:RequestStreamingAround(
            LoadCFrame.Position
        )

        if self:IsDungeonActive() then
            return false,
                "dungeon became active before Ginzo travel"
        end

        local MoveSuccess,
            MoveError =
            QuestController:MoveCharacterToCFrame(
                LoadCFrame
            )

        if not MoveSuccess then
            return false,
                tostring(
                    MoveError
                )
        end

        QuestController:RequestStreamingAround(
            LoadCFrame.Position
        )

        NPC =
            self:WaitForGinzo(
                LoadCFrame.Position
            )
    end

    if not NPC then
        return false,
            "Ginzo did not replicate after entering Mistfall Harbor"
    end

    local Target =
        QuestController:GetObjectCFrame(
            NPC
        )

    if not Target then
        return false,
            "Ginzo has no usable root/body part"
    end

    QuestController:RememberNPCPosition(
        self.SellerConfig,
        NPC
    )

    return QuestController:MoveCharacterToCFrame(
        Target
            * CFrame.new(
                0,
                2.5,
                4
            )
    )
end


function AutoSellController:SellCurrentCoins()
    if not HubRunning
        or not Settings.AutoSellCoins
        or self.Busy
        or CollectibleInteractionBusy
        or Settings.__LootFarmBusy
        or Settings.__BossRewardBusy
        or Settings.__RaidCollecting
        or RaidController.Busy
        or self:IsDungeonActive()
    then
        return false
    end

    local Amounts =
        self:GetCoinAmounts()

    if self:GetTotalCoins(
        Amounts
    ) <= 0
    then
        return false
    end

    local Character =
        LocalPlayer.Character

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Root then
        return false
    end

    self.Busy = true
    Settings.__AutoSellBusy =
        true

    -- A dungeon can begin between the scheduled safety check and this
    -- function starting. Never release the farm or teleport if that happens.
    if self:IsDungeonActive() then
        Settings.__AutoSellBusy =
            false

        self.Busy =
            false

        HubDebug(
            "[Combat Hub] Auto Sell Coins: dungeon active, sale postponed"
        )

        return false
    end

    -- Release whichever farm currently owns Heartbeat positioning.
    QuestFarmController:ResetTarget()

    local ReturnCFrame =
        Root.CFrame

    local MoveSuccess,
        MoveError =
        self:MoveToGinzo()

    if not MoveSuccess then
        warn(
            "[Combat Hub] Auto Sell Coins: "
                .. tostring(
                    MoveError
                )
        )

        Settings.__AutoSellBusy =
            false

        self.Busy =
            false

        return false
    end

    task.wait(
        0.08
    )

    local SignalFunction =
        self:GetSignalFunction()

    if not SignalFunction then
        warn(
            "[Combat Hub] Auto Sell Coins: SignalFunction remote not found"
        )

        Settings.__AutoSellBusy =
            false

        self.Busy =
            false

        return false
    end

    local SoldAny =
        false

    -- Repeat because the normal Sell UI limits one selected amount to 999.
    for Pass = 1, 20 do
        if not HubRunning
            or not Settings.AutoSellCoins
        then
            break
        end

        local Current =
            self:GetCoinAmounts()

        local BeforeTotal =
            self:GetTotalCoins(
                Current
            )

        if BeforeTotal <= 0 then
            break
        end

        local Batch =
            self:BuildBatch(
                Current
            )

        if not Batch then
            break
        end

        if not self:IsSafeCoinBatch(
            Batch
        )
        then
            warn(
                "[Combat Hub] Auto Sell Coins blocked an unsafe SellItems batch"
            )

            break
        end

        local InvokeSuccess,
            InvokeResult =
            pcall(function()
                return SignalFunction:InvokeServer(
                    "SellItems",
                    Batch
                )
            end)

        if not InvokeSuccess then
            warn(
                "[Combat Hub] Auto Sell Coins remote error: "
                    .. tostring(
                        InvokeResult
                    )
            )

            break
        end

        task.wait(
            self.RemoteSettleDelay
        )

        ------------------------------------------------------
        -- INVENTORY REPLICATION CONFIRMATION
        --
        -- The captured SellItems payload is correct. Do not treat a single
        -- ~0.5s unchanged read as failure; the replicated Inventory tree can
        -- update later than the remote response.
        ------------------------------------------------------

        local AfterTotal =
            BeforeTotal

        local ReplicationStarted =
            os.clock()

        while HubRunning
            and Settings.AutoSellCoins
            and os.clock()
                - ReplicationStarted
                < self.RemoteReplicationTimeout
        do
            AfterTotal =
                self:GetTotalCoins(
                    self:GetCoinAmounts()
                )

            if AfterTotal
                < BeforeTotal
            then
                break
            end

            task.wait(
                0.10
            )
        end

        if AfterTotal
            < BeforeTotal
        then
            SoldAny =
                true

            HubDebug(
                "[Combat Hub] Auto Sell Coins: "
                    .. tostring(
                        BeforeTotal
                        - AfterTotal
                    )
                    .. " coin item(s) sold"
            )
        else
            -- Keep this quiet. The server may reject a sale temporarily
            -- (distance/state/save guard/etc.). The next normal sell cycle
            -- can try again without flooding the executor console.
            HubDebug(
                "[Combat Hub] Auto Sell Coins: SellItems returned without "
                    .. "an inventory change; postponing"
            )

            break
        end
    end

    -- Return to where Auto Sell interrupted the player. The farm/raid loops
    -- will reacquire their own targets after movement ownership is released.
    if HubRunning
        and LocalPlayer.Character
        and LocalPlayer.Character:FindFirstChild(
            "HumanoidRootPart"
        )
    then
        QuestController:MoveCharacterToCFrame(
            ReturnCFrame
        )
    end

    Settings.__AutoSellBusy =
        false

    self.Busy =
        false

    return SoldAny
end


function AutoSellController:DisconnectInventoryWatchers()
    for _,
        Connection in ipairs(
            self.InventoryConnections
        )
    do
        pcall(function()
            Connection:Disconnect()
        end)
    end

    table.clear(
        self.InventoryConnections
    )

    for Item,
        Connection in pairs(
            self.AmountConnections
        )
    do
        pcall(function()
            Connection:Disconnect()
        end)

        self.AmountConnections[
            Item
        ] =
            nil
    end

    self.InventoryFolder =
        nil
end


function AutoSellController:WatchItem(
    Item
)
    if not Item
        or not Item.Parent
        or not self.CoinSet[
            Item.Name
        ]
    then
        return
    end

    local OldConnection =
        self.AmountConnections[
            Item
        ]

    if OldConnection then
        OldConnection:Disconnect()
        self.AmountConnections[
            Item
        ] =
            nil
    end

    local Amount =
        Item:FindFirstChild(
            "Amount"
        )

    if Amount
        and Amount:IsA(
            "ValueBase"
        )
    then
        self.AmountConnections[
            Item
        ] =
            Amount.Changed:Connect(
                function()
                    -- Intentionally do nothing here.
                    -- Auto Sell uses the fixed 10-minute cycle instead of
                    -- interrupting farms on every coin pickup.
                end
            )
    end
end


function AutoSellController:BindInventoryWatchers()
    self:DisconnectInventoryWatchers()

    local Inventory =
        self:GetInventoryFolder()

    if not Inventory then
        return false
    end

    self.InventoryFolder =
        Inventory

    for _,
        Item in ipairs(
            Inventory:GetChildren()
        )
    do
        self:WatchItem(
            Item
        )
    end

    table.insert(
        self.InventoryConnections,
        Inventory.ChildAdded:Connect(
            function(Item)
                self:WatchItem(
                    Item
                )

                -- Do not sell immediately when a coin item is added.
                -- The periodic 10-minute loop owns sell timing.
            end
        )
    )

    table.insert(
        self.InventoryConnections,
        Inventory.ChildRemoved:Connect(
            function(Item)
                local Connection =
                    self.AmountConnections[
                        Item
                    ]

                if Connection then
                    Connection:Disconnect()
                    self.AmountConnections[
                        Item
                    ] =
                        nil
                end
            end
        )
    )

    return true
end


function AutoSellController:SellWhenSafe(
    Reason
)
    if not HubRunning
        or not Settings.AutoSellCoins
    then
        return false
    end

    local DungeonWaitLogged =
        false

    while HubRunning
        and Settings.AutoSellCoins
    do
        if self:GetTotalCoins(
            self:GetCoinAmounts()
        ) <= 0
        then
            HubDebug(
                "[Combat Hub] Auto Sell Coins: 10-minute check found no coins"
            )

            return false
        end

        ------------------------------------------------------
        -- DUNGEON SAFETY
        ------------------------------------------------------
        --
        -- Never teleport to Ginzo while Ouwigahara is active.
        -- Temporary.ActiveNpcs and the dungeon map rely on the player
        -- remaining in/near the current streamed dungeon.
        if self:IsDungeonActive() then
            if not DungeonWaitLogged then
                DungeonWaitLogged =
                    true

                HubDebug(
                    "[Combat Hub] Auto Sell Coins: 10-minute timer reached, "
                        .. "but dungeon is active • sale postponed"
                )
            end

            task.wait(
                self.BusyRetryDelay
            )

            continue
        end

        if DungeonWaitLogged then
            DungeonWaitLogged =
                false

            HubDebug(
                "[Combat Hub] Auto Sell Coins: dungeon ended • resuming pending sale"
            )
        end

        if not self.Busy
            and not CollectibleInteractionBusy
            and not Settings.__LootFarmBusy
            and not Settings.__BossRewardBusy
            and not Settings.__RaidCollecting
            and not RaidController.Busy
        then
            HubDebug(
                "[Combat Hub] Auto Sell Coins: "
                    .. tostring(
                        Reason
                        or "scheduled check"
                    )
            )

            return self:SellCurrentCoins()
        end

        -- The 10-minute mark arrived during loot/raid activity.
        -- Wait for a safe opening rather than disrupting the current action.
        task.wait(
            self.BusyRetryDelay
        )
    end

    return false
end


function AutoSellController:Start()
    Settings.AutoSellCoins =
        true

    self.LoopID +=
        1

    self.Busy =
        false

    Settings.__AutoSellBusy =
        false

    self:BindInventoryWatchers()

    -- Learn Ginzo's position immediately if Mistfall Harbor is currently
    -- streamed. The exact preload coordinate is also configured, so this
    -- is only a useful cache refresh.
    local Ginzo =
        QuestController:GetNPC(
            self.SellerConfig
        )

    if Ginzo then
        QuestController:RememberNPCPosition(
            self.SellerConfig,
            Ginzo
        )
    end

    local MyLoopID =
        self.LoopID

    HubDebug(
        "[Combat Hub] Auto Sell Coins enabled • next check in 10 minutes"
    )

    task.spawn(function()
        local NextSellAt =
            os.clock()
            + self.SellInterval

        while HubRunning
            and Settings.AutoSellCoins
            and MyLoopID
                == self.LoopID
        do
            -- Keep inventory watcher bindings healthy without using them
            -- as sell triggers.
            if self:GetInventoryFolder()
                ~= self.InventoryFolder
            then
                self:BindInventoryWatchers()
            end

            local NPC =
                QuestController:GetNPC(
                    self.SellerConfig
                )

            if NPC then
                QuestController:RememberNPCPosition(
                    self.SellerConfig,
                    NPC
                )
            end

            local Remaining =
                NextSellAt
                - os.clock()

            if Remaining > 0 then
                task.wait(
                    math.min(
                        Remaining,
                        1
                    )
                )

                continue
            end

            if not HubRunning
                or not Settings.AutoSellCoins
                or MyLoopID
                    ~= self.LoopID
            then
                break
            end

            self:SellWhenSafe(
                "10-minute scheduled check"
            )

            -- Always start a fresh 10-minute interval after the scheduled
            -- check finishes, whether coins existed or not.
            NextSellAt =
                os.clock()
                + self.SellInterval

            if HubRunning
                and Settings.AutoSellCoins
            then
                HubDebug(
                    "[Combat Hub] Auto Sell Coins: next check in 10 minutes"
                )
            end
        end
    end)
end


function AutoSellController:Stop()
    Settings.AutoSellCoins =
        false

    self.LoopID +=
        1

    self.ScheduleToken +=
        1

    self:DisconnectInventoryWatchers()

    Settings.__AutoSellBusy =
        false

    self.Busy =
        false
end




--// ============================================================
--// AUTO BLOCK
--// ============================================================
--
-- Captured block remotes:
--
-- Hold:
-- CombatEvent:FireServer(
--     "server_skill_controller_signaler",
--     "Blocking",
--     "Hold",
--     Vector3
-- )
--
-- Release:
-- CombatEvent:FireServer(
--     "server_skill_controller_signaler",
--     "Blocking",
--     "UnHold",
--     Vector3,
--     nil
-- )
--
-- Detection:
--   * Watch nearby NPC Animator.AnimationPlayed signals for immediate reaction.
--   * Heartbeat verifies currently-playing attack/action tracks so one missed
--     AnimationPlayed event cannot leave the player unprotected.
--   * The replicated "Blocking" value is used when available to tell whether
--     the server actually accepted the block.

local AutoBlockUtility = nil
local AutoBlockUtilityTried = false

local function GetAutoBlockUtility()
    if AutoBlockUtilityTried then
        return AutoBlockUtility
    end

    AutoBlockUtilityTried =
        true

    pcall(function()
        AutoBlockUtility =
            require(
                ReplicatedStorage
                    :WaitForChild("CAM")
                    :WaitForChild("Global")
                    :WaitForChild("Utility")
            )
    end)

    return AutoBlockUtility
end



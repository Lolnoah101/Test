local function GetLootFolder()
    return workspace:FindFirstChild("LootDrops")
end


local function GetDebreeFolder()
    return workspace:FindFirstChild("Debree")
end


local function GetLootDropFromPrompt(Prompt)
    local LootFolder =
        GetLootFolder()

    if not LootFolder
        or not Prompt
        or not Prompt:IsA("ProximityPrompt")
        or not Prompt:IsDescendantOf(LootFolder)
    then
        return nil
    end

    local Current =
        Prompt.Parent

    while Current
        and Current ~= LootFolder
        and Current ~= workspace
    do
        if Current.Parent == LootFolder then
            return Current
        end

        Current = Current.Parent
    end

    return Prompt.Parent
end


local function GetSoulDropFromPrompt(Prompt)
    local Debree =
        GetDebreeFolder()

    if not Debree
        or not Prompt
        or not Prompt:IsA("ProximityPrompt")
        or Prompt.Name ~= "SoulPrompt"
        or not Prompt:IsDescendantOf(Debree)
    then
        return nil
    end

    local Current =
        Prompt.Parent

    -- Souls are currently replicated as direct children of workspace.Debree:
    -- workspace.Debree["Weak Soul"].Root.SoulPrompt
    -- workspace.Debree["Strong Soul"]....SoulPrompt
    while Current
        and Current ~= Debree
        and Current ~= workspace
    do
        if Current.Parent == Debree then
            if Current.Name == "Weak Soul"
                or Current.Name == "Strong Soul"
            then
                return Current
            end

            return nil
        end

        Current = Current.Parent
    end

    return nil
end


local function GetLootRarity(LootDrop)
    if not LootDrop then
        return nil
    end

    -- Prefer explicit attributes if the game exposes them.
    for _, AttributeName in ipairs({
        "Rarity",
        "Tier",
        "Quality",
    }) do
        local Value =
            LootDrop:GetAttribute(
                AttributeName
            )

        if typeof(Value) == "string"
            and Value ~= ""
        then
            return Value
        end
    end

    -- From your current capture the rarity appears as a direct child
    -- of workspace.LootDrops.LootDrop (for example: "Rare").
    for _, Child in ipairs(
        LootDrop:GetChildren()
    ) do
        if KnownLootRaritySet[
            Child.Name
        ] then
            return Child.Name
        end
    end

    return nil
end


local function GetLootName(
    LootDrop,
    Prompt
)
    if Prompt then
        local ObjectText =
            tostring(
                Prompt.ObjectText
                or ""
            )

        if ObjectText ~= "" then
            return ObjectText
        end
    end

    if LootDrop then
        local AttributeName =
            LootDrop:GetAttribute(
                "ItemName"
            )

        if typeof(AttributeName) == "string"
            and AttributeName ~= ""
        then
            return AttributeName
        end
    end

    return LootDrop
        and LootDrop.Name
        or "Loot"
end


local function LootMatchesSelection(
    LootDrop
)
    local Selected =
        Settings.LootRarity
        or "Any"

    if Selected == "Any" then
        return true
    end

    local Rarity =
        GetLootRarity(

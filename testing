local function CleanLuck(Value)
    if Value == nil then
        return nil
    end

    Value = tostring(Value)
    Value = Value:gsub("[Ll][Uu][Cc][Kk]", "")
    Value = Value:gsub("%s+", "")
    Value = Value:upper()

    return Value
end

local function NormalizeLuckSelection(Value)
    local Selected = {}

    if typeof(Value) == "string" then
        Selected[Value] = true
        return Selected
    end

    if typeof(Value) ~= "table" then
        return Selected
    end

    -- Rayfield Gen2 multi-select may provide either an array of strings
    -- or a dictionary-like table. Support both formats.
    for Key, Entry in pairs(Value) do
        if typeof(Key) == "number" and typeof(Entry) == "string" then
            Selected[Entry] = true

        elseif typeof(Key) == "string" then
            if Entry == true then
                Selected[Key] = true

            elseif typeof(Entry) == "string" then
                Selected[Entry] = true
            end
        end
    end

    return Selected
end


local function GetSelectedLuckList()
    local Result = {}

    for _, Luck in ipairs(LuckOptions) do
        if Settings.SelectedLucks[Luck] then
            table.insert(Result, Luck)
        end
    end

    return Result
end


local function GetSelectedLuckText()
    local Selected = GetSelectedLuckList()

    if #Selected == 0 then
        return "None"
    end

    return table.concat(Selected, ", ")
end


local function IsLuckSelected(LuckText)
    local Clean = CleanLuck(LuckText)

    for Luck, Enabled in pairs(Settings.SelectedLucks) do
        if Enabled and CleanLuck(Luck) == Clean then
            return true
        end
    end

    return false
end


local function GetEggLuck(Egg)
    if not Egg then
        return nil
    end

    for _, Object in ipairs(Egg:GetDescendants()) do
        if Object.Name == "Luck"
            and (
                Object:IsA("TextLabel")
                or Object:IsA("TextButton")
                or Object:IsA("TextBox")
            )
        then
            if Object.Text and Object.Text ~= "" then
                return CleanLuck(Object.Text)
            end
        end
    end

    return nil
end

local function GetPickupPrompt(Egg)
    if not Egg then
        return nil
    end

    for _, Object in ipairs(Egg:GetDescendants()) do
        if Object:IsA("ProximityPrompt")
            and Object.Name == "Pickup"
        then
            return Object
        end
    end

    return nil
end

local function GetEggTarget(Egg, Prompt)
    if Prompt
        and Prompt.Parent
        and Prompt.Parent:IsA("BasePart")
    then
        return Prompt.Parent
    end

    if Egg:IsA("BasePart") then
        return Egg
    end

    if Egg:IsA("Model") and Egg.PrimaryPart then
        return Egg.PrimaryPart
    end

    local PreferredNames = {
        "Cube.001",
        "Sphere.004",
        "EggBase",
        "Handle",
    }

    for _, Name in ipairs(PreferredNames) do
        local Part = Egg:FindFirstChild(Name, true)

        if Part and Part:IsA("BasePart") then
            return Part
        end
    end

    return Egg:FindFirstChildWhichIsA("BasePart", true)
end

local function FindEggByLuck(WantedLuck)
    SearchCount += 1

    local Wanted = CleanLuck(WantedLuck)

    for _, Egg in ipairs(RenderedEggs:GetChildren()) do
        local EggLuck = GetEggLuck(Egg)

        if EggLuck == Wanted then
            local Prompt = GetPickupPrompt(Egg)

            if Prompt and Prompt.Enabled then
                return Egg, Prompt
            end
        end
    end

    return nil
end

local function FindEggBySelectedLucks()
    SearchCount += 1

    for _, Egg in ipairs(RenderedEggs:GetChildren()) do
        local EggLuck = GetEggLuck(Egg)

        if EggLuck and IsLuckSelected(EggLuck) then
            local Prompt = GetPickupPrompt(Egg)

            if Prompt and Prompt.Enabled then
                -- Return the dropdown label that matched this egg.
                for _, Luck in ipairs(LuckOptions) do
                    if Settings.SelectedLucks[Luck]
                        and CleanLuck(Luck) == EggLuck
                    then
                        return Egg, Prompt, Luck
                    end
                end
            end
        end
    end

    return nil
end


local function GetMatchingSelectedEggs()
    local Results = {}

    for _, Egg in ipairs(RenderedEggs:GetChildren()) do
        local EggLuck = GetEggLuck(Egg)

        if EggLuck and IsLuckSelected(EggLuck) then
            local Prompt = GetPickupPrompt(Egg)

            if Prompt then
                table.insert(Results, {
                    Egg = Egg,
                    Prompt = Prompt,
                    Luck = EggLuck,
                })
            end
        end
    end

    return Results
end


local function GetMatchingEggs(WantedLuck)
    local Results = {}
    local Wanted = CleanLuck(WantedLuck)

    for _, Egg in ipairs(RenderedEggs:GetChildren()) do

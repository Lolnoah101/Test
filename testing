local function GetActiveGamemodeFarmFolder()
    -- MOVEMENT PRIORITY:
    -- 1) Active Time Trial
    -- 2) Active Raid
    -- 3) Commandment Fragment collector
    -- 4) Normal Auto Farm
    --
    -- The fragment and normal-farm layers are handled by the main
    -- farm worker below. This function resolves the two gamemodes.
    if Settings.AutoFarmTimeTrial then
        local TimeTrialFolder =
            GetTimeTrialEnemyFolder()

        if TimeTrialFolder then
            return TimeTrialFolder,
                "TimeTrial"
        end

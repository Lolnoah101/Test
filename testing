--// Rayfield Gen2
local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

--// Window
local Window = Rayfield:CreateWindow({
    name = "Testing",
    subtitle = "Combat Hub",
    theme = "default",

    configuration = {
        autoSave = true,
        autoLoad = true,
        fileName = "TestingHub",
    },
})

--// Combat Tab
local CombatTab = Window:CreateTab({
    name = "Combat",
})

--// Variables
local M1Enabled = false
local Skill1Enabled = false
local Skill2Enabled = false
local Skill3Enabled = false
local Skill4Enabled = false

--==================================================
-- M1
--==================================================

CombatTab:CreateToggle({
    name = "Auto M1",
    description = "Automatically uses your M1 attack.",
    flag = "AutoM1",

    callback = function(value)
        M1Enabled = value

        if M1Enabled then
            task.spawn(function()
                while M1Enabled do

                    -- PUT YOUR M1 CODE HERE


                    task.wait(0.1)
                end
            end)
        end
    end,
})


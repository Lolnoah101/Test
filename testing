    ] == true
end


function AutoCardController:GetCombinedCardText(
    Entry
)
    if not Entry then
        return "",
            "",
            ""
    end

    local Title =
        string.lower(
            tostring(
                Entry.Title
                or ""
            )
        )

    local Description =
        string.lower(
            tostring(
                Entry.Bottom
                or ""
            )
        )

    return Title,
        Description,
        Title
            .. " "
            .. Description
end


function AutoCardController:ExtractLargestNumber(
    Text
)
    local Largest =
        0

    for NumberText in string.gmatch(
        tostring(
            Text
            or ""
        ),
        "(%d+%.?%d*)"
    )
    do
        local Number =
            tonumber(
                NumberText
            )

        if Number
            and Number > Largest
        then
            Largest =
                Number
        end
    end

    return Largest
end


function AutoCardController:ExtractPointMultiplier(
    Text
)
    Text =
        string.lower(
            tostring(
                Text
                or ""
            )
        )

    local Multiplier =
        string.match(
            Text,
            "x%s*(%d+%.?%d*)%s*points"
        )
        or string.match(
            Text,
            "x%s*(%d+%.?%d*)%s*point"
        )

    return tonumber(
        Multiplier
    )
end


function AutoCardController:ScoreMorePoints(
    Entry
)
    if not Entry
        or self:IsNeverPickCard(
            Entry
        )
    then
        return -math.huge
    end

    local Title,
        Description,
        Combined =
        self:GetCombinedCardText(
            Entry
        )

    local IsPointCard =
        string.find(
            Combined,
            "point",
            1,
            true
        )
        or string.find(
            Combined,
            "trophy",
            1,
            true
        )
        or string.find(
            Combined,
            "score",
            1,
            true
        )
        or string.find(
            Combined,
            "fortune",
            1,
            true
        )

    if not IsPointCard then
        return -math.huge
    end

    local Score =
        1000

    -- Event choices such as:
    --   Bare Hands, x2.2 points
    --   Glass Floor, x1.5 points
    --   Fair Fight, x1.2 points
    --
    -- A larger multiplier should always beat a smaller multiplier.
    local Multiplier =
        self:ExtractPointMultiplier(
            Combined
        )

    if Multiplier then
        Score =
            3000
            + Multiplier
                * 1000
    end

    -- Flat score/trophy cards:
    --   Trophy +75
    --   Fine Trophy +150
    --   Fortune +750
    --
    -- Preserve the actual displayed amount in the ranking.
    local LargestNumber =
        self:ExtractLargestNumber(
            Title
        )

    if string.find(
        Title,
        "fortune",
        1,
        true
    ) then
        Score =
            math.max(
                Score,
                2400
                    + LargestNumber
            )
    elseif string.find(
        Title,
        "fine trophy",
        1,
        true
    ) then
        Score =
            math.max(
                Score,
                2200
                    + LargestNumber
            )
    elseif string.find(
        Title,
        "trophy",
        1,
        true
    ) then
        Score =
            math.max(
                Score,
                2000
                    + LargestNumber
            )
    end

    -- Deterministic tie break.
    Score -=
        Entry.Slot
        * 0.001

    return Score
end


function AutoCardController:ScoreTowardsCharacter(
    Entry
)
    if not Entry
        or self:IsNeverPickCard(
            Entry
        )
    then
        return -math.huge
    end

    local Title,
        Description,
        Combined =
        self:GetCombinedCardText(
            Entry
        )

    -- Explicitly reject score-only/event-point choices for this mode.
    if (
        string.find(
            Combined,
            "points added straight",
            1,
            true
        )
        or string.find(
            Title,
            "trophy",
            1,
            true
        )
        or string.find(
            Title,
            "fortune",
            1,
            true
        )
        or string.find(
            Combined,
            "that floor pays",
            1,
            true
        )
    )
    then
        return -math.huge
    end

    local Score =
        self.CharacterExactPriorities[
            Title
        ]
        or 0

    local Matched =
        Score > 0

    for _,
        Rule in ipairs(
            self.CharacterKeywordPriorities
        )
    do
        if string.find(
            Combined,
            Rule[1],
            1,
            true
        )
        then
            Matched =
                true

            Score +=
                Rule[2]
        end
    end

    for _,
        Rule in ipairs(
            self.NegativeKeywords
        )
    do
        if string.find(
            Combined,
            Rule[1],
            1,
            true
        )
        then
            Score +=
                Rule[2]
        end
    end

    if not Matched then
        return -math.huge
    end

    -- Prefer the stronger version of the same stat when the title exposes
    -- a larger +number / percentage.
    Score +=
        math.min(
            self:ExtractLargestNumber(
                Title
            ),
            500
        )

    Score -=
        Entry.Slot
        * 0.001

    return Score
end


function AutoCardController:ScoreBalanced(

local function LogUI(Message)
    local Text =
        "["
        .. os.date("%H:%M:%S")
        .. "] "
        .. tostring(Message)

    print(
        "[Anime Breaker] "
        .. tostring(Message)
    )

    if ShowcaseUI.DebugConsole then
        pcall(function()
            ShowcaseUI.DebugConsole:Append(
                Text
            )
        end)
    end
end


local function Toast(Title, Subtitle)
    pcall(function()
        Window:Toast({
            title = Title,
            subtitle = Subtitle or "",
            duration = 3,
        })
    end)

    LogUI(
        tostring(Title)
        .. (
            Subtitle
            and Subtitle ~= ""
            and (
                " • "
                .. tostring(Subtitle)
            )
            or ""
        )
    )
end

local function IsUUID(Name)
    return typeof(Name) == "string"
        and #Name == 32
        and Name:match("^[%da-fA-F]+$") ~= nil
end

local function GetEnemyFolder()
    local Enemies =
        Workspace:FindFirstChild("_ENEMIES")

    if not Enemies then
        return nil
    end

    return Enemies:FindFirstChild("Client")
end

local function GetInRangeFolder()
    local Enemies =
        Workspace:FindFirstChild("_ENEMIES")

    return Enemies
        and Enemies:FindFirstChild("InRange")
end


local function GetInRangeEnemyUUIDs()
    local InRange =
        GetInRangeFolder()

    if not InRange then
        return {}
    end

    local UUIDs = {}
    local Seen = {}

    -- Re-read the live InRange folder every Heartbeat.
    -- The game itself decides which enemies are currently hittable.
    for _, Enemy in ipairs(
        InRange:GetChildren()
    ) do
        local UUID =
            Enemy.Name

        if IsUUID(UUID)
            and not Seen[UUID]
        then
            Seen[UUID] = true

            table.insert(
                UUIDs,
                UUID
            )
        end
    end

    table.sort(UUIDs)

    return UUIDs
end



function AutoBestEquipmentController:NormalizeStatName(
    StatName
)
    return string.lower(
        string.gsub(
            tostring(
                StatName
                or ""
            ),
            "_",
            " "
        )
    )
end


function AutoBestEquipmentController:NormalizeStatMagnitude(
    StatName,
    Value
)
    Value =
        tonumber(
            Value
        )
        or 0

    local Name =
        self:NormalizeStatName(
            StatName
        )

    local IsFactor =
        string.find(
            Name,
            "factor",
            1,
            true
        )
        or string.find(
            Name,
            "multiplier",
            1,
            true
        )

    if IsFactor
        and Value >= 0.5
        and Value <= 3
    then
        return (
            Value - 1
        ) * 100
    end

    local PercentageLike =
        string.find(
            Name,
            "chance",
            1,
            true
        )
        or string.find(
            Name,
            "reduction",
            1,
            true
        )
        or string.find(
            Name,
            "speed",
            1,
            true
        )
        or string.find(
            Name,
            "cooldown",
            1,
            true
        )
        or string.find(
            Name,
            "critical",
            1,
            true
        )
        or string.find(
            Name,
            "crit",
            1,
            true
        )

    if PercentageLike
        and math.abs(
            Value
        ) <= 3
    then
        return Value
            * 100
    end

    return Value
end

function AutoBestEquipmentController:GetDamageStatBucket(
    StatName
)
    local Name =
        self:NormalizeStatName(
            StatName
        )

    if string.find(
        Name,
        "additional damage",
        1,
        true
    )
        and not string.find(
            Name,
            "factor",
            1,
            true
        )
        and not string.find(
            Name,
            "multiplier",
            1,
            true
        )
    then
        return "FlatAdditionalDamage"
    end

    if string.find(
        Name,
        "additional damage factor",
        1,
        true
    )
        or (
            string.find(
                Name,
                "additional damage",
                1,
                true
            )
            and (
                string.find(
                    Name,
                    "factor",
                    1,
                    true
                )
                or string.find(
                    Name,
                    "multiplier",
                    1,
                    true
                )
            )
        )
    then
        return "AdditionalDamageFactor"
    end

    if string.find(
        Name,
        "critical",
        1,
        true
    )
        or string.find(
            Name,
            "crit",
            1,
            true
        )
    then
        return "Crit"
    end

    if string.find(
        Name,
        "attack speed",
        1,
        true
    )
    then
        return "AttackSpeed"
    end

    if string.find(
        Name,
        "damage",
        1,
        true
    )
        or string.find(
            Name,
            "attack",
            1,
            true
        )
        or string.find(
            Name,
            "strength",
            1,
            true
        )
        or string.find(
            Name,
            "power",
            1,
            true
        )
    then
        return "OtherDamage"
    end

    if string.find(
        Name,
        "cooldown",
        1,
        true
    )
    then
        return "Cooldown"
    end

    return "Other"
end


function AutoBestEquipmentController:GetDamageComparisonVector(
    Stats,
    ItemName,
    ItemInstance,
    Definition
)
    local Vector = {
        FlatAdditionalDamage = 0,
        AdditionalDamageFactor = 0,
        OtherDamage = 0,
        Crit = 0,
        AttackSpeed = 0,
        Cooldown = 0,
        OtherUseful = 0,
    }

    if type(
        Stats
    ) ~= "table"
    then
        return Vector
    end

    local RefineLevel =
        self:GetRefineLevel(
            ItemInstance
        )

    local SeriesMultiplier =
        self:GetSeriesMultiplier(
            ItemInstance
        )

    for StatName,
        RawValue in pairs(
            Stats
        )
    do
        if type(
            RawValue
        ) == "number"
            and RawValue ~= 0
        then
            local Value =
                RawValue

            if Definition.Refinable
                == true
            then
                Value *=
                    self:GetRefinementMultiplier(
                        ItemName,
                        StatName,
                        RefineLevel
                    )
            end

            Value *=
                SeriesMultiplier

            local Bucket =
                self:GetDamageStatBucket(
                    StatName
                )

            if Bucket
                == "FlatAdditionalDamage"
            then
                Vector.FlatAdditionalDamage +=
                    Value

            elseif Bucket
                == "AdditionalDamageFactor"
            then
                local Bonus =
                    Value

                if Bonus >= 0.5
                    and Bonus <= 3
                then
                    Bonus =
                        (
                            Bonus - 1
                        )
                        * 100
                elseif math.abs(
                    Bonus
                ) <= 0.5
                then
                    Bonus *=
                        100
                end

                Vector.AdditionalDamageFactor +=
                    Bonus

            elseif Bucket
                == "OtherDamage"
            then
                Vector.OtherDamage +=
                    self:NormalizeStatMagnitude(
                        StatName,
                        Value
                    )

            elseif Bucket
                == "Crit"
            then
                Vector.Crit +=
                    self:NormalizeStatMagnitude(
                        StatName,
                        Value
                    )

            elseif Bucket
                == "AttackSpeed"
            then
                Vector.AttackSpeed +=
                    self:NormalizeStatMagnitude(
                        StatName,
                        Value
                    )

            elseif Bucket
                == "Cooldown"
            then
                Vector.Cooldown +=
                    self:NormalizeStatMagnitude(
                        StatName,
                        Value
                    )

            else
                Vector.OtherUseful +=
                    math.max(
                        0,
                        self:NormalizeStatMagnitude(
                            StatName,
                            Value
                        )
                    )
            end
        end
    end

    return Vector
end


function AutoBestEquipmentController:IsDamageCandidateBetter(
    A,
    B
)
    if B == nil then
        return true
    end

    local AV =
        A.DamageVector
        or {}

    local BV =
        B.DamageVector
        or {}

    local Order = {
        "FlatAdditionalDamage",
        "AdditionalDamageFactor",
        "OtherDamage",
        "Crit",
        "AttackSpeed",
        "Cooldown",
        "OtherUseful",
    }

    for _,
        Key in ipairs(
            Order
        )
    do
        local AValue =
            tonumber(
                AV[
                    Key
                ]
            )
            or 0

        local BValue =
            tonumber(
                BV[
                    Key
                ]
            )
            or 0

        if math.abs(
            AValue - BValue
        ) > 0.000001
        then
            return AValue
                > BValue
        end
    end

    if A.RefineLevel
        ~= B.RefineLevel
    then
        return A.RefineLevel
            > B.RefineLevel
    end

    if A.Rarity
        ~= B.Rarity
    then
        return A.Rarity
            > B.Rarity
    end

    return A.Id
        < B.Id
end


